10 REM STAR SHOOTER: SHIP AT THE BOTTOM, SHOOT THE CROSSING ENEMY
20 REM B3 TARGET: THREE MOVES, STRIG, CRASH PAIR, CAN, PLAY, BEEP
30 CLS:SPRITE ON
40 SC=0:TC=0
50 DEF MOVE(0)=SPRITE(9,0,1,255,0,0)
60 POSITION 0,120,200:MOVE 0
70 DEF MOVE(1)=SPRITE(8,3,2,112,0,1)
80 POSITION 1,16,40:MOVE 1
90 DEF MOVE(2)=SPRITE(14,1,1,88,0,2)
100 PLAY "T3O4C3E3G3O5C5"
110 REM MAIN LOOP
120 S=STICK(0):TR=STRIG(0)
130 IF (S AND 1)<>0 THEN GOSUB 300
140 IF (S AND 2)<>0 THEN GOSUB 340
150 IF (TR AND 8)<>0 THEN GOSUB 400
160 IF MOVE(1)=0 THEN POSITION 1,16,40:MOVE 1
170 IF MOVE(2)=0 THEN ERA 2
180 C=CRASH(1):IF C=2 THEN GOSUB 500
190 TC=TC+1:IF TC>1800 THEN 600
200 LOCATE 0,0:PRINT "SCORE";SC;
210 PAUSE 1
220 GOTO 120
300 REM MOVE RIGHT
310 X=XPOS(0):IF X>224 THEN RETURN
320 DEF MOVE(0)=SPRITE(9,3,1,4,0,0):POSITION 0,X,200:MOVE 0
330 RETURN
340 REM MOVE LEFT
350 X=XPOS(0):IF X<24 THEN RETURN
360 DEF MOVE(0)=SPRITE(9,7,1,4,0,0):POSITION 0,X,200:MOVE 0
370 RETURN
400 REM FIRE UNLESS THE LASER IS STILL FLYING
410 IF MOVE(2)=-1 THEN RETURN
420 POSITION 2,XPOS(0),192
430 MOVE 2:BEEP
440 RETURN
500 REM ENEMY DOWN
510 SC=SC+10:BEEP
520 CAN 1,2
530 POSITION 1,16,40:MOVE 1
540 RETURN
600 REM TIME UP
610 ERA 0,1,2:SPRITE OFF
620 LOCATE 9,11:PRINT "タイムアップ!"
630 LOCATE 8,13:PRINT "SCORE";SC
640 IF SC>=100 THEN LOCATE 9,15:PRINT "すごい!"
650 END
