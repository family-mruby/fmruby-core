10 REM STAR SHOOTER: KEYBOARD ONLY. ARROWS FLY THE SHIP, Z SHOOTS
20 REM ONE MINUTE ROUND. THE SPRITE PLANE IN ONE PROGRAM: DEF MOVE IN
25 REM 8 DIRECTIONS, MOVE, POSITION, XPOS/YPOS, CRASH BOTH WAYS,
30 REM ERA, CAN, PALET, PLAY, BEEP
40 REM THE KEYBOARD IS THE PAD (FMRB_BASIC.CPP): ARROWS = STICK, Z = A
50 CLS:SPRITE ON
60 REM NIGHT SKY, WHITE AND RED SPRITES OUTLINED IN BLACK
70 PALET 0,15,22,42,48
80 PALET S 0,15,48,22,42
90 PALET S 1,15,48,42,32
100 REM DIRECTION CODE OF A (DX,DY) STEP, LOOKED UP BY (DY+1)*3+DX+1
110 DIM DC(8)
120 FOR I=0 TO 8:READ A:DC(I)=A:NEXT
130 DATA 8,1,2,7,0,3,6,5,4
140 REM THE SHIP IS KEPT INSIDE THIS BOX, WHICH IS THE VISIBLE SCREEN
150 XL=16:XR=224:YT=48:YB=200
160 REM TITLE. THE FIRE KEY STARTS THE GAME, SO IT IS TRIED FIRST
170 LOCATE 9,7:PRINT "ホシヲ ウテ"
180 LOCATE 5,12:PRINT "ヤジルシ  ウゴク"
190 LOCATE 5,14:PRINT "Z        ウツ"
200 LOCATE 8,19:PRINT "Z ヲ オセ"
210 PAUSE 1
220 IF (STRIG(0) AND 8)=0 THEN 210
230 CLS
240 SC=0:HP=3:TC=0
250 REM THE SHIP, THE ENEMY CROSSING THE TOP, AND THE LASER
260 DEF MOVE(0)=SPRITE(9,0,1,4,0,0)
270 POSITION 0,120,190:MOVE 0
280 DEF MOVE(1)=SPRITE(8,3,2,112,0,1)
290 POSITION 1,16,40:MOVE 1
300 DEF MOVE(2)=SPRITE(14,1,1,88,0,2)
310 PLAY "T3O4C3E3G3O5C5"
320 REM MAIN LOOP
330 GOSUB 700
340 IF (STRIG(0) AND 8)<>0 THEN GOSUB 600
350 IF MOVE(1)=0 THEN POSITION 1,16,40:MOVE 1
360 IF MOVE(2)=0 THEN ERA 2
370 C=CRASH(1)
380 IF C=2 THEN GOSUB 630
390 IF C=0 THEN GOSUB 660
400 TC=TC+1
410 LOCATE 0,0:PRINT "SCORE";SC;" HP";HP;
420 PAUSE 1
430 IF TC>3600 THEN 800
440 IF HP>0 THEN 330
450 GOTO 800
600 REM FIRE, UNLESS THE LASER IS STILL FLYING
610 IF MOVE(2)=-1 THEN RETURN
620 POSITION 2,XPOS(0),YPOS(0)-8:MOVE 2:BEEP
625 RETURN
630 REM ENEMY DOWN. CAN CLEARS BOTH, SO BOTH ARE DEFINED AGAIN
640 SC=SC+10:BEEP
645 CAN 1,2
650 DEF MOVE(1)=SPRITE(8,3,2,112,0,1)
652 POSITION 1,16,40:MOVE 1
654 DEF MOVE(2)=SPRITE(14,1,1,88,0,2)
656 RETURN
660 REM THE ENEMY RAMMED THE SHIP: ERA KEEPS THE DEFINITION
670 HP=HP-1:BEEP
680 ERA 1
690 POSITION 1,16,40:MOVE 1
695 RETURN
700 REM FLY THE SHIP, KEEPING IT INSIDE THE BOX. THE MOVE ENGINE DRIVES
701 REM THE ENEMY AND THE LASER, BUT NOT THE SHIP: POSITION AND DEF MOVE
702 REM BOTH RESET THE STEP COUNTER, SO A MOTION RE-ISSUED EVERY FRAME
703 REM NEVER REACHES ITS STEP PERIOD AND WOULD STAND STILL. THE SHIP IS
704 REM THEREFORE STEPPED BY HAND, AND DEF MOVE ONLY TURNS IT
710 S=STICK(0):DX=0:DY=0
720 IF (S AND 1)=1 THEN DX=1
730 IF (S AND 2)=2 THEN DX=-1
740 IF (S AND 4)=4 THEN DY=1
750 IF (S AND 8)=8 THEN DY=-1
760 X=XPOS(0)+DX*4:Y=YPOS(0)+DY*4
770 IF X<XL THEN X=XL
775 IF X>XR THEN X=XR
780 IF Y<YT THEN Y=YT
785 IF Y>YB THEN Y=YB
790 POSITION 0,X,Y
793 DR=DC((DY+1)*3+DX+1)
796 IF DR<>0 THEN DEF MOVE(0)=SPRITE(9,DR,1,4,0,0)
797 RETURN
800 REM TIME UP OR OUT OF HP
810 ERA 0,1,2:SPRITE OFF
820 CLS
830 IF HP>0 THEN LOCATE 8,10:PRINT "タイムアップ!"
840 IF HP<=0 THEN LOCATE 8,10:PRINT "ゲキツイ サレタ"
850 LOCATE 8,13:PRINT "SCORE";SC
860 IF SC>=100 THEN LOCATE 9,16:PRINT "スゴイ!"
865 PAUSE 300
870 END
