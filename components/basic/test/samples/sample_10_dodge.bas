10 REM DODGE: MOVE MARIO WITH THE PAD, AVOID FALLING FIREBALLS
20 REM B3 TARGET: DEF MOVE, MOVE/ERA, STICK, CRASH, XPOS/YPOS, PAUSE
30 CLS:SPRITE ON
40 DIM DT(10)
50 FOR I=0 TO 10:READ A:DT(I)=A:NEXT
60 DATA 0,3,7,0,5,4,6,0,1,2,8
70 SC=0:HP=3
80 DEF MOVE(0)=SPRITE(0,0,1,255,0,0)
90 POSITION 0,120,180:MOVE 0
100 DEF MOVE(1)=SPRITE(6,5,1,96,0,1)
110 GOSUB 300
120 REM MAIN LOOP
130 S=STICK(0):IF S>10 THEN 160
140 DR=DT(S):IF DR=0 THEN 160
150 X=XPOS(0):Y=YPOS(0):DEF MOVE(0)=SPRITE(0,DR,1,4,0,0):POSITION 0,X,Y:MOVE 0
160 IF MOVE(1)=0 THEN GOSUB 300
170 IF CRASH(0)=1 THEN GOSUB 400
180 SC=SC+1
190 LOCATE 0,0:PRINT "SCORE";SC;" HP";HP;
200 PAUSE 2
210 IF HP>0 THEN 130
220 LOCATE 8,12:PRINT "ゲームオーバー"
230 LOCATE 7,14:PRINT "SCORE";SC
240 ERA 0,1:SPRITE OFF
250 END
300 REM RESPAWN THE FIREBALL AT A RANDOM X
310 POSITION 1,RND(208)+16,29:MOVE 1
320 RETURN
400 REM HIT
410 BEEP:HP=HP-1
420 ERA 1:GOSUB 300
430 RETURN
