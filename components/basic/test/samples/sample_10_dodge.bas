10 REM DODGE: MOVE THE HERO WITH THE PAD, AVOID THE FALLING FIREBALLS
20 REM B3 TARGET: DEF MOVE, MOVE/CUT/ERA, PALET, STICK, CRASH, XPOS/YPOS
30 CLS:SPRITE ON
40 REM BRIGHT SKY BACKDROP WITH BLACK INK AND BLACK OUTLINED SPRITES
50 PALET 0,49,2,22,15
60 PALET S 0,49,15,22,39
70 PALET S 1,49,15,38,54
80 REM DIRECTION CODE OF A (DX,DY) STEP, LOOKED UP BY (DY+1)*3+DX+1
90 DIM DC(8),WT(3)
100 FOR I=0 TO 8:READ A:DC(I)=A:NEXT
110 DATA 8,1,2,7,0,3,6,5,4
120 REM THE HERO IS KEPT INSIDE THIS BOX, WHICH IS THE VISIBLE SCREEN
130 XL=16:XR=224:YT=48:YB=200
140 SC=0:HP=3
150 DEF MOVE(0)=SPRITE(0,0,1,2,0,0)
160 POSITION 0,120,180:MOVE 0
170 FOR I=1 TO 3
180 DEF MOVE(I)=SPRITE(6,5,1,96,0,1)
190 WT(I)=(I-1)*15:NEXT
200 REM MAIN LOOP
210 GOSUB 600
220 FOR I=1 TO 3
230 IF MOVE(I)<>0 THEN 270
240 IF WT(I)>0 THEN WT(I)=WT(I)-1:GOTO 270
250 WT(I)=RND(30)+10
260 GOSUB 400
270 NEXT
280 C=CRASH(0):IF C>0 THEN GOSUB 500
290 SC=SC+1
300 LOCATE 0,0:PRINT "SCORE";SC;" HP";HP;
310 PAUSE 2
320 IF HP>0 THEN 210
330 LOCATE 8,12:PRINT "ゲームオーバー"
340 LOCATE 7,14:PRINT "SCORE";SC
350 ERA 0,1,2,3:SPRITE OFF
360 END
400 REM DROP FIREBALL I FROM A RANDOM PLACE ALONG THE TOP EDGE
410 DEF MOVE(I)=SPRITE(6,5,RND(2)+1,96,0,1)
420 POSITION I,RND(209)+16,24
430 MOVE I
440 RETURN
500 REM HIT: THAT FIREBALL BURNS OUT AND COMES BACK AFTER A WHILE
510 BEEP:HP=HP-1
520 ERA C
530 WT(C)=RND(30)+10
540 RETURN
600 REM WALK THE HERO, DROPPING ANY STEP THAT WOULD LEAVE THE BOX
610 S=STICK(0):DX=0:DY=0
620 IF (S AND 1)=1 THEN DX=1
630 IF (S AND 2)=2 THEN DX=-1
640 IF (S AND 4)=4 THEN DY=1
650 IF (S AND 8)=8 THEN DY=-1
660 X=XPOS(0):IF X<XL THEN X=XL
670 IF X>XR THEN X=XR
680 Y=YPOS(0):IF Y<YT THEN Y=YT
690 IF Y>YB THEN Y=YB
700 IF X+DX*4<XL OR X+DX*4>XR THEN DX=0
710 IF Y+DY*4<YT OR Y+DY*4>YB THEN DY=0
720 DR=DC((DY+1)*3+DX+1)
730 IF DR=0 THEN CUT 0
740 POSITION 0,X,Y
750 IF DR<>0 THEN DEF MOVE(0)=SPRITE(0,DR,1,2,0,0):MOVE 0
760 RETURN
