10 REM DATA/READ/RESTORE, DIM ARRAY, GOSUB/RETURN
20 DIM S(5)
30 N=0
40 READ V
50 IF V=-1 THEN 90
60 N=N+1
70 S(N)=V
80 GOTO 40
90 T=0
100 FOR I=1 TO N
110 T=T+S(I)
120 NEXT
130 PRINT "COUNT";N
140 PRINT "TOTAL";T
150 GOSUB 200
160 RESTORE
170 READ V
180 PRINT "FIRST";V
190 END
200 REM AVERAGE (INTEGER DIVISION)
210 PRINT "AVERAGE";T/N
220 RETURN
230 DATA 12,34,56,78,90,-1
