10 REM STRING FUNCTIONS - LEN/LEFT$/RIGHT$/MID$/ASC/CHR$/VAL/STR$
20 A$="FAMILY BASIC"
30 PRINT A$
40 PRINT LEN(A$)
50 PRINT LEFT$(A$,6)
60 PRINT RIGHT$(A$,5)
70 PRINT MID$(A$,8,5)
80 B$=""
90 FOR I=1 TO LEN(A$)
100 C$=MID$(A$,I,1)
110 IF C$=" " THEN 130
120 B$=B$+C$
130 NEXT
140 PRINT B$
150 PRINT ASC("A")
160 PRINT CHR$(66)
170 PRINT VAL("123")+1
180 PRINT STR$(-45)
190 END
