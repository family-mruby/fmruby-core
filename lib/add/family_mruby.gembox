MRuby::GemBox.new do |conf|
  # Compiler must be included for runtime compilation (sandbox, eval)
  conf.gem core: 'mruby-compiler'

  # loading order is important
  conf.gem core: 'picoruby-fmrb-io'
  conf.gem core: "picoruby-fmrb-filesystem"

  conf.gem core: 'picoruby-machine'
  conf.gem core: 'picoruby-require'
  conf.gem core: 'picoruby-sandbox'
  conf.gem core: 'picoruby-env'
  conf.gem core: 'picoruby-crc'
  conf.gem core: 'picoruby-rng'

  # Optional
  conf.gem core: "picoruby-eval"
  conf.gem core: "picoruby-yaml"
  conf.gem core: "picoruby-json"
  conf.gem core: 'picoruby-syntax-highlight'

  # Family mruby specific
  conf.gem core: "picoruby-fmrb-const"
  conf.gem core: "picoruby-fmrb-log"
  conf.gem core: "picoruby-fmrb-msgpack"
  conf.gem core: "picoruby-fmrb-kernel"
  conf.gem core: "picoruby-fmrb-bmp332"
  # One FFT, four engines (doc/mic_spectrum). Before the app gem: the
  # microphone demo reaches for it through FmrbApp.
  conf.gem core: "picoruby-fmrb-fft"
  conf.gem core: "picoruby-fmrb-app"
  # Editor document model in C (POOL_ID_EDITOR_DOC arena). After picoruby-fmrb-app
  # so the loading order stays "framework, then the pieces that lean on it".
  conf.gem core: "picoruby-fmrb-editor-core"
  # Type inference engine behind the editor's completion/hover/diagnostics
  # (pure C, no Ruby classes; parses with the prism inside mruby-compiler).
  # Delivered from the pinned fork by rake ti:setup, see doc/editor_ti/plan.md.
  conf.gem core: "picoruby-ti"
  conf.gem core: "picoruby-fmrb-debug"
  # MIDI: protocol layer and MML parser imported from Midori, then the
  # Family mruby transports and players
  conf.gem core: "picoruby-midi"
  conf.gem core: "picoruby-midi-mml"
  conf.gem core: "picoruby-fmrb-midi"
  conf.gem core: "picoruby-fmrb-picorabbit"
end
