<%
  # mrb_get_args letter and the C variable(s) it fills, per argument kind.
  get = lambda do |p|
    v = "a_#{p.name}"
    case p.ty.kind
    when :int then ['i', ["mrb_int #{v}"], ["&#{v}"]]
    when :bool then ['b', ["mrb_bool #{v}"], ["&#{v}"]]
    when :float then ['f', ["mrb_float #{v}"], ["&#{v}"]]
    when :str, :bin then ['s', ["const char *#{v}", "mrb_int #{v}_len"], ["&#{v}", "&#{v}_len"]]
    when :choice then ['n', ["mrb_sym #{v}"], ["&#{v}"]]
    when :record then ['H', ["mrb_value #{v}"], ["&#{v}"]]
    when :array then ['A', ["mrb_value #{v}"], ["&#{v}"]]
    end
  end
  # The C expressions the flat function takes for one argument.
  pass = lambda do |p|
    v = "a_#{p.name}"
    case p.ty.kind
    when :int, :choice then ["(#{p.ty.ctype})#{p.ty.kind == :choice ? "c_#{p.name}" : v}"]
    when :bool then ["#{v} ? 1 : 0"]
    when :float then ["(#{p.ty.ctype})#{v}"]
    when :str then [v, "(int32_t)#{v}_len"]
    when :bin then ["(const uint8_t *)#{v}", "(int32_t)#{v}_len"]
    when :record then ["&r_#{p.name}"]
    when :array then ["l_#{p.name}", "(int32_t)n_#{p.name}"]
    end
  end
  int_lit = ->(n) { n.negative? ? "(#{n + 1}LL - 1)" : "#{n}ULL" }
-%>
/* Generated by tools/boundary/gen.rb from the .rbs files in sig/ -- do not edit. */
/*
 * mruby methods of the app boundary. Included by the gem's C file after it
 * defines the receiver hook of each class: int32_t fmrb_mrb_recv_<name>(mrb,
 * self) gives the receiver number. FMRB_GEN_MRB_DEFINE_<Class>(mrb, cls)
 * registers the class's methods. A record is a Hash with Symbol keys.
 */
#include <string.h>
#include "fmrb_gen/fmrb_boundary.h"

static void fmrb_gen_mrb_check(mrb_state *mrb, int32_t ret, const char *what)
{
    if (ret == FMRB_BOUNDARY_ERR_ARG) {
        mrb_raisef(mrb, E_ARGUMENT_ERROR, "%s: argument out of range", what);
    }
    if (ret < 0) {
        mrb_raisef(mrb, E_RUNTIME_ERROR, "%s failed: %d", what, (int)ret);
    }
}
<% if records.any? -%>

/* One field of a record: present, an Integer, and in its width's range. The
   key's symbol comes from the caller (mrb_intern_lit, the length known when
   compiled); the text is for the message. */
static __attribute__((unused)) mrb_int fmrb_gen_mrb_field_int(mrb_state *mrb, mrb_value h, mrb_sym sym,
                                                                    const char *key, long long lo,
                                                                    unsigned long long hi)
{
    mrb_value v = mrb_hash_get(mrb, h, mrb_symbol_value(sym));
    if (mrb_nil_p(v)) {
        mrb_raisef(mrb, E_ARGUMENT_ERROR, "record field %s: missing", key);
    }
    mrb_int n = mrb_as_int(mrb, v);
    if ((n < 0 && (long long)n < lo) || (n >= 0 && (unsigned long long)n > hi)) {
        mrb_raisef(mrb, E_ARGUMENT_ERROR, "record field %s: %d out of range", key, (int)n);
    }
    return n;
}

static __attribute__((unused)) mrb_value fmrb_gen_mrb_field(mrb_state *mrb, mrb_value h, mrb_sym sym, const char *key)
{
    mrb_value v = mrb_hash_get(mrb, h, mrb_symbol_value(sym));
    if (mrb_nil_p(v) && !mrb_hash_key_p(mrb, h, mrb_symbol_value(sym))) {
        mrb_raisef(mrb, E_ARGUMENT_ERROR, "record field %s: missing", key);
    }
    return v;
}
<% end -%>
<% records.each do |r| -%>

/* <%= r.klass %>::<%= r.name %> from a Hash */
static __attribute__((unused)) void fmrb_gen_mrb_pack_<%= r.cname %>(mrb_state *mrb, mrb_value h, <%= r.cname %> *out)
{
    if (!mrb_hash_p(h)) {
        mrb_raise(mrb, E_ARGUMENT_ERROR, "<%= r.name %>: expected a Hash");
    }
<% r.fields.each do |f| -%>
<% case f.ty.kind when :int -%>
    out-><%= f.name %> = (<%= f.ty.ctype %>)fmrb_gen_mrb_field_int(mrb, h, mrb_intern_lit(mrb, "<%= f.name %>"), "<%= f.name %>", <%= int_lit.(f.ty.min) %>, <%= int_lit.(f.ty.max) %>);
<% when :bool -%>
    out-><%= f.name %> = mrb_test(fmrb_gen_mrb_field(mrb, h, mrb_intern_lit(mrb, "<%= f.name %>"), "<%= f.name %>")) ? 1 : 0;
<% when :float -%>
    out-><%= f.name %> = (<%= f.ty.ctype %>)mrb_as_float(mrb, fmrb_gen_mrb_field(mrb, h, mrb_intern_lit(mrb, "<%= f.name %>"), "<%= f.name %>"));
<% end -%>
<% end -%>
}

/* <%= r.klass %>::<%= r.name %> as a Hash */
static __attribute__((unused)) mrb_value fmrb_gen_mrb_unpack_<%= r.cname %>(mrb_state *mrb, const <%= r.cname %> *in)
{
    mrb_value h = mrb_hash_new_capa(mrb, <%= r.fields.size %>);
<% r.fields.each do |f| -%>
<% val = case f.ty.kind when :int then "mrb_int_value(mrb, (mrb_int)in->#{f.name})" when :bool then "mrb_bool_value(in->#{f.name} != 0)" else "mrb_float_value(mrb, (mrb_float)in->#{f.name})" end -%>
    mrb_hash_set(mrb, h, mrb_symbol_value(mrb_intern_lit(mrb, "<%= f.name %>")), <%= val %>);
<% end -%>
    return h;
}
<% end -%>
<% funcs.each do |f| -%>
<% gs = f.params.map { |p| get.(p) } -%>

/* <%= f.ruby_sig %>: <%= f.doc_en %> */
static mrb_value fmrb_gen_mrb_<%= f.import_name %>(mrb_state *mrb, mrb_value self)
{
<% gs.flat_map { |g| g[1] }.each do |decl| -%>
    <%= decl %>;
<% end -%>
<% unless f.params.empty? -%>
    mrb_get_args(mrb, "<%= gs.map(&:first).join %>", <%= gs.flat_map { |g| g[2] }.join(', ') %>);
<% end -%>
<% f.params.each do |p| -%>
<% case p.ty.kind when :choice -%>
    /* the choice by its name, looked up once (no symbol interned per call) */
    int32_t c_<%= p.name %>;
    mrb_int n_<%= p.name %>;
    const char *s_<%= p.name %> = mrb_sym_name_len(mrb, a_<%= p.name %>, &n_<%= p.name %>);
<% p.ty.values.each_with_index do |v, i| -%>
    <%= i.zero? ? '' : '} else ' %>if (n_<%= p.name %> == <%= v.to_s.bytesize %> && memcmp(s_<%= p.name %>, "<%= v %>", <%= v.to_s.bytesize %>) == 0) {
        c_<%= p.name %> = <%= i %>;
<% end -%>
    } else {
        mrb_raisef(mrb, E_ARGUMENT_ERROR, "<%= f.method %>: <%= p.name %> is one of <%= p.ty.values.map { |v| ":#{v}" }.join(', ') %>");
    }
<% when :record -%>
    <%= p.ty.record.cname %> r_<%= p.name %>;
    fmrb_gen_mrb_pack_<%= p.ty.record.cname %>(mrb, a_<%= p.name %>, &r_<%= p.name %>);
<% when :array -%>
<% et = p.ty.elem.kind == :record ? p.ty.elem.record.cname : p.ty.elem.ctype -%>
    mrb_int n_<%= p.name %> = RARRAY_LEN(a_<%= p.name %>);
    if (n_<%= p.name %> > FMRB_BOUNDARY_ARRAY_MAX) {
        mrb_raisef(mrb, E_ARGUMENT_ERROR, "<%= f.method %>: more than %d in <%= p.name %>", FMRB_BOUNDARY_ARRAY_MAX);
    }
    <%= et %> l_<%= p.name %>[FMRB_BOUNDARY_ARRAY_MAX];
    for (mrb_int i = 0; i < n_<%= p.name %>; i++) {
<% if p.ty.elem.kind == :record -%>
        fmrb_gen_mrb_pack_<%= et %>(mrb, mrb_ary_ref(mrb, a_<%= p.name %>, i), &l_<%= p.name %>[i]);
<% else -%>
        l_<%= p.name %>[i] = (<%= et %>)mrb_as_int(mrb, mrb_ary_ref(mrb, a_<%= p.name %>, i));
<% end -%>
    }
<% end -%>
<% end -%>
<% if f.recv -%>
    int32_t <%= f.recv %> = fmrb_mrb_recv_<%= f.recv %>(mrb, self);
<% end -%>
<% args = (f.recv ? [f.recv] : []) + f.params.flat_map { |p| pass.(p) } -%>
<% if f.returns_record? -%>
    <%= f.ret.record.cname %> out;
    int32_t ret = <%= f.flat %>(<%= (args + ['&out']).join(', ') %>);
    fmrb_gen_mrb_check(mrb, ret, "<%= f.method %>");
<% if f.ret.optional -%>
    if (ret == 0) {
        return mrb_nil_value();
    }
<% end -%>
    return fmrb_gen_mrb_unpack_<%= f.ret.record.cname %>(mrb, &out);
<% elsif f.returns_bytes? -%>
    char buf[128];
    int32_t ret = <%= f.flat %>(<%= (args + ["(#{f.ret.kind == :bin ? 'uint8_t' : 'char'} *)buf", 'sizeof(buf)']).join(', ') %>);
    fmrb_gen_mrb_check(mrb, ret, "<%= f.method %>");
    if (ret <= (int32_t)sizeof(buf)) {
        return mrb_str_new(mrb, buf, ret);
    }
    mrb_value s = mrb_str_new(mrb, NULL, ret);
    int32_t got = <%= f.flat %>(<%= (args + ["(#{f.ret.kind == :bin ? 'uint8_t' : 'char'} *)RSTRING_PTR(s)", 'ret']).join(', ') %>);
    fmrb_gen_mrb_check(mrb, got, "<%= f.method %>");
    mrb_str_resize(mrb, s, got < ret ? got : ret);
    return s;
<% else -%>
    int32_t ret = <%= f.flat %>(<%= args.join(', ') %>);
    fmrb_gen_mrb_check(mrb, ret, "<%= f.method %>");
<% case f.ret when :self -%>
    return self;
<% when :void -%>
    return mrb_nil_value();
<% else -%>
<% case f.ret.kind when :bool -%>
    return mrb_bool_value(ret != 0);
<% when :choice -%>
<% f.ret.values.each_with_index do |v, i| -%>
    if (ret == <%= i %>) return mrb_symbol_value(mrb_intern_lit(mrb, "<%= v %>"));
<% end -%>
    return mrb_nil_value();
<% else -%>
    return mrb_fixnum_value(ret);
<% end -%>
<% end -%>
<% end -%>
}
<% end -%>
<% funcs.group_by(&:klass).each do |klass, fs| -%>

#define FMRB_GEN_MRB_DEFINE_<%= klass %>(mrb, cls) \
<% fs.each do |f| -%>
    mrb_define_<%= f.singleton ? 'class_' : '' %>method((mrb), (cls), "<%= f.method %>", fmrb_gen_mrb_<%= f.import_name %>, <%= f.params.empty? ? 'MRB_ARGS_NONE()' : "MRB_ARGS_REQ(#{f.params.size})" %>); \
<% end -%>
    do {} while (0)
<% end -%>
