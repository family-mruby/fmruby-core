<%
  py = []
  py << '# The boundary methods of the Family mruby classes, generated from sig/'
  py << '# (tools/boundary/gen.rb). The prelude classes (FmrbGfx ...) inherit them'
  py << '# and add the wrappers by hand, as the Ruby mrblib does.'
  py << 'import _fmrb'
  funcs.group_by(&:klass).each do |klass, fs|
    py << ''
    py << ''
    py << "class _#{klass}Boundary:"
    fs.each do |f|
      names = f.params.map(&:name)
      py << ''
      py << "    # #{f.doc_en}"
      if f.singleton
        py << '    @staticmethod'
        py << "    def #{f.method}(#{names.join(', ')}):"
        call = "_fmrb.#{f.import_name}(#{names.join(', ')})"
      else
        py << "    def #{f.method}(#{(['self'] + names).join(', ')}):"
        call = "_fmrb.#{f.import_name}(#{(['self'] + names).join(', ')})"
      end
      if f.ret == :self && !f.singleton
        py << "        #{call}"
        py << '        return self'
      elsif f.ret == :self || f.ret == :void
        py << "        #{call}"
      else
        py << "        return #{call}"
      end
    end
  end
  esc = ->(l) { l.gsub('\\', '\\\\\\\\').gsub('"', '\\"') }
-%>
/* Generated by tools/boundary/gen.rb from the .rbs files in sig/ -- do not edit. */
/*
 * The Python half of the app boundary: one class per boundary class of sig/,
 * each method calling its _fmrb function with the object itself as the
 * receiver. Run before the prelude (fmrb_prelude.h), whose classes inherit
 * these; the source lives in flash with the prelude's.
 */
#pragma once

static const char fmrb_mp_boundary_src[] =
<% py.each do |l| -%>
    "<%= esc.(l) %>\n"
<% end -%>
    ;
