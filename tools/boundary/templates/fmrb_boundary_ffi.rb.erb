<%
  ffi = lambda do |ctype, where|
    case ctype
    when 'int32_t' then ':int32'
    when 'int16_t' then ':int16'
    when 'uint16_t' then ':uint16'
    when 'int8_t' then ':int8'
    when 'uint8_t' then ':uint8'
    when 'uint32_t' then ':uint32'
    when 'int64_t' then ':int64'
    when 'double' then ':double'
    when 'float' then ':float'
    else
      raise "#{where}: #{ctype} has no Spinel FFI type" unless ctype.end_with?('*')
      ':str'
    end
  end
-%>
# Generated by tools/boundary/gen.rb from the .rbs files in sig/ -- do not edit.
# Spinel FFI declarations of the app boundary's flat functions
# (components/fmrb_common/include/fmrb_gen/fmrb_boundary.h). Spliced into the
# Spinel app programs before fmrb_app_base_spinel.rb, whose classes call them.
# A String argument is two: the String and its bytesize. A record argument is
# a String of its packed bytes (and an array of them, that and the count).
# A function that gives back a record or bytes is reached through its adaptor
# fmrb_spx_b_* (fmrb_boundary_spx.inc), which returns them as a byte String:
# empty for none or for an error.
module FmrbBoundary
<% funcs.each do |f| -%>
<% if f.returns_record? || f.returns_bytes? -%>
<% ps = f.c_params[0...(f.returns_record? ? -1 : -2)] -%>
  ffi_func :fmrb_spx_b_<%= f.import_name %>, [<%= ps.map { |t, _| ffi.(t, f.ruby_sig) }.join(', ') %>], :binstr  # <%= f.ruby_sig %>
<% else -%>
  ffi_func :<%= f.flat %>, [<%= f.c_params.map { |t, _| ffi.(t, f.ruby_sig) }.join(', ') %>], :int32  # <%= f.ruby_sig %>
<% end -%>
<% end -%>
end
