<%
  int_lit = ->(n) { n.negative? ? "(#{n + 1}LL - 1)" : "#{n}ULL" }
  new_int = ->(ty, expr) { ty.ctype.start_with?('u') ? "mp_obj_new_int_from_uint((mp_uint_t)#{expr})" : "mp_obj_new_int((mp_int_t)#{expr})" }
-%>
/* Generated by tools/boundary/gen.rb from the .rbs files in sig/ -- do not edit. */
/*
 * MicroPython functions of the _fmrb module for the app boundary: one per
 * flat function, named after it without "fmrb_" (gfx_fill_rect). The receiver
 * comes first and goes through the hook fmrb_mp_recv_<name>(obj), which
 * fmrb_module.c defines before including this. The Python classes generated
 * into fmrb_boundary_py.h call them. A record is a dict, a Symbol choice its
 * name (a str) or its number. FMRB_GEN_MP_GLOBALS are module table entries.
 *
 * Every MP_QSTR_ here must be in the committed qstr table
 * (components/micropython/mp_embed): rake micropython:gen after a change,
 * and rake test (boundary:check) says when it was forgotten.
 */
#include "fmrb_gen/fmrb_boundary.h"

static void fmrb_gen_mp_check(int32_t ret)
{
    if (ret == FMRB_BOUNDARY_ERR_ARG) {
        mp_raise_ValueError(MP_ERROR_TEXT("argument out of range"));
    }
    if (ret < 0) {
        mp_raise_msg(&mp_type_RuntimeError, MP_ERROR_TEXT("graphics command failed"));
    }
}
<% if records.any? -%>

static __attribute__((unused)) mp_obj_t fmrb_gen_mp_field(mp_obj_t d, qstr key)
{
    if (!mp_obj_is_type(d, &mp_type_dict)) {
        mp_raise_TypeError(MP_ERROR_TEXT("a record is a dict"));
    }
    return mp_obj_dict_get(d, MP_OBJ_NEW_QSTR(key));
}

static __attribute__((unused)) mp_int_t fmrb_gen_mp_field_int(mp_obj_t d, qstr key, long long lo,
                                                             unsigned long long hi)
{
    mp_int_t n = mp_obj_get_int(fmrb_gen_mp_field(d, key));
    if ((n < 0 && (long long)n < lo) || (n >= 0 && (unsigned long long)n > hi)) {
        mp_raise_ValueError(MP_ERROR_TEXT("record field out of range"));
    }
    return n;
}
<% end -%>
<% records.each do |r| -%>

static __attribute__((unused)) void fmrb_gen_mp_pack_<%= r.cname %>(mp_obj_t d, <%= r.cname %> *out)
{
<% r.fields.each do |f| -%>
<% case f.ty.kind when :int -%>
    out-><%= f.name %> = (<%= f.ty.ctype %>)fmrb_gen_mp_field_int(d, MP_QSTR_<%= f.name %>, <%= int_lit.(f.ty.min) %>, <%= int_lit.(f.ty.max) %>);
<% when :bool -%>
    out-><%= f.name %> = mp_obj_is_true(fmrb_gen_mp_field(d, MP_QSTR_<%= f.name %>)) ? 1 : 0;
<% when :float -%>
    out-><%= f.name %> = (<%= f.ty.ctype %>)mp_obj_get_float(fmrb_gen_mp_field(d, MP_QSTR_<%= f.name %>));
<% end -%>
<% end -%>
}

static __attribute__((unused)) mp_obj_t fmrb_gen_mp_unpack_<%= r.cname %>(const <%= r.cname %> *in)
{
    mp_obj_t d = mp_obj_new_dict(<%= r.fields.size %>);
<% r.fields.each do |f| -%>
<% val = case f.ty.kind when :int then new_int.(f.ty, "in->#{f.name}") when :bool then "mp_obj_new_bool(in->#{f.name} != 0)" else "mp_obj_new_float((mp_float_t)in->#{f.name})" end -%>
    mp_obj_dict_store(d, MP_OBJ_NEW_QSTR(MP_QSTR_<%= f.name %>), <%= val %>);
<% end -%>
    return d;
}
<% end -%>
<% funcs.each do |f| -%>
<% n_args = f.params.size + (f.recv ? 1 : 0) -%>

/* <%= f.ruby_sig %>: <%= f.doc_en %> */
<% if n_args.zero? -%>
static mp_obj_t fmrb_gen_mp_<%= f.import_name %>(void)
{
<% else -%>
static mp_obj_t fmrb_gen_mp_<%= f.import_name %>(size_t n_args, const mp_obj_t *args)
{
    (void)n_args;
<% end -%>
<% args = [] -%>
<% if f.recv -%>
    int32_t <%= f.recv %> = fmrb_mp_recv_<%= f.recv %>(args[0]);
<% args << f.recv -%>
<% end -%>
<% f.params.each_with_index do |p, i| -%>
<% a = "args[#{i + (f.recv ? 1 : 0)}]" -%>
<% case p.ty.kind when :int -%>
<% args << "(#{p.ty.ctype})mp_obj_get_int(#{a})" -%>
<% when :bool -%>
<% args << "mp_obj_is_true(#{a}) ? 1 : 0" -%>
<% when :float -%>
<% args << "(#{p.ty.ctype})mp_obj_get_float(#{a})" -%>
<% when :str, :bin -%>
    size_t <%= p.name %>_len;
    const char *<%= p.name %> = mp_obj_str_get_data(<%= a %>, &<%= p.name %>_len);
<% args << (p.ty.kind == :bin ? "(const uint8_t *)#{p.name}" : p.name) << "(int32_t)#{p.name}_len" -%>
<% when :choice -%>
    int32_t <%= p.name %> = -1;
    if (mp_obj_is_int(<%= a %>)) {
        <%= p.name %> = (int32_t)mp_obj_get_int(<%= a %>);
    } else {
        const char *s = mp_obj_str_get_str(<%= a %>);
<% p.ty.values.each_with_index do |v, k| -%>
        if (strcmp(s, "<%= v %>") == 0) <%= p.name %> = <%= k %>;
<% end -%>
    }
    if (<%= p.name %> < 0 || <%= p.name %> >= <%= p.ty.values.size %>) {
        mp_raise_ValueError(MP_ERROR_TEXT("<%= p.name %> is one of <%= p.ty.values.join(', ') %>"));
    }
<% args << p.name -%>
<% when :record -%>
    <%= p.ty.record.cname %> <%= p.name %>;
    fmrb_gen_mp_pack_<%= p.ty.record.cname %>(<%= a %>, &<%= p.name %>);
<% args << "&#{p.name}" -%>
<% when :array -%>
<% et = p.ty.elem.kind == :record ? p.ty.elem.record.cname : p.ty.elem.ctype -%>
    size_t <%= p.name %>_count = 0;
    mp_obj_t *<%= p.name %>_items = NULL;
    mp_obj_get_array(<%= a %>, &<%= p.name %>_count, &<%= p.name %>_items);
    if (<%= p.name %>_count > FMRB_BOUNDARY_ARRAY_MAX) {
        mp_raise_ValueError(MP_ERROR_TEXT("too many in <%= p.name %>"));
    }
    <%= et %> <%= p.name %>[FMRB_BOUNDARY_ARRAY_MAX];
    for (size_t i = 0; i < <%= p.name %>_count; i++) {
<% if p.ty.elem.kind == :record -%>
        fmrb_gen_mp_pack_<%= et %>(<%= p.name %>_items[i], &<%= p.name %>[i]);
<% else -%>
        <%= p.name %>[i] = (<%= et %>)mp_obj_get_int(<%= p.name %>_items[i]);
<% end -%>
    }
<% args << p.name << "(int32_t)#{p.name}_count" -%>
<% end -%>
<% end -%>
<% if f.returns_record? -%>
    <%= f.ret.record.cname %> out;
    int32_t ret = <%= f.flat %>(<%= (args + ['&out']).join(', ') %>);
    fmrb_gen_mp_check(ret);
<% if f.ret.optional -%>
    if (ret == 0) {
        return mp_const_none;
    }
<% end -%>
    return fmrb_gen_mp_unpack_<%= f.ret.record.cname %>(&out);
<% elsif f.returns_bytes? -%>
<% ct = f.ret.kind == :bin ? 'uint8_t' : 'char' -%>
    char buf[128];
    int32_t ret = <%= f.flat %>(<%= (args + ["(#{ct} *)buf", 'sizeof(buf)']).join(', ') %>);
    fmrb_gen_mp_check(ret);
    if (ret <= (int32_t)sizeof(buf)) {
        return <%= f.ret.kind == :bin ? 'mp_obj_new_bytes((const byte *)buf, ret)' : 'mp_obj_new_str(buf, ret)' %>;
    }
    vstr_t vs;
    vstr_init_len(&vs, ret);
    int32_t got = <%= f.flat %>(<%= (args + ["(#{ct} *)vs.buf", 'ret']).join(', ') %>);
    fmrb_gen_mp_check(got);
    vs.len = (size_t)(got < ret ? got : ret);
    return <%= f.ret.kind == :bin ? 'mp_obj_new_bytes_from_vstr(&vs)' : 'mp_obj_new_str_from_vstr(&vs)' %>;
<% else -%>
    int32_t ret = <%= f.flat %>(<%= args.join(",\n        ") %>);
    fmrb_gen_mp_check(ret);
<% if f.ret == :self || f.ret == :void -%>
    return mp_const_none;
<% elsif f.ret.kind == :bool -%>
    return mp_obj_new_bool(ret != 0);
<% elsif f.ret.kind == :choice -%>
    static const char *const ret_names[] = { <%= f.ret.values.map { |v| %("#{v}") }.join(', ') %> };
    const char *name = ret_names[ret < <%= f.ret.values.size %> ? ret : 0];
    return mp_obj_new_str(name, strlen(name));
<% else -%>
    return mp_obj_new_int(ret);
<% end -%>
<% end -%>
}
<% if n_args.zero? -%>
static MP_DEFINE_CONST_FUN_OBJ_0(fmrb_gen_mp_<%= f.import_name %>_obj, fmrb_gen_mp_<%= f.import_name %>);
<% else -%>
static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(fmrb_gen_mp_<%= f.import_name %>_obj, <%= n_args %>, <%= n_args %>, fmrb_gen_mp_<%= f.import_name %>);
<% end -%>
<% end -%>

#define FMRB_GEN_MP_GLOBALS \
<% funcs.each do |f| -%>
    { MP_ROM_QSTR(MP_QSTR_<%= f.import_name %>), MP_ROM_PTR(&fmrb_gen_mp_<%= f.import_name %>_obj) }, \
<% end -%>
    /* end of the list */
