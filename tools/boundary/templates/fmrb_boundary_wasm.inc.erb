<%
  # One wasm parameter per C parameter of the flat function: its signature
  # letter and how it is read out of the raw slot.
  slot = lambda do |ctype|
    case ctype
    when 'double' then ['F', 'double']
    when 'float' then ['f', 'float']
    when 'int64_t', 'uint64_t' then ['I', ctype]
    else ['i', ctype.end_with?('*') ? 'uint32_t' : ctype]
    end
  end
-%>
/* Generated by tools/boundary/gen.rb from the .rbs files in sig/ -- do not edit. */
/*
 * WAMR glue of the app boundary: raw-form natives (arguments arrive as an
 * array of 64-bit slots, the result goes back in slot 0), so no call goes
 * through a signature-dependent trampoline. A pointer argument is an offset
 * in the app's memory; it is checked against the length it comes with (or
 * the record's size) before it is used, and a bad one gives
 * FMRB_BOUNDARY_ERR_ARG. Register FMRB_GEN_WASM_NATIVES with
 * wasm_runtime_register_natives_raw under the import module "fmrb". Needs
 * wasm_export.h before it.
 */
#include "fmrb_gen/fmrb_boundary.h"

static __attribute__((unused)) void *fmrb_gen_wasm_ptr(wasm_exec_env_t env, uint32_t off, uint64_t size, int *bad)
{
    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
    if (size > 0x7fffffffu || !wasm_runtime_validate_app_addr(inst, (uint64_t)off, size)) {
        // The check raises an exception in the app; the call answers
        // FMRB_BOUNDARY_ERR_ARG instead, as every other bad argument does.
        wasm_runtime_clear_exception(inst);
        *bad = 1;
        return NULL;
    }
    return wasm_runtime_addr_app_to_native(inst, (uint64_t)off);
}
<% funcs.each do |f| -%>
<% ps = f.c_params -%>

/* <%= f.ruby_sig %>: <%= f.doc_en %> */
static void fmrb_gen_wasm_<%= f.import_name %>(wasm_exec_env_t env, uint64_t *args)
{
    (void)env;
<% if ps.any? { |t, _| t.end_with?('*') } -%>
    int bad = 0;
<% end -%>
<% ps.each_with_index do |(t, n), i| -%>
<% _, st = slot.(t) -%>
    <%= st %> <%= t.end_with?('*') ? "#{n}_off" : n %> = *(<%= st %> *)&args[<%= i %>];
<% end -%>
<% ps.each_with_index do |(t, n), i| -%>
<% next unless t.end_with?('*') -%>
<% base = t.sub(/\Aconst /, '').delete_suffix(' *') -%>
<% nxt = ps[i + 1] -%>
<% size = if nxt && (nxt[1] == "#{n}_len" || nxt[1] == "#{n}_count" || nxt[1] == 'out_size') then "(uint64_t)(#{nxt[1]} < 0 ? 0x80000000u : (uint32_t)#{nxt[1]}) * sizeof(#{base})" else "sizeof(#{base})" end -%>
    <%= t %><%= n %> = (<%= t %>)fmrb_gen_wasm_ptr(env, <%= n %>_off, <%= size %>, &bad);
<% end -%>
<% if ps.any? { |t, _| t.end_with?('*') } -%>
    if (bad) {
        *(int32_t *)&args[0] = FMRB_BOUNDARY_ERR_ARG;
        return;
    }
<% end -%>
    *(int32_t *)&args[0] = <%= f.flat %>(<%= ps.map { |_, n| n }.join(', ') %>);
}
<% end -%>

#define FMRB_GEN_WASM_NATIVES \
<% funcs.each do |f| -%>
    { "<%= f.import_name %>", (void *)fmrb_gen_wasm_<%= f.import_name %>, "(<%= f.c_params.map { |t, _| slot.(t)[0] }.join %>)i", NULL }, \
<% end -%>
    /* end of the list */
