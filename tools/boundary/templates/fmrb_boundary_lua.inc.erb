<%
  int_lit = ->(n) { n.negative? ? "(#{n + 1}LL - 1)" : "#{n}ULL" }
-%>
/* Generated by tools/boundary/gen.rb from the .rbs files in sig/ -- do not edit. */
/*
 * Lua functions of the app boundary. Included by the Lua extension after it
 * defines the receiver hook of each class: int32_t fmrb_lua_recv_<name>(L,
 * index) gives the receiver number (and raises a Lua error when there is
 * none). The instance methods of a class without a receiver number
 * (FmrbApp: the receiver is the app) are functions of the class's table, as
 * the class's own are (FmrbApp.window_width()): a Lua app has no app object.
 * FMRB_GEN_LUA_<Class>_METHODS are the luaL_Reg entries of the
 * instance methods, FMRB_GEN_LUA_<Class>_FUNCTIONS those of the class's own.
 * A method that returns self in Ruby returns its receiver here too; a record
 * is a table, a Symbol choice a string.
 */
#include "fmrb_gen/fmrb_boundary.h"

static int fmrb_gen_lua_check(lua_State *L, int32_t ret, const char *what)
{
    if (ret == FMRB_BOUNDARY_ERR_ARG) {
        return luaL_error(L, "%s: argument out of range", what);
    }
    return luaL_error(L, "%s failed: %d", what, (int)ret);
}
<% if records.any? -%>

/* One field of the table at idx: present, an integer, and in range. */
static __attribute__((unused)) lua_Integer fmrb_gen_lua_field_int(lua_State *L, int idx, const char *key,
                                                                 long long lo, unsigned long long hi)
{
    lua_getfield(L, idx, key);
    if (!lua_isinteger(L, -1)) {
        luaL_error(L, "record field %s: an integer is needed", key);
    }
    lua_Integer n = lua_tointeger(L, -1);
    lua_pop(L, 1);
    if ((n < 0 && (long long)n < lo) || (n >= 0 && (unsigned long long)n > hi)) {
        luaL_error(L, "record field %s: %d out of range", key, (int)n);
    }
    return n;
}
<% end -%>
<% records.each do |r| -%>

/* <%= r.klass %>::<%= r.name %> from the table at idx */
static __attribute__((unused)) void fmrb_gen_lua_pack_<%= r.cname %>(lua_State *L, int idx, <%= r.cname %> *out)
{
    idx = lua_absindex(L, idx);
    luaL_checktype(L, idx, LUA_TTABLE);
<% r.fields.each do |f| -%>
<% case f.ty.kind when :int -%>
    out-><%= f.name %> = (<%= f.ty.ctype %>)fmrb_gen_lua_field_int(L, idx, "<%= f.name %>", <%= int_lit.(f.ty.min) %>, <%= int_lit.(f.ty.max) %>);
<% when :bool -%>
    lua_getfield(L, idx, "<%= f.name %>");
    out-><%= f.name %> = lua_toboolean(L, -1) ? 1 : 0;
    lua_pop(L, 1);
<% when :float -%>
    lua_getfield(L, idx, "<%= f.name %>");
    out-><%= f.name %> = (<%= f.ty.ctype %>)luaL_checknumber(L, -1);
    lua_pop(L, 1);
<% end -%>
<% end -%>
}

/* <%= r.klass %>::<%= r.name %> as a new table on the stack */
static __attribute__((unused)) void fmrb_gen_lua_unpack_<%= r.cname %>(lua_State *L, const <%= r.cname %> *in)
{
    lua_createtable(L, 0, <%= r.fields.size %>);
<% r.fields.each do |f| -%>
<% case f.ty.kind when :int -%>
    lua_pushinteger(L, (lua_Integer)in-><%= f.name %>);
<% when :bool -%>
    lua_pushboolean(L, in-><%= f.name %> != 0);
<% else -%>
    lua_pushnumber(L, (lua_Number)in-><%= f.name %>);
<% end -%>
    lua_setfield(L, -2, "<%= f.name %>");
<% end -%>
}
<% end -%>
<% funcs.each do |f| -%>
<% base = f.recv ? 2 : 1 -%>

/* <%= f.ruby_sig %>: <%= f.doc_en %> */
static int fmrb_gen_lua_<%= f.import_name %>(lua_State *L)
{
<% if f.recv -%>
    int32_t <%= f.recv %> = fmrb_lua_recv_<%= f.recv %>(L, 1);
<% end -%>
<% args = f.recv ? [f.recv] : [] -%>
<% f.params.each_with_index do |p, i| -%>
<% n = base + i -%>
<% case p.ty.kind when :int -%>
    <%= p.ty.ctype %> <%= p.name %> = (<%= p.ty.ctype %>)luaL_checkinteger(L, <%= n %>);
<% args << p.name -%>
<% when :bool -%>
    luaL_checkany(L, <%= n %>);
    int32_t <%= p.name %> = lua_toboolean(L, <%= n %>) ? 1 : 0;
<% args << p.name -%>
<% when :float -%>
    <%= p.ty.ctype %> <%= p.name %> = (<%= p.ty.ctype %>)luaL_checknumber(L, <%= n %>);
<% args << p.name -%>
<% when :str, :bin -%>
    size_t <%= p.name %>_len;
    const char *<%= p.name %> = luaL_checklstring(L, <%= n %>, &<%= p.name %>_len);
<% args << (p.ty.kind == :bin ? "(const uint8_t *)#{p.name}" : p.name) << "(int32_t)#{p.name}_len" -%>
<% when :choice -%>
    static const char *const <%= p.name %>_names[] = { <%= p.ty.values.map { |v| %("#{v}") }.join(', ') %>, NULL };
    int32_t <%= p.name %> = (int32_t)luaL_checkoption(L, <%= n %>, NULL, <%= p.name %>_names);
<% args << p.name -%>
<% when :record -%>
    <%= p.ty.record.cname %> <%= p.name %>;
    fmrb_gen_lua_pack_<%= p.ty.record.cname %>(L, <%= n %>, &<%= p.name %>);
<% args << "&#{p.name}" -%>
<% when :array -%>
<% et = p.ty.elem.kind == :record ? p.ty.elem.record.cname : p.ty.elem.ctype -%>
    luaL_checktype(L, <%= n %>, LUA_TTABLE);
    lua_Integer <%= p.name %>_count = (lua_Integer)lua_rawlen(L, <%= n %>);
    if (<%= p.name %>_count > FMRB_BOUNDARY_ARRAY_MAX) {
        return luaL_error(L, "<%= f.method %>: more than %d in <%= p.name %>", FMRB_BOUNDARY_ARRAY_MAX);
    }
    <%= et %> <%= p.name %>[FMRB_BOUNDARY_ARRAY_MAX];
    for (lua_Integer i = 0; i < <%= p.name %>_count; i++) {
        lua_rawgeti(L, <%= n %>, i + 1);
<% if p.ty.elem.kind == :record -%>
        fmrb_gen_lua_pack_<%= et %>(L, -1, &<%= p.name %>[i]);
<% else -%>
        <%= p.name %>[i] = (<%= et %>)luaL_checkinteger(L, -1);
<% end -%>
        lua_pop(L, 1);
    }
<% args << p.name << "(int32_t)#{p.name}_count" -%>
<% end -%>
<% end -%>
<% if f.returns_record? -%>
    <%= f.ret.record.cname %> out;
    int32_t ret = <%= f.flat %>(<%= (args + ['&out']).join(', ') %>);
    if (ret < 0) {
        return fmrb_gen_lua_check(L, ret, "<%= f.method %>");
    }
<% if f.ret.optional -%>
    if (ret == 0) {
        lua_pushnil(L);
        return 1;
    }
<% end -%>
    fmrb_gen_lua_unpack_<%= f.ret.record.cname %>(L, &out);
    return 1;
<% elsif f.returns_bytes? -%>
    luaL_Buffer b;
    char *buf = luaL_buffinitsize(L, &b, 128);
    int32_t ret = <%= f.flat %>(<%= (args + ["(#{f.ret.kind == :bin ? 'uint8_t' : 'char'} *)buf", '128']).join(', ') %>);
<% if f.nilable? -%>
    if (ret == FMRB_BOUNDARY_NONE) {
        luaL_pushresultsize(&b, 0);
        lua_pop(L, 1);
        lua_pushnil(L);
        return 1;
    }
<% end -%>
    if (ret < 0) {
        return fmrb_gen_lua_check(L, ret, "<%= f.method %>");
    }
    if (ret > 128) {
        buf = luaL_prepbuffsize(&b, (size_t)ret);
        int32_t got = <%= f.flat %>(<%= (args + ["(#{f.ret.kind == :bin ? 'uint8_t' : 'char'} *)buf", 'ret']).join(', ') %>);
<% if f.nilable? -%>
        if (got == FMRB_BOUNDARY_NONE) {
            luaL_pushresultsize(&b, 0);
            lua_pop(L, 1);
            lua_pushnil(L);
            return 1;
        }
<% end -%>
        if (got < 0) {
            return fmrb_gen_lua_check(L, got, "<%= f.method %>");
        }
        ret = got < ret ? got : ret;
    }
    luaL_pushresultsize(&b, (size_t)ret);
    return 1;
<% else -%>
    <%= f.ret_ctype %> ret = <%= f.flat %>(<%= args.join(', ') %>);
<% if f.nilable? -%>
    if (ret == FMRB_BOUNDARY_NONE) {
        lua_pushnil(L);
        return 1;
    }
<% end -%>
    if (ret < 0) {
        return fmrb_gen_lua_check(L, (int32_t)ret, "<%= f.name %>");
    }
<% case f.ret when :self -%>
<% if f.recv -%>
    lua_pushvalue(L, 1);
    return 1;
<% else -%>
    return 0;
<% end -%>
<% when :void -%>
    return 0;
<% else -%>
<% case f.ret.kind when :bool -%>
    lua_pushboolean(L, ret != 0);
<% when :choice -%>
    static const char *const ret_names[] = { <%= f.ret.values.map { |v| %("#{v}") }.join(', ') %> };
    lua_pushstring(L, ret_names[ret < <%= f.ret.values.size %> ? ret : 0]);
<% else -%>
    lua_pushinteger(L, (lua_Integer)ret);
<% end -%>
    return 1;
<% end -%>
<% end -%>
}
<% end -%>
<% funcs.group_by(&:klass).each do |klass, fs| -%>

#define FMRB_GEN_LUA_<%= klass %>_METHODS \
<% fs.select(&:recv).each do |f| -%>
    {"<%= f.name %>", fmrb_gen_lua_<%= f.import_name %>}, \
<% end -%>
    /* end of the list */

#define FMRB_GEN_LUA_<%= klass %>_FUNCTIONS \
<% fs.reject(&:recv).each do |f| -%>
    {"<%= f.name %>", fmrb_gen_lua_<%= f.import_name %>}, \
<% end -%>
    /* end of the list */
<% end -%>
