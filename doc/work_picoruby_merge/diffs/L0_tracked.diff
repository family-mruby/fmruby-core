+typedef struct {
+  mrb_state *mrb;
+  int active;
+  uint32_t pending_ticks;   /* 案D: ticks accumulated by signal source, drained by VM thread */
+  uint32_t tick_countdown;  /* 案D: ticks until next preemption signal (timeslice cadence) */
+} mrb_vm_entry_t;
+
+static struct {
+  mrb_vm_entry_t vms[FMRB_MRB_MAX_VMS];
