+ * family-mruby: true if it is safe to yield the current task right now, i.e. we
+ * are executing the task's own bytecode and NOT nested inside a C function that
+ * re-entered the VM via mrb_funcall (any ci with cci > 0 above the task base).
+ * Yielding across such a C boundary returns from a nested mrb_vm_exec without
+ * unwinding it: it strands the C frame, leaves mrb->c->ci at the wrong depth
+ * ("task context corrupted: no proc on resume") and dangles the longjmp
+ * context. So an asynchronously requested switch (set by the tick signal) is
+ * deferred until execution returns to a safe top-level point. The walk runs
+ * only when a switch is actually pending, so the cost is paid rarely.
+ */
+static inline mrb_bool
+mrb_task_yield_ok(mrb_state *mrb)
+{
+  mrb_callinfo *ci;
+  for (ci = mrb->c->ci; ci >= mrb->c->cibase; ci--) {
+    if (ci->cci > 0) return FALSE;
+  }
+  return TRUE;
+}
