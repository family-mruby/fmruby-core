# Environment variables for fmruby-core build
#
# Shell/command-line env OVERRIDES the values here (standard dotenv), so you can
# switch targets/engines without editing this file, e.g.:
#   FMRB_HW_TARGET=TAB5 FMRB_KERNEL_ENGINE=spinel rake build:esp32
# Switch the target by editing FMRB_HW_TARGET below, or override on the CLI.
# NOTE: switching HW target (chip) needs `rake clean_all` first (re-set-target).

# Docker image version
ESP_IDF_VERSION=v5.5.4

# ---- HW target (selects the ESP32 chip) -------------------------------------
#   NARYAv3       -> esp32s3  (Retro, N16R8)     <- active
#   ATOM_DISPLAY  -> esp32s3  (M5 AtomS3, n8r8)  <- SUSPENDED, does not build
#   TAB5          -> esp32p4  (Modern / M5Stack Tab5, RISC-V)
#   NARYAv4       -> esp32p4  (Modern / dedicated board being designed; built
#                              on ESP32-P4-Nano pins, see doc/naryav4/)
#   ATOMS3R       -> esp32s3  (M5Stack AtomS3R, headless single-app terminal,
#                              doc/headless_s3/; branch feature/headless-h1 on)
#                  Its board defaults (Rakefile BOARD_BUILD_DEFAULTS) beat the
#                  values in this file, but not the shell: editor=mruby,
#                  FFT_SPINEL=0, FONT_JA=0, ASTERISM=1.
#FMRB_HW_TARGET=NARYAv3
#FMRB_HW_TARGET=ATOM_DISPLAY
FMRB_HW_TARGET=TAB5
#FMRB_HW_TARGET=NARYAv4
#FMRB_HW_TARGET=ATOMS3R

# ---- Engine: mruby (default) vs Spinel AOT ----------------------------------
# Usually passed on the CLI, but can be pinned here. Leave unset for mruby.
FMRB_KERNEL_ENGINE=spinel        # compile the kernel with Spinel
#FMRB_APP_ENGINE_DESKTOP=spinel   # compile system_desktop with Spinel
# The editor as a Spinel program (P5). Its on-device debugger is NOT in this
# build: comment this line out to get the mruby editor back when you need to
# debug (doc/editor_serious_mode/report/p5.md).
FMRB_APP_ENGINE_EDITOR=spinel
# Example (Spinel kernel on P4):
#   FMRB_HW_TARGET=TAB5 FMRB_KERNEL_ENGINE=spinel rake build:esp32

# ---- Optional parts (what goes into the firmware) ---------------------------
# Spinel FFT backend (doc/mic_spectrum). Default 1; 0 leaves it out (~45KB).
#FMRB_FFT_SPINEL=0
# Japanese fonts efontJA 16/12/12 bold (~1MB of flash). Default 1; with 0,
# set_font(:ja, ...) falls back to misaki 8 and returns that (doc/headless_s3).
#FMRB_FONT_JA=0
# Asterism (Zenoh + the Ruby layers) on an S3 board (doc/ruby_asterism).
# Default 0 on the S3 (Retro keeps its flash/RAM); P4 always has it.
# Changing it needs `rake clean`.
#FMRB_ASTERISM=1

# ---- Measurement / porting switches (usually off) ---------------------------
# GC pause histograms in GC.stat (doc/midi/report/p6.md). Measurement only.
#FMRB_GC_PROFILE=1
# The VM ticks itself instead of the mruby_tick task (the wasm port needs it).
# Touching it means `rake clean`.
#FMRB_TASK_SELF_TICK=1
# Modern display backend: unset/ppa = PPA hardware, cpu = software compositor
# (doc/wasm/ P3). Touch main/CMakeLists.txt after switching so ninja
# reconfigures; check the boot log for "CPU display backend".
#FMRB_DISPLAY_BACKEND=cpu

# ---- Where the sibling checkouts are (default: fetched by PIN / vendor) -----
#SPINEL_DIR=../tmp/spinel                # a local Spinel compiler checkout
#PICORUBY_TI_DIR=../picoruby-ti          # a local picoruby-ti checkout
#ASTERISM_DIR=../asterism                # the asterism gem (Ruby layers)
#PICORUBY_ASTERISM_ZENOH_DIR=../picoruby-asterism-zenoh
#ZENOH_PICO_DIR=../zenoh-pico            # a zenoh-pico checkout

# ---- USB serial (rake attach / check-port) ----------------------------------
#VIDPID=1a86:7523 #Narya v3
#VIDPID=1a86:55d3 #Narya v4
VIDPID=303a:1001,1a86:55d3 #Tab5 + P4-Nano(CH343)
# The AtomS3R is also 303a:1001 (same as the Tab5): name the port explicitly.
# Attach one device by its usbipd bus id instead of VIDPID:
#BUSID=1-6
# Flash speed for rake flash (esptool -b). Lower it if a long write fails.
#FLASH_BAUD=460800

# ---- Browser build (rake wasm:*) --------------------------------------------
#JOBS=8                                  # parallel jobs for the wasm build
#PORT=8006                               # rake wasm:serve port
#DIST=1                                  # rake wasm:serve serves build/dist
