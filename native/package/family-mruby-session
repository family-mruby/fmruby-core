#!/bin/sh
# family-mruby-session - the login screen's "Family mruby" session on a
# Linux PC (doc/linux_native/ L7, L9b). The display manager runs this from
# /usr/share/wayland-sessions/family-mruby.desktop; it starts Family mruby
# as the Wayland compositor itself (--machine linux_pc_wl): it takes the
# screen (DRM/KMS) and the seat from logind (or seatd) through libseat, and
# Linux programs started from its launcher, its Shell or by themselves come
# as Family mruby windows (X11 ones through Xwayland, started when the
# first is). When Family mruby ends (its Exit entry: the Linux windows are
# asked to close, those still there after a few seconds are ended), the
# display manager shows the login screen again. The power entries (power
# off, restart, suspend) go to logind from inside Family mruby.
#
# Settings: /etc/default/family-mruby-session (a shell fragment, optional;
# every variable set there is passed on to the program):
#
#   ROTATE=0|90|180|270  turn the output clockwise, for a panel mounted
#                        sideways. The compositor turns it, so the pointer
#                        (touchpad, mouse) turns with the picture.
#   FMRB_ARGS="..."      more arguments for family-mruby (--set key=value)
#   WLR_RENDERER=pixman  draw without the GPU (a virtual machine whose
#                        graphics wlroots cannot use)
#   WLR_NO_HARDWARE_CURSORS=1
#                        draw the mouse pointer into the picture (when no
#                        pointer shows, as in some virtual machines)
#
# FMRB_SESSION_CONF names another settings file (for trying settings out).
#
# Its output (and Family mruby's log) goes where the display manager puts a
# session's: the journal, or ~/.local/share/sddm/wayland-session.log.

set -u

ROTATE=0
FMRB_ARGS=""
CONF=${FMRB_SESSION_CONF:-/etc/default/family-mruby-session}
# What the file sets reaches the program's environment (WLR_RENDERER and
# the like).
set -a
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
set +a

say() { echo "family-mruby-session: $*" >&2; }

here=$(dirname "$(readlink -f "$0")")
prog="$here/family-mruby"
if [ ! -x "$prog" ]; then
    say "$prog is missing; reinstall the family-mruby package"
    exit 1
fi

case "$ROTATE" in
    0|90|180|270) ;;
    *) say "ROTATE=$ROTATE in $CONF is not 0, 90, 180 or 270; not turning"; ROTATE=0 ;;
esac

# The compositor goes onto the console (DRM/KMS): a parent compositor's or
# X server's names, should the display manager pass any, would nest it in
# them instead. WLR_BACKENDS, when set, says where on purpose (the tests'
# headless output) and is left alone.
if [ -z "${WLR_BACKENDS:-}" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

say "starting $prog --machine linux_pc_wl (rotate $ROTATE) $FMRB_ARGS"
# shellcheck disable=SC2086
exec "$prog" --machine linux_pc_wl --set display.rotate="$ROTATE" $FMRB_ARGS "$@"
