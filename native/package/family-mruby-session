#!/bin/sh
# family-mruby-session - the login screen's "Family mruby" session on a
# Linux PC (doc/linux_native/ L7, L9b). The display manager runs this from
# /usr/share/wayland-sessions/family-mruby.desktop; it starts Family mruby
# as the Wayland compositor itself (--machine linux_pc_wl): it takes the
# screen (DRM/KMS) and the seat from logind (or seatd) through libseat, and
# Linux programs started from its launcher, its Shell or by themselves come
# as Family mruby windows (X11 ones through Xwayland, started when the
# first is). When Family mruby ends (its Exit entry: the Linux windows are
# asked to close, those still there after a few seconds are ended), the
# display manager shows the login screen again. The power entries (power
# off, restart, suspend) go to logind from inside Family mruby.
#
# The screen lock (L13): with swaylock installed (a Recommends), the power
# menu has Lock, and logind's Lock (loginctl lock-session, a lid closed)
# and a suspend lock the screen too. swaylock asks for the password;
# Family mruby never sees it. If swaylock ends without unlocking, the
# screen stays locked: a key starts it again.
#
# Japanese input (L12b): when fcitx5 is installed (with fcitx5-mozc for
# kana-kanji conversion), the compositor starts it and it types both into
# Linux programs and into Family mruby's apps; Ctrl+Space (or the
# half/full-width key) switches it. Without fcitx5, Family mruby's own kana
# input works as on the devices. FMRB_ARGS="--set compositor.ime=" leaves
# fcitx5 out.
#
# Settings: /etc/default/family-mruby-session (a shell fragment, optional;
# every variable set there is passed on to the program):
#
#   ROTATE=0|90|180|270  turn the output clockwise, for a panel mounted
#                        sideways. The compositor turns it, so the pointer
#                        (touchpad, mouse) turns with the picture.
#   FMRB_ARGS="..."      more arguments for family-mruby (--set key=value)
#   WLR_RENDERER=pixman  draw without the GPU (a virtual machine whose
#                        graphics wlroots cannot use)
#   WLR_NO_HARDWARE_CURSORS=1
#                        draw the mouse pointer into the picture (when no
#                        pointer shows, as in some virtual machines)
#
# In a virtual machine (systemd-detect-virt --vm names one: VirtualBox,
# VMware, QEMU/KVM, Hyper-V, ...) both of the last two are set by this
# script when neither the file nor the environment sets them: a virtual
# machine's display adapter rarely gives wlroots a GPU it can draw with
# (VirtualBox's VMSVGA without 3D stays black), and drawing without the GPU
# always works there. What the file sets wins, so a virtual machine with
# working 3D can still try the GPU (WLR_RENDERER=gles2). On a PC that is
# not a virtual machine nothing changes: wlroots picks the renderer itself.
# The choice is logged in one line.
#
# Settings and notices (L14): the menu's Bluetooth and the network
# dialog's Wi-Fi open Family mruby's settings window (NetworkManager and
# BlueZ do the work; a password goes to NetworkManager), the volume and its
# keys move PipeWire's (or PulseAudio's) output, and Linux programs'
# notifications show at the top right. Sharing the screen from a browser's
# meeting (or recording it) goes through xdg-desktop-portal-wlr (a
# Recommends): this script names the desktop (XDG_CURRENT_DESKTOP, the
# portal's family-mruby-portals.conf) to the session's services before the
# start, and Family mruby tells them where the screen is once it is up.
#
# When Family mruby ends other than by its Exit entry (it crashed, or was
# killed), this script starts it again and the new one says so in a notice;
# the reason is logged. After the 4th such end within a minute it stops
# trying and the login screen comes back. Ending it with SIGTERM (a logout,
# a shutdown, kill) is not a crash: the session ends. Linux programs started
# inside Family mruby end with it (a Wayland program's windows belong to the
# compositor); the new one starts none of them again.
#
# FMRB_SESSION_CONF names another settings file (for trying settings out).
#
# Its output (and Family mruby's log) goes where the display manager puts a
# session's: the journal, or ~/.local/share/sddm/wayland-session.log.

set -u

ROTATE=0
FMRB_ARGS=""
CONF=${FMRB_SESSION_CONF:-/etc/default/family-mruby-session}
# What the file sets reaches the program's environment (WLR_RENDERER and
# the like).
set -a
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
set +a

say() { echo "family-mruby-session: $*" >&2; }

here=$(dirname "$(readlink -f "$0")")
prog="$here/family-mruby"
if [ ! -x "$prog" ]; then
    say "$prog is missing; reinstall the family-mruby package"
    exit 1
fi

# Drawing in a virtual machine (see above).
virt=$(systemd-detect-virt --vm 2>/dev/null) || virt=""
case "$virt" in
    ""|none) ;;
    *)
        set_here=""
        kept=""
        if [ -z "${WLR_RENDERER:-}" ]; then
            WLR_RENDERER=pixman
            export WLR_RENDERER
            set_here="WLR_RENDERER=pixman"
        else
            kept="WLR_RENDERER=$WLR_RENDERER"
        fi
        if [ -z "${WLR_NO_HARDWARE_CURSORS:-}" ]; then
            WLR_NO_HARDWARE_CURSORS=1
            export WLR_NO_HARDWARE_CURSORS
            set_here="${set_here:+$set_here }WLR_NO_HARDWARE_CURSORS=1"
        else
            kept="${kept:+$kept }WLR_NO_HARDWARE_CURSORS=$WLR_NO_HARDWARE_CURSORS"
        fi
        if [ -n "$set_here" ]; then
            say "a virtual machine ($virt): drawing without the GPU ($set_here${kept:+; kept as set: $kept}); set WLR_RENDERER in $CONF to choose otherwise"
        else
            say "a virtual machine ($virt): kept as set: $kept"
        fi
        ;;
esac

case "$ROTATE" in
    0|90|180|270) ;;
    *) say "ROTATE=$ROTATE in $CONF is not 0, 90, 180 or 270; not turning"; ROTATE=0 ;;
esac

# The compositor goes onto the console (DRM/KMS): a parent compositor's or
# X server's names, should the display manager pass any, would nest it in
# them instead. WLR_BACKENDS, when set, says where on purpose (the tests'
# headless output) and is left alone.
if [ -z "${WLR_BACKENDS:-}" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

# The desktop's name for the session's services (the desktop portal picks
# its backends by it); the display manager sets it from the session entry's
# DesktopNames, this covers a start without one.
XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-family-mruby}
XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}
export XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
if command -v dbus-update-activation-environment > /dev/null 2>&1; then
    dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_TYPE > /dev/null 2>&1 ||
        say "the session's services were not told the desktop's name (no session bus?)"
fi

# Starting again after an abnormal end (see above).
MAX_ENDS=3          # abnormal ends a minute that are started again
WINDOW_S=60
ends=""             # the times (s) of the abnormal ends within the window
restarted=""        # how the last run ended (SIGSEGV, status 3), for the new one's notice
child=""
stopping=""

on_signal() {
    stopping=$1
    [ -n "$child" ] && kill "-$1" "$child" 2> /dev/null
}
trap 'on_signal TERM' TERM
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT

while :; do
    say "starting $prog --machine linux_pc_wl (rotate $ROTATE) $FMRB_ARGS${restarted:+ (again: the last run ended abnormally, $restarted)}"
    # shellcheck disable=SC2086
    FMRB_SESSION_RESTARTED="$restarted" "$prog" --machine linux_pc_wl --set display.rotate="$ROTATE" $FMRB_ARGS "$@" &
    child=$!
    # wait returns early when a trapped signal comes; wait again for the end.
    while :; do
        wait "$child"
        rc=$?
        kill -0 "$child" 2> /dev/null || break
    done
    child=""
    if [ -n "$stopping" ]; then
        say "the session ends (SIG$stopping)"
        exit "$rc"
    fi
    if [ "$rc" -eq 0 ]; then
        say "Family mruby ended (its Exit entry)"
        exit 0
    fi
    if [ "$rc" -gt 128 ]; then
        sig=$(kill -l "$((rc - 128))" 2> /dev/null) || sig=$((rc - 128))
        why="SIG$sig"
        how="ended by SIG$sig"
        case "$sig" in
            TERM|HUP|INT)
                say "Family mruby $how: not a crash, the session ends"
                exit "$rc"
                ;;
        esac
    else
        why="status $rc"
        how="exited with status $rc"
    fi
    now=$(date +%s)
    kept=""
    count=0
    for t in $ends $now; do
        if [ $((now - t)) -lt "$WINDOW_S" ]; then
            kept="$kept $t"
            count=$((count + 1))
        fi
    done
    ends=$kept
    if [ "$count" -gt "$MAX_ENDS" ]; then
        say "Family mruby $how; that is $count abnormal ends within ${WINDOW_S}s: not starting it again (back to the login screen)"
        exit 1
    fi
    say "Family mruby $how; starting it again ($count of $MAX_ENDS within ${WINDOW_S}s)"
    restarted=$why
    sleep 1
done
