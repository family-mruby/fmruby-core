# ファイルを丸ごと読み書きする。実装は本体の C (main/app/fmrb_boundary_file.c)、
# list の包みは lib/gems/picoruby-fmrb-app/mrblib/fmrb-file.rb。
#
# パスで呼ぶ、開いたままの状態を持たない関数だけを置く。1 回の呼び出しで
# ファイル全体を読む・書くので、大きなファイルは丸ごとメモリに載る。読む位置を
# 持って少しずつ読むなら Ruby の File (picoruby の IO) を使う。File は今のまま。
# 読み書きできる場所は File と同じ (判定は本体)。
#
# FmrbFile はモジュールごと本体との境界に載る (%a{fmrb.boundary}、doc/app_boundary)。
# 結果が nil のことがあるもの (read・size・free_bytes) は、ほかの言語では
# FMRB_BOUNDARY_NONE (C) や None・nil で「無い」を表す。

# ファイルを丸ごと読み書きする <<en>> Read and write whole files by path
#
# パスで呼ぶ関数だけで、開いたままの状態は持たない。`read`・`write`・`append`・`exist?`・
# `size`・`delete`・`mkdir`・`list` がある。1 回でファイル全体を読み書きするので、
# 大きなファイルは丸ごとメモリに載る。読む位置を持って少しずつ読むなら `File`。
# <<en>>
# Functions called by path; nothing stays open. There are `read`, `write`,
# `append`, `exist?`, `size`, `delete`, `mkdir` and `list`. A call reads or
# writes the whole file, so a big file is held in memory entirely. To read
# a little at a time from a position, use `File`.
%a{fmrb.boundary}
module FmrbFile
  # ファイル全体を読む <<en>> Read a whole file
  #
  # 無い・読めないときは nil。
  # ```ruby
  # text = FmrbFile.read("/home/memo.txt")
  # ```
  # <<en>>
  # nil when it is not there or cannot be read.
  # ```ruby
  # text = FmrbFile.read("/home/memo.txt")
  # ```
  def self.read: (String path) -> bin?

  # ファイル全体を書く (前の中身は消える) <<en>> Write a whole file, replacing it
  #
  # 書けたら true。
  # ```ruby
  # FmrbFile.write("/home/memo.txt",
  #                "hello")
  # ```
  # <<en>>
  # true when it was written.
  # ```ruby
  # FmrbFile.write("/home/memo.txt",
  #                "hello")
  # ```
  def self.write: (String path, bin data) -> bool

  # ファイルの終わりに足す <<en>> Add to the end of a file
  #
  # 無ければ作る。書けたら true。
  # ```ruby
  # FmrbFile.append("/home/log.txt",
  #                 "one more\n")
  # ```
  # <<en>>
  # Makes the file when it is not there; true when it was written.
  # ```ruby
  # FmrbFile.append("/home/log.txt",
  #                 "one more\n")
  # ```
  def self.append: (String path, bin data) -> bool

  # ファイルかディレクトリがあるか <<en>> Whether a file or a directory is there
  #
  # ```ruby
  # FmrbFile.exist?("/home/memo.txt")
  # ```
  def self.exist?: (String path) -> bool

  # ファイルの大きさ (バイト) <<en>> A file's size in bytes
  #
  # 無いときは nil。
  # ```ruby
  # n = FmrbFile.size("/home/memo.txt")
  # ```
  # <<en>>
  # nil when it is not there.
  # ```ruby
  # n = FmrbFile.size("/home/memo.txt")
  # ```
  def self.size: (String path) -> int64?

  # ファイルか空のディレクトリを消す <<en>> Delete a file or an empty directory
  #
  # 消せたら true。
  # ```ruby
  # FmrbFile.delete("/home/old.txt")
  # ```
  # <<en>>
  # true when it was deleted.
  # ```ruby
  # FmrbFile.delete("/home/old.txt")
  # ```
  def self.delete: (String path) -> bool

  # ディレクトリを作る <<en>> Make a directory
  #
  # 作れたら true (もうあるときも true)。
  # ```ruby
  # FmrbFile.mkdir("/home/notes")
  # ```
  # <<en>>
  # true when it was made, or is there already.
  # ```ruby
  # FmrbFile.mkdir("/home/notes")
  # ```
  def self.mkdir: (String path) -> bool

  # ディレクトリの中の名前の一覧 <<en>> The names in a directory
  #
  # ディレクトリの名前は後ろに "/" が付く。読めないときは nil。
  # ```ruby
  # FmrbFile.list("/home").each do |n|
  #   Log.info(n)
  # end
  # ```
  # <<en>>
  # A directory's name ends in "/". nil when it cannot be read.
  # ```ruby
  # FmrbFile.list("/home").each do |n|
  #   Log.info(n)
  # end
  # ```
  %a{fmrb.internal}
  def self.list: (String dir) -> Array[String]?

  # list の省略なしの形 (名前を改行でつなぐ) <<en>> list as one String, a name per line
  #
  # 名前を "\n" でつないだ 1 つの文字列 (最後の名前の後にも "\n")。
  # ディレクトリの名前は後ろに "/"。読めないときは nil。包みは list (配列にする)。
  # <<en>>
  # The names joined by "\n", one after the last name too; a directory's
  # name ends in "/". nil when it cannot be read. The wrapper is list (an
  # Array).
  # ```ruby
  # FmrbFile.list_raw("/home")
  # ```
  def self.list_raw: (String dir) -> String?

  # 消せない・名前を変えられない場所か <<en>> Whether the entry cannot be deleted or renamed
  #
  # PC 版の配布物の木と /mnt/root で true。端末・sim・ブラウザ版では常に false。
  # ```ruby
  # FmrbFile.path_read_only?("/mnt/root/etc/hostname")
  # ```
  # <<en>>
  # true for the PC build's distribution tree and /mnt/root; always false on
  # the devices, the simulation and the browser.
  # ```ruby
  # FmrbFile.path_read_only?("/mnt/root/etc/hostname")
  # ```
  def self.path_read_only?: (String path) -> bool

  # その場所にあと何バイト書けるか <<en>> How many more bytes can be written where the path lives
  #
  # /tmp は RAM のファイルシステムの空き、ほかはその下のファイルシステムの空き。
  # 分からないとき (ブラウザ版の SD など) は nil。
  # ```ruby
  # FmrbFile.free_bytes("/tmp")
  # ```
  # <<en>>
  # /tmp: what is left of the RAM filesystem; elsewhere: the free space of
  # the filesystem under it. nil when it cannot be known.
  # ```ruby
  # FmrbFile.free_bytes("/tmp")
  # ```
  def self.free_bytes: (String path) -> int64?
end

# ファイルの読み書き (File) <<en>> Reading and writing files (File)
#
# IO の子クラスで、write・puts・print・flush・close・closed? は IO のもの。
# 実装は Family mruby の gem picoruby-fmrb-filesystem (lib/gems/picoruby-fmrb-filesystem/:
# mrblib/file.rb、ports/esp32/fmrb_filesystem.c) と picoruby-fmrb-io。
# **CRuby の File にあって無いもの**:
# gets・each_line・readlines・seek・eof?・File.read・File.write・File.binread・
# File.foreach・File.stat・File.mtime ほか。読むのは `read`、全体を一度に書く・読むなら FmrbFile。
# **失敗は RuntimeError** (Errno::ENOENT などは無く、ファイルが無い・書けない・数が多すぎる、は
# メッセージだけで区別する)。書いてよい場所は /home と /tmp (/tmp は RAM の上の小さな一時置き場)。
# <<en>>
# A subclass of IO; write, puts, print, flush, close and closed? are IO's.
# Implemented in the Family mruby gems picoruby-fmrb-filesystem
# (lib/gems/picoruby-fmrb-filesystem/: mrblib/file.rb,
# ports/esp32/fmrb_filesystem.c) and picoruby-fmrb-io.
# **What CRuby's File has and this one lacks**: gets, each_line, readlines,
# seek, eof?, File.read, File.write, File.binread, File.foreach, File.stat,
# File.mtime and more. Read with `read`; to write or read a whole file at
# once use FmrbFile.
# **A failure is a RuntimeError** (no Errno::ENOENT and the like; a missing
# file, a file that cannot be written and too many open files are told apart
# by the message only). Writable places are /home and /tmp (/tmp is a small
# temporary space in RAM).
class File < IO
  # パスの区切り <<en>> The path separator
  SEPARATOR: String

  # ファイルを開く (new) <<en>> Open a file (new)
  #
  # mode は `"r"` (省略時・読む)・`"w"` (空にして書く。無ければ作る)・`"a"` (末尾に足す。無ければ作る)
  # と、`"r+"` (読み書き。無いと失敗)・`"w+"` (空にして読み書き)・`"a+"` (読めて、書くと
  # 必ず末尾に足す。無ければ作る)。`b` は付けてもよく (`"rb+"` は `"r+"` と同じ)、
  # **ほかの文字で始まる mode は読み取り専用として開く** (エラーにならない)。
  # `perm` は受け取るだけで使わない。
  #
  # **開けないと RuntimeError ("failed to open file: パス")**。理由 (無い・場所が無い・
  # 開いている数が上限) は区別できない。開いたままにできるのは、ESP32 では全アプリで 10 個。
  # 開いた File は使い終えたら close する (File.open のブロックなら自動)。
  # ```ruby
  # f = File.new("/home/a.txt", "w")
  # f.write("hi")
  # f.close
  # ```
  # <<en>>
  # mode: `"r"` (default; read), `"w"` (truncate and write; created when missing), `"a"`
  # (append; created when missing), `"r+"` (read and write; fails when missing),
  # `"w+"` (truncate, read and write) and `"a+"` (read, and every write goes to the
  # end; created when missing). A `b` may be added (`"rb+"` is `"r+"`).
  # **A mode starting with any other letter opens read-only**
  # (no error). `perm` is accepted and ignored.
  #
  # **RuntimeError ("failed to open file: path") when it cannot open**; the reason
  # (missing, no room, too many open) is not told apart. Only 10 files can be open on
  # an ESP32, for all apps together. Close a File when done (File.open with a block
  # does it).
  # ```ruby
  # f = File.new("/home/a.txt", "w")
  # f.write("hi")
  # f.close
  # ```
  def self.new: (String path, ?String mode, ?Integer perm) -> File

  # パスを組み立てる <<en>> Join path parts
  #
  # 部品の間に "/" を 1 つだけ入れてつなぐ (重なった "/" は 1 つに)。部品は String か、
  # String の配列 (入れ子も可)。ほかは TypeError。引数が無いと ""。
  # ```ruby
  # File.join("/home", "a.txt")   #=> "/home/a.txt"
  # ```
  # <<en>>
  # Joins the parts with exactly one "/" between them. Parts are Strings or arrays of
  # Strings (nesting allowed); anything else is a TypeError. "" with no arguments.
  # ```ruby
  # File.join("/home", "a.txt")   #=> "/home/a.txt"
  # ```
  def self.join: (*(String | Array[untyped]) names) -> String

  # パスの最後の名前 <<en>> The last name of a path
  #
  # 末尾の "/" は無視する。`suffix` (省略すると何も取らない) が名前の終わりに一致すれば
  # 取り除く (**文字列そのままの一致だけ**。CRuby の ".*" は使えない)。"/" は "/"。
  # ```ruby
  # File.basename("/home/a.txt")          #=> "a.txt"
  # File.basename("/home/a.txt", ".txt")  #=> "a"
  # ```
  # <<en>>
  # Ignores trailing "/". `suffix` (nothing is removed when left out) is cut off the
  # end when it matches (**literal text only**; CRuby's ".*" does not work). "/" gives
  # "/".
  # ```ruby
  # File.basename("/home/a.txt")          #=> "a.txt"
  # File.basename("/home/a.txt", ".txt")  #=> "a"
  # ```
  def self.basename: (String path, ?String suffix) -> String

  # パスの親のディレクトリ <<en>> The directory part of a path
  #
  # ```ruby
  # File.dirname("/home/a.txt")   #=> "/home"
  # ```
  # <<en>>
  # `level` (1 when left out) is how many names to cut off; a negative level is an
  # ArgumentError. A path with no "/" gives ".".
  # ```ruby
  # File.dirname("/home/a.txt")   #=> "/home"
  # ```
  def self.dirname: (String path, ?Integer level) -> String

  # 拡張子 (ドットを含む) <<en>> The extension, with its dot
  #
  # ```ruby
  # File.extname("a.txt")   #=> ".txt"
  # ```
  def self.extname: (String filename) -> String

  # 絶対パスにする <<en>> Make a path absolute
  #
  # "." と ".." をたどり、重なった "/" をまとめる。
  # **相対パスの基準は `default_dir` (省略すると ".") を環境変数 `PWD` (無ければ "/") に付けたもの**で、`Dir.getwd` ではない。
  # "~" で始まるパスは環境変数 `HOME` に置き換わり、HOME が無いと ArgumentError。
  # "~名前" の形は ArgumentError。ファイルがあるかは見ない。
  # ```ruby
  # File.expand_path("/home/../tmp/a")   #=> "/tmp/a"
  # ```
  # <<en>>
  # Resolves "." and ".." and merges repeated "/".
  # **A relative path is based on `default_dir` (".")**
  # **put on the environment variable `PWD` ("/" when it is not set)**,
  # not on `Dir.getwd`. A leading "~" becomes `HOME` (ArgumentError when HOME is not
  # set); the "~name" form is an ArgumentError. It does not check the file exists.
  # ```ruby
  # File.expand_path("/home/../tmp/a")   #=> "/tmp/a"
  # ```
  def self.expand_path: (String path, ?String default_dir) -> String

  # ファイルかディレクトリがあるか (exists? も同じ) <<en>> Whether a file or a directory is there
  #
  # ディレクトリでも true。無い・調べられないときは false (例外は出ない)。
  # `exists?` は同じ働きの別名。
  # <<en>>
  # true for a directory too; false when it is missing or cannot be checked (no
  # exception). `exists?` is the same method under another name.
  # ```ruby
  # File.exist?("/home/a.txt")
  # ```
  def self.exists?: (String path) -> bool

  # 普通のファイルか <<en>> Whether it is a regular file
  #
  # ディレクトリや、無いパスは false。
  # ```ruby
  # File.file?("/home/a.txt")
  # ```
  # <<en>>
  # false for a directory or a missing path.
  # ```ruby
  # File.file?("/home/a.txt")
  # ```
  def self.file?: (String path) -> bool

  # ディレクトリか <<en>> Whether it is a directory
  #
  # 無いパスは false。"/"・"/mnt" は true。
  # ```ruby
  # File.directory?("/tmp")
  # ```
  # <<en>>
  # false for a missing path. "/" and "/mnt" are true.
  # ```ruby
  # File.directory?("/tmp")
  # ```
  def self.directory?: (String path) -> bool

  # ファイルの大きさ (バイト) <<en>> A file's size in bytes
  #
  # **無いと nil でなく RuntimeError ("stat failed for パス")**。先に `File.exist?` で調べる。
  # (nil を返す `FmrbFile.size` もある。)
  # ```ruby
  # n = File.size("/home/a.txt")
  # ```
  # <<en>>
  # **RuntimeError ("stat failed for path") when it is missing**, not nil; check with
  # `File.exist?` first. (`FmrbFile.size` returns nil instead.)
  # ```ruby
  # n = File.size("/home/a.txt")
  # ```
  def self.size: (String path) -> Integer

  # ファイルを消す <<en>> Delete a file
  #
  # **パスは 1 つだけ** (CRuby のように複数は渡せない)。消せたら 1 を返し、
  # **消せないと RuntimeError ("cannot delete パス")**。無い・ディレクトリ・
  # 開いたままのファイルは消せない (ディレクトリは `Dir.delete`)。`unlink` は同じ働きの別名。
  # ```ruby
  # File.delete("/home/old.txt") if File.exist?("/home/old.txt")
  # ```
  # <<en>>
  # **One path only** (several cannot be given as in CRuby). Returns 1 when deleted and
  # **raises RuntimeError ("cannot delete path") when it cannot**: a missing file, a
  # directory (use `Dir.delete`) or a file still open. `unlink` is the same method.
  # ```ruby
  # File.delete("/home/old.txt") if File.exist?("/home/old.txt")
  # ```
  def self.delete: (String path) -> Integer

  # ファイルを消す (delete の別名) <<en>> Delete a file (same as delete)
  #
  # ```ruby
  # File.unlink("/home/old.txt")
  # ```
  def self.unlink: (String path) -> Integer

  # 名前を変える・移す <<en>> Rename or move a file
  #
  # 成功すると 0。**失敗すると RuntimeError ("cannot rename 元 to 先")**。先に同じ名前の
  # ファイルがあるときの動きは、実装の rename(3) まかせ (確かめていない。先に `File.delete`
  # すると確実)。
  # ```ruby
  # File.rename("/home/a.tmp", "/home/a.txt")
  # ```
  # <<en>>
  # Returns 0 when it worked and
  # **raises RuntimeError ("cannot rename old to new") when it fails**.
  # What happens when the target exists is left to the underlying
  # rename(3) (not checked; delete the target first to be sure).
  # ```ruby
  # File.rename("/home/a.tmp", "/home/a.txt")
  # ```
  def self.rename: (String old_path, String new_path) -> Integer

  # 開いたファイルのパス <<en>> The path the file was opened with
  #
  # ```ruby
  # f.path
  # ```
  def path: () -> String

  # パスを置き換える (記録だけ) <<en>> Set the recorded path
  #
  # `path` が返す値を変えるだけで、ファイルは動かない。
  # ```ruby
  # f.path = "/home/b.txt"
  # ```
  # <<en>>
  # Only changes what `path` returns; the file does not move.
  # ```ruby
  # f.path = "/home/b.txt"
  # ```
  def path=: (String value) -> String
end
