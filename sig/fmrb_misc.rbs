# その他。言葉の切りかえ、ログ、ファイルの読み書き。
# 実装は lib/gems/picoruby-fmrb-app/mrblib/fmrb-i18n.rb、
# lib/gems/picoruby-fmrb-log と picoruby の File。

# 日本語と英語で表示を切りかえる <<en>> Switch the display between Japanese and English
module FmrbI18n
  # 言葉の表を足す <<en>> Add a table of words
  #
  # アプリごとに自分の表を足す。**表にない印は消さない**ので、デスクトップの
  # 表と並んで残る。**同じ言葉の同じ印は、後から足した方に置きかわる**。
  # ```ruby
  # FmrbI18n.add(
  #   "en" => { save: "Save" },
  #   "ja" => { save: "保存" })
  # ```
  # <<en>>
  # Each app adds its own table. **Keys it does not name are kept**,
  # so this table and the desktop's live side by side.
  # **A key named again for the same language is replaced** by the later value.
  # ```ruby
  # FmrbI18n.add(
  #   "en" => { save: "Save" },
  #   "ja" => { save: "保存" })
  # ```
  def self.add: (Hash table) -> void

  # 今の言葉 ("ja" か "en") <<en>> The language now, "ja" or "en"
  #
  # アプリを別の端末へ移すと、着いた側の言葉になります。
  # ```ruby
  # if FmrbI18n.lang == "ja"
  #   draw_ja
  # end
  # ```
  # <<en>>
  # An app moved to another machine speaks the language of that machine.
  # ```ruby
  # if FmrbI18n.lang == "ja"
  #   draw_ja
  # end
  # ```
  def self.lang: () -> String

  # 印から今の言葉の文を引く <<en>> Look a key up in the language now
  #
  # 印が表に無ければ印の名前がそのまま返る (落ちない)。
  # ```ruby
  # @ui.set_text(:save, FmrbI18n.t(:save))
  # ```
  # <<en>>
  # An unknown key comes back as its own name instead of raising.
  # ```ruby
  # @ui.set_text(:save, FmrbI18n.t(:save))
  # ```
  def self.t: (Symbol key) -> String

  # 字を描いたときの横幅を測る <<en>> Measure how wide text would be
  #
  # **日本語は 1 文字が 2 文字幅**なので、`length` では測れない。
  # 右寄せや中央寄せはこれで測る。
  # ```ruby
  # w = FmrbI18n.text_width(s)
  # gfx.draw_text(320 - w, y, s)
  # ```
  # <<en>>
  # A Japanese character is two cells wide, so `length` will not do. Use this
  # to right-align or centre.
  # ```ruby
  # w = FmrbI18n.text_width(s)
  # gfx.draw_text(320 - w, y, s)
  # ```
  def self.text_width: (String str) -> Integer

  # 幅に入るところまで切りつめる <<en>> Cut it down to what fits the width
  #
  # 文字の途中で切らない。
  # 切ったときは末尾に `ellipsis` (省略すると `".."`、12 ドット) を付け、
  # 付けた分も max_px に入れる。`""` を渡すと何も付けない。入るときは
  # そのまま返す。
  # ```ruby
  # s = FmrbI18n.truncate_to(name, 120)
  # ```
  # <<en>>
  # Never cuts a character in half.
  # When it cuts it appends `ellipsis` (`".."` when left out, 12 pixels), and
  # that counts inside max_px. `""` appends nothing. Text that fits comes
  # back as it is.
  # ```ruby
  # s = FmrbI18n.truncate_to(name, 120)
  # ```
  def self.truncate_to: (String str, Integer max_px, ?String ellipsis) -> String

  # 言葉の表そのもの <<en>> The table of words itself
  #
  # 言語 => 印 => 文 の Hash。`add` はここに書き込む。最初に聞かれたときに
  # `{ "en" => {}, "ja" => {} }` として作られる。
  # ```ruby
  # FmrbI18n.strings["ja"][:save]
  # ```
  # <<en>>
  # The table of words as a Hash of language to key to text, `add` writes into
  # it. It starts as `{ "en" => {}, "ja" => {} }`, made the first time it is
  # asked for.
  # ```ruby
  # FmrbI18n.strings["ja"][:save]
  # ```
  def self.strings: () -> Hash[String, Hash[untyped, String]]

  # 覚えた言葉を忘れる <<en>> Forget the language resolved so far
  #
  # 次の `lang` が端末の設定を読み直す。別の端末へ移されたアプリは
  # **土台が自分で呼ぶ**ので、ふつうのアプリは呼ばない。常に nil を返す。
  # ```ruby
  # FmrbI18n.forget
  # ```
  # <<en>>
  # The next `lang` reads the machine's setting again. For an app moved to
  # another machine **the base calls it itself**, so an ordinary app does not.
  # It always returns nil.
  # ```ruby
  # FmrbI18n.forget
  # ```
  def self.forget: () -> nil

  # 半角カナか <<en>> Whether it is a half-width katakana
  #
  # `i` バイト目からの 3 バイトが半角カタカナ (U+FF61 から U+FF9F) なら true。
  # **`i` は文字ではなくバイトの位置、`n` は文字列のバイト数**
  # (`bytesize`)。3 バイト残っていなければ false。`text_width` が半角カナを
  # 4 ドットで数えるのに使う。
  # ```ruby
  # s = "ｱ"
  # FmrbI18n.half_kana?(s, 0, s.bytesize)
  # #=> true
  # ```
  # <<en>>
  # True when the 3 bytes from byte `i` are a half-width katakana (U+FF61 to
  # U+FF9F). **`i` is a byte position, not a character one**, and
  # **`n` is the string's byte size** (`bytesize`). False when fewer than 3 bytes are
  # left. `text_width` uses it to count half-width kana as 4 pixels.
  # ```ruby
  # s = "ｱ"
  # FmrbI18n.half_kana?(s, 0, s.bytesize)
  # #=> true
  # ```
  def self.half_kana?: (String str, Integer i, Integer n) -> bool
end


# ログ (シリアルと sim の端末に出る) <<en>> The log (goes to the serial port and the sim's terminal)
#
# Log はクラスごと本体との境界に載る (%a{fmrb.boundary}、doc/app_boundary)。
# info などは包みで、隣に省略なしの _raw の形がある (mruby の包みは C で、
# 前に書いたタグを 1 つめに受ける形 `Log.info("TAG", msg)` も読む)。
# <<en>>
# Log as a whole class is on the boundary to the system (%a{fmrb.boundary},
# doc/app_boundary). info and the like are wrappers, each with a _raw form
# next to it that leaves nothing out (the mruby wrapper is in C and also
# reads the older form that takes the tag first, `Log.info("TAG", msg)`).
%a{fmrb.boundary}
module Log
  # 細かい様子をログに書く <<en>> Write a debug line to the log
  #
  # 行の頭にアプリの名前が付く。
  # ```ruby
  # Log.debug("x = #{x}")
  # ```
  # <<en>>
  # The line starts with the app's name.
  # ```ruby
  # Log.debug("x = #{x}")
  # ```
  %a{fmrb.internal}
  def self.debug: (String msg) -> void

  # debug の省略なしの形 <<en>> debug with nothing left out
  #
  # 細かい様子 (D) の 1 行を書く。包みは debug。
  # ```ruby
  # Log.debug_raw("ready")
  # ```
  # <<en>>
  # Writes one line, debug (D). The wrapper is debug.
  # ```ruby
  # Log.debug_raw("ready")
  # ```
  def self.debug_raw: (String msg) -> void

  # ログに書く <<en>> Write a line to the log
  #
  # 行の頭にアプリの名前が付く。
  # ```ruby
  # Log.info("saved #{path}")
  # ```
  # <<en>>
  # The line starts with the app's name.
  # ```ruby
  # Log.info("saved #{path}")
  # ```
  %a{fmrb.internal}
  def self.info: (String msg) -> void

  # info の省略なしの形 <<en>> info with nothing left out
  #
  # ふつうの知らせ (I) の 1 行を書く。包みは info。
  # ```ruby
  # Log.info_raw("ready")
  # ```
  # <<en>>
  # Writes one line, an ordinary note (I). The wrapper is info.
  # ```ruby
  # Log.info_raw("ready")
  # ```
  def self.info_raw: (String msg) -> void

  # 注意をログに書く <<en>> Write a warning to the log
  #
  # 行の頭にアプリの名前が付く。
  # ```ruby
  # Log.warn("x = #{x}")
  # ```
  # <<en>>
  # The line starts with the app's name.
  # ```ruby
  # Log.warn("x = #{x}")
  # ```
  %a{fmrb.internal}
  def self.warn: (String msg) -> void

  # warn の省略なしの形 <<en>> warn with nothing left out
  #
  # 注意 (W) の 1 行を書く。包みは warn。
  # ```ruby
  # Log.warn_raw("ready")
  # ```
  # <<en>>
  # Writes one line, a warning (W). The wrapper is warn.
  # ```ruby
  # Log.warn_raw("ready")
  # ```
  def self.warn_raw: (String msg) -> void

  # エラーをログに書く <<en>> Write an error to the log
  #
  # 行の頭にアプリの名前が付く。
  # ```ruby
  # Log.error("x = #{x}")
  # ```
  # <<en>>
  # The line starts with the app's name.
  # ```ruby
  # Log.error("x = #{x}")
  # ```
  %a{fmrb.internal}
  def self.error: (String msg) -> void

  # error の省略なしの形 <<en>> error with nothing left out
  #
  # エラー (E) の 1 行を書く。包みは error。
  # ```ruby
  # Log.error_raw("ready")
  # ```
  # <<en>>
  # Writes one line, an error (E). The wrapper is error.
  # ```ruby
  # Log.error_raw("ready")
  # ```
  def self.error_raw: (String msg) -> void

end

# ファイルの読み書き。最小限だけ <<en>> Reading and writing files, the minimum only
#
# picoruby の File。
# <<en>>
# Picoruby's File.
class File
  # ファイルを開く <<en>> Open a file
  #
  # **ブロックを渡した形が安全** (抜けるときに閉じ、ブロックの値を返す)。
  # mode は `"r"` `"w"` `"a"` (省略すると `"r"`。細かい形は `File.new`)。
  # 無いファイルを読もうとすると RuntimeError。**File.binread は無い**
  # ので、読むのは `read`。
  # ```ruby
  # File.open("/home/a.txt", "r") do |f|
  #   body = f.read
  # end
  # ```
  # <<en>>
  # **Pass a block**: it closes on the way out and returns the block's
  # value. The mode is `"r"`, `"w"` or `"a"` (`"r"` when left out; see
  # `File.new` for the rest). Reading a missing file raises RuntimeError.
  # There is no `File.binread`; use `read`.
  # ```ruby
  # File.open("/home/a.txt", "r") do |f|
  #   body = f.read
  # end
  # ```
  def self.open: (String path, ?String mode) -> File
               | (String path, ?String mode) { (File file) -> untyped } -> untyped

  # ファイルがあるかどうか <<en>> Whether the file is there
  #
  # ```ruby
  # return unless File.exist?(path)
  # ```
  def self.exist?: (String path) -> bool

  # 中身を読む (長さを渡せばその分だけ) <<en>> Read the file, or that many bytes of it
  #
  # 引数なしなら残り全部が文字列で返る。
  # **大きいファイルは丸ごとメモリに載る**ので、少しずつ処理するなら長さ (バイト) を渡して回す。終わりまで
  # 読んだ後は **nil でなく ""** が返る。
  #
  # **`gets` (1 行読む) は無い** (呼ぶと NoMethodError)。行で分けるなら、
  # 読んだ文字列を `split("\n")` する。
  # ```ruby
  # body = f.read
  # head = f.read(16)
  # body.split("\n").each do |line|
  #   handle(line)
  # end
  # ```
  # <<en>>
  # Without an argument it returns all that is left, in memory at once; for
  # a big file pass a length (bytes) and loop. At the end it returns
  # **"" and not nil**.
  #
  # **There is no `gets`** (calling it raises NoMethodError). To work line
  # by line, `split("\n")` what you read.
  # ```ruby
  # body = f.read
  # head = f.read(16)
  # body.split("\n").each do |line|
  #   handle(line)
  # end
  # ```
  def read: (?Integer length) -> String

  # 書き込む <<en>> Write to the file
  #
  # 書けたバイト数が返る。
  # ```ruby
  # f.write("hello\n")
  # ```
  # <<en>>
  # It gives back how many bytes went out.
  # ```ruby
  # f.write("hello\n")
  # ```
  def write: (String str) -> Integer

  # 閉じる <<en>> Close it
  #
  # ブロック付きの `open` なら要らない。
  # ```ruby
  # f.close
  # ```
  # <<en>>
  # Not needed when `open` was given a block.
  # ```ruby
  # f.close
  # ```
  def close: () -> void
end

# TOML の読み書き (FmrbToml)。
# 実装は lib/gems/picoruby-fmrb-app の mrblib/fmrb-toml.rb と ports/esp32/toml.c (読みは
# ファームウェア自身の TOML リーダ `FmrbToml._parse`。system_conf.toml や .app.toml を読むものと同じ)。
# 全ビルドに入る (family_mruby.gembox)。

# TOML の設定を読む・行ごとに書き換える <<en>> Read TOML; rewrite it by line
#
# `load` でファイル、`parse` で文字列を Hash にする。**読めなかったときは例外でなく nil** で、
# 理由は `FmrbToml.error`。書くのは `update` だけで、**指したキーの行だけを書き換える**ので、
# 人が手で書いたコメント・順序・知らないキーが残る。
# ```ruby
# conf = FmrbToml.load("/home/app.toml")
# n = conf ? conf["name"] : nil
# ```
# <<en>>
# `load` reads a file and `parse` a
# string into a Hash. **A failure is nil, not an exception**; `FmrbToml.error` says why. The
# only writer is `update`, which **changes only the lines of the keys you name**, so comments,
# order and keys nobody here knows stay as a person wrote them.
# ```ruby
# conf = FmrbToml.load("/home/app.toml")
# n = conf ? conf["name"] : nil
# ```
module FmrbToml
  # 文字列の TOML を Hash にする <<en>> Parse a TOML string into a Hash
  #
  # 表 (`[a]`) は Hash、配列は Array、`[[name]]` は Hash の Array。文字列・整数 (`0x..` も)・
  # 小数・true/false はそのまま。**日付と引用符の無い 1 語 (`bg = black`)** は、
  # 書かれた文字列のまま返る。
  #
  # TOML でないと (1 行の誤りでも) nil。理由は `FmrbToml.error`。例外は出ない。
  # ```ruby
  # FmrbToml.parse("a = 1\n[s]\nb = \"x\"\n")
  # #=> {"a"=>1, "s"=>{"b"=>"x"}}
  # ```
  # <<en>>
  # A table (`[a]`) is a Hash, an array an Array, `[[name]]` an Array of Hash. Strings,
  # integers (`0x..` too), floats and true/false come back as themselves. **A date and an unquoted word (`bg = black`)**
  # come back as the text that was written.
  #
  # Text that is not TOML (even one bad line) gives nil; `FmrbToml.error` says why. No exception.
  # ```ruby
  # FmrbToml.parse("a = 1\n[s]\nb = \"x\"\n")
  # #=> {"a"=>1, "s"=>{"b"=>"x"}}
  # ```
  def self.parse: (String text) -> Hash[String, untyped]?

  # ファイルの TOML を Hash にする <<en>> Read a TOML file into a Hash
  #
  # ファイルが無いと nil (ログは出さない。設定を誰も変えていない普通の状態)。読めない・
  # TOML でないと nil で、ログに 1 行 (`toml: パス: 理由`) が出る。どちらも理由は
  # `FmrbToml.error`。
  # ```ruby
  # conf = FmrbToml.load("/home/app.toml")
  # ```
  # <<en>>
  # A missing file gives nil with no log line (the ordinary state of a setting nobody has
  # changed). An unreadable file or one that is not TOML gives nil and one log line
  # (`toml: path: reason`). Either way `FmrbToml.error` has the reason.
  # ```ruby
  # conf = FmrbToml.load("/home/app.toml")
  # ```
  def self.load: (String path) -> Hash[String, untyped]?

  # 直前の読み書きが nil になった理由 <<en>> Why the last parse, load or update gave nil
  #
  # 成功した後は nil。
  # ```ruby
  # Log.warn(FmrbToml.error) if conf.nil?
  # ```
  # <<en>>
  # nil after a success.
  # ```ruby
  # Log.warn(FmrbToml.error) if conf.nil?
  # ```
  def self.error: () -> String?

  # ファイルのキーだけ書き換える <<en>> Set keys in a file, leaving the other lines alone
  #
  # values は `名前 => 値` の Hash。名前は先頭のキー (`"rise_mg"`) か `"表.キー"`
  # (`"editor.bg"`。最後の `.` で表とキーに分ける)。キーが無ければ足し (表が無ければ
  # ファイルの終わりに足す)、**値が nil ならそのキーを消す**。値は文字列・Symbol (文字列で
  # 書く)・整数・小数・true/false・Array・Hash、または `FmrbToml.raw` の「引用符なし」。
  #
  # 書いたあとに読み直して、値が入っていれば**書いた後の Hash**を返す。ファイルがあるのに
  # TOML でないときは**触らずに** nil (人の文章だから)。書けない・読み戻して合わない
  # ときも nil。いずれも理由は `FmrbToml.error`。ファイルが無ければ作る。
  # ```ruby
  # FmrbToml.update("/home/app.toml",
  #                 { "editor.bg" => 36 })
  # ```
  # <<en>>
  # values is a Hash of `name => value`. A name is a top-level key (`"rise_mg"`) or
  # `"table.key"` (`"editor.bg"`; the last `.` splits table from key). A missing key is added
  # (a missing table goes at the end of the file), and **a nil value removes the key**. A value
  # is a String, a Symbol (written as a string), an Integer, a Float, true/false, an Array, a
  # Hash, or an unquoted word from `FmrbToml.raw`.
  #
  # The file is read back afterwards, and the Hash it holds now is returned when it has the
  # values. A file that exists but is not TOML is **left untouched** and gives nil (it is
  # somebody's text). A failed write or a value that does not read back is nil too. All of
  # them leave the reason in `FmrbToml.error`. A missing file is created.
  # ```ruby
  # FmrbToml.update("/home/app.toml",
  #                 { "editor.bg" => 36 })
  # ```
  def self.update: (String path, Hash[String, untyped] values) -> Hash[String, untyped]?

  # 引用符を付けずにそのまま書く値 <<en>> A value written as it is, unquoted
  #
  # `update` に渡すと、文字列でも引用符を付けずに書く (色の名前 `bg = black` など)。
  # ```ruby
  # FmrbToml.update(path,
  #   { "shell.bg" => FmrbToml.raw("black") })
  # ```
  # <<en>>
  # Passed to `update`, it is written without quotes even though it is text (a colour name,
  # `bg = black`).
  # ```ruby
  # FmrbToml.update(path,
  #   { "shell.bg" => FmrbToml.raw("black") })
  # ```
  def self.raw: (String text) -> FmrbToml::Raw

  # 値 1 つの TOML の字 <<en>> The TOML text of one value
  #
  # 文字列は引用符で囲んでエスケープし、数と true/false はそのまま、Array と Hash は 1 行の
  # インライン形。Symbol は文字列。**それ以外は ArgumentError** ("no TOML for クラス名")。
  # ```ruby
  # FmrbToml.dump_value("a\"b")  #=> "\"a\\\"b\""
  # ```
  # <<en>>
  # A String is quoted and escaped, numbers and true/false as they are, an Array or a Hash in
  # one-line inline form. A Symbol is a string. **Anything else is an ArgumentError**
  # ("no TOML for ClassName").
  # ```ruby
  # FmrbToml.dump_value("a\"b")  #=> "\"a\\\"b\""
  # ```
  def self.dump_value: (untyped value) -> String

  # キーの TOML の字 <<en>> The TOML text of a key
  #
  # 英数字と `_`・`-` だけならそのまま、ほかは引用符で囲む。
  # ```ruby
  # FmrbToml.dump_key("a b")  #=> "\"a b\""
  # ```
  # <<en>>
  # Returned as it is when it holds only letters, digits, `_` and `-`; otherwise quoted.
  # ```ruby
  # FmrbToml.dump_key("a b")  #=> "\"a b\""
  # ```
  def self.dump_key: (String key) -> String

  # 引用符なしで書く値の入れもの <<en>> Holds a value to write unquoted
  #
  # 普通は `FmrbToml.raw` で作る。
  # ```ruby
  # r = FmrbToml::Raw.new("black")
  # r.text   #=> "black"
  # ```
  # <<en>>
  # Usually made with `FmrbToml.raw`.
  # ```ruby
  # r = FmrbToml::Raw.new("black")
  # r.text   #=> "black"
  # ```
  class Raw
    # 字を入れて作る (to_s にして持つ) <<en>> Make one from text (kept as to_s)
    #
    # ```ruby
    # r = FmrbToml::Raw.new("black")
    # ```
    def self.new: (untyped text) -> FmrbToml::Raw

    # 持っている字 <<en>> The text it holds
    #
    # ```ruby
    # r.text   #=> "black"
    # ```
    def text: () -> String
  end
end

# 色の名前と、アプリごとの色の上書き (FmrbColors)。
# 実装は lib/gems/picoruby-fmrb-app/mrblib/fmrb-colors.rb。全ビルドに入る。
# Spinel でコンパイルした側 (main/ruby/spinel/fmrb_app_base_spinel.rb) には、行読みの別の写しがある。

# 色の名前の表と、/home/colors.toml の読み書き <<en>> The colour-name table, and /home/colors.toml
#
# 色は **RGB332 の 0〜255 の整数**。名前は web の色名を 256 色に写したもの (101 個の
# 一覧と、同じ色へ行く別名)。`/home/colors.toml` にはアプリごとの上書きだけを書き、
# ファイルも節もキーも無ければ「テーマのまま」になる。
# ```ruby
# bg = FmrbColors.by_name("navy")   #=> 2
# ```
# <<en>>
# A colour is **an RGB332 integer, 0..255**. The names are the web's, mapped onto the 256
# colours (a list of 101, plus aliases that land on the same colour). /home/colors.toml holds
# only what an app overrides: a missing file, section or key means "use the theme".
# ```ruby
# bg = FmrbColors.by_name("navy")   #=> 2
# ```
module FmrbColors
  # 上書きのファイル <<en>> The overrides file
  PATH: String

  # テーマの色より 1 段暗い色 <<en>> A step darker than a theme colour
  #
  # 赤と緑を 2 段、青を 1 段下げる。結果が 0x01 (デスクトップの透明色)・元の色・`avoid` に
  # なるときは、下げずに上げる方へ振る。隣り合うバーが溶け合わないようにするためのもの。
  # ```ruby
  # bar = FmrbColors.shade(
  #   FmrbConst::THEME_MENU_BG, bg)
  # ```
  # <<en>>
  # Down two of the seven red/green steps and one of the three blue ones. When the result would
  # be 0x01 (the desktop's transparent key), the colour itself or `avoid`, it goes the other way.
  # For a bar that must not merge with its neighbour.
  # ```ruby
  # bar = FmrbColors.shade(
  #   FmrbConst::THEME_MENU_BG, bg)
  # ```
  def self.shade: (Integer color, ?Integer? avoid) -> Integer

  # 名前から色 (RGB332) を引く <<en>> Look a colour up by name
  #
  # 名前は**小文字**で、一覧か別名にあるもの。無ければ nil。
  # ```ruby
  # FmrbColors.by_name("black")   #=> 0
  # ```
  # <<en>>
  # The name must be **lowercase** and in the list or the aliases. Otherwise nil.
  # ```ruby
  # FmrbColors.by_name("black")   #=> 0
  # ```
  def self.by_name: (String name) -> Integer?

  # 色の名前 (選ぶときに見せるもの) <<en>> The name to show for a colour
  #
  # 名前の無い色は nil。別名は返らず、一覧の名前が返る。
  # ```ruby
  # FmrbColors.name_of(0)   #=> "black"
  # ```
  # <<en>>
  # nil for a colour without a name. An alias is never returned, only the list's name.
  # ```ruby
  # FmrbColors.name_of(0)   #=> "black"
  # ```
  def self.name_of: (Integer value) -> String?

  # 一覧の n 番目の名前 <<en>> The nth name in the list
  #
  # 0 から。範囲外は nil。
  # ```ruby
  # FmrbColors.name_at(0)   #=> "black"
  # ```
  # <<en>>
  # From 0. nil out of range.
  # ```ruby
  # FmrbColors.name_at(0)   #=> "black"
  # ```
  def self.name_at: (Integer index) -> String?

  # 一覧の個数 <<en>> How many names the list holds
  #
  # ```ruby
  # FmrbColors.palette_size.times { |i| p FmrbColors.name_at(i) }
  # ```
  def self.palette_size: () -> Integer

  # 一覧の n 番目の色 <<en>> The nth colour of the list
  #
  # 0 から。範囲外は nil。`name_at` と同じ並び。
  # ```ruby
  # FmrbColors.palette_value(0)   #=> 0
  # ```
  # <<en>>
  # From 0. nil out of range. Same order as `name_at`.
  # ```ruby
  # FmrbColors.palette_value(0)   #=> 0
  # ```
  def self.palette_value: (Integer index) -> Integer?

  # 文字を色にする <<en>> Turn text into a colour
  #
  # `"0x24"` (16 進)、`"36"` (10 進)、`"black"`・`"\"black\""` (名前) を 0〜255 にする。
  # **それ以外は nil** なので、打ち間違いはテーマの色が残る (黒で塗られない)。16 進と 10 進は
  # 256 を超えても下 8 ビットに丸める。
  # ```ruby
  # FmrbColors.to_color("0x1C")   #=> 28
  # ```
  # <<en>>
  # `"0x24"` (hex), `"36"` (decimal), `"black"` or `"\"black\""` (a name) become 0..255.
  # **Anything else is nil**, so a typo leaves the theme colour (it never paints black).
  # A hex or decimal above 255 is cut to its low 8 bits.
  # ```ruby
  # FmrbColors.to_color("0x1C")   #=> 28
  # ```
  def self.to_color: (String text) -> Integer?

  # 色を書き戻す字にする <<en>> The text to write back for a colour
  #
  # 名前があれば名前、無ければ `"0x1C"` の形。
  # ```ruby
  # FmrbColors.to_text(28)   #=> "0x1C" か名前
  # ```
  # <<en>>
  # Its name when it has one, otherwise the `"0x1C"` form.
  # ```ruby
  # FmrbColors.to_text(28)   #=> "0x1C" or a name
  # ```
  def self.to_text: (Integer value) -> String

  # 1 つの節の上書きを読む <<en>> Read one section's overrides
  #
  # `{ "bg" => 36, ... }` を返す。**ファイルや節が無い・TOML でない・色にならない値**は
  # 空か飛ばしで、例外にならない。整数は下 8 ビット (負は飛ばす)、文字列は `to_color`。
  # ```ruby
  # c = FmrbColors.section("editor")
  # bg = c["bg"] || FmrbConst::THEME_WINDOW_BG
  # ```
  # <<en>>
  # Returns `{ "bg" => 36, ... }`. **A missing file or section, non-TOML text, a non-colour value**
  # give an empty Hash or are skipped; nothing raises. An integer is
  # cut to 8 bits (a negative one is skipped), a string goes through `to_color`.
  # ```ruby
  # c = FmrbColors.section("editor")
  # bg = c["bg"] || FmrbConst::THEME_WINDOW_BG
  # ```
  def self.section: (String name) -> Hash[String, Integer]

  # 1 つの色の上書きを書く <<en>> Write one override
  #
  # 節 `section` のキー `key` に色を書く。**value が nil ならそのキーを消す** (テーマに戻る)。
  # 書き方は `FmrbToml.update` と同じ (他の行・コメントは残る)。ファイルに入れば true、
  # 書けない・TOML でないファイルなら false。
  # ```ruby
  # FmrbColors.set("shell", "bg", 0x24)
  # ```
  # <<en>>
  # Writes a colour to key `key` of section `section`. **A nil value removes the key** (back
  # to the theme). It writes as `FmrbToml.update` does (other lines and comments stay). true
  # when the file holds it now, false when it could not be written or the file is not TOML.
  # ```ruby
  # FmrbColors.set("shell", "bg", 0x24)
  # ```
  def self.set: (String section, String key, Integer? value) -> bool

  # 1 つの節の上書きを全部消す <<en>> Remove a whole section
  #
  # 見出しからその節の終わりまでを消して、ファイルを書き直す。ファイルが無ければ true、
  # 書けなければ false。**ほかの節は保つが全体を書き直す**。
  # ```ruby
  # FmrbColors.clear("shell")
  # ```
  # <<en>>
  # Drops the heading and everything up to the next section, then rewrites the file. true when
  # there is no file, false when the write fails. **Other sections are kept, but the file is rewritten whole.**
  # ```ruby
  # FmrbColors.clear("shell")
  # ```
  def self.clear: (String section) -> bool
end
