# ほかの端末とのやり取り (Asterism)。実装は
# lib/gems/picoruby-fmrb-asterism/mrblib/ (FmrbAsterism) と、Asterism の
# gem (vendor/asterism/mrblib/。Asterism::Connection など)。
#
# アプリが使う側だけを書く。順番は次のとおり。
#
# 1. on_create で FmrbAsterism::Link を作る (つなぐ)。
# 2. つながるたびに Link がアプリの link_up(link) を呼ぶ。そこで
#    link.conn (Asterism::Connection) にオブジェクトを公開し (expose)、
#    トピックを出し (publish)、受ける (subscribe)。つなぎ直すと新しい
#    conn になるので、毎回ここでやり直す。
# 3. on_update で毎回 @link.update を呼ぶ。届いた呼び出しへの答えと
#    subscribe のブロックは、この中で動く。
# 4. ほかの端末のオブジェクトは conn["<端末>/<アプリ>/<名前>"] で受け取り、
#    メソッドを呼ぶ (呼び出す)。待たずに呼ぶなら async。
# 5. on_destroy で @link.close (閉じる)。
#
# 見本: flash/app/demo/talk_board.app.rb (公開してトピックで知らせる側) と
# flash/app/demo/talk_client.app.rb (呼んで、トピックを受ける側)。
#
# 送れる値は nil・true・false・Integer・Float・String・Symbol (String に
# なる)・Array・Hash だけ (MessagePack)。Hash のキーは String で届く。
#
# 同じ端末の中のアプリどうしなら FmrbApp の publish / subscribe
# (Pub/Sub) で足りる。こちらはネットワーク (ルータ) 越しにほかの端末と話す。

# ほかの端末とつなぐ設定と Link <<en>> Settings and the link to other machines
#
# 設定 (ルータ・端末の名前) は端末の /home/asterism/config.toml にある。
# アプリが自分で読まなくても、Link が使う。
# <<en>>
# The machine's settings (router, node ID) live in
# /home/asterism/config.toml; the Link uses them for you.
module FmrbAsterism
  # この端末の種類の名前 <<en>> This machine's kind ("sim", "p4nano", ...)
  #
  # ```ruby
  # kind = FmrbAsterism.host
  # ```
  def self.host: () -> String

  # この端末のつなぎ方の設定 <<en>> How this machine connects (resolved settings)
  #
  # 例外を出さない。設定がおかしいときは error に理由が入る。
  # 普通は Link が読むので、アプリが呼ぶのは表示したいときだけ。
  # ```ruby
  # st = FmrbAsterism.settings
  # puts "#{st.node} via #{st.router}"
  # ```
  # <<en>>
  # Never raises; a bad setting puts its reason in error. The Link
  # reads it itself, so call it only to show it.
  # ```ruby
  # st = FmrbAsterism.settings
  # puts "#{st.node} via #{st.router}"
  # ```
  def self.settings: () -> FmrbAsterism::Settings

  # 設定ファイル <<en>> The settings file ("/home/asterism/config.toml")
  CONFIG_FILE: String
  # 設定と証明書を置くディレクトリ <<en>> The directory of the settings and credentials
  DIR: String
  # 何も指定が無いときのルータ <<en>> The router used when none is set ("tcp/zenohd:7447", the sim's)
  DEFAULT_ROUTER: String
  # 端末の設定ファイル <<en>> The machine's settings file ("/etc/system_conf.toml")
  SYSTEM_CONF: String

  # config.toml の中身 <<en>> What config.toml says (router, node, name)
  #
  # `{"router" => ..., "node" => ..., "name" => ...}` のうち、ファイルに書いてある
  # 文字列の項目だけ。ファイルが無ければ {}。
  # **ファイルが無いときは、昔のファイル (zenoh_echo.txt など) があれば config.toml に写してから読む**
  # (昔のファイルは残る)。TOML でないファイルは {} でログに 1 行出る。
  # ```ruby
  # c = FmrbAsterism.config
  # router = c["router"]
  # ```
  # <<en>>
  # Only the String entries of `{"router" => ..., "node" => ..., "name" => ...}`
  # that the file has; {} without it.
  # **Without the file, the files from before config.toml (zenoh_echo.txt and others) are copied into it first**
  # (the old files stay). A file that is not TOML gives {} and a log line.
  # ```ruby
  # c = FmrbAsterism.config
  # router = c["router"]
  # ```
  def self.config: () -> Hash

  # config.toml だけを読む <<en>> Read config.toml (without the old-file copy of config)
  #
  # config と同じ形の Hash。ファイルが無い・TOML でないと {}。昔のファイルの
  # 引っ越しはしない。
  # ```ruby
  # c = FmrbAsterism.read_config
  # ```
  # <<en>>
  # The same Hash as config; {} when the file is missing or is not TOML.
  # It does not copy the old files.
  # ```ruby
  # c = FmrbAsterism.read_config
  # ```
  def self.read_config: () -> Hash

  # config.toml を書く <<en>> Write config.toml from a Hash
  #
  # c の "router"・"node"・"name" のうち持っているものだけを書く。
  # **ファイル全体を置き換える**ので、残したい項目も c に入れる (config で読んで
  # 直して渡す)。ディレクトリが無ければ作る。nil を返す。
  # ```ruby
  # c = FmrbAsterism.config
  # c["router"] = "tcp/192.0.2.2:7447"
  # FmrbAsterism.write_config(c)
  # ```
  # <<en>>
  # Writes only the "router", "node" and "name" that c has.
  # **It replaces the whole file**, so keep the entries you want in c (read with config,
  # change, pass back). Makes the directory when it is missing. Returns nil.
  # ```ruby
  # c = FmrbAsterism.config
  # c["router"] = "tcp/192.0.2.2:7447"
  # FmrbAsterism.write_config(c)
  # ```
  def self.write_config: (Hash c) -> nil

  # 保存してある名前 <<en>> The saved display name ("" when none)
  #
  # config.toml の name。無いか読めなければ ""。
  # ```ruby
  # n = FmrbAsterism.saved_name
  # ```
  def self.saved_name: () -> String

  # 表示の名前を保存する <<en>> Save the display name and use it now
  #
  # 前後の空白を除いて config.toml の name に書き、このプログラムの名乗りの既定
  # (Asterism.profile_defaults) にも入れる。nil か "" で消す。接続中なら変更が
  # ネットワークに流れる。名乗りの Hash を返す。名乗りが受け付けない名前
  # (64 バイトを超える) は ArgumentError で、ファイルは変わらない。
  # ```ruby
  # FmrbAsterism.save_name("Rover")
  # ```
  # <<en>>
  # Trims it, writes it as name in config.toml and sets it in this
  # program's profile defaults (Asterism.profile_defaults); nil or ""
  # removes it. A connected app puts the change on the network. Returns the
  # profile Hash. A name the profile does not take (over 64 bytes) raises
  # ArgumentError and the file is left as it was.
  # ```ruby
  # FmrbAsterism.save_name("Rover")
  # ```
  def self.save_name: (String? name) -> Hash

  # この端末の mDNS の名前 <<en>> The machine's mDNS host name ("" without WiFi)
  #
  # WiFi の情報から読む。WiFi の無い端末・読めないときは ""。
  # ```ruby
  # h = FmrbAsterism.hostname
  # ```
  # <<en>>
  # Read from the WiFi info; "" on a machine without WiFi or when it
  # cannot be read.
  # ```ruby
  # h = FmrbAsterism.hostname
  # ```
  def self.hostname: () -> String

  # 端末の設定 (system_conf.toml) の文字列 <<en>> A top-level String of /etc/system_conf.toml ("" if none)
  #
  # key の値の前後の空白を除いて返す。ファイルが無い・キーが無い・文字列
  # でないと ""。
  # ```ruby
  # r = FmrbAsterism.system_conf(
  #   "zenoh_router")
  # ```
  # <<en>>
  # The value of key, trimmed. "" when the file or the key is missing or
  # the value is not a String.
  # ```ruby
  # r = FmrbAsterism.system_conf(
  #   "zenoh_router")
  # ```
  def self.system_conf: (String key) -> String

  # ルータが TLS を求めているか <<en>> Whether a locator asks for TLS (starts with "tls/")
  #
  # ```ruby
  # FmrbAsterism.tls?(
  #   "tls/router.example.org:7447")
  # #=> true
  # ```
  def self.tls?: (String? locator) -> bool

  # 証明書の .tar の場所 <<en>> The path of the credentials .tar in /home/asterism (nil if none)
  #
  # 名前順で最初の .tar。2 つ以上あるとログに 1 行出す。ディレクトリが
  # 読めなくても nil。
  # ```ruby
  # path = FmrbAsterism.credentials_path
  # ```
  # <<en>>
  # The first .tar by name; it logs a line when there is more than one.
  # nil also when the directory cannot be read.
  # ```ruby
  # path = FmrbAsterism.credentials_path
  # ```
  def self.credentials_path: () -> String?

  # TLS のルータ用の証明書を読む <<en>> Load the credentials for a tls/ router
  #
  # locator が "tls/" で始まらなければ nil。始まるのに .tar が無い・読めないと
  # Asterism::Error。この証明書の名前が、ルータのアクセス制御が知っている
  # 端末の名前になる。
  # ```ruby
  # c = FmrbAsterism.credentials_for(
  #   "tls/router.example.org:7447")
  # ```
  # <<en>>
  # nil unless the locator starts with "tls/". Raises Asterism::Error when
  # it does and there is no .tar or it cannot be read. The certificate's
  # name is the node ID the router's access control knows.
  # ```ruby
  # c = FmrbAsterism.credentials_for(
  #   "tls/router.example.org:7447")
  # ```
  def self.credentials_for: (String locator) -> Asterism::Credentials?

  # つなぎ方の設定 <<en>> Connection settings
#
# FmrbAsterism.settings の答え。
# <<en>>
# What FmrbAsterism.settings answers.
  class Settings
    # ルータの場所 <<en>> The router's locator ("tcp/host:7447")
    #
    # ```ruby
    # r = FmrbAsterism.settings.router
    # ```
    def router: () -> String

    # この端末の名前 (ノード ID) <<en>> This machine's node ID
    #
    # ほかの端末はこの名前で、こちらのオブジェクトを呼ぶ。
    # ```ruby
    # me = FmrbAsterism.settings.node
    # ```
    # <<en>>
    # Other machines call this machine's objects by this name.
    # ```ruby
    # me = FmrbAsterism.settings.node
    # ```
    def node: () -> String

    # 持ち主が付けた表示の名前 <<en>> The display name the owner gave ("" for none)
    #
    # ```ruby
    # n = FmrbAsterism.settings.name
    # ```
    def name: () -> String

    # 設定がおかしい理由 <<en>> Why the settings are unusable (nil when fine)
    #
    # ```ruby
    # err = FmrbAsterism.settings.error
    # ```
    def error: () -> String?

    # 証明書 <<en>> The credentials for a TLS router (nil when none)
    #
    # ルータが tls/ のときだけ読んだ Asterism::Credentials。そうでなければ nil。
    # ```ruby
    # c = FmrbAsterism.settings.credentials
    # ```
    # <<en>>
    # The Asterism::Credentials, only for a tls/ router; nil otherwise.
    # ```ruby
    # c = FmrbAsterism.settings.credentials
    # ```
    def credentials: () -> Asterism::Credentials?

    # Zenoh に渡す設定 <<en>> The Zenoh config for Session.open (TLS keys; nil without credentials)
    #
    # ```ruby
    # cfg = FmrbAsterism.settings
    #   .zenoh_config
    # ```
    def zenoh_config: () -> Hash?
  end

  # つなぐ・つなぎ直す・閉じる <<en>> Keeps the app connected (connect, retry, close)
  #
  # アプリ 1 つに 1 つ。on_create で作り、on_update で毎回 update を
  # 呼び、on_destroy で close する。つながるたびにアプリの
  # **link_up(link)** を呼ぶ。つながらなかった・切れたときは、アプリに
  # **link_down(link)** があれば呼ぶ (無くてよい)。切れたら retry_ms
  # ごとに自分でつなぎ直す。
  #
  # ```ruby
  # def on_create
  #   @link = FmrbAsterism::Link.new(
  #     self, "talk")
  # end
  #
  # def link_up(link)
  #   link.conn.expose("board", self,
  #     methods: { post: 1 })
  # end
  #
  # def on_update
  #   @link.update
  #   100
  # end
  #
  # def on_destroy
  #   @link.close
  # end
  # ```
  # <<en>>
  # One per app. Make it in on_create, call update in every on_update,
  # close it in on_destroy. After every connect it calls the app's
  # **link_up(link)**; after a failed connect or a lost connection it
  # calls **link_down(link)** when the app has one (optional). It
  # connects again by itself every retry_ms.
  class Link
    # つなぎ直す間隔の既定 (ms) <<en>> Default retry_ms (3000)
    DEFAULT_RETRY_MS: Integer
    # WiFi を待つ上限の既定 (ms) <<en>> Default wifi_wait_ms (20000)
    DEFAULT_WIFI_WAIT_MS: Integer

    # 作る (つなぐのは後の update) <<en>> Make a link (update connects later)
    #
    # owner はアプリ (self)。app はネットワークでのアプリの名前で、
    # ほかの端末からは "<端末>/<app>/<オブジェクト>" で見える。
    # /・*・#・?・$ を含めない、@ で始めない。
    # **キーワードは省ける**: tag: (ログの頭)、retry_ms: (つなぎ直す
    # 間隔、既定 3000。nil なら 1 回だけ)。作っただけではつながない。
    # 同じ端末で同じ app 名は 1 つだけ (2 つ目は :still_there)。
    # ほかのキーワード: `wifi_wait_ms:` (省略すると 20000。WiFi に
    # アドレスが付くのを待つ上限)、`screen_wait_ms:` (省略すると待たない。
    # 値を渡すと screen_ready まで待つ)、`settings:` (省略すると
    # FmrbAsterism.settings)。
    # ```ruby
    # @link = FmrbAsterism::Link.new(
    #   self, "talk", retry_ms: 5000)
    # ```
    # <<en>>
    # owner is the app (self). app is the app's name on the network:
    # others see "<node>/<app>/<object>". No /, *, #, ?, $ and no leading
    # @. **Keywords are optional**: tag: (log prefix), retry_ms: (default
    # 3000; nil tries once). Making it does not connect yet. One app of a
    # name per machine (a second one gets :still_there). Also
    # `wifi_wait_ms:` (20000 when left out; the most it waits for WiFi to
    # get an address), `screen_wait_ms:` (not waiting when left out; a value
    # waits for screen_ready), `settings:` (FmrbAsterism.settings when left out).
    # ```ruby
    # @link = FmrbAsterism::Link.new(
    #   self, "talk", retry_ms: 5000)
    # ```
    def self.new: (FmrbApp owner, String app, ?tag: String?, ?retry_ms: Integer?, ?wifi_wait_ms: Integer, ?screen_wait_ms: Integer?, ?settings: FmrbAsterism::Settings?) -> FmrbAsterism::Link

    # 毎回呼ぶ (答える・受ける・つなぐ) <<en>> Call every on_update (answer, receive, connect)
    #
    # つながっている間は届いた呼び出しに答え、subscribe のブロックを
    # 呼ぶ。つながっていなければ、時間が来たらつなぐ。つなぐ間
    # (ルータが無いと数秒) アプリは止まる。つながっている間 true。
    # ```ruby
    # def on_update
    #   if @link.update
    #     check_call
    #   end
    #   100
    # end
    # ```
    # <<en>>
    # While connected it answers the calls that came in and runs the
    # subscribe blocks; otherwise it connects when it is time (the app
    # waits for that, a few seconds when there is no router). True
    # while connected.
    # ```ruby
    # def on_update
    #   if @link.update
    #     check_call
    #   end
    #   100
    # end
    # ```
    def update: () -> bool

    # つながっているか <<en>> Whether it is connected
    #
    # つなぎ直しの途中 (:reconnecting) も true。
    # ```ruby
    # return unless @link.connected?
    # ```
    # <<en>>
    # Also true while reconnecting.
    # ```ruby
    # return unless @link.connected?
    # ```
    def connected?: () -> bool

    # 出した物がほかに届く状態か <<en>> Connected and not reconnecting
    #
    # ```ruby
    # @topic.put(v) if @link.up?
    # ```
    def up?: () -> bool

    # 今の状態 <<en>> The state now
    #
    # :connected がつながっている。:connecting は次の update で
    # つなぐ (先に「つないでいます」を描ける)。:retrying・:lost・
    # :still_there は retry_ms の後にまたつなぐ。:failed は
    # retry_ms: nil で失敗した、:closed は close の後。
    # ```ruby
    # if @link.state == :connecting
    #   show("つないでいます")
    # end
    # ```
    # <<en>>
    # :connected is connected. :connecting connects on the next update
    # (draw "connecting" first). :retrying, :lost and :still_there try
    # again after retry_ms. :failed failed with retry_ms: nil, :closed
    # is after close.
    # ```ruby
    # if @link.state == :connecting
    #   show("connecting")
    # end
    # ```
    def state: () -> (:waiting_wifi | :waiting_screen | :connecting | :connected | :reconnecting | :retrying | :still_there | :lost | :failed | :closed)

    # つながっていない理由 <<en>> Why it is not connected ("" while connected)
    #
    # ```ruby
    # def link_down(link)
    #   show(link.reason)
    # end
    # ```
    def reason: () -> String

    # つながり (公開・呼び出し・トピック) <<en>> The connection: expose, call, publish, subscribe
    #
    # つながっている間だけある。つながる前・切れた後は nil。
    # つなぎ直すと別の物になるので、変数にしまわず毎回 link.conn から
    # 取る (link_up の中か、connected? の後)。
    # ```ruby
    # c = @link.conn
    # c.nodes if c
    # ```
    # <<en>>
    # Only while connected; nil before the first connect and after a
    # loss. A new one after every connect, so take it from link.conn
    # each time (in link_up, or after connected?).
    # ```ruby
    # c = @link.conn
    # c.nodes if c
    # ```
    def conn: () -> Asterism::Connection?

    # この端末の名前 (ノード ID) <<en>> This machine's node ID
    #
    # ```ruby
    # me = @link.node
    # ```
    def node: () -> String

    # ネットワークでのアプリの名前 <<en>> The app's name on the network
    #
    # ```ruby
    # path = "#{@link.node}/#{@link.app}"
    # ```
    def app: () -> String

    # ルータの場所 <<en>> The router's locator
    #
    # ```ruby
    # r = @link.router
    # ```
    def router: () -> String

    # 最後につなぐのにかかった時間 (ms) <<en>> Milliseconds the last connect took
    #
    # ```ruby
    # ms = @link.took_ms
    # ```
    def took_ms: () -> Integer

    # つながった回数 <<en>> How many times it has connected
    #
    # ```ruby
    # n = @link.connects
    # ```
    def connects: () -> Integer

    # アプリの側でつながりをあきらめる <<en>> Give up the connection now (retried after retry_ms)
    #
    # 閉じて理由を残し、retry_ms の後につなぎ直す (link_down も呼ぶ)。
    # ```ruby
    # @link.lost("no answer")
    # ```
    # <<en>>
    # Closes it, keeps the reason, connects again after retry_ms (and
    # calls link_down).
    # ```ruby
    # @link.lost("no answer")
    # ```
    def lost: (String why) -> void

    # 閉じる (もうつながない) <<en>> Close for good (on_destroy)
    #
    # 公開したオブジェクト・トピック・購読もいっしょに終わる。
    # ```ruby
    # def on_destroy
    #   @link.close
    # end
    # ```
    # <<en>>
    # The exposed objects, topics and subscriptions end with it.
    # ```ruby
    # def on_destroy
    #   @link.close
    # end
    # ```
    def close: () -> void

    # 画面ができたと知らせる <<en>> Tell the link the screen is ready
    #
    # Link.new に screen_wait_ms: を渡したときだけ要る。
    # ```ruby
    # @link.screen_ready
    # ```
    # <<en>>
    # Only needed when Link.new was given screen_wait_ms:.
    # ```ruby
    # @link.screen_ready
    # ```
    def screen_ready: () -> void
  end
end

# Asterism の gem。アプリは conn から使う <<en>> The Asterism gem; apps use it through conn
#
# vendor/asterism にある gem。アプリは FmrbAsterism::Link の conn から使う。
# <<en>>
# The gem in vendor/asterism. An app uses it through the conn of an FmrbAsterism::Link.
module Asterism
  # 通信の版 <<en>> The wire protocol version this implementation speaks
  PROTOCOL: Integer
  # 呼び出しの待ち時間の既定 (秒) <<en>> Default time limit of a call (seconds)
  DEFAULT_TIMEOUT: Float
  # 呼び出しの待ち時間の既定 (ミリ秒) <<en>> Default time limit of a call (milliseconds)
  DEFAULT_TIMEOUT_MS: Integer
  # 同じ名前の相手を探す時間 (秒) <<en>> How long connect looks for another copy of the same node/app (seconds)
  CHECK_TIMEOUT: Float
  # キーの根 <<en>> The first chunk of every key ("asterism")
  ROOT: String

  # ネットワークにつなぐ (Link を使わないとき) <<en>> Open a connection (what Link does for you)
  #
  # ルータ (locator) につないで、このアプリ (node の app) を Asterism の上に
  # 出し、Asterism::Connection を返す。**端末のアプリは普通 Link を使う**
  # (WiFi を待つ・つなぎ直す・設定を読むのは Link)。これは Link が呼ぶ入口。
  # **つなぐ間アプリは止まる** (同じ名前の相手を探す `check_timeout:` の
  # 1.5 秒ほどと、ルータが無いときの数秒)。
  # `node:` (省略すると credentials の名前)、`app:` (必須)、`mode:` (省略すると
  # ルータのクライアント。:peer ならルータ無し)、`listen:`、`config:` (TLS の
  # キーなど。Hash か JSON5 の String)、`connect_timeout:` (PC の CRuby だけ。
  # 端末は ArgumentError)、`check_timeout:` (秒)、`credentials:`
  # (.tar のパスか Asterism::Credentials。locator と node の既定になる)。
  # つなげないと Asterism::Disconnected、同じ node/app が既にあると
  # Asterism::Error、名前が正しくないと ArgumentError。
  # ```ruby
  # conn = Asterism.connect(
  #   "tcp/192.0.2.2:7447",
  #   node: "fmruby-aaa001", app: "demo")
  # ```
  # <<en>>
  # Connects to the router (locator), puts this app (app of node) on
  # Asterism and returns an Asterism::Connection. **An app on a machine normally uses Link**
  # (Link waits for WiFi, connects again and reads the settings); this is
  # the entry Link calls. **The app waits while it connects** (about 1.5 s
  # of `check_timeout:` looking for another copy of the same name, and a
  # few seconds when there is no router). `node:`
  # (the credentials' name when left out), `app:` (required), `mode:`
  # (a client of a router when left out; :peer for no router), `listen:`,
  # `config:` (TLS keys and the like; a Hash or a JSON5 String),
  # `connect_timeout:` (CRuby on a PC only; ArgumentError on a machine),
  # `check_timeout:` (seconds), `credentials:` (a .tar path or an
  # Asterism::Credentials; it gives the default locator and node).
  # Raises Asterism::Disconnected when it cannot connect, Asterism::Error
  # when the same node/app is already there, ArgumentError for a bad name.
  # ```ruby
  # conn = Asterism.connect(
  #   "tcp/192.0.2.2:7447",
  #   node: "fmruby-aaa001", app: "demo")
  # ```
  def self.connect: (?String? locator, ?node: String?, app: String, ?mode: Symbol?, ?listen: String?, ?config: (Hash | String)?, ?connect_timeout: (Integer | Float)?, ?check_timeout: (Integer | Float)?, ?credentials: (String | Asterism::Credentials)?) -> Asterism::Connection

  # 開いている接続の一覧 <<en>> The connections of this program that are open
  #
  # 開いた順。切れたあと on_leave をまだ知らせていないものも入る。
  # ```ruby
  # n = Asterism.connections.size
  # ```
  # <<en>>
  # In the order they were opened; one that was lost but still has its
  # on_leave blocks to tell is included.
  # ```ruby
  # n = Asterism.connections.size
  # ```
  def self.connections: () -> Array[Asterism::Connection]

  # 全部の接続を poll する <<en>> Poll every connection of this program
  #
  # 1 つでもつながっていれば true。Link を使うなら Link#update が呼ぶ。
  # ```ruby
  # Asterism.poll_all
  # ```
  # <<en>>
  # True while one of them is connected. With a Link, Link#update polls.
  # ```ruby
  # Asterism.poll_all
  # ```
  def self.poll_all: () -> bool

  # このプログラムの端末の名乗りの既定 <<en>> The program's default profile for every node
  #
  # キーワードを渡すとその項目を変え (nil で外す。`icon: nil` は既定の
  # アイコンも使わない)、できた名乗りを返す。渡さなければ今の既定を返す。
  # 接続している端末には変更が流れる。端末ごとの上書きは Connection#profile。
  # 項目は `kind:` (Symbol か String)、`name:`・`host:` (String)、
  # `icon:` (PNG のバイト列)。受け付けないものは ArgumentError。
  # ```ruby
  # Asterism.profile_defaults(
  #   kind: :family_mruby, host: "sim")
  # ```
  # <<en>>
  # With keywords it changes those fields (nil removes one; `icon: nil`
  # does not use the default icon either) and returns the profile they make;
  # without, it returns the defaults. Connected nodes put the change on the
  # network. A node's own override is Connection#profile. Fields:
  # `kind:` (Symbol or String), `name:` and `host:` (Strings), `icon:`
  # (PNG bytes). ArgumentError for what it does not accept.
  # ```ruby
  # Asterism.profile_defaults(
  #   kind: :family_mruby, host: "sim")
  # ```
  def self.profile_defaults: (?kind: (Symbol | String)?, ?name: String?, ?host: String?, ?icon: String?) -> Hash

  # 既定のアイコンのファイル <<en>> Where the default icon is read from
  #
  # 端末では "/usr/share/asterism/icon.png"。誰もアイコンを指定しなければ
  # このファイルが使われる。
  # ```ruby
  # path = Asterism.default_icon_path
  # ```
  # <<en>>
  # "/usr/share/asterism/icon.png" on a machine. It is used when nobody
  # gave an icon.
  # ```ruby
  # path = Asterism.default_icon_path
  # ```
  def self.default_icon_path: () -> String?

  # 値に付いた添え物を読む <<en>> Read the attachment of a value: [seq, run id, time, from]
  #
  # att は値と一緒に来た添え物のバイト列。`[番号, 接続の番号, 送り手の時刻,
  # 送り手]` を返す。番号が無い (添え物が無い・形が違う) と nil。
  # 送り手は place が :node か :global (共有の場所) のときだけ入る。
  # 普通は subscribe が SampleInfo にしてくれる。
  # ```ruby
  # seq, run, ms, from =
  #   Asterism.read_attachment(att)
  # ```
  # <<en>>
  # att is the attachment bytes that came with a value. Returns `[seq,
  # run id, sender's time, sender]`; nil without a sequence number (no
  # attachment, or the wrong shape). The sender is filled only for a shared
  # place (place :node or :global). subscribe turns it into a SampleInfo for
  # you.
  # ```ruby
  # seq, run, ms, from =
  #   Asterism.read_attachment(att)
  # ```
  def self.read_attachment: (String? att, ?Symbol? place, ?String? node) -> Array[untyped]?

  # ネットワーク上のアプリ 1 つ分のつながり <<en>> One app's connection to the network
#
# link.conn で得る。
# <<en>>
# Got with link.conn.
  class Connection
    # オブジェクトを公開する <<en>> Expose an object to other machines
    #
    # name はオブジェクトの名前で、ほかの端末からは
    # "<この端末>/<アプリ>/<name>" で呼ばれる。
    # **methods: はキーワードで渡す**: 呼んでよいメソッドの名前と引数の数の Hash
    # ({ post: 1 }。数は呼ばれる前に確かめる、-1 は何個でも) か、
    # 名前の Array。並べたメソッドだけが呼べる。obj にそのメソッドが
    # 無いと ArgumentError。公開したメソッドは update の中で呼ばれる。
    # メソッドが例外を出すと、呼んだ側に RemoteError で届く。
    # `caller:` (省略すると渡さない) に :from のようなキーワード名を渡すと、
    # 呼ぶたびに呼んだ端末の名前がそのキーワードで公開メソッドに渡る。
    # `doc:` (省略すると無し) はオブジェクトの説明 (2048 バイトまで)。
    # 戻り値は公開した道 ("node/app/name")。link_up の中で呼ぶ。
    # ```ruby
    # def link_up(link)
    #   link.conn.expose("board", self,
    #     methods: { post: 1 })
    # end
    #
    # def post(text)
    #   @lines << text
    #   @lines.size
    # end
    # ```
    # <<en>>
    # Others call it as "<this node>/<app>/<name>".
    # **Pass methods: as a keyword**: a Hash of method name => number of arguments
    # ({ post: 1 }, checked before the call; -1 for any) or an Array of
    # names. Only those can be called; a missing one raises
    # ArgumentError. Exposed methods run inside update; what they raise
    # reaches the caller as a RemoteError. `caller:` (not given when left
    # out), a keyword name such as :from: every call passes the calling
    # node's ID to the method under that keyword. `doc:` (none when left
    # out) describes the object (2048 bytes at most). Returns the path.
    # Call it in link_up.
    # ```ruby
    # def link_up(link)
    #   link.conn.expose("board", self,
    #     methods: { post: 1 })
    # end
    # ```
    def expose: (String name, untyped obj, methods: (Array[untyped] | Hash[untyped, untyped]), ?caller: (Symbol | String)?, ?doc: String?) -> String

    # ほかの端末のオブジェクトを受け取る <<en>> A proxy for another machine's object
    #
    # path は "<端末>/<アプリ>/<オブジェクト>"。受け取っただけでは何も
    # 送らない。そのメソッドを呼ぶと相手で動き、答えを待つ (既定 2 秒。
    # **timeout: で秒を変えられる**。ミリ秒なら `timeout_ms:`)。待つ間も、こちらに来た呼び出しには
    # 答える。待たずに呼ぶなら async。
    # 失敗: 相手が例外を出した・公開していない・引数の数が違うと
    # Asterism::RemoteError、時間切れは Asterism::TimeoutError、
    # つながっていないと Asterism::Disconnected。どれも Asterism::Error。
    # ```ruby
    # b = @link.conn[
    #   "fmruby-1/talk_board/board"]
    # begin
    #   n = b.post("hello")
    # rescue ::Asterism::Error => e
    #   show(e.message)
    # end
    # ```
    # <<en>>
    # path is "<node>/<app>/<object>". Nothing is sent until a method is
    # called on it; the call runs there and waits for the answer (2 s;
    # **timeout: sets seconds**; `timeout_ms:` for milliseconds), answering calls to this app meanwhile.
    # Use async not to wait. Fails with Asterism::RemoteError (it raised,
    # is not exposed, wrong arguments), Asterism::TimeoutError, or
    # Asterism::Disconnected -- all Asterism::Error.
    # ```ruby
    # b = @link.conn[
    #   "fmruby-1/talk_board/board"]
    # n = b.post("hello")
    # ```
    def []: (String path, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Asterism::Proxy

    # 公開されているオブジェクトを探す <<en>> The exposed objects alive now matching a pattern
    #
    # pattern の * は 1 区切り、`**` は何区切りでも (省略すると全部)。この端末の物も入る。
    # 答えはオブジェクトの Array (受け取り方は conn[path] と同じ)。
    # ブロックを渡すと 1 つずつ渡し、数を返す。
    # ネットワークに問い合わせないので、毎回呼んでよい。
    # ```ruby
    # list = @link.conn.each(
    #   "*/talk_board/board")
    # @board = list[0]
    # ```
    # <<en>>
    # * is one chunk, `**` any number (everything when left out); this
    # machine's own are included. With a block it yields each and returns
    # the count. Returns an Array of proxies (like conn[path]). It does not ask the
    # network, so it is cheap to call every time.
    # ```ruby
    # list = @link.conn.each(
    #   "*/talk_board/board")
    # @board = list[0]
    # ```
    def each: (?String pattern) -> Array[Asterism::Proxy]
            | (?String pattern) { (Asterism::Proxy proxy) -> untyped } -> Integer

    # 今いる端末の名前 <<en>> The node IDs alive now (this one first)
    #
    # ```ruby
    # names = @link.conn.nodes
    # ```
    def nodes: () -> Array[String]

    # 今いるアプリ ("端末/アプリ") <<en>> The apps alive now ("node/app") matching a pattern
    #
    # ```ruby
    # list = @link.conn.apps("*/talk")
    # ```
    def apps: (?String pattern) -> Array[String]

    # この端末/アプリの道 <<en>> This app's path, "node/app"
    #
    # ```ruby
    # me = @link.conn.path
    # ```
    def path: () -> String

    # トピックを出す (値を流す口を作る) <<en>> Declare a topic to put values on
    #
    # name は "said" や "game/score" (区切りは /)。ほかの端末からは
    # "<この端末>/<アプリ>/<name>" で受ける。返った Topic の put で
    # 値を流す。キーワード (type:・unit:・desc:・ts:) は省ける。
    # 残らない (後から受け始めた側には前の値は届かない)。つながって
    # いないと Asterism::Disconnected。link_up の中で呼ぶ。
    # ```ruby
    # def link_up(link)
    #   @said = link.conn.publish("said")
    # end
    # # ...
    # @said.put({ "text" => "hi" })
    # ```
    # <<en>>
    # name is "said" or "game/score". Others subscribe to
    # "<this node>/<app>/<name>"; put on the returned Topic sends a
    # value. Keywords (type:, unit:, desc:, ts:) are optional. Values are
    # not kept for late readers. Raises Asterism::Disconnected when not
    # connected. Call it in link_up.
    # ```ruby
    # @said = link.conn.publish("said")
    # @said.put({ "text" => "hi" })
    # ```
    def publish: ((String | Symbol) name, ?type: (Symbol | Integer | String)?, ?unit: String?, ?desc: String?, ?ts: bool, ?encoding: String?, ?shared: (Symbol | String)?) -> Asterism::Topic

    # トピックを受ける (ブロックで) <<en>> Receive the values of topics (in a block)
    #
    # path は "<端末>/<アプリ>/<トピック>"。* は 1 区切り、`**` は何区切り
    # でも。値が来るたびに、**update の中で**ブロックが |値, info| で
    # 呼ばれる (info は Asterism::SampleInfo)。自分で put した値は
    # 自分には届かない。**depth: で溜める数を変えられる**。
    # 止めるには返った Subscription の close。link_up の中で呼ぶ。
    # ```ruby
    # def link_up(link)
    #   link.conn.subscribe(
    #     "*/talk_board/said") do |v, info|
    #     got(v, info.from)
    #   end
    # end
    # ```
    # <<en>>
    # path is "<node>/<app>/<topic>" (* one chunk, `**` any number). The
    # block gets |value, info| (an Asterism::SampleInfo)
    # **inside update**. Your own puts do not come back to you. **depth:** sets how
    # many wait between updates. close the returned Subscription to stop.
    # Call it in link_up.
    # ```ruby
    # link.conn.subscribe(
    #   "*/talk_board/said") do |v, info|
    #   got(v, info.from)
    # end
    # ```
    def subscribe: (String path, ?depth: Integer?) { (untyped value, Asterism::SampleInfo info) -> untyped } -> Asterism::Subscription

    # このアプリの状態を出す <<en>> Set this app's status (a small Hash others can read)
    #
    # Hash を渡すと全部を入れ替え、キーワードで渡すとその項目だけ
    # 変わる (nil で消える)。変わったときだけ流れる。1 KB まで。
    # 引数なしなら今の状態を返す (無ければ nil)。`status(lines: 3)` の
    # ようにキーワードで渡すと、その項目だけが変わる。
    # ```ruby
    # @link.conn.status(
    #   { "lines" => @lines.size })
    # ```
    # <<en>>
    # A Hash replaces it, keywords change those fields (nil removes one).
    # It goes out only when it changes; 1 KB at most. Without arguments,
    # returns it (nil when none). `status(lines: 3)` changes only that field.
    # ```ruby
    # @link.conn.status(
    #   { "lines" => @lines.size })
    # ```
    def status: (?Hash status, **untyped fields) -> Hash?

    # ほかのアプリの状態を読む <<en>> Another app's status (nil when it does not answer)
    #
    # 答えを待つ (既定 2 秒。`timeout:` は秒、`timeout_ms:` はミリ秒)。
    # つながっていないと Asterism::Disconnected。
    # ```ruby
    # st = @link.conn.status_of(
    #   "fmruby-1", "talk_board")
    # ```
    # <<en>>
    # Waits for the answer (2 s; `timeout:` in seconds, `timeout_ms:` in
    # milliseconds). Raises Asterism::Disconnected when not
    # connected.
    # ```ruby
    # st = @link.conn.status_of(
    #   "fmruby-1", "talk_board")
    # ```
    def status_of: (String node, String app, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Hash?

    # 端末が来たときに呼ぶブロック <<en>> Run a block when another machine joins
    #
    # ブロックは |端末の名前| で、update の中で呼ばれる。link_up の
    # 中で渡す (つなぎ直すと消えるため)。
    # ```ruby
    # link.conn.on_join { |n| joined(n) }
    # ```
    # <<en>>
    # The block gets |node| and runs inside update. Give it in link_up
    # (a new connection forgets it).
    # ```ruby
    # link.conn.on_join { |n| joined(n) }
    # ```
    def on_join: () { (String node) -> untyped } -> Asterism::Connection

    # 端末が去ったときに呼ぶブロック <<en>> Run a block when another machine leaves
    #
    # 切れたときは、知っていた端末が全部去る。
    # ```ruby
    # link.conn.on_leave { |n| left(n) }
    # ```
    # <<en>>
    # When the connection is lost, every machine known until then leaves.
    # ```ruby
    # link.conn.on_leave { |n| left(n) }
    # ```
    def on_leave: () { (String node) -> untyped } -> Asterism::Connection

    # 今答えている呼び出し (だれから) <<en>> The call being answered now: who called (nil outside)
    #
    # 公開したメソッドの中で、呼んだ端末の名前を知るのに使う。
    # ```ruby
    # def post(text)
    #   who = @link.conn.current_call.from
    #   add("#{who}: #{text}")
    # end
    # ```
    # <<en>>
    # Inside an exposed method, tells which machine called.
    # ```ruby
    # def post(text)
    #   who = @link.conn.current_call.from
    #   add("#{who}: #{text}")
    # end
    # ```
    def current_call: () -> Asterism::CurrentCall?

    # このアプリの名前 <<en>> This app's name on the network
    #
    # ```ruby
    # name = @link.conn.app
    # ```
    def app: () -> String

    # この端末の名前 (ノード ID) <<en>> This machine's node ID
    #
    # ```ruby
    # me = @link.conn.node_id
    # ```
    def node_id: () -> String

    # 今の接続の番号 <<en>> The run id of this connection (16 random bits)
    #
    # 接続するたびに変わる。トピックの値に付いて、受ける側が
    # 「送り手がつなぎ直した」と気づくのに使う (SampleInfo#restarted?)。
    # ```ruby
    # id = @link.conn.run_id
    # ```
    # <<en>>
    # A new one for every connect. It goes with each value of the
    # topics, so a reader notices that the sender connected again
    # (SampleInfo#restarted?).
    # ```ruby
    # id = @link.conn.run_id
    # ```
    def run_id: () -> Integer

    # つながっているか <<en>> Whether the connection is there
    #
    # つなぎ直しの途中 (reconnecting?) も true。セッションが閉じていると
    # 気づいたときは、その場で「切れた」ことにして false を返す。
    # ```ruby
    # return unless conn.connected?
    # ```
    # <<en>>
    # Also true while reconnecting. When it finds the session closed it
    # marks the connection lost on the spot and returns false.
    # ```ruby
    # return unless conn.connected?
    # ```
    def connected?: () -> bool

    # 切れたあと自動でつなぎ直している最中か <<en>> Whether the binding is reconnecting by itself
    #
    # true の間は connected? も true。ほかの端末は一度 leave し、戻ると
    # join し直す。呼び出しは Disconnected か時間切れ、put は誰にも届かない。
    # 戻ると、公開したオブジェクト・トピック・購読は元のまま使える。
    # ```ruby
    # if conn.reconnecting?
    #   show("reconnecting")
    # end
    # ```
    # <<en>>
    # While true, connected? is true too. The other nodes leave (on_leave)
    # and join again; calls raise Disconnected or time out and puts reach
    # nobody. Once it is back, what was exposed, published and subscribed
    # works as before.
    # ```ruby
    # if conn.reconnecting?
    #   show("reconnecting")
    # end
    # ```
    def reconnecting?: () -> bool

    # つながっていない理由 <<en>> Why the connection went away (nil while connected)
    #
    # ```ruby
    # why = @link.conn.lost_reason
    # ```
    def lost_reason: () -> String?

    # つながりを閉じる <<en>> Close the connection
    #
    # 公開・トピック・購読もいっしょに終わり、on_join などのブロックも
    # 忘れる。何度呼んでも構わない。閉じたものはもう開かない
    # (Asterism.connect で作り直す)。Link を使うなら Link#close でよい。
    # 戻り値は nil。
    # ```ruby
    # conn.close
    # ```
    # <<en>>
    # Everything exposed, published and subscribed ends with it, and the
    # on_join blocks are forgotten. Safe to call twice. A closed
    # connection is not opened again (make a new one with
    # Asterism.connect). With a Link, Link#close does this. Returns nil.
    # ```ruby
    # conn.close
    # ```
    def close: () -> nil

    # 毎回呼ぶ (答える・受ける・知らせる) <<en>> Poll: answer, receive, tell joins
    #
    # 届いた呼び出しに答え、on_join / on_leave のブロックと subscribe の
    # ブロックを呼ぶ。つなぎ直しの待ちの中からは呼ばれない。閉じたら false。
    # **Link を使うなら Link#update が呼ぶので、自分では呼ばない**。
    # Asterism.poll_all はプログラムの全部の接続を呼ぶ。
    # ```ruby
    # conn = Asterism.connect(r, app: "x")
    # conn.poll
    # ```
    # <<en>>
    # Answers the calls that came in and runs the on_join / on_leave and
    # subscribe blocks (never from inside the polling of a waiting call).
    # False once closed. **With a Link, Link#update calls it; do not call it yourself.**
    # Asterism.poll_all polls every connection.
    # ```ruby
    # conn = Asterism.connect(r, app: "x")
    # conn.poll
    # ```
    def poll: () -> bool

    # Zenoh のセッション <<en>> The Zenoh session, for what Asterism does not do
    #
    # ROS 2 の Node (`Asterism::ROS::Node.new(conn.session, ...)`) や
    # put・subscribe を直接使うとき用。セッションは接続のもので、
    # そこから close しても何も起きない (1 回だけ警告)。閉じるのは
    # Connection#close。つながっていないと Asterism::Disconnected。
    # ```ruby
    # s = @link.conn.session
    # node = Asterism::ROS::Node.new(s, "n")
    # ```
    # <<en>>
    # For a ROS 2 Node (`Asterism::ROS::Node.new(conn.session, ...)`) or
    # put and subscribe by hand. The session belongs to the connection: its
    # close does nothing (it warns once); Connection#close closes it.
    # Raises Asterism::Disconnected when not connected.
    # ```ruby
    # s = @link.conn.session
    # node = Asterism::ROS::Node.new(s, "n")
    # ```
    def session: () -> untyped

    # 公開しているオブジェクトの名前 <<en>> Names of the objects exposed now
    #
    # ```ruby
    # names = @link.conn.exposed
    # ```
    def exposed: () -> Array[String]

    # 公開をやめる <<en>> Stop exposing an object
    #
    # 公開していたら true、無ければ false。
    # ```ruby
    # @link.conn.unexpose("board")
    # ```
    # <<en>>
    # True when it was exposed, false when it was not.
    # ```ruby
    # @link.conn.unexpose("board")
    # ```
    def unexpose: ((String | Symbol) name) -> bool

    # 出しているトピックの名前 <<en>> The topics published now (their entries)
    #
    # 自分のトピックは名前、共有のものは "<端末>/@shared/<名前>" か
    # "@shared/<名前>"。
    # ```ruby
    # list = @link.conn.published
    # ```
    # <<en>>
    # Own topics by name; shared ones as "<node>/@shared/<name>" or
    # "@shared/<name>".
    # ```ruby
    # list = @link.conn.published
    # ```
    def published: () -> Array[String]

    # トピックをやめる <<en>> Withdraw a topic
    #
    # Topic か、publish に渡した名前 (共有なら同じ `shared:` も) を渡す。
    # 宣言が消える。やめたら true、無いものは false。
    # 同じ名前でまた publish すると番号は続きから。
    # ```ruby
    # @link.conn.unpublish("said")
    # ```
    # <<en>>
    # Pass the Topic, or its name with the `shared:` it was published with.
    # Its declaration goes. True when there was one. Publishing the name
    # again goes on from the same numbers.
    # ```ruby
    # @link.conn.unpublish("said")
    # ```
    def unpublish: ((Asterism::Topic | String | Symbol) topic, ?shared: (Symbol | String)?) -> bool

    # 受けるのをやめる <<en>> End a subscription
    #
    # Subscription#close と同じ。受けていたら true。
    # ```ruby
    # @link.conn.unsubscribe(@sub)
    # ```
    # <<en>>
    # The same as Subscription#close. True when it was open.
    # ```ruby
    # @link.conn.unsubscribe(@sub)
    # ```
    def unsubscribe: (Asterism::Subscription sub) -> bool

    # on_join で渡したブロックを外す <<en>> Remove a block given to on_join
    #
    # 渡したときの Proc を取っておき、同じものを渡す。
    # ```ruby
    # h = proc { |n| joined(n) }
    # conn.on_join(&h)
    # conn.off_join(h)
    # ```
    # <<en>>
    # Keep the Proc you gave and pass it again.
    # ```ruby
    # h = proc { |n| joined(n) }
    # conn.on_join(&h)
    # conn.off_join(h)
    # ```
    def off_join: (Proc blk) -> Asterism::Connection

    # on_leave で渡したブロックを外す <<en>> Remove a block given to on_leave
    #
    # ```ruby
    # conn.off_leave(h)
    # ```
    def off_leave: (Proc blk) -> Asterism::Connection

    # アプリが来たときに呼ぶブロック <<en>> Run a block when another machine's app appears
    #
    # ブロックは |端末の名前, アプリの名前| で、update の中で呼ばれる。
    # 1 つの端末が複数のアプリを動かしていても、アプリごとに来る・去る。
    # 切れたときは、知っていたアプリが全部去る。link_up の中で渡す。
    # ```ruby
    # conn.on_app_join do |n, a|
    #   seen(n, a)
    # end
    # ```
    # <<en>>
    # The block gets |node, app| and runs inside update. A node may run
    # several apps; each comes and goes on its own. When the connection is
    # lost, every app known until then leaves. Give it in link_up.
    # ```ruby
    # conn.on_app_join do |n, a|
    #   seen(n, a)
    # end
    # ```
    def on_app_join: () { (String node, String app) -> untyped } -> Asterism::Connection

    # アプリが去ったときに呼ぶブロック <<en>> Run a block when another machine's app leaves
    #
    # ```ruby
    # conn.on_app_leave do |n, a|
    #   gone(n, a)
    # end
    # ```
    def on_app_leave: () { (String node, String app) -> untyped } -> Asterism::Connection

    # on_app_join のブロックを外す <<en>> Remove a block given to on_app_join
    #
    # ```ruby
    # conn.off_app_join(h)
    # ```
    def off_app_join: (Proc blk) -> Asterism::Connection

    # on_app_leave のブロックを外す <<en>> Remove a block given to on_app_leave
    #
    # ```ruby
    # conn.off_app_leave(h)
    # ```
    def off_app_leave: (Proc blk) -> Asterism::Connection

    # この端末の名乗り (種類・名前・アイコン) <<en>> This node's profile (kind, name, host, icon)
    #
    # キーワードを渡すとその項目を変えて、全体を返す。渡さなければ今のものを
    # 返す。`kind:` (Symbol か String。nil で既定へ戻す)、`name:`・`host:`
    # (String。nil で外す)、`icon:` (PNG のバイト列。nil でアイコン無し)。
    # 受け付けないものは ArgumentError。名乗りは端末のもので、同じ端末の
    # ほかの接続にも効く。変えると流れる。
    # ```ruby
    # conn.profile(name: "Rover")
    # ```
    # <<en>>
    # With keywords it changes those fields and returns the profile;
    # without, it returns the profile. `kind:` (Symbol or String; nil goes
    # back to the default), `name:` and `host:` (Strings; nil leaves them
    # out), `icon:` (PNG bytes; nil for no icon). ArgumentError for what it
    # does not accept. The profile belongs to the node, so other
    # connections of the same node share it. A change is put on the network.
    # ```ruby
    # conn.profile(name: "Rover")
    # ```
    def profile: (?kind: (Symbol | String)?, ?name: String?, ?host: String?, ?icon: String?) -> Hash

    # ほかの端末の名乗りを読む <<en>> Another node's profile (nil when it does not answer)
    #
    # 答えを待つ (既定 2 秒。`timeout:` は秒、`timeout_ms:` はミリ秒)。
    # `icon: false` でアイコンのバイト列を省く (icon_hash は付く)。
    # つながっていないと Asterism::Disconnected。自分の端末は問い合わせない。
    # ```ruby
    # p = @link.conn.profile_of(node)
    # name = p["name"] if p
    # ```
    # <<en>>
    # Waits for the answer (2 s; `timeout:` in seconds, `timeout_ms:` in
    # milliseconds). `icon: false` leaves out the icon bytes (icon_hash
    # still says which one). Raises Asterism::Disconnected when not
    # connected. Its own node is not asked over the network.
    # ```ruby
    # p = @link.conn.profile_of(node)
    # name = p["name"] if p
    # ```
    def profile_of: (String node, ?icon: bool, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Hash?

    # 端末やアプリが話す通信の版 <<en>> The protocol version a node or app speaks
    #
    # "端末/アプリ" を渡すとそのアプリの版 (まだ見えていなければ nil)。
    # 端末だけなら、そのアプリの版の一番低いもの。アプリが見えない端末は名乗りに
    # 聞く (答えなければ nil、版が書いてなければ 0)。自分の版は
    # Asterism::PROTOCOL。
    # ```ruby
    # v = conn.protocol_of("n/app")
    # ```
    # <<en>>
    # "node/app" gives that app's version (nil while it is not seen); a
    # node alone gives the lowest of its apps', or asks its profile when
    # no app is known (nil without an answer, 0 when it says none). This
    # program speaks Asterism::PROTOCOL.
    # ```ruby
    # v = conn.protocol_of("n/app")
    # ```
    def protocol_of: (String node, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Integer?

    # 自分の型を決める <<en>> Define an application type for topic values
    #
    # name は "mygame/board.strokes" のような名前。fields は
    # `[[名前, 型], ...]` で、型は名前 (組み込みの "vector3"、基本の "int"
    # "float" "str" "bin" "bool" "any"、別の自分の型。末尾に "[]" で配列)。
    # 値は欄の名前をキーにした Hash で、名前は短いほど値が小さい。
    # `desc:` (省略すると無し) は説明。同じ名前は置き換わる。つながりが
    # 閉じても残る。送った定義 ({"f" => ..., "d" => ...}) を返す。
    # 数を型にしたり不正な欄だと ArgumentError。publish の `type:` に名前を渡す。
    # ```ruby
    # conn.define_type("g/pt",
    #   [["x", "int"], ["y", "int"]])
    # ```
    # <<en>>
    # name is like "mygame/board.strokes". fields is `[[name, type], ...]`;
    # a type is a name: built in ("vector3"), basic ("int", "float",
    # "str", "bin", "bool", "any") or another of your types, "[]" at the
    # end for an array. Values are Hashes keyed by the field names (short
    # names keep them small). `desc:` (none when left out) is a text.
    # Defining a name again replaces it; the types outlive close. Returns
    # the definition as sent ({"f" => ..., "d" => ...}). ArgumentError for
    # a number as a type or a bad field. Pass the name as publish's `type:`.
    # ```ruby
    # conn.define_type("g/pt",
    #   [["x", "int"], ["y", "int"]])
    # ```
    def define_type: ((String | Symbol) name, Array[Array[untyped]] fields, ?desc: String?) -> Hash

    # ほかのアプリのトピックを読む <<en>> Another app's topics (nil if no answer)
    #
    # `{トピック名 => {"t" => 型, "u" => 単位, ...}}`。何も出していなければ {}、
    # 答えが無ければ nil。status_of と同じ待ち方 (既定 2 秒、`timeout:`
    # は秒、`timeout_ms:` はミリ秒)。つながっていないと Asterism::Disconnected。
    # ```ruby
    # t = @link.conn.pubs_of("n", "app")
    # ```
    # <<en>>
    # `{topic => {"t" => type, "u" => unit, ...}}`; {} when it has none, nil
    # without an answer. Waits like status_of (2 s; `timeout:` in seconds,
    # `timeout_ms:` in milliseconds). Raises Asterism::Disconnected when
    # not connected.
    # ```ruby
    # t = @link.conn.pubs_of("n", "app")
    # ```
    def pubs_of: (String node, String app, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Hash?

    # ほかのアプリの自分の型を読む <<en>> Another app's own types (nil when it does not answer)
    #
    # `{型の名前 => {"f" => [[欄, 型], ...], "d" => 説明}}`。無ければ {}、
    # 答えが無ければ nil。待ち方は pubs_of と同じ。
    # ```ruby
    # t = @link.conn.types_of("n", "app")
    # ```
    # <<en>>
    # `{type name => {"f" => [[field, type], ...], "d" => text}}`; {} when it
    # has none, nil without an answer. Waits like pubs_of.
    # ```ruby
    # t = @link.conn.types_of("n", "app")
    # ```
    def types_of: (String node, String app, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Hash?

    # 共有の場所に値を出しているアプリを探す <<en>> The apps that publish on a shared key
    #
    # path は "@shared/<名前>" か "<端末>/@shared/<名前>" (端末は * も可)。
    # `{"端末/アプリ" => 宣言}` を返す (自分も入る)。誰もいなければ {}。
    # 全アプリの名乗りに一度に問い合わせて `timeout:` (秒、既定 2 秒) まで
    # 待つ (`timeout_ms:` はミリ秒)。共有の道でなければ ArgumentError、
    # つながっていないと Asterism::Disconnected。
    # ```ruby
    # who = conn.publishers_of(
    #   "@shared/lobby")
    # ```
    # <<en>>
    # path is "@shared/<name>" or "<node>/@shared/<name>" (node may be *).
    # Returns `{"node/app" => declaration}` (this app's own included), {}
    # when nobody publishes it. Asks every app's profile at once and waits
    # up to `timeout:` seconds (2 by default; `timeout_ms:` in
    # milliseconds). ArgumentError for a path that is not a shared key;
    # Asterism::Disconnected when not connected.
    # ```ruby
    # who = conn.publishers_of(
    #   "@shared/lobby")
    # ```
    def publishers_of: (String path, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Hash

    # 受けた値の送り手の宣言を読む <<en>> The sender's declaration of the topic a value came on
    #
    # info は subscribe のブロックの SampleInfo。送り手の @pubs の、その
    # キーの項目 (`{"t", "e", "u", "d", "ts"}`) を返す。共有の場所では送り手ごとに
    # 宣言が違うので、送り手 (info.from) に問い合わせる。送り手が分からない・
    # 答えない・宣言していなければ nil。初回だけ待ち (既定 2 秒)、答えは覚える。
    # ```ruby
    # d = conn.declaration_of(info)
    # ```
    # <<en>>
    # info is the SampleInfo a subscribe block gets. Returns the sender's
    # entry for that key in its @pubs (`{"t", "e", "u", "d", "ts"}`). On a
    # shared key every sender declares it its own way, so it asks the
    # sender (info.from). nil when the sender is unknown, does not answer
    # or does not declare the key. Waits the first time (2 s), then keeps
    # the answer.
    # ```ruby
    # d = conn.declaration_of(info)
    # ```
    def declaration_of: (Asterism::SampleInfo info, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> Hash?

    # 受けた値の型を、送り手の宣言から読む <<en>> The type of a value, as its sender declared it
    #
    # 組み込みの型なら番号 (Integer)、自分の型なら `[名前, 定義]` (定義は送り手の
    # 自分の型の表から。無ければ nil)。型が無い・送り手が答えない場合は nil。
    # 待ち方と覚え方は declaration_of と同じ。
    # ```ruby
    # t = conn.type_of(info)
    # ```
    # <<en>>
    # A built-in type's number (Integer), or `[name, definition]` for the
    # sender's own type (the definition from its own types; nil when it
    # does not tell). nil when there is no type or the sender does not
    # answer. Waits and keeps the answer as declaration_of does.
    # ```ruby
    # t = conn.type_of(info)
    # ```
    def type_of: (Asterism::SampleInfo info, ?timeout: (Integer | Float)?, ?timeout_ms: Integer?) -> (Integer | Array[untyped])?
  end

  # ほかの端末のオブジェクトの代わり <<en>> Stand-in for an object on another machine
  #
  # conn[path] の答え。公開されたメソッドを、そのまま普通のメソッドのように呼ぶ
  # (`board.post("hi")`)。呼ぶと答えを待つ。
  # <<en>>
  # What conn[path] answers. Call the published methods like ordinary
  # methods (`board.post("hi")`). A call waits for the answer.
  class Proxy
    # 待たずに呼ぶ形にする <<en>> The same object, with calls that do not wait
    #
    # メソッドを呼ぶと、すぐに Asterism::Future が返る。update のたびに
    # done? を見て、true になったら value で答えを取る。
    # ```ruby
    # @call = @board.async.post("hi")
    # # on_update:
    # if @call && @call.done?
    #   n = @call.value
    #   @call = nil
    # end
    # ```
    # <<en>>
    # Each call returns an Asterism::Future at once. Look at done? in
    # every update and take value once it is true.
    # ```ruby
    # @call = @board.async.post("hi")
    # # on_update:
    # if @call && @call.done?
    #   n = @call.value
    #   @call = nil
    # end
    # ```
    def async: () -> Asterism::AsyncProxy

    # 名前でメソッドを呼ぶ <<en>> Call a remote method by its name
    #
    # 普通は `board.post("hi")` と書けばよい。名前が Ruby で書けない
    # ときや、class・display など Object が持つ名前のときに使う。
    # ```ruby
    # v = board.asterism_call("post", "hi")
    # ```
    # <<en>>
    # Normally just write `board.post("hi")`. For names Ruby cannot write
    # or that Object already has (class, display, ...).
    # ```ruby
    # v = board.asterism_call("post", "hi")
    # ```
    def asterism_call: ((String | Symbol) name, *untyped args, **untyped kw) -> untyped

    # 相手の道 <<en>> The path, "node/app/object"
    #
    # ```ruby
    # node = px.asterism_path.split("/")[0]
    # ```
    def asterism_path: () -> String

    # 相手が公開しているメソッドの名前 <<en>> The exposed methods (asks the other machine once)
    #
    # 答えを待つ。答えが無ければ Asterism::Error。
    # ```ruby
    # names = board.remote_methods
    # ```
    # <<en>>
    # Waits for the answer; raises Asterism::Error without one.
    # ```ruby
    # names = board.remote_methods
    # ```
    def remote_methods: () -> Array[Symbol]

    # 呼び出しが出ていく接続 <<en>> The connection the calls go out on
    #
    # ```ruby
    # c = board.asterism_connection
    # ```
    def asterism_connection: () -> Asterism::Connection

    # 相手が答えるメソッドの表 <<en>> The meta of the object (asked once, then kept)
    #
    # `{"methods" => [{"name" => ..., "arity" => ...}, ...]}`。初回は相手に
    # 問い合わせて待つ。答えが無ければ Asterism::TimeoutError か
    # Asterism::RemoteError ("no_object")、切れていれば Asterism::Disconnected。
    # ```ruby
    # m = board.asterism_meta
    # ```
    # <<en>>
    # `{"methods" => [{"name" => ..., "arity" => ...}, ...]}`. The first
    # call asks the other machine and waits. Raises Asterism::TimeoutError
    # or Asterism::RemoteError ("no_object") without an answer,
    # Asterism::Disconnected when closed.
    # ```ruby
    # m = board.asterism_meta
    # ```
    def asterism_meta: () -> Hash

    # 覚えている表を捨てる <<en>> Forget the kept meta (the object may be exposed again)
    #
    # 次に asterism_meta や remote_methods を呼ぶと問い合わせ直す。自分を返す。
    # ```ruby
    # board.asterism_refresh
    # ```
    # <<en>>
    # The next asterism_meta or remote_methods asks again. Returns itself.
    # ```ruby
    # board.asterism_refresh
    # ```
    def asterism_refresh: () -> Asterism::Proxy
  end

  # 待たずに呼ぶ形 <<en>> The no-wait form of a proxy
#
# Proxy#async の答え。メソッドを呼ぶと Future が返る。
# <<en>>
# What Proxy#async answers. Calling a method gives back a Future.
  class AsyncProxy
    # 名前で呼んで、すぐ Future を受け取る <<en>> Call a remote method by name, a Future at once
    #
    # ```ruby
    # f = board.async.asterism_call(
    #   "post", "hi")
    # ```
    def asterism_call: ((String | Symbol) name, *untyped args, **untyped kw) -> Asterism::Future
  end

  # 待たずに呼んだ呼び出しの答え <<en>> The answer of a no-wait call
#
# これから届く。
# <<en>>
# It arrives later.
  class Future
    # 答えが来たか (待たない) <<en>> Whether the answer came, or the time ran out (never waits)
    #
    # 時間切れ・切れたときも true になる (value が例外を出す)。
    # ```ruby
    # if @call.done?
    #   take(@call.value)
    # end
    # ```
    # <<en>>
    # Also true once the time ran out or the connection closed (value
    # raises then).
    # ```ruby
    # if @call.done?
    #   take(@call.value)
    # end
    # ```
    def done?: () -> bool

    # 答えの値 <<en>> The answer (raises what the call failed with)
    #
    # done? の前に呼ぶと待つ。相手が例外を出したら
    # Asterism::RemoteError、時間切れは Asterism::TimeoutError。
    # ```ruby
    # begin
    #   n = @call.value
    # rescue ::Asterism::Error => e
    #   show(e.message)
    # end
    # ```
    # <<en>>
    # Waits when called before done?. Raises Asterism::RemoteError (it
    # raised there) or Asterism::TimeoutError.
    # ```ruby
    # begin
    #   n = @call.value
    # rescue ::Asterism::Error => e
    #   show(e.message)
    # end
    # ```
    def value: () -> untyped

    # 答えまでの時間 (ms) <<en>> Milliseconds from the call to its answer (nil until done)
    #
    # ```ruby
    # ms = @call.took_ms
    # ```
    def took_ms: () -> Integer?

    # 呼んだ道 <<en>> The object's path, "node/app/object"
    #
    # ```ruby
    # p = @call.path
    # ```
    def path: () -> String

    # 呼んだメソッドの名前 <<en>> The name of the method that was called
    #
    # ```ruby
    # m = @call.method_name
    # ```
    def method_name: () -> String

    # 答えまでの時間 (秒) <<en>> Seconds from the call to its answer (nil until done)
    #
    # ```ruby
    # s = @call.took
    # ```
    def took: () -> Float?

    # 答えをそのまま読む <<en>> The decoded answer as it is
    #
    # {"value" => ...} か {"error" => ...} の Hash のまま返す。value と同じに
    # 待ち、時間切れは Asterism::TimeoutError、切れたら Asterism::Disconnected、
    # 読めない答えは Asterism::Error。普通は value を使う。
    # ```ruby
    # raw = @call.raw_value
    # ```
    # <<en>>
    # The answer as the Hash it came in ({"value" => ...} or
    # {"error" => ...}). Waits like value; Asterism::TimeoutError on a time
    # out, Asterism::Disconnected when closed, Asterism::Error for an
    # unreadable answer. Normally use value.
    # ```ruby
    # raw = @call.raw_value
    # ```
    def raw_value: () -> untyped
  end

  # 出したトピック <<en>> A topic being published
#
# conn.publish の答え。
# <<en>>
# What conn.publish answers.
  class Topic
    # 値を流す <<en>> Send a value to the subscribers
    #
    # 送れるのは nil・true・false・数・文字列・Symbol・Array・Hash だけ
    # (ほかは Asterism::EncodeError)。受けている側全部に届く。
    # 閉じた・切れたトピックは Asterism::Disconnected。
    # ```ruby
    # @said.put({ "from" => who,
    #             "text" => text })
    # ```
    # <<en>>
    # Only nil, true, false, numbers, Strings, Symbols, Arrays and
    # Hashes (others raise Asterism::EncodeError). Every subscriber gets
    # it. A closed topic or a lost connection raises
    # Asterism::Disconnected.
    # ```ruby
    # @said.put({ "from" => who,
    #             "text" => text })
    # ```
    def put: (untyped value) -> void

    # トピックの名前 <<en>> The topic's name
    #
    # ```ruby
    # n = @said.name
    # ```
    def name: () -> String

    # トピックをやめる <<en>> Withdraw the topic
    #
    # ```ruby
    # @said.close
    # ```
    def close: () -> bool

    # トピックが閉じているか <<en>> Whether the topic is withdrawn
    #
    # ```ruby
    # return if @said.closed?
    # ```
    def closed?: () -> bool

    # このトピックを出した接続 <<en>> The connection that published it
    #
    # ```ruby
    # c = @said.connection
    # ```
    def connection: () -> Asterism::Connection

    # 流している道 <<en>> The whole key values go on ("asterism/<node>/<app>/<name>")
    #
    # ```ruby
    # k = @said.key
    # ```
    def key: () -> String

    # 宣言の項目名 <<en>> Its name in the declarations (the shared ones differ)
    #
    # 自分のトピックは name と同じ。共有なら "<端末>/@shared/<名前>" か
    # "@shared/<名前>"。published が返すのはこれ。
    # ```ruby
    # e = @said.entry
    # ```
    # <<en>>
    # Same as name for an own topic; "<node>/@shared/<name>" or
    # "@shared/<name>" for a shared one. published returns these.
    # ```ruby
    # e = @said.entry
    # ```
    def entry: () -> String

    # 共有の場所か <<en>> Which shared place it is on (nil: the app's own)
    #
    # nil は自分の道、:node は端末の @shared、:global はネットワークの @shared。
    # ```ruby
    # s = @said.shared
    # ```
    # <<en>>
    # nil is the app's own key, :node the node's @shared, :global the
    # network's @shared.
    # ```ruby
    # s = @said.shared
    # ```
    def shared: () -> (:node | :global)?

    # 値と一緒に送った符号化 <<en>> The Zenoh encoding of the values (nil: MessagePack)
    #
    # publish の `encoding:` に渡したもの ("image/jpeg" など)。
    # ```ruby
    # e = @cam.encoding
    # ```
    # <<en>>
    # What publish's `encoding:` was given ("image/jpeg", ...).
    # ```ruby
    # e = @cam.encoding
    # ```
    def encoding: () -> String?

    # 次に送る値の番号 <<en>> The sequence number the next put sends
    #
    # 0 から始まり、2147483647 の次は 0 に戻る。
    # ```ruby
    # n = @said.seq
    # ```
    # <<en>>
    # Starts at 0 and goes back to 0 after 2147483647.
    # ```ruby
    # n = @said.seq
    # ```
    def seq: () -> Integer

    # 送り手の時刻も付けるか <<en>> Whether each value carries the sender's time
    #
    # publish の `ts: true` のとき true。
    # ```ruby
    # t = @said.ts?
    # ```
    # <<en>>
    # True when publish got `ts: true`.
    # ```ruby
    # t = @said.ts?
    # ```
    def ts?: () -> bool

    # 送った宣言 <<en>> The declaration as sent
    #
    # `{"t" => 型, "u" => 単位, "d" => 説明, "e" => 符号化の番号, "ts" => true}`
    # のうち、指定した項目だけ。コピーを返す。
    # ```ruby
    # d = @said.declaration
    # ```
    # <<en>>
    # The fields that were given out of `{"t" => type, "u" => unit,
    # "d" => text, "e" => encoding number, "ts" => true}`. A copy.
    # ```ruby
    # d = @said.declaration
    # ```
    def declaration: () -> Hash
  end

  # 受けているトピック <<en>> A topic being subscribed to
#
# conn.subscribe の答え。
# <<en>>
# What conn.subscribe answers.
  class Subscription
    # 受けるのをやめる <<en>> Stop receiving
    #
    # ```ruby
    # @sub.close
    # ```
    def close: () -> bool

    # やめたか <<en>> Whether it is closed
    #
    # ```ruby
    # @sub.closed?
    # ```
    def closed?: () -> bool

    # これまでに受けた数 <<en>> How many values came so far
    #
    # ```ruby
    # n = @sub.received
    # ```
    def received: () -> Integer

    # 受けている道 <<en>> The path it receives ("<node>/<app>/<topic>")
    #
    # ```ruby
    # p = @sub.path
    # ```
    def path: () -> String

    # この購読の接続 <<en>> The connection it belongs to
    #
    # ```ruby
    # c = @sub.connection
    # ```
    def connection: () -> Asterism::Connection

    # 取りこぼした数 <<en>> Values the queue had no room for
    #
    # 次の update までに溜められる数 (`depth:`) を超えて、捨てた数。
    # ```ruby
    # warn_gap if @sub.dropped > 0
    # ```
    # <<en>>
    # Values dropped because more than `depth:` came between two updates.
    # ```ruby
    # warn_gap if @sub.dropped > 0
    # ```
    def dropped: () -> Integer

    # 読めなかった値の数 <<en>> Values left out because they were not MessagePack
    #
    # ```ruby
    # bad = @sub.malformed
    # ```
    # <<en>>
    # Values left out: no encoding, and not one MessagePack value.
    # ```ruby
    # bad = @sub.malformed
    # ```
    def malformed: () -> Integer
  end

  # 受けた値に付いてくる情報 <<en>> Information that comes with a received value
#
# subscribe のブロックの 2 つ目。
# <<en>>
# The second argument of the subscribe block.
  class SampleInfo
    # 送った端末/アプリ <<en>> The sender, "node/app"
    #
    # ```ruby
    # do |v, info|
    #   who = info.from
    # end
    # ```
    def from: () -> String?

    # 送った端末の名前 <<en>> The sender's node ID
    #
    # ```ruby
    # n = info.node
    # ```
    def node: () -> String?

    # 送ったアプリの名前 <<en>> The sender's app name
    #
    # ```ruby
    # a = info.app
    # ```
    def app: () -> String?

    # トピックの名前 <<en>> The topic's name
    #
    # ```ruby
    # t = info.name
    # ```
    def name: () -> String

    # 前の値から取りこぼした数 <<en>> How many values were missed before this one
    #
    # ```ruby
    # warn_gap if info.lost > 0
    # ```
    def lost: () -> Integer

    # 送った側の番号 <<en>> The sender's sequence number
    #
    # ```ruby
    # s = info.seq
    # ```
    def seq: () -> Integer?

    # 値が届いた道 <<en>> The whole key it came on
    #
    # ```ruby
    # k = info.key
    # ```
    def key: () -> String

    # 値が届いた道 (asterism/ の下) <<en>> The key below asterism/ ("<node>/<app>/<name>")
    #
    # ```ruby
    # p = info.path
    # ```
    def path: () -> String

    # 共有の場所か <<en>> Which shared place (nil: an app's own topic)
    #
    # ```ruby
    # sh = info.shared
    # ```
    def shared: () -> (:node | :global)?

    # 送り手の接続の番号 <<en>> The sender's run id (nil when it came without one)
    #
    # 送り手がつなぎ直すと変わる。
    # ```ruby
    # r = info.run_id
    # ```
    # <<en>>
    # It changes when the sender connects again.
    # ```ruby
    # r = info.run_id
    # ```
    def run_id: () -> Integer?

    # 送り手の時刻 <<en>> The sender's time in ms since 1970 (nil unless ts: true)
    #
    # ```ruby
    # t = info.time
    # ```
    def time: () -> Integer?

    # ルータが付けた時刻 <<en>> The router's timestamp (nil when none)
    #
    # 型は Asterism::Zenoh::Timestamp。
    # ```ruby
    # ts = info.timestamp
    # ```
    # <<en>>
    # An Asterism::Zenoh::Timestamp.
    # ```ruby
    # ts = info.timestamp
    # ```
    def timestamp: () -> untyped

    # 値の符号化 <<en>> "msgpack", or the Zenoh encoding ("image/jpeg")
    #
    # "msgpack" なら値は復号した Ruby の値、それ以外はバイト列 (String)。
    # ```ruby
    # if info.encoding == "image/jpeg"
    #   img = v
    # end
    # ```
    # <<en>>
    # With "msgpack" the value is the decoded Ruby value; otherwise it is the
    # bytes (a String).
    # ```ruby
    # if info.encoding == "image/jpeg"
    #   img = v
    # end
    # ```
    def encoding: () -> String

    # 送り手が新しく始めたか <<en>> Whether the sender started a new run
    #
    # 接続し直した (接続の番号が変わった) か、同じ接続で番号が戻ったとき true。
    # 接続し直したときの lost は 0。「今の値」を問い合わせ直す合図に使う。
    # ```ruby
    # ask_again if info.restarted?
    # ```
    # <<en>>
    # True when the sender connected again (its run id changed; lost is 0
    # then) or its numbers went back on the same run. Use it as the cue to ask for the
    # current value again.
    # ```ruby
    # ask_again if info.restarted?
    # ```
    def restarted?: () -> bool

    # 全部の項目の Hash <<en>> All the fields as a Hash
    #
    # `key`・`path`・`shared`・`from`・`node`・`app`・`name`・`seq`・`run_id`・
    # `time`・`encoding`・`timestamp`・`lost`・`restarted` を Symbol のキーで返す。
    # ```ruby
    # puts info.to_h
    # ```
    # <<en>>
    # The fields key, path, shared, from, node, app, name, seq, run_id,
    # time, encoding, timestamp, lost and restarted, with Symbol keys.
    # ```ruby
    # puts info.to_h
    # ```
    def to_h: () -> Hash
  end

  # 今答えている呼び出し <<en>> The call being answered now
#
# conn.current_call の答え。
# <<en>>
# What conn.current_call answers.
  class CurrentCall
    # 呼んだ端末の名前 <<en>> The calling machine's node ID
    #
    # ```ruby
    # who = @link.conn.current_call.from
    # ```
    def from: () -> String

    # 呼ばれたオブジェクトの名前 <<en>> The exposed object's name
    #
    # ```ruby
    # o = call.object
    # ```
    def object: () -> String

    # 呼ばれたメソッドの名前 <<en>> The method's name
    #
    # ```ruby
    # m = call.method
    # ```
    def method: () -> String

    # 呼んだ人を確かめた程度 <<en>> How far the caller's name is checked
    #
    # :claimed は呼んだ側が自分で名乗った名前 (名前を確かにするのは
    # ルータのアクセス制御)。:local は同じアプリの中からの呼び出し。
    # ```ruby
    # trust = conn.current_call.verified
    # ```
    # <<en>>
    # :claimed is the name the caller gave itself (the router's access
    # control is what makes it binding). :local is a call from this same
    # app.
    # ```ruby
    # trust = conn.current_call.verified
    # ```
    def verified: () -> (:claimed | :local)
  end

  # やり取りの失敗の元 <<en>> Parent of every Asterism failure
#
# rescue ::Asterism::Error で全部受かる。
# <<en>>
# `rescue ::Asterism::Error` catches them all.
  class Error
    # 失敗の説明 <<en>> What went wrong
    #
    # ```ruby
    # rescue ::Asterism::Error => e
    #   show(e.message)
    # ```
    def message: () -> String
  end

  # 相手のメソッドが例外を出した・呼べなかった <<en>> Remote method failed or raised
  class RemoteError < Asterism::Error
    # 相手の例外のクラスの名前 <<en>> The class name of the error over there
    #
    # ```ruby
    # rescue ::Asterism::RemoteError => e
    #   show(e.remote_class)
    # ```
    def remote_class: () -> String

    # 相手の例外の文 <<en>> The error's message over there
    #
    # ```ruby
    # show(e.remote_message)
    # ```
    def remote_message: () -> String

    # 何が起きたか <<en>> What happened ("raised", "not_exposed", "arguments", ...)
    #
    # "raised" は相手のメソッドが例外を出した。"not_exposed" は公開して
    # いないメソッド、"no_object" はオブジェクトが無い、"arguments" は
    # 引数の数が違う、"unsendable" は送れない値を返した。
    # ```ruby
    # if e.remote_kind == "not_exposed"
    #   show("呼べません")
    # end
    # ```
    # <<en>>
    # "raised": the method raised. "not_exposed": not an exposed method.
    # "no_object": no such object. "arguments": wrong number of
    # arguments. "unsendable": it returned a value that cannot travel.
    # ```ruby
    # if e.remote_kind == "not_exposed"
    #   show("not callable")
    # end
    # ```
    def remote_kind: () -> String?

    # 作る <<en>> Make one (the answers of the other machine are turned into these)
    #
    # ```ruby
    # e = Asterism::RemoteError.new(
    #   "NameError", "x", "no_object")
    # ```
    def self.new: (String remote_class, String remote_message, ?String? remote_kind) -> Asterism::RemoteError
  end

  # 時間内に答えが来なかった <<en>> No answer came in time
#
# 相手がいない・遅い。
# <<en>>
# The other side is absent or slow.
  class TimeoutError < Asterism::Error
  end

  # つながっていない・切れた <<en>> Not connected, or the link dropped
  class Disconnected < Asterism::Error
  end

  # 送れない値を送ろうとした <<en>> A value that cannot be sent was sent
#
# 送る前に止まる。
# <<en>>
# It stops before anything is sent.
  class EncodeError < Asterism::Error
  end

  # コンソールが渡す証明書一式 (.tar) <<en>> The credentials .tar a console hands out
  #
  # Asterism のコンソールが証明書を出すときに渡す .tar (秘密鍵・証明書・
  # CA・asterism.json) を読んだもの。TLS のルータにつなぐときに
  # `Asterism.connect(credentials: ...)` へ渡すと、証明書が Zenoh に渡り、
  # ルータの場所と端末の名前の既定も入っている値から取られる。
  # 端末では FmrbAsterism.credentials_for と FmrbAsterism.settings.credentials
  # が読んだものを返すので、アプリが自分で読むことはあまり無い。
  # 読めない・形が違うときは Asterism::Credentials::Error。
  # <<en>>
  # The .tar an Asterism console hands out with a certificate (private
  # key, certificate, CA, asterism.json), read. Pass it to
  # `Asterism.connect(credentials: ...)` for a TLS router: the certificates
  # go to Zenoh and the router and node ID default to what it holds. On a
  # machine FmrbAsterism.credentials_for and FmrbAsterism.settings.credentials
  # return one already read, so an app rarely reads it itself. A file that
  # cannot be read or has the wrong shape raises Asterism::Credentials::Error.
  class Credentials
    # 証明書の .tar を読めない・形が違う <<en>> The file is missing something or holds it wrong
    class Error < Asterism::Error
    end

    # .tar を読む <<en>> Read a credentials .tar
    #
    # path の .tar を読む。1 MB を超えるものは読まない。`warn:` (省略すると true)
    # は、CRuby で鍵のファイルを他人が読めるかの注意を出すかで、端末では
    # 意味が無い。読めない・鍵や証明書が無い・鍵が 2 つある、のとき
    # Asterism::Credentials::Error。
    # ```ruby
    # c = Asterism::Credentials.load(
    #   "/home/asterism/n.tar")
    # ```
    # <<en>>
    # Reads the .tar at path (nothing over 1 MB). `warn:` (true when left
    # out) is the check of who may read the key file on CRuby; it does
    # nothing on a machine. Raises Asterism::Credentials::Error when it
    # cannot be read, has no key or certificate, or has two keys.
    # ```ruby
    # c = Asterism::Credentials.load(
    #   "/home/asterism/n.tar")
    # ```
    def self.load: (String path, ?warn: bool) -> Asterism::Credentials

    # .tar を読む (load と同じ) <<en>> Read a credentials .tar (same as load)
    #
    # ```ruby
    # c = Asterism::Credentials.new(
    #   "/home/asterism/n.tar")
    # ```
    def self.new: (String path, ?warn: bool) -> Asterism::Credentials

    # .tar のパス <<en>> The path it was read from
    #
    # ```ruby
    # p = creds.path
    # ```
    def path: () -> String

    # 端末の名前 (証明書の名前) <<en>> The node name the certificate is for
    #
    # ルータのアクセス制御はこの名前で端末を知る。接続の node: の既定になる。
    # ```ruby
    # me = creds.name
    # ```
    # <<en>>
    # The router's access control knows the machine by this name. It is the
    # default node: of a connection.
    # ```ruby
    # me = creds.name
    # ```
    def name: () -> String

    # 証明書の種類 <<en>> The kind asterism.json says (nil when it says none)
    #
    # ```ruby
    # k = creds.kind
    # ```
    def kind: () -> String?

    # ルータの場所 <<en>> The router's locator in asterism.json (nil when none)
    #
    # "tls/ホスト:ポート" の形。接続の locator の既定になる。
    # ```ruby
    # r = creds.router
    # ```
    # <<en>>
    # Shaped "tls/host:port". It is the default locator of a connection.
    # ```ruby
    # r = creds.router
    # ```
    def router: () -> String?

    # 証明書の期限 <<en>> The expiry asterism.json says (nil when none)
    #
    # asterism.json に書かれた文字列のまま。
    # ```ruby
    # s = creds.not_after
    # ```
    # <<en>>
    # The string as asterism.json has it.
    # ```ruby
    # s = creds.not_after
    # ```
    def not_after: () -> String?

    # 秘密鍵 (PEM) <<en>> The private key (PEM text)
    #
    # 人に見せたりログに出したりしない。
    # ```ruby
    # pem = creds.key_pem
    # ```
    # <<en>>
    # Never show it or log it.
    # ```ruby
    # pem = creds.key_pem
    # ```
    def key_pem: () -> String

    # 証明書 (PEM) <<en>> The certificate (PEM text)
    #
    # ```ruby
    # pem = creds.cert_pem
    # ```
    def cert_pem: () -> String

    # CA の証明書 (PEM) <<en>> The CA certificate (PEM text)
    #
    # ```ruby
    # pem = creds.ca_pem
    # ```
    def ca_pem: () -> String

    # asterism.json の内容 <<en>> What asterism.json says (a Hash; {} without it)
    #
    # name・kind・router・not_after などの文字列。
    # ```ruby
    # n = creds.info["name"]
    # ```
    # <<en>>
    # Strings such as name, kind, router and not_after.
    # ```ruby
    # n = creds.info["name"]
    # ```
    def info: () -> Hash

    # Zenoh に渡す TLS の設定 <<en>> The Zenoh configuration keys for mutual TLS
    #
    # CA・証明書・鍵を base64 にして、`transport/link/tls/...` のキーと
    # enable_mtls を入れた Hash。Asterism.connect が `credentials:` から
    # 自分で使うので、普通は呼ばない。
    # ```ruby
    # cfg = creds.zenoh_config
    # ```
    # <<en>>
    # A Hash with the CA, certificate and key as base64 under
    # `transport/link/tls/...` and enable_mtls. Asterism.connect uses it
    # from `credentials:`, so you rarely call it.
    # ```ruby
    # cfg = creds.zenoh_config
    # ```
    def zenoh_config: () -> Hash
  end

  # トピックの値の型の名前と番号 <<en>> Names and numbers of the built-in value types
  #
  # publish の `type:` に渡す組み込みの型。番号か Symbol (:vector3) で書く。
  # 自分の型は文字列で、Connection#define_type で決める。
  module Types
    # 数 (Float か Integer) <<en>> A number (Float or Integer)
    NUMBER: Integer
    # [x, y, z] <<en>> [x, y, z]
    VECTOR3: Integer
    # [x, y, z, qx, qy, qz, qw] (ROS 2 の Pose の順) <<en>> [x, y, z, qx, qy, qz, qw] (ROS 2's Pose order)
    POSE: Integer
    # 画像 (符号化に従ったバイト列) <<en>> An image (bytes in the topic's encoding)
    IMAGE: Integer
    # 状態 (String か Integer) <<en>> A state (a String or an Integer)
    STATE: Integer
    # ログの 1 件 (level・msg・time) <<en>> A log record (level, msg, time)
    LOG: Integer
    # 文字列 <<en>> A String
    TEXT: Integer

    # 組み込みの型の番号 <<en>> The number of a built-in type from its name (nil if none)
    #
    # ```ruby
    # Asterism::Types.number(:vector3)  #=> 2
    # ```
    def self.number: ((Symbol | String) name) -> Integer?

    # 受けた型の表を整える <<en>> Clean a received map of type definitions
    #
    # 名前が String で、"f" が `[[欄, 型], ...]` の定義だけを残す (壊れた
    # ものは落とす)。Hash でなければ nil。types_of の答えはこれを通ってくる。
    # ```ruby
    # t = Asterism::Types.check(raw)
    # ```
    # <<en>>
    # Keeps the definitions with a String name and an "f" that is an Array
    # of `[field, type]` pairs, and drops the broken ones. nil when it is
    # not a Hash. The answer of types_of went through it.
    # ```ruby
    # t = Asterism::Types.check(raw)
    # ```
    def self.check: (untyped h) -> Hash?
  end

  # トピックの宣言 (@pubs) の決まり <<en>> Rules for the topic declarations (@pubs)
  #
  # 出しているトピックの宣言を ({"名前" => {"t", "e", "u", "d", "ts"}}) 送る
  # ときの決まりと、符号化の番号表。pubs_of や publishers_of の答えの形を知る
  # ときに読む。
  module Pubs
    # 符号化の名前の番号 <<en>> The fixed number of a Zenoh encoding (nil when none)
    #
    # "image/jpeg" や "text/plain;charset=utf-8" (; から後は無視)。
    # ```ruby
    # Asterism::Pubs.encoding_id(
    #   "image/jpeg")  #=> 17
    # ```
    # <<en>>
    # "image/jpeg" or "text/plain;charset=utf-8" (what follows ";" is
    # ignored).
    # ```ruby
    # Asterism::Pubs.encoding_id(
    #   "image/jpeg")  #=> 17
    # ```
    def self.encoding_id: (String name) -> Integer?

    # 番号から符号化の名前 <<en>> The encoding name of a number (nil when none)
    #
    # ```ruby
    # Asterism::Pubs.encoding_name(17)
    # #=> "image/jpeg"
    # ```
    def self.encoding_name: (Integer id) -> String?

    # 宣言の項目から出す先を分ける <<en>> Split a declaration entry into [shared, node, name]
    #
    # 自分のトピックは `[nil, nil, 名前]`、"<端末>/@shared/<名前>" は
    # `[:node, 端末, 名前]`、"@shared/<名前>" は `[:global, nil, 名前]`。
    # 名前として使えない形なら nil。
    # ```ruby
    # Asterism::Pubs.place("@shared/lobby")
    # #=> [:global, nil, "lobby"]
    # ```
    # <<en>>
    # An own topic gives `[nil, nil, name]`, "<node>/@shared/<name>" gives
    # `[:node, node, name]`, "@shared/<name>" gives `[:global, nil, name]`.
    # nil for a form that is not a name.
    # ```ruby
    # Asterism::Pubs.place("@shared/lobby")
    # #=> [:global, nil, "lobby"]
    # ```
    def self.place: (String entry) -> Array[untyped]?

    # 宣言の項目を作る <<en>> The declaration entry of a topic
    #
    # `shared` は nil・:node・:global。nil なら name のまま、:node なら
    # "<node>/@shared/<name>"、:global なら "@shared/<name>"。
    # ```ruby
    # Asterism::Pubs.entry(
    #   :global, "n", "lobby")
    # #=> "@shared/lobby"
    # ```
    # <<en>>
    # `shared` is nil, :node or :global: name as it is, "<node>/@shared/<name>"
    # or "@shared/<name>".
    # ```ruby
    # Asterism::Pubs.entry(
    #   :global, "n", "lobby")
    # #=> "@shared/lobby"
    # ```
    def self.entry: (Symbol? shared, String node, String name) -> String

    # 宣言の項目から道を作る <<en>> The key below asterism/ a declared entry puts values on
    #
    # `path("n", "app", "imu")` は "n/app/imu"、共有はその項目がそのまま
    # (端末は項目の中)。項目が正しくなければ nil。
    # ```ruby
    # Asterism::Pubs.path("n", "app", "imu")
    # #=> "n/app/imu"
    # ```
    # <<en>>
    # `path("n", "app", "imu")` is "n/app/imu"; a shared entry is the key
    # itself. nil when the entry is not valid.
    # ```ruby
    # Asterism::Pubs.path("n", "app", "imu")
    # #=> "n/app/imu"
    # ```
    def self.path: (String node, String app, String entry) -> String?

    # 受けた宣言の表を整える <<en>> Clean a received map of declarations
    #
    # 項目名として正しく、宣言が Hash のものを残し、"t"・"e"・"u"・"d"・"ts" の
    # 正しいものだけを入れる。node (宣言を出した端末) を渡すと、ほかの
    # 端末の共有の項目は落とす。Hash でなければ nil。pubs_of の答えはこれを
    # 通ってくる。
    # ```ruby
    # d = Asterism::Pubs.check(raw, "n")
    # ```
    # <<en>>
    # Keeps entries with a valid name and a Hash declaration, with only the
    # valid "t", "e", "u", "d" and "ts". With node (the node that declared
    # them), another node's shared entries are dropped. nil when it is not
    # a Hash. The answer of pubs_of went through it.
    # ```ruby
    # d = Asterism::Pubs.check(raw, "n")
    # ```
    def self.check: (untyped h, ?String? node) -> Hash?

    # @pubs への put を読む <<en>> Read a put on asterism/<node>/<app>/@pubs
    #
    # key と payload (購読した側が受けるまま) から `[端末, アプリ, 宣言]` を返す。
    # そうでなければ nil。
    # ```ruby
    # n, a, d = Asterism::Pubs.parse(k, b)
    # ```
    # <<en>>
    # Returns `[node, app, declarations]` from the key and payload as a
    # subscriber gets them; nil when it is not one.
    # ```ruby
    # n, a, d = Asterism::Pubs.parse(k, b)
    # ```
    def self.parse: (String key, String payload) -> Array[untyped]?
  end

  # 受けた値の番号の記憶 <<en>> A reader's memory of the sequence numbers
  #
  # 送り手ごと・道ごとに、最後の接続の番号と値の番号を覚えて、取りこぼし
  # (lost) と送り手のやり直し (restarted) を数える。Subscription が 1 つずつ
  # 持っていて、SampleInfo の lost・restarted はこれが決める。自分で
  # 値を受けるときに使う (普通のアプリは subscribe だけでよい)。
  class Sequences
    # 作る <<en>> Make one remembering up to max lanes
    #
    # `max` (省略すると端末は 64、PC は 4096) を超えると、一番古く見た道を
    # 忘れる (その次の値は最初のものとして数える)。
    # ```ruby
    # seqs = Asterism::Sequences.new(16)
    # ```
    # <<en>>
    # `max` (64 on a machine, 4096 on a PC when left out). Past it the lane
    # seen longest ago is forgotten (its next value counts as a first one).
    # ```ruby
    # seqs = Asterism::Sequences.new(16)
    # ```
    def self.new: (?Integer? max) -> Asterism::Sequences

    # 値を 1 つ見る <<en>> See one value: [lost, restarted]
    #
    # lane は道 (共有の道は送り手も含めた文字列)、run は送り手の接続の
    # 番号 (nil なら番号なし)、seq は値の番号、app は送り手の
    # "端末/アプリ" (分からなければ nil)。`[取りこぼした数, 送り手がやり直したか]` を
    # 返す。道を初めて見るときは [0, false]。
    # ```ruby
    # lost, again =
    #   seqs.see("k", 7, 1, "n/a")
    # ```
    # <<en>>
    # lane is the key (for a shared key, with the sender), run the sender's
    # run id (nil: none), seq the value's number, app the sender's
    # "node/app" (nil when unknown). Returns `[values missed, whether the
    # sender restarted]`; the first sight of a lane is [0, false].
    # ```ruby
    # lost, again =
    #   seqs.see("k", 7, 1, "n/a")
    # ```
    def see: (String lane, Integer? run, Integer seq, ?String? app) -> Array[untyped]

    # あるアプリの記憶を忘れる <<en>> Forget the lanes of an app that left
    #
    # 忘れた道の数を返す。
    # ```ruby
    # n = seqs.forget("n/app")
    # ```
    # <<en>>
    # Returns how many lanes it forgot.
    # ```ruby
    # n = seqs.forget("n/app")
    # ```
    def forget: (String app) -> Integer

    # 覚えている道の数 <<en>> How many lanes are remembered now
    #
    # ```ruby
    # n = seqs.size
    # ```
    def size: () -> Integer

    # 全部忘れる <<en>> Forget everything
    #
    # 自分を返す。
    # ```ruby
    # seqs.clear
    # ```
    # <<en>>
    # Returns itself.
    # ```ruby
    # seqs.clear
    # ```
    def clear: () -> Asterism::Sequences
  end

  # アプリの状態の決まり <<en>> Rules for an app's status
  #
  # Connection#status が扱う状態 (小さな Hash) の大きさの上限と、受けた状態を
  # 整える関数。status_of の答えの形を知るときに読む。
  module Status
    # 状態を詰めた大きさの上限 (バイト) <<en>> The most bytes the packed status may take
    MAX_BYTES: Integer
    # 入れ子の深さの上限 <<en>> The most levels of arrays and maps below the status
    MAX_DEPTH: Integer

    # 受けた状態を整える <<en>> Clean a received status
    #
    # 空でない String のキーだけを残す。Hash でない、または詰めると
    # MAX_BYTES を超えるときは nil。status_of の答えはこれを通ってくる。
    # ```ruby
    # st = Asterism::Status.check(raw)
    # ```
    # <<en>>
    # Keeps the entries with a non-empty String key. nil when it is not a
    # Hash or packs into more than MAX_BYTES. The answer of status_of went
    # through it.
    # ```ruby
    # st = Asterism::Status.check(raw)
    # ```
    def self.check: (untyped h) -> Hash?

    # @status への put を読む <<en>> Read a put on asterism/<node>/<app>/@status
    #
    # key と payload (購読した側が受けるまま) から `[端末, アプリ, 状態]` を返す。
    # そうでなければ nil。
    # ```ruby
    # n, a, st = Asterism::Status.parse(k, b)
    # ```
    # <<en>>
    # Returns `[node, app, status]` from the key and payload as a
    # subscriber gets them; nil when it is not one.
    # ```ruby
    # n, a, st = Asterism::Status.parse(k, b)
    # ```
    def self.parse: (String key, String payload) -> Array[untyped]?
  end

  # 端末の名乗り (Profile) <<en>> A node's profile: kind, name, host, icon
  #
  # 端末が自分で言う種類・名前・場所・アイコンの決まりと、PNG のアイコンを
  # 調べる関数。名乗りを変えるのは Connection#profile と Asterism.profile_defaults。
  module Profile
    # PNG のアイコンを調べる <<en>> Check a PNG icon: [width, height, icon_hash] (nil if not acceptable)
    #
    # 名乗りに載せてよい PNG か見る: 8 バイトの印、8192 バイトまで、チャンクが
    # IHDR から IEND まで続くこと、一辺 256 画素まで。よければ
    # `[幅, 高さ, icon_hash]` (icon_hash は 8 桁の 16 進)、だめなら nil。
    # ```ruby
    # w, h, hash =
    #   Asterism::Profile.png_info(png)
    # ```
    # <<en>>
    # Checks a PNG a profile may carry: the 8-byte signature, 8192 bytes at
    # most, chunks running from IHDR to IEND, each side 256 pixels at most.
    # Returns `[width, height, icon_hash]` (8 hex digits), or nil.
    # ```ruby
    # w, h, hash =
    #   Asterism::Profile.png_info(png)
    # ```
    def self.png_info: (untyped bytes) -> Array[untyped]?

    # 受けた名乗りを整える <<en>> Clean a received profile
    #
    # 正しい項目 (kind・protocol・host・name・icon・icon_hash) だけを残す。
    # kind が正しくなければ nil。壊れたアイコンは hash ごと落ちる。
    # profile_of の答えはこれを通ってくる。
    # ```ruby
    # p = Asterism::Profile.check(raw)
    # ```
    # <<en>>
    # Keeps the valid fields (kind, protocol, host, name, icon, icon_hash).
    # nil when kind is not valid. A broken icon goes with its hash. The
    # answer of profile_of went through it.
    # ```ruby
    # p = Asterism::Profile.check(raw)
    # ```
    def self.check: (untyped h) -> Hash?
  end

  # 接続のセッションに付くモジュール <<en>> Extended onto each connection's session
  #
  # connection.session に付いて、接続以外からの close を無視させる。
  # アプリが直接使うことはない。
  module SharedSession
    # 接続以外からの close は何もしない <<en>> A close from anyone but the connection does nothing
    #
    # 1 回だけ警告を出して nil を返す。閉じるのは Connection#close。
    # ```ruby
    # conn.session.close  # does nothing
    # ```
    # <<en>>
    # Warns once and returns nil. Connection#close is what closes it.
    # ```ruby
    # conn.session.close  # does nothing
    # ```
    def close: () -> nil
  end
end
