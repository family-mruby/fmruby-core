# アプリの土台。実装は lib/add/picoruby-fmrb-app/mrblib/fmrb-app.rb と
# ports/esp32/app.c、Spinel 版は main/prebuild_scripts/spinel/
# fmrb_app_base_spinel.rb。
#
# 省略可能引数とキーワード引数は型推論エンジンが扱えないので、よく使う
# 呼び方を必須引数だけの形にして書いてある (sig/README.md)。

class FmrbApp
  # 絵を描く画面
  @gfx: FmrbGfx

  # 絵を描く画面 <<en>> The canvas to draw on
  #
  # (0, 0) はアプリが描いてよい区画 (user area) の左上。枠のある Window
  # では枠の内側、枠なし・全画面では Window の左上。マウスの ev[:x] も同じ。
  # ```ruby
  # gfx.fill_rect(0, 0, 10, 10,
  #               theme_fg)
  # gfx.present
  # ```
  # <<en>>
  # (0, 0) is the top-left of the area the app owns (the user area): inside
  # the frame of a framed window, the window's top-left when it has no frame
  # or is fullscreen. A mouse event's ev[:x] is in the same place.
  # ```ruby
  # gfx.fill_rect(0, 0, 10, 10,
  #               theme_fg)
  # gfx.present
  # ```
  def gfx: () -> FmrbGfx

  # Window 全体に描く画面 (枠の上も) <<en>> Draws on the whole window, frame too
  #
  # 原点が Window の左上の、もう 1 つの描き手。枠を自分で描く、区画の外に
  # 自分のタイトルを出す、などのときに使う。文字の書体は canvas で共通
  # なので、set_font は gfx の方で呼ぶ。
  # ```ruby
  # window_gfx.fill_rect(0, 0,
  #   window_width, 11, theme_accent)
  # ```
  # <<en>>
  # A second drawer whose origin is the window's top-left: for drawing
  # outside the area, such as a frame or a title of the app's own. The font
  # belongs to the canvas, so call set_font on gfx.
  # ```ruby
  # window_gfx.fill_rect(0, 0,
  #   window_width, 11, theme_accent)
  # ```
  def window_gfx: () -> FmrbGfx

  # ---- 名前や大きさ ----

  # アプリの名前 <<en>> The app's name
  #
  # ```ruby
  # Log.info("#{name} started")
  # ```
  def name: () -> String

  # 動いている最中かどうか <<en>> Whether it is still running
  #
  # ```ruby
  # stop unless running
  # ```
  def running: () -> bool

  # Window の横幅 (ドット) <<en>> Window width in pixels
  #
  # Window の外枠まで含めた幅。中に描ける範囲は `@user_area_width` の方。
  # ```ruby
  # w = window_width
  # ```
  # <<en>>
  # The window including its border. What can be drawn in is
  # `@user_area_width`.
  # ```ruby
  # w = window_width
  # ```
  def window_width: () -> Integer

  # Window の高さ (ドット) <<en>> Window height in pixels
  #
  # ```ruby
  # h = window_height
  # ```
  def window_height: () -> Integer

  # Window の左上の位置 <<en>> Left edge of the window
  #
  # ```ruby
  # x = pos_x
  # ```
  def pos_x: () -> Integer

  # Window の左上の位置 <<en>> Top edge of the window
  #
  # ```ruby
  # y = pos_y
  # ```
  def pos_y: () -> Integer

  # 動いている機械の種類 <<en>> Which machine this is
  #
  # `:esp32` か `:linux` (Symbol) を返す。ブラウザ版も `:linux` なので、
  # ブラウザを見分けるなら `FmrbConst::BOARD == "wasm"`。別の端末へ移った
  # アプリでは、移った先の値になる。
  # ```ruby
  # if platform == :esp32
  # ```
  # <<en>>
  # Either `:esp32` or `:linux` (a Symbol). The browser build says `:linux`
  # too; tell it apart with `FmrbConst::BOARD == "wasm"`. In an app moved to
  # another machine it is the machine where it now runs.
  # ```ruby
  # if platform == :esp32
  # ```
  def platform: () -> Symbol

  # 全画面かどうか <<en>> Whether it fills the screen
  #
  # ```ruby
  # draw_window_frame unless fullscreen
  # ```
  def fullscreen: () -> bool

  # Window の角が丸いかどうか <<en>> Whether the corners are rounded
  #
  # ```ruby
  # r = rounded_corners ? 6 : 0
  # ```
  def rounded_corners: () -> bool

  # 閉じるボタンで終われるか <<en>> Whether the close button ends it
  #
  # ```ruby
  # show_close_button if closable
  # ```
  def closable: () -> bool

  # 枠なしの Window か (window_frame = "none") <<en>> Whether the window has no frame
  #
  # 枠・タイトルバー・閉じるボタンが無く、user area は Window 全体、地は透ける色。
  # <<en>>
  # No frame, title bar or close button: the user area is the whole window and
  # its ground is the colour key (.app.toml window_frame = "none").
  # ```ruby
  # bg = frameless? ? nil : theme_bg
  # ```
  def frameless?: () -> bool

  # ---- 呼ばれるところ (書きかえて使う) ----

  # 始まるときに一度だけ呼ばれる <<en>> Called once as it starts
  #
  # 画面も Window もここで使える状態になっています。最初の絵と、あとで使う変数を
  # ここで用意します。
  #
  # ファイルにはクラスを書くだけです。末尾に起動のコードは要りません:
  # ファイルを読み終えると、そのクラスが作られて `start` されます。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @n = 0
  #     clear_user_area
  #     gfx.present
  #   end
  # end
  # ```
  # <<en>>
  # The screen and the window are ready by the time this runs. Set up the
  # first frame and whatever state the app will keep.
  #
  # A file only defines the class; it needs no starting code at the end.
  # Once the file has been read, the class is made and started.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @n = 0
  #     clear_user_area
  #     gfx.present
  #   end
  # end
  # ```
  def on_create: () -> void

  # 毎フレーム呼ばれる。描画を書く場所 <<en>> called every frame; draw here
  #
  # アプリが動いているあいだ、くり返し呼ばれます。ここに 1 フレーム分の
  # 描画を書きます。動きは、呼ばれるたびに位置を少しずつ変えて作ります。
  #
  # 中で止まると他のアプリまで止まるので、**ここで長く待たない**こと。
  # 時間をおきたいときは `set_timer` を使います。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @x = 0
  #   end
  #
  #   def on_update
  #     @x = (@x + 1) % window_width
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.fill_circle(@x, 60, 8,
  #                     FmrbGfx::YELLOW)
  #     gfx.present
  #   end
  # end
  # ```
  # <<en>>
  # Called over and over while the app runs. Draw one frame's worth of graphics
  # here; movement comes from changing the position a little on each call.
  #
  # Blocking in here blocks the other apps too, so **never wait long in this
  # method**. Use `set_timer` when something has to happen later.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @x = 0
  #   end
  #
  #   def on_update
  #     @x = (@x + 1) % window_width
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.fill_circle(@x, 60, 8,
  #                     FmrbGfx::YELLOW)
  #     gfx.present
  #   end
  # end
  # ```
  def on_update: () -> void

  # 終わるときに一度だけ呼ばれる <<en>> Called once as it ends
  #
  # 終わる直前に一度だけ呼ばれます。開いたファイルを閉じる、保存する、と
  # いった後始末をここに書きます。
  #
  # 呼ばれるのは**行儀よく終わったとき**だけです。例外で落ちたアプリはここに
  # 来ません。消えて困るものは、終わりを待たずに書き出しておくこと。
  # <<en>>
  # Called once, just before the app ends: close files, save what should be
  # saved.
  #
  # It runs only on an orderly exit. An app that dies on an exception never
  # gets here, so anything that must not be lost should be written out
  # before then.
  def on_destroy: () -> void

  # 他のアプリに画面を渡すとき <<en>> Called when the screen goes to another app
  #
  # 別のアプリが前に出たときに呼ばれます。アプリは動いたままで、画面だけが
  # 見えなくなります。**描いても誰も見ていない**ので、重い描画や音を
  # 止めるならここです。
  # <<en>>
  # Called when another app comes to the front. This app keeps running; only
  # its screen goes away. Nobody is looking at what it draws, so this is
  # where to stop an expensive animation or a sound.
  def on_suspend: () -> void

  # 画面が戻ってきたとき <<en>> Called when the screen comes back
  #
  # 画面が戻ってきたときに呼ばれます。**画面の中身は残っていません** —
  # ここで描き直します。
  # <<en>>
  # Called when this app gets the screen back. What was on it is gone;
  # redraw here.
  def on_resume: () -> void

  # イメージに書かれた直後 <<en>> Called once the app is written to an image
  #
  # アプリがイメージに書かれ、閉じる直前に呼ばれます。アプリは**終わったの
  # ではなく移った**ので `on_destroy` は来ません。ここでしたことは
  # イメージに入りません。運べるのは `.app.toml` に `movable = true` と
  # 書いた、mruby で動くアプリだけです (doc/checkpoint/movable_apps.md)。
  # <<en>>
  # Called once the image is written, just before the app closes. The app
  # moved rather than ended, so `on_destroy` does not come. What is done here
  # is not in the image. Only an app on mruby whose `.app.toml` says
  # `movable = true` can be written (doc/checkpoint/movable_apps.md).
  def on_checkpoint: () -> void

  # イメージから起動したとき <<en>> Called when started from an image
  #
  # イメージから起動したアプリで、**書かれた所から続ける直前**に呼ばれます。
  # インスタンス変数も Task もタイマもそのまま戻っています。Window (同じ場所・
  # 大きさ・枠、フォント、`GfxBlock`) と `subscribe` した知らせは基底クラスが
  # 戻してあり、キーボードはこのアプリに来ます。**描いた絵は戻りません**:
  # Window は枠だけの空の状態なので、何かあったときだけ描くアプリはここで描き
  # 直します (`on_update` で毎回全部描くアプリは何もしなくてよい)。
  # スプライトや画像など、アプリが自分で外に作ったものもここで作り直します。
  # ファイルを開いたままのアプリはイメージに書けません。
  # 画面の大きさが違う端末 (Retro と Modern) へ移ると、Window が画面に収まるよう
  # 縮められたり、全画面の大きさが変わったりします。そのときは
  # `on_restore` の前に `on_resize` が来ます (大きさを変えたときと同じ)。
  # 移った先のビルドには、すべての端末に共通でないメソッドが無いことが
  # あります。`respond_to?` で確認するか `rescue NoMethodError` で受けて
  # ください (端末の違いはアプリの小さな窓口のオブジェクトに集め、そこで
  # `respond_to?` か `method_missing` で吸収するのがおすすめ。`Array` など
  # 組み込みのクラスに `method_missing` を足すのはおすすめしません)。
  # 着いた側は足りない名前をログと答えで教えますが、断りません。無いと
  # 続けられないメソッドは `.app.toml` に `requires = ["名前"]` と書くと、
  # それが無いビルドへは移りません。詳しくは doc/checkpoint/movable_apps.md。
  # <<en>>
  # Called in an app started from an image, just before it goes on from where
  # it was written. Its instance variables, Tasks and timers are back as they
  # were. The base has made its window again (the same place, size and frame,
  # its fonts and `GfxBlock`s) and subscribed to its topics again, and the
  # keyboard comes to it. **What was drawn does not come back**: the window
  # is an empty frame, so an app that draws only when something happens
  # draws here (one that draws everything in `on_update` need not). Make
  # again here what the app itself made outside the VM (sprites, images). An
  # app holding a file open cannot be written to an image.
  # Moved to a machine with another screen (Retro and Modern), the window may
  # be made smaller to fit it, or a fullscreen app gets that screen's size:
  # `on_resize` then comes before `on_restore`, as after a resize.
  # The build it moved to may lack a method not common to every machine:
  # check with `respond_to?` or rescue NoMethodError (gather the differences
  # in a small object of the app's own and absorb them there with
  # `respond_to?` or `method_missing`; adding `method_missing` to a built-in
  # class such as `Array` is not recommended). The arriving side tells the
  # names it lacks in its log and its answer, and does not refuse. A method
  # the app cannot go on without goes in its `.app.toml` as
  # `requires = ["name"]`: it is not moved to a build without it.
  # See doc/checkpoint/movable_apps.md.
  def on_restore: () -> void

  # 自分のイメージを断られたとき <<en>> Called when its own image is refused
  #
  # `checkpoint` で頼んだイメージが書けなかったときに、理由を持って
  # 呼ばれます。アプリはそのまま動き続けます。
  # <<en>>
  # Called with the reason when the image asked for with
  # `checkpoint` could not be written. The app goes on.
  def on_checkpoint_refused: (String reason) -> void

  # キーやマウスの入力が来たとき <<en>> called on key and mouse input
  #
  # ev は入力の中身が入った Hash です。よく使うのは次の 4 つ:
  #
  # - `ev[:type]` … `:key_down` `:mouse_up` など、何が起きたか
  # - `ev[:scancode]` … 押されたキーの番号。**文字ではなくこちらで見ます**
  #   (かな入力のときも同じ番号が届くため)
  # - `ev[:x]` `ev[:y]` … マウスの位置 (gfx と同じ、区画の左上が 0。
  #   Window の左上からの位置は `ev[:wx]` `ev[:wy]`)
  #
  # Ctrl や Shift が押されていたかは `ev_ctrl?(ev)` などで調べます。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_event(ev)
  #     return unless
  #       ev[:type] == :key_down
  #     case ev[:scancode]
  #     when 0x4F then @x += 4  # 右
  #     when 0x50 then @x -= 4  # 左
  #     end
  #   end
  # end
  # ```
  # <<en>>
  # ev is a Hash describing the input. Four fields cover most uses:
  #
  # - `ev[:type]` -- what happened: `:key_down`, `:mouse_up` and so on
  # - `ev[:scancode]` -- the key's number. **Look at this, not the character**
  #   (kana input delivers the same numbers)
  # - `ev[:x]` `ev[:y]` -- where the mouse is (from the area's top-left,
  #   as gfx draws; from the window's: `ev[:wx]` `ev[:wy]`)
  #
  # Use `ev_ctrl?(ev)` and friends to see whether Ctrl or Shift was held.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_event(ev)
  #     return unless
  #       ev[:type] == :key_down
  #     case ev[:scancode]
  #     when 0x4F then @x += 4  # right
  #     when 0x50 then @x -= 4  # left
  #     end
  #   end
  # end
  # ```
  def on_event: (Hash ev) -> void

  # Window の大きさが変わったとき <<en>> Called when the window is resized
  #
  # Window の大きさが変わったときに呼ばれます。全画面への切り替えでも呼ばれます。
  #
  # **FmrbUI の部品は作った場所に貼り付いたまま**なので、大きさが変わったら
  # 作り直しが要ります。枠も描き直します。
  #
  # ```ruby
  # def on_resize(w, h)
  #   detach_ui(@ui) if @ui
  #   @ui = FmrbUI.new(self)
  #   build_widgets
  #   redraw
  # end
  # ```
  # <<en>>
  # Called when the window changes size, and when it enters or leaves full
  # screen.
  #
  # **FmrbUI widgets stay where they were built**, so a resize means building
  # them again. Redraw the frame too.
  #
  # ```ruby
  # def on_resize(w, h)
  #   detach_ui(@ui) if @ui
  #   @ui = FmrbUI.new(self)
  #   build_widgets
  #   redraw
  # end
  # ```
  def on_resize: (Integer new_width, Integer new_height) -> void

  # 閉じてよいか聞かれたとき <<en>> Called when it is asked to close
  #
  # 閉じるボタンや Ctrl+Q で呼ばれる。**書き換えなければそのまま終わる**。
  # 保存を尋ねたいときはここで止める。
  # ```ruby
  # def on_quit_request
  #   if @modified
  #     ask_save
  #   else
  #     stop
  #   end
  # end
  # ```
  # <<en>>
  # Called by the close button and Ctrl+Q. **Left alone, the app just ends.**
  # Override it to ask about unsaved work.
  # ```ruby
  # def on_quit_request
  #   if @modified
  #     ask_save
  #   else
  #     stop
  #   end
  # end
  # ```
  def on_quit_request: () -> void

  # 枠なしの Window の右クリック・長押し <<en>> Right click or long press, frameless
  #
  # 枠なしの Window の右クリック (離したとき) と、動かさずに 1 秒押し続けた
  # とき (ev[:type] が :long_press) に呼ばれる。既定は Window のメニュー
  # (request_window_menu: 送る・読み直し・閉じる) を出す。右ボタンを自分で
  # 使うアプリは空で書き換える (メニューも出したいなら super(ev) を呼ぶ)。
  # 右クリックは on_event にも届く。長押しは届かない。
  # ```ruby
  # def on_frameless_right_click(ev)
  # end
  # ```
  # <<en>>
  # Called on a right click on a frameless window (on its release), and on a
  # left press held still for a second (ev[:type] is :long_press, the way on
  # a touch screen). The default opens the window menu (request_window_menu:
  # Send to, Reload, Close). An app that uses the right button overrides it
  # with an empty method (or calls super(ev) to have the menu too); a right
  # click reaches on_event either way, a long press does not.
  # ```ruby
  # def on_frameless_right_click(ev)
  # end
  # ```
  def on_frameless_right_click: (Hash ev) -> void

  # 当たりを四角の一覧で決める (枠なし) <<en>> Hit shape: rectangles (frameless window)
  #
  # 押して当たるのは、四角・マスク・印を付けた sprite を合わせた所だけ。
  # ほかを押すと後ろの Window へ抜ける。何も決めなければ Window の四角。
  # 座標は Window の中。`[]` で四角を外す。移ったら基底が決め直す。
  # ```ruby
  # set_hit_shape([[0, 0, 40, 30],
  #                [10, 30, 20, 8]])
  # ```
  # <<en>>
  # A frameless window takes a press only inside the union of these
  # rectangles, its mask and its marked sprites; elsewhere the press goes to
  # what is behind. Nothing declared: the whole window. Window coordinates;
  # `[]` drops the rectangles. A move carries them along.
  # ```ruby
  # set_hit_shape([[0, 0, 40, 30],
  #                [10, 30, 20, 8]])
  # ```
  def set_hit_shape: (Array rects) -> bool

  # 当たりをマスク (FmrbHitMask) で決める <<en>> Hit shape: a mask (FmrbHitMask)
  #
  # 左上を (x, y) に置く。nil で外す。
  # ```ruby
  # m = hit_mask_from_art(ROWS,
  #       transparent: ".", scale: 3)
  # set_hit_mask(m, 36, 38)
  # ```
  # <<en>>
  # Its top-left at (x, y); nil drops it.
  # ```ruby
  # m = hit_mask_from_art(ROWS,
  #       transparent: ".", scale: 3)
  # set_hit_mask(m, 36, 38)
  # ```
  def set_hit_mask: (FmrbHitMask? mask, ?Integer x, ?Integer y) -> bool

  # ドット絵の文字列から当たりのマスクを作る <<en>> A hit mask from dot-art strings
  #
  # 1 文字 1 マス (ASCII)。transparent に含まれない文字が当たる。
  # 1 マスは scale x scale 画素。
  # ```ruby
  # m = hit_mask_from_art(
  #       ["..XX..", ".XXXX."],
  #       transparent: ".", scale: 2)
  # ```
  # <<en>>
  # One ASCII character per cell; every character not in transparent is
  # hit. A cell is scale x scale pixels.
  # ```ruby
  # m = hit_mask_from_art(
  #       ["..XX..", ".XXXX."],
  #       transparent: ".", scale: 2)
  # ```
  def hit_mask_from_art: (Array rows, ?transparent: String, ?scale: Integer) -> FmrbHitMask

  # sprite に当たりの印を付ける <<en>> Mark a sprite as part of the hit shape
  #
  # sprite の四角 (mask を渡せばその形) が、sprite の位置と見え隠れに
  # ついて当たりに入る。移った後は on_restore で付け直す。
  # ```ruby
  # add_hit_sprite(@player)
  # ```
  # <<en>>
  # The sprite's rectangle (or the mask given, over its top-left) is hit
  # wherever the sprite is, while it is visible. After a move, on_restore
  # marks the sprites it makes again.
  # ```ruby
  # add_hit_sprite(@player)
  # ```
  def add_hit_sprite: (SpriteInstance sprite, ?FmrbHitMask? mask) -> bool

  # sprite の当たりの印を外す <<en>> Unmark a sprite
  #
  # ```ruby
  # remove_hit_sprite(@player)
  # ```
  def remove_hit_sprite: (SpriteInstance sprite) -> void

  # 当たりを Window の四角に戻す <<en>> Back to the window rectangle
  #
  # ```ruby
  # clear_hit_shape
  # ```
  def clear_hit_shape: () -> bool

  # ---- 動かす ----

  # アプリを動かし始める <<en>> Start the app running
  #
  # `on_create` を呼び、アプリのループに入り、終わったら後始末をします。
  #
  # ファイルのアプリでは自分で呼びません。ファイルを読み終えたあと、
  # そのファイルが定義した `FmrbApp` の子が作られ、これが呼ばれます。
  # `.app.toml` (か `#---fmrb` の囲み) に `class = "MyApp"` があれば
  # そのクラスを、無ければ子が 1 つのときにそれを起動します。決まらない
  # ときは理由がエラーの Window に出ます。
  # <<en>>
  # Calls `on_create`, runs the app's loop, and cleans up when it ends.
  #
  # An app file does not call it: once the file has been read, the FmrbApp
  # subclass it defines is made and this is called: the one `class = "MyApp"`
  # in the .app.toml (or the `#---fmrb` header) names, or else the only one.
  # When none can be picked, the error window says why.
  def start: () -> void

  # アプリを止める <<en>> Stop the app
  #
  # ループを抜けて終わる。**これを通った終わりだけが「行儀のよい終わり」**
  # として記録され、例外で落ちたのと区別が付く。
  # <<en>>
  # Leaves the loop and ends. **Only an ending that goes through here counts
  # as an orderly one**, which is how the kernel tells it from a crash.
  def stop: () -> void

  # 使った物を片づける <<en>> Let go of what it used
  #
  # 後始末。`start` が最後に自分で呼ぶので、普通は書かない。
  # <<en>>
  # Cleanup. `start` calls it at the end, so an app rarely calls it itself.
  def destroy: () -> void

  # 自分をもう一度読み込み直す <<en>> Ask to be loaded again
  #
  # ファイルから起動したアプリを、書き直した内容で起動し直すよう頼む。
  # Window のメニューの「読み直し」と同じ問いを出す。
  # <<en>>
  # Asks for a file-based app to be started again from the rewritten file.
  # The window menu's Reload asks the same.
  def request_reload: () -> void

  # Window のメニューを出す <<en>> Open this window's menu
  #
  # デスクトップに Window のメニューを出してもらう (x, y は Window の中の
  # 位置)。送る (運べるアプリで)・読み直し (ファイルのアプリで)・閉じる。
  # タイトルバーの右クリックと、枠なしの右クリック・長押しの既定がこれを
  # 呼ぶ。
  # <<en>>
  # Asks the desktop for this window's menu at (x, y) of the window: Send to
  # (a movable app), Reload (an app started from a file), Close. A right
  # click on the title bar, and on a frameless window the default right
  # click and long press, call this.
  def request_window_menu: (Integer x, Integer y) -> void

  # 「<アプリ> を閉じますか?」と聞く <<en>> Ask "Close <app>?" on the desktop
  #
  # デスクトップに確認の画面を出してもらう。はいなら on_quit_request が
  # 呼ばれ、いいえ・外のクリックでは何も起きない。
  # <<en>>
  # Asks the desktop to show "Close <app>?". Yes calls on_quit_request; No
  # or a click outside does nothing.
  def request_close_confirm: () -> void

  # 呼ばれ続ける本体の繰り返し <<en>> The body that is called over and over
  #
  # `start` の中身。自分で呼ぶことはまず無い。
  # <<en>>
  # What `start` runs. There is rarely a reason to call it directly.
  def main_loop: () -> void

  # ---- Window と絵 ----

  # Window のふちと題名を描き直す <<en>> Redraw the frame and the title
  #
  # タイトルバーとわく、閉じるボタンを描きます。全画面のときは何もしません。
  #
  # **大きさの変わるアプリは、描き直すたびに呼ぶこと。** 一度描いたきりに
  # すると、Window を広げたときにわくが壊れます。
  #
  # タイトルバーは既定のフォントで描かれますが、**呼ぶ前のフォント設定は
  # 戻されます**。`set_font(:ja)` を毎フレーム掛け直す必要はありません。
  # <<en>>
  # Draws the title bar, the border and the close button. Does nothing in
  # full screen.
  #
  # **An app that can be resized must call this on every redraw.** Drawing
  # the frame once leaves it broken the first time the window grows.
  #
  # The title bar uses the default font, but the font in force before the
  # call is put back, so `set_font(:ja)` does not have to be re-applied
  # every frame.
  def draw_window_frame: () -> void

  # 中身の場所をぬりつぶす。色を省くとテーマの紙の色 <<en>> theme page colour by default
  #
  # Window の中だけを塗りつぶします。**わくも描き直し**、その場所にあった
  # FmrbUI の部品にも描き直しの印を付けます。Window のアプリで画面を消すときは
  # `gfx.clear` ではなくこちらを使います。
  #
  # `gfx.clear` は canvas 全体を塗るので、自分で描いたタイトルバーもわくも
  # 消えます。
  # <<en>>
  # Wipes the user area only -- and puts the frame back, and marks any FmrbUI
  # widget standing in the wiped area for redrawing. In a windowed app this
  # is what to use, not `gfx.clear`.
  #
  # `gfx.clear` paints the whole canvas, taking the title bar and the border
  # with it.
  def clear_user_area: () -> void

  # ---- テーマの色 (system_conf.toml の [theme]) ----

  # 紙の色 <<en>> page background from the system theme
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 40, 20,
  #               theme_bg)
  # ```
  def theme_bg: () -> Integer

  # 紙に書く字の色 <<en>> ink for text on theme_bg
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 40, 20,
  #               theme_fg)
  # ```
  def theme_fg: () -> Integer

  # 目立たせる色 <<en>> selection / emphasis colour
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 40, 20,
  #               theme_accent)
  # ```
  def theme_accent: () -> Integer

  # 線や枠、うすい字の色 <<en>> rules, boxes, muted text
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 40, 20,
  #               theme_border)
  # ```
  def theme_border: () -> Integer

  # 濃い地の上に書く字の色 <<en>> ink on accent or button backgrounds
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 40, 20,
  #               theme_fg_light)
  # ```
  def theme_fg_light: () -> Integer

  # 右はしに巻物のつまみを描く <<en>> Draw a scrollbar down the right edge
  #
  # Window の右端にスクロールバーを描く。**位置は自分で持つ** — この呼び出しは
  # 絵を描くだけで、値は覚えない。
  # ```ruby
  # draw_scrollbar(@scroll,
  #                @lines.size,
  #                visible_rows)
  # ```
  # <<en>>
  # Draws the bar down the right edge. **The position stays yours** -- this
  # only paints it.
  # ```ruby
  # draw_scrollbar(@scroll,
  #                @lines.size,
  #                visible_rows)
  # ```
  def draw_scrollbar: (Integer scroll, Integer total, Integer visible) -> void

  # つまみのどこを押したか調べる <<en>> Work out where the scrollbar was pressed
  #
  # クリックがバーのどこに当たったかを返す。当たっていなければ nil。
  # ```ruby
  # case scrollbar_hit(ev[:x], ev[:y])
  # when :up   then @scroll -= 1
  # when :down then @scroll += 1
  # end
  # ```
  # <<en>>
  # Where a click landed on the bar, or nil if it missed.
  # ```ruby
  # case scrollbar_hit(ev[:x], ev[:y])
  # when :up   then @scroll -= 1
  # when :down then @scroll += 1
  # end
  # ```
  def scrollbar_hit: (Integer click_x, Integer click_y) -> Symbol?

  # Window を動かす <<en>> Move the window
  #
  # ```ruby
  # set_window_position(20, 40)
  # ```
  def set_window_position: (Integer x, Integer y) -> FmrbApp

  # 全画面にするか元に戻すか頼む <<en>> Ask to go full screen or come back
  #
  # 全画面と Window を切り替えるよう頼みます。**すぐには変わりません** — VM は
  # 動いたまま、答えは `on_resize` として返ってきます。そのときには
  # `fullscreen` も Window の中の大きさも新しい値になっています。
  #
  # 描き直しは `on_resize` に書きます。ここでは書きません。
  # <<en>>
  # Asks to switch between full screen and a window. **Nothing changes
  # immediately** -- the VM keeps running and the answer arrives as
  # `on_resize`, by which time `fullscreen` and the user area are the new
  # ones.
  #
  # Redraw in `on_resize`, not here.
  def request_fullscreen: (bool on) -> void

  # 全画面と Window を切りかえる <<en>> Switch between full screen and window
  #
  # 全画面と Window を切り替える。**答えは `on_resize` で返る** (`request_fullscreen`
  # と同じ)。
  # <<en>>
  # Switches between full screen and a window. **The answer arrives as
  # `on_resize`**, as with `request_fullscreen`.
  def toggle_fullscreen: () -> void

  # 自分用の画面をもう一枚作る <<en>> Make a second canvas of its own
  #
  # このアプリの持ちものとして canvas をもう 1 枚作り、それに結び付いた
  # FmrbGfx を返します。終了時 (異常終了も含む) に自動で消えます。
  #
  # **呼び方はキーワード引数です** — 上のシグネチャは型推論の都合で
  # 位置引数の形に直してあります。実際にはこう書きます:
  #
  # ```ruby
  # g = create_canvas_gfx(
  #   width: 200, height: 100)
  # g.present(20, 40)
  # ```
  #
  # **全画面のアプリ向け**です。Window のアプリで使うと、フォーカスが移ったとき
  # に Window の管理側が追いかけてくれません。
  # <<en>>
  # Makes another canvas owned by this app and returns an FmrbGfx bound to
  # it. It is deleted when the app ends, a crash included.
  #
  # **It takes keyword arguments** -- the signature above is written
  # positionally because the type engine has no keywords. The real call is:
  #
  # ```ruby
  # g = create_canvas_gfx(
  #   width: 200, height: 100)
  # g.present(20, 40)
  # ```
  #
  # **Meant for fullscreen apps.** The window manager does not follow extra
  # canvases across a change of focus.
  def create_canvas_gfx: (Integer width, Integer height) -> FmrbGfx

  # 作った画面を片づける <<en>> Let go of a canvas it made
  #
  # ```ruby
  # delete_canvas_gfx(@layer)
  # ```
  def delete_canvas_gfx: (FmrbGfx gfx) -> void

  # ---- キーの調べかた (on_event の中で使う) ----

  # Ctrl を押していたかどうか <<en>> Whether Ctrl was held
  #
  # Ctrl が押されていたかを返します。左右どちらでも真です。
  #
  # 文字のキーを見分けるときは **`ev[:scancode]` を使うこと**。
  # `ev[:keycode]` は環境で変わります (Linux では SDL の値が来ます) が、
  # scancode は どこでも同じ USB HID の番号です。
  #
  # ```ruby
  # # Ctrl+S
  # if ev_ctrl?(ev) &&
  #    ev[:scancode] == 0x16
  # ```
  # <<en>>
  # Whether Ctrl was held; either side counts.
  #
  # Match letter keys on **`ev[:scancode]`**. `ev[:keycode]` differs between
  # platforms (SDL values on Linux), while the scancode is the same USB HID
  # number everywhere.
  #
  # ```ruby
  # # Ctrl+S
  # if ev_ctrl?(ev) &&
  #    ev[:scancode] == 0x16
  # ```
  def ev_ctrl?: (Hash ev) -> bool

  # Shift を押していたかどうか <<en>> Whether Shift was held
  #
  # ```ruby
  # if ev_shift?(ev)
  # ```
  def ev_shift?: (Hash ev) -> bool

  # Alt を押していたかどうか <<en>> Whether Alt was held
  #
  # ```ruby
  # if ev_alt?(ev)
  # ```
  def ev_alt?: (Hash ev) -> bool

  # ---- 時間と伝言 ----

  # 決まった時間ごとに呼んでもらう <<en>> Ask to be called on a timer
  #
  # interval ミリ秒後に一度だけブロックを呼びます。**繰り返しません** —
  # 続けたいならブロックの中でもう一度 `set_timer` を呼びます。
  #
  # 呼ばれる時刻はアプリのループの刻みに丸められるので、**ミリ秒どおりには
  # 来ません**。戻り値は `clear_timer` に渡す番号です。
  #
  # Spinel で動かすアプリでは、**ブロックの外側のローカル変数を掴めません**
  # (インスタンス変数と定数は使えます)。
  #
  # ```ruby
  # @id = set_timer(500) { blink }
  # ```
  # <<en>>
  # Calls the block once, interval milliseconds later. **It does not
  # repeat** -- call `set_timer` again inside the block for that.
  #
  # The moment it fires is rounded to the app loop's own tick, so it is not
  # accurate to the millisecond. The return value is the id `clear_timer`
  # takes.
  #
  # Under Spinel a stored block **cannot capture an outer local variable**
  # (instance variables and constants are fine).
  #
  # ```ruby
  # @id = set_timer(500) { blink }
  # ```
  def set_timer: (Integer interval) -> Integer

  # 時間の呼び出しをやめる <<en>> Stop a timer
  #
  # `set_timer` が返した番号を渡して止める。
  # ```ruby
  # @id = set_timer(500) { blink }
  # clear_timer(@id)
  # ```
  # <<en>>
  # Stops the timer whose id `set_timer` returned.
  # ```ruby
  # @id = set_timer(500) { blink }
  # clear_timer(@id)
  # ```
  def clear_timer: (Integer timer_id) -> void

  # 知らせを受け取るようにする <<en>> Start receiving a kind of notice
  #
  # その名前で配られたものが `on_control` に届くようになる。
  # ```ruby
  # subscribe("clock/hour")
  # ```
  # <<en>>
  # What is published under that name starts arriving at `on_control`.
  # ```ruby
  # subscribe("clock/hour")
  # ```
  def subscribe: (String topic) -> void

  # 知らせを受け取るのをやめる <<en>> Stop receiving a kind of notice
  #
  # ```ruby
  # unsubscribe("clock/hour")
  # ```
  def unsubscribe: (String topic) -> void

  # みんなに知らせを送る <<en>> Send a notice to everyone
  #
  # topic の名前で、購読しているアプリ全部にデータを配ります。
  #
  # **1 通で送れるのは 176 バイトまで**です。大きなものは `/tmp` に書いて
  # **その場所だけを配る**のが定石です (`/tmp` はメモリの上にあり、
  # 再起動で消えます)。
  # <<en>>
  # Sends data to every app subscribed to that topic.
  #
  # **One message carries at most 176 bytes.** For anything larger, write it
  # to `/tmp` and publish the path instead (`/tmp` lives in memory and is
  # gone on the next boot).
  def publish: (String topic) -> void

  # 他のアプリに伝言を送る <<en>> Send a message to another app
  #
  # 特定の相手に直接送る。**1 通 176 バイトまで**は `publish` と同じ。
  # ```ruby
  # send_message(pid,
  #   FmrbConst::MSG_TYPE_APP_CONTROL,
  #   { "cmd" => "hello" })
  # ```
  # <<en>>
  # Sends straight to one process. The same **176-byte** limit as `publish`.
  # ```ruby
  # send_message(pid,
  #   FmrbConst::MSG_TYPE_APP_CONTROL,
  #   { "cmd" => "hello" })
  # ```
  def send_message: (Integer dest_pid, Integer msg_type, untyped data) -> void

  # ---- ファイル ----

  # ファイルを選ぶ Window を出してもらう <<en>> Ask for a file chooser
  #
  # ファイル選択の Window を開くよう頼む。選ばれた道は `on_control` に届く。
  # "open" か "save" を渡す。
  # ```ruby
  # request_file_select("open")
  # ```
  # <<en>>
  # Asks for the file dialog; the chosen path arrives at `on_control`.
  # Pass "open" or "save".
  # ```ruby
  # request_file_select("open")
  # ```
  def request_file_select: (String mode) -> void

  # ファイルをアプリとして動かす <<en>> Run a file as an app
  #
  # ```ruby
  # request_run("/app/usr/mine.app.rb")
  # ```
  def request_run: (String path) -> void

  # 自分をイメージに書いて閉じる <<en>> Write this app to an image and close
  #
  # 自分を止めてイメージ (`/tmp/<名前>.ckpt`) に書き、閉じるよう頼みます。
  # 書くのはメッセージ待ちの後の区切りなので、**`on_event` や `on_update`
  # の中から頼んでよい**です。書けたら `on_checkpoint` の後に閉じ、
  # `restart: true` を渡すとすぐにイメージから起動し直します (`on_restore`)。断られたら
  # `on_checkpoint_refused` が来ます。頼めたら nil、頼めないときは理由の
  # 文字列を返します。
  # ```ruby
  # why = checkpoint(restart: true)
  # Log.warn(why) if why
  # ```
  # <<en>>
  # Asks for this app to be stopped, written to an image
  # (`/tmp/<name>.ckpt`) and closed. The image is written at the break after
  # the message wait, so **asking from `on_event` or `on_update` is fine**.
  # Once written the app closes after `on_checkpoint`; given `restart: true`
  # the image is started again at once (`on_restore`). A refusal arrives as
  # `on_checkpoint_refused`. nil when asked, else a String saying why not.
  # ```ruby
  # why = checkpoint(restart: true)
  # Log.warn(why) if why
  # ```
  def checkpoint: () -> String?

  # 自分を別の端末へ移す <<en>> Move this app to another machine
  #
  # 自分を Asterism の端末 `to` (その端末のノード ID) へ移すよう頼みます。
  # カーネルは先に相手に呼ぶメソッドがあるかを聞き、止めてイメージを書き、
  # 運んで、相手で起動できたらこちらを閉じます (`on_checkpoint` が最後、
  # 相手では `on_restore`)。断られた・返事が無いときは `on_checkpoint_refused`
  # が来て、止めた所から続けます。頼めたら nil、頼めないときは理由の文字列。
  # ```ruby
  # why = move_to("fmruby-abcdef")
  # Log.warn(why) if why
  # ```
  # <<en>>
  # Asks for this app to be moved to the Asterism machine `to` (its node
  # ID). The kernel asks that machine first whether it has the methods the
  # app calls, writes the image, carries it and closes the app here once it
  # is up there (`on_checkpoint` last here, `on_restore` there). When it
  # stays (refused, no answer), `on_checkpoint_refused` says why and the app
  # goes on. nil when asked, else a String saying why not.
  # ```ruby
  # why = move_to("fmruby-abcdef")
  # Log.warn(why) if why
  # ```
  def move_to: (String to) -> String?

  # ---- 後片づけの調子 ----

  # ひまな時に片づけをするか <<en>> Whether to tidy up when idle
  #
  # 暇なときに GC を回す設定が入っているかどうか。
  # <<en>>
  # Whether the app collects garbage while it has nothing to do.
  def idle_gc: () -> bool

  # ---- クラスメソッド ----

  # 今の言葉 ("ja" か "en") <<en>> The language now, "ja" or "en"
  #
  # ```ruby
  # if FmrbApp.language == "ja"
  # ```
  def self.language: () -> String

  # クリップボードの文字 <<en>> The text on the clipboard
  #
  # どのアプリとも同じ 1 つのクリップボード。空なら `""`。
  # PC とブラウザ版では、そちらでコピーした文字も入る。
  # `FmrbApp.clipboard(100)` のように数を渡すと、
  # そのバイト数までを、文字の途中で切らずに返す。
  # ```ruby
  # text = FmrbApp.clipboard
  # ```
  # <<en>>
  # One clipboard shared by every app; `""` when empty.
  # On the PC and in the browser, text copied there too.
  # Given a number, at most that many bytes, never
  # cutting a character.
  # ```ruby
  # text = FmrbApp.clipboard
  # ```
  def self.clipboard: () -> String

  # クリップボードに文字を入れる <<en>> Put text on the clipboard
  #
  # 64 KB より大きいと入れずに false を返す。
  # ```ruby
  # FmrbApp.set_clipboard("hello")
  # ```
  # <<en>>
  # Over 64 KB it is not put there, and the answer is
  # false.
  # ```ruby
  # FmrbApp.set_clipboard("hello")
  # ```
  def self.set_clipboard: (String text) -> bool

  # クリップボードが変わった回数 <<en>> How many times the clipboard changed
  #
  # 文字を読まずに、変わったかどうかを知るのに使う。
  # ```ruby
  # g = FmrbApp.clipboard_gen
  # ```
  # <<en>>
  # To tell a change without reading the text.
  # ```ruby
  # g = FmrbApp.clipboard_gen
  # ```
  def self.clipboard_gen: () -> Integer

  # 画面の右上に小さな知らせを出す <<en>> Show a small notice at the top right
  #
  # 数秒で消える。上にアプリの名前、その下に文と本文
  # (2 行まで)。知らせを出せるのは PC だけで、
  # ほかの端末では何も出さずに false を返す。
  # ```ruby
  # FmrbApp.notify("Saved", "/home/a.txt")
  # ```
  # <<en>>
  # It goes after a few seconds: the app's name, the
  # text and the body (two lines at most). Only the PC
  # shows them; elsewhere nothing shows and the answer
  # is false.
  # ```ruby
  # FmrbApp.notify("Saved", "/home/a.txt")
  # ```
  def self.notify: (String summary, String body) -> bool

  # 動いているアプリの一覧 <<en>> The apps that are running
  #
  # 動いているアプリの一覧。1 つずつが名前と pid を持つ Hash。
  # ```ruby
  # FmrbApp.ps.each do |a|
  #   Log.info("#{a[:pid]} #{a[:name]}")
  # end
  # ```
  # <<en>>
  # Every running app, each a Hash with its name and pid.
  # ```ruby
  # FmrbApp.ps.each do |a|
  #   Log.info("#{a[:pid]} #{a[:name]}")
  # end
  # ```
  def self.ps: () -> Array

  # アプリ一覧が変わった回数 <<en>> How many times the app list changed
  #
  # 一覧が変わるたびに増える番号。**これが変わったときだけ `ps` を呼べば**、
  # 毎フレーム一覧を作らずに済む。
  # <<en>>
  # A number that changes whenever the list does. **Call `ps` only when it
  # moves** and the list is not rebuilt every frame.
  def self.ps_gen: () -> Integer

  # 別のアプリをイメージに書いて閉じる <<en>> Write another app to an image
  #
  # pid のアプリを止めてイメージに書き、閉じるよう頼みます (Shell の
  # `checkpoint`)。`restart: true` ならすぐに起動し直します。頼めたら nil、
  # 頼めないときは理由の文字列。答えは後から `on_control` に
  # `{"cmd" => "checkpoint_result", "pid", "ok", "path" か "reason"}`
  # で届きます。
  # ```ruby
  # FmrbApp.checkpoint(5,
  #                    restart: true)
  # ```
  # <<en>>
  # Asks for app pid to be stopped, written to an image and closed (the
  # shell's `checkpoint`); `restart: true` starts it again at once. nil when
  # asked, else a String saying why not. The answer arrives later at
  # `on_control` as
  # `{"cmd" => "checkpoint_result", "pid", "ok", "path" or "reason"}`.
  # ```ruby
  # FmrbApp.checkpoint(5,
  #                    restart: true)
  # ```
  def self.checkpoint: (Integer pid) -> String?

  # 別のアプリを別の端末へ移す <<en>> Move another app to another machine
  #
  # pid のアプリを Asterism の端末 `to` (ノード ID) へ移すよう頼みます
  # (Shell の `move`)。頼めたら nil、頼めないときは理由の文字列。答えは後から
  # `on_control` に `{"cmd" => "checkpoint_result", "pid", "ok", "to",
  # "there" と "missing" か "reason"}` で届きます。
  # ```ruby
  # FmrbApp.move(5, "fmruby-abcdef")
  # ```
  # <<en>>
  # Asks for app pid to be moved to the Asterism machine `to` (its node ID;
  # the shell's `move`). nil when asked, else a String saying why not. The
  # answer arrives later at `on_control` as `{"cmd" =>
  # "checkpoint_result", "pid", "ok", "to", "there" and "missing" or
  # "reason"}`.
  # ```ruby
  # FmrbApp.move(5, "fmruby-abcdef")
  # ```
  def self.move: (Integer pid, String to) -> String?

  # 空きメモリの様子 <<en>> How much memory is free
  #
  # ```ruby
  # h = FmrbApp.heap_info
  # Log.info("#{h[:free]} free")
  # ```
  def self.heap_info: () -> Hash

  # 自分のメモリの使用率 (百分率) <<en>> How much of its own memory is used
  #
  # ```ruby
  # pct = FmrbApp.pool_usage
  # ```
  def self.pool_usage: () -> Integer

  # 自分のメモリの使用量 (バイト) <<en>> How much of its own memory is used, in bytes
  #
  # 使えないときは -1。**百分率では粗すぎるとき**に使う (デスクトップの
  # 1536KB のプールでは 1% が 15KB)。前後で引き算すれば、その処理が出した
  # ごみの量が分かる。
  # ```ruby
  # before = FmrbApp.pool_used
  # scan_everything
  # kb = (FmrbApp.pool_used - before) / 1024
  # ```
  # <<en>>
  # -1 when it cannot be read. Use it where the percent is too coarse: one
  # percent of the desktop's 1536KB pool is 15KB. Subtract across a piece of
  # work and you have the garbage it made.
  # ```ruby
  # before = FmrbApp.pool_used
  # scan_everything
  # kb = (FmrbApp.pool_used - before) / 1024
  # ```
  def self.pool_used: () -> Integer

  # 機械全体のメモリの様子 <<en>> The whole machine's memory
  #
  # ```ruby
  # i = FmrbApp.sys_pool_info
  # ```
  def self.sys_pool_info: () -> Hash

  # 設定ファイルの中身を読む <<en>> Read a settings file
  #
  # `system_conf.toml` の節を読む。無ければ nil。
  # ```ruby
  # rows = FmrbApp.config("theme")
  # ```
  # <<en>>
  # Reads a section of `system_conf.toml`, or nil if it is not there.
  # ```ruby
  # rows = FmrbApp.config("theme")
  # ```
  def self.config: (String section_name) -> Array?

  # 電源を入れてからの時間 (百万分の一秒) <<en>> Microseconds since power-on
  #
  # ```ruby
  # t0 = FmrbApp.uptime_us
  # work
  # us = FmrbApp.uptime_us - t0
  # ```
  def self.uptime_us: () -> Integer

  # 今の日付と時刻 <<en>> The date and time now
  #
  # いまの日時。時計が合っていなければ nil。
  # ```ruby
  # t = FmrbApp.wallclock
  # Log.info("#{t[:hour]}") if t
  # ```
  # <<en>>
  # The date and time now, or nil when the clock has never been set.
  # ```ruby
  # t = FmrbApp.wallclock
  # Log.info("#{t[:hour]}") if t
  # ```
  def self.wallclock: () -> Hash?

  # 絵を送った回数の記録 <<en>> A tally of the frames sent
  #
  # ```ruby
  # s = FmrbApp.gfx_stats
  # ```
  def self.gfx_stats: () -> Hash

  # マウスの矢印を出す <<en>> Show the mouse pointer
  #
  # マウスの矢印を出す。デスクトップが起動時に呼ぶ。
  # <<en>>
  # Shows the mouse pointer; the desktop does this at boot.
  def self.enable_cursor: () -> void

  # マウスの矢印を見せるか隠すか <<en>> Show or hide the mouse pointer
  #
  # ```ruby
  # FmrbApp.set_cursor_visible(false)
  # ```
  def self.set_cursor_visible: (bool visible) -> void

  # かな入力を切りかえる (0 切 1 ひら 2 カタ) <<en>> Switch kana input (0 off 1 hira 2 kata)
  #
  # 0 = 英字、1 = ひらがな、2 = カタカナ。
  # ```ruby
  # FmrbApp.set_kana_mode(1)
  # ```
  # <<en>>
  # 0 for ASCII, 1 for hiragana, 2 for katakana.
  # ```ruby
  # FmrbApp.set_kana_mode(1)
  # ```
  def self.set_kana_mode: (Integer mode) -> void

  # 文字カーソルの位置を知らせる (PC の IME 用) <<en>> Tell where the text cursor is (for a PC's IME)
  #
  # 文字を打つアプリが、カーソルを描くたびに呼ぶ。x, y は canvas の座標
  # (行の左上)、h は行の高さ。h = 0 で「今は文字を打たない」。PC の IME
  # (fcitx5 など) は、変換中の文字と候補をここに出す。端末では何もしない。
  # ```ruby
  # FmrbApp.set_text_cursor(x, y, 12)
  # ```
  # <<en>>
  # Apps that take text call this whenever they draw their cursor: x, y in
  # canvas coordinates (the top-left of the cell), h the line's height;
  # h = 0 says no text is taken now. A PC's IME (fcitx5 and the like) shows
  # the text being composed and its candidates there. Nothing on the devices.
  # ```ruby
  # FmrbApp.set_text_cursor(x, y, 12)
  # ```
  def self.set_text_cursor: (Integer x, Integer y, Integer h) -> void

  # 本体が消音中か <<en>> Whether the machine is muted
  #
  # ```ruby
  # FmrbApp.audio_muted?
  # ```
  def self.audio_muted?: () -> bool

  # 消せない・名前を変えられない場所か <<en>> Whether the entry cannot be deleted or renamed
  #
  # PC 版の配布物の木と /mnt/root で true。端末・sim・ブラウザ版では常に false。
  # 削除を確かめる前に聞く用 (File Manager)。
  # ```ruby
  # FmrbApp.path_read_only?("/mnt/root/etc/hostname")
  # ```
  def self.path_read_only?: (String path) -> bool

  # アプリの設定 (.app.toml とコメント) <<en>> An app's settings (.app.toml and comment)
  #
  # .app.toml と、.rb の先頭の `#---fmrb`
  # コメントを合わせて読む。両方にある
  # 項目は .app.toml が勝つ。キーも値も
  # 文字列 (配列は空白でつなぐ)。どちらも
  # 無いファイル (アプリでない) は nil。
  # ```ruby
  # m = FmrbApp.app_meta(
  #   "/app/game/flappy.app.rb")
  # m["app_screen_name"] if m
  # ```
  # <<en>>
  # Reads the .app.toml and the `#---fmrb`
  # comment at the top of the .rb together;
  # a key both set takes the .app.toml's
  # value. Keys and values are Strings (an
  # array's items joined by a space). nil
  # for a file with neither (not an app).
  # ```ruby
  # m = FmrbApp.app_meta(
  #   "/app/game/flappy.app.rb")
  # m["app_screen_name"] if m
  # ```
  def self.app_meta: (String path) -> Hash[String, String]?

  # その場所にあと何バイト書けるか <<en>> How many more bytes can be written where the path lives
  #
  # /tmp は RAM のファイルシステムの空き、ほかはその下のファイルシステムの空き。
  # 分からないとき (ブラウザ版の /home など) は nil。
  # ```ruby
  # FmrbApp.free_bytes("/tmp")
  # ```
  # <<en>>
  # /tmp: what is left of the RAM filesystem; elsewhere: the free space of
  # the filesystem under it. nil when it cannot be known (the browser's /home).
  # ```ruby
  # FmrbApp.free_bytes("/tmp")
  # ```
  def self.free_bytes: (String path) -> Integer?

  # 本体の音量 (0-10) <<en>> The machine's volume (0-10)
  #
  # ```ruby
  # FmrbApp.audio_volume
  # ```
  def self.audio_volume: () -> Integer

  # WiFi がつながっているか <<en>> Whether WiFi is connected
  #
  # ```ruby
  # if FmrbApp.wifi_connected?
  # ```
  def self.wifi_connected?: () -> bool

  # WiFi のつながり具合 <<en>> How WiFi is doing
  #
  # **Retro では nil**。Modern は WiFi の状態、Linux は母艦の網の状態を返す。
  # ```ruby
  # i = FmrbApp.wifi_info
  # Log.info(i[:ip]) if i
  # ```
  # <<en>>
  # **nil on Retro.** Modern reports its WiFi, Linux the host's network.
  # ```ruby
  # i = FmrbApp.wifi_info
  # Log.info(i[:ip]) if i
  # ```
  def self.wifi_info: () -> Hash?

  # つないだ USB 機器の一覧 <<en>> The USB devices attached
  #
  # ```ruby
  # FmrbApp.usb_devices.each do |d|
  #   Log.info(d[:type])
  # end
  # ```
  def self.usb_devices: () -> Array

  # USB の生の入力を受け取る <<en>> Start receiving raw USB input
  #
  # その口の生のレポートが `on_control` に届くようになる。HID Inspector が
  # 使っている。
  # <<en>>
  # Raw reports from that slot start arriving at `on_control`. The HID
  # Inspector is what uses this.
  def self.hid_raw_subscribe: (Integer slot) -> bool

  # USB の生の入力をやめる <<en>> Stop receiving raw USB input
  #
  # ```ruby
  # FmrbApp.hid_raw_unsubscribe(1)
  # ```
  def self.hid_raw_unsubscribe: (Integer slot) -> bool

  # 自分の pid <<en>> This app's own pid
  #
  # `ps` の :id と同じ番号。一覧から自分を外すときに使う。
  # ```ruby
  # me = FmrbApp.pid
  # ```
  # <<en>>
  # The number `ps` reports as :id; for leaving itself out of the list.
  # ```ruby
  # me = FmrbApp.pid
  # ```
  def self.pid: () -> Integer

  # 起動したファイル <<en>> The file this app was started from
  #
  # ファームに入っているアプリでは "" 。
  # <<en>>
  # "" for an app built into the firmware.
  def self.script_path: () -> String

  # 自分のメモリのごみを集める <<en>> Collect this app's garbage now
  #
  # ```ruby
  # FmrbApp.gc
  # ```
  def self.gc: () -> void

  # 電池の残り (百分率) <<en>> The battery's charge in percent
  #
  # 電池の無い端末では nil。
  # ```ruby
  # FmrbApp.battery_level
  # ```
  # <<en>>
  # nil where there is no battery value.
  # ```ruby
  # FmrbApp.battery_level
  # ```
  def self.battery_level: () -> Integer?

  # 電池を充電中か <<en>> Whether the battery is charging
  #
  # ```ruby
  # FmrbApp.battery_charging?
  # ```
  def self.battery_charging?: () -> bool

  # ブラウン管の見た目の今の設定 <<en>> The CRT look now
  #
  # 描けない所では "" 。ほかは "crt" か "sharp" と 8 つの強さ。
  # <<en>>
  # "" where it cannot be drawn, else "crt" or "sharp" and the eight
  # strengths, e.g. "crt,55,30,30,15,40,0,0,0".
  def self.crt_state: () -> String

  # Linux のコマンドが使えるか <<en>> Whether Linux commands run here
  #
  # ネイティブ版と sim だけ true。
  # <<en>>
  # true on the native program and in the simulation.
  def self.linux_available?: () -> bool

  # Linux のコマンドを端末で始める <<en>> Start a Linux command in a terminal
  #
  # 返すのは番号。始められないときは例外。cmd が nil ならシェル。
  # ```ruby
  # h = FmrbApp.linux_start("ls",
  #       "/home", 80, 24)
  # ```
  # <<en>>
  # Answers a handle; raises when it cannot start. A nil cmd is a shell.
  # ```ruby
  # h = FmrbApp.linux_start("ls",
  #       "/home", 80, 24)
  # ```
  def self.linux_start: (String? cmd, String cwd, Integer cols, Integer rows) -> Integer

  # Linux のコマンドの出力を読む <<en>> Read a Linux command's output
  #
  # まだ無ければ ""、終わったら nil。待たない。
  # ```ruby
  # s = FmrbApp.linux_read(h)
  # ```
  # <<en>>
  # "" when there is none yet, nil once it ended. Never waits.
  # ```ruby
  # s = FmrbApp.linux_read(h)
  # ```
  def self.linux_read: (Integer h) -> String?

  # Linux のコマンドに書く <<en>> Write to a Linux command
  #
  # ```ruby
  # FmrbApp.linux_write(h, "q")
  # ```
  def self.linux_write: (Integer h, String data) -> Integer

  # Linux のコマンドにシグナルを送る <<en>> Send a signal to a Linux command
  #
  # :int・:term・:kill・:hup。
  # ```ruby
  # FmrbApp.linux_signal(h, :int)
  # ```
  # <<en>>
  # :int, :term, :kill or :hup.
  # ```ruby
  # FmrbApp.linux_signal(h, :int)
  # ```
  def self.linux_signal: (Integer h, Symbol sig) -> bool

  # Linux のコマンドの終わりの値 <<en>> A Linux command's exit code
  #
  # 動いている間は nil。
  # <<en>>
  # nil while it runs.
  def self.linux_exit_code: (Integer h) -> Integer?

  # Linux のコマンドの端末の大きさを変える <<en>> Resize a Linux command's terminal
  #
  # ```ruby
  # FmrbApp.linux_resize(h, 80, 24)
  # ```
  def self.linux_resize: (Integer h, Integer cols, Integer rows) -> bool

  # Linux のコマンドを閉じる <<en>> Close a Linux command
  #
  # まだ動いていれば止める。待たない。
  # <<en>>
  # Ends it if it still runs; never waits.
  def self.linux_close: (Integer h) -> void
end
