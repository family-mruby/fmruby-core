# アプリの土台。実装は lib/add/picoruby-fmrb-app/mrblib/fmrb-app.rb と
# ports/esp32/app.c、Spinel 版は main/prebuild_scripts/spinel/
# fmrb_app_base_spinel.rb。
#
# 省略可能引数とキーワード引数は型推論エンジンが扱えないので、よく使う
# 呼び方を必須引数だけの形にして書いてある (sig/README.md)。

class FmrbApp
  # 絵を描く画面
  @gfx: FmrbGfx

  # 絵を描く画面
  def gfx: () -> FmrbGfx

  # ---- 名前や大きさ ----

  # アプリの名前
  def name: () -> String

  # 動いている最中かどうか
  def running: () -> bool

  # 窓の横幅 (ドット)
  def window_width: () -> Integer

  # 窓の高さ (ドット)
  def window_height: () -> Integer

  # 窓の左上の位置
  def pos_x: () -> Integer

  # 窓の左上の位置
  def pos_y: () -> Integer

  # 動いている機械の種類
  def platform: () -> String

  # 全画面かどうか
  def fullscreen: () -> bool

  # 窓の角が丸いかどうか
  def rounded_corners: () -> bool

  # 閉じるボタンで終われるか
  def closable: () -> bool

  # ---- 呼ばれるところ (書きかえて使う) ----

  # 始まるときに一度だけ呼ばれる
  #
  # 画面も窓もここで使える状態になっています。最初の絵と、あとで使う変数を
  # ここで用意します。
  #
  # ファイルに書いたアプリは、**末尾に起動の 4 行が要ります**。これが無いと
  # クラスを定義しただけで何も起きません。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @n = 0
  #     clear_user_area
  #     gfx.present
  #   end
  # end
  #
  # begin
  #   MyApp.new.start
  # rescue => e
  #   Log.error("#{e.class}: #{e.message}")
  # end
  # ```
  # <<en>>
  # The screen and the window are ready by the time this runs. Set up the
  # first frame and whatever state the app will keep.
  #
  # An app written to a file **needs the four starting lines at the end**;
  # without them the class is defined and nothing happens.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @n = 0
  #     clear_user_area
  #     gfx.present
  #   end
  # end
  #
  # begin
  #   MyApp.new.start
  # rescue => e
  #   Log.error("#{e.class}: #{e.message}")
  # end
  # ```
  def on_create: () -> void

  # 毎フレーム呼ばれる。描画を書く場所 <<en>> called every frame; draw here
  #
  # アプリが動いているあいだ、くり返し呼ばれます。ここに 1 フレーム分の
  # 描画を書きます。動きは、呼ばれるたびに位置を少しずつ変えて作ります。
  #
  # 中で止まると他のアプリまで止まるので、**ここで長く待たない**こと。
  # 時間をおきたいときは `set_timer` を使います。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @x = 0
  #   end
  #
  #   def on_update
  #     @x = (@x + 1) % window_width
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.fill_circle(@x, 60, 8,
  #                     FmrbGfx::YELLOW)
  #     gfx.present
  #   end
  # end
  # ```
  # <<en>>
  # Called over and over while the app runs. Draw one frame's worth of graphics
  # here; movement comes from changing the position a little on each call.
  #
  # Blocking in here blocks the other apps too, so **never wait long in this
  # method**. Use `set_timer` when something has to happen later.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_create
  #     @x = 0
  #   end
  #
  #   def on_update
  #     @x = (@x + 1) % window_width
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.fill_circle(@x, 60, 8,
  #                     FmrbGfx::YELLOW)
  #     gfx.present
  #   end
  # end
  # ```
  def on_update: () -> void

  # 終わるときに一度だけ呼ばれる
  #
  # 終わる直前に一度だけ呼ばれます。開いたファイルを閉じる、保存する、と
  # いった後始末をここに書きます。
  #
  # 呼ばれるのは**行儀よく終わったとき**だけです。例外で落ちたアプリはここに
  # 来ません。消えて困るものは、終わりを待たずに書き出しておくこと。
  # <<en>>
  # Called once, just before the app ends: close files, save what should be
  # saved.
  #
  # It runs only on an orderly exit. An app that dies on an exception never
  # gets here, so anything that must not be lost should be written out
  # before then.
  def on_destroy: () -> void

  # 他のアプリに画面を渡すとき
  #
  # 別のアプリが前に出たときに呼ばれます。アプリは動いたままで、画面だけが
  # 見えなくなります。**描いても誰も見ていない**ので、重い描画や音を
  # 止めるならここです。
  # <<en>>
  # Called when another app comes to the front. This app keeps running; only
  # its screen goes away. Nobody is looking at what it draws, so this is
  # where to stop an expensive animation or a sound.
  def on_suspend: () -> void

  # 画面が戻ってきたとき
  #
  # 画面が戻ってきたときに呼ばれます。**画面の中身は残っていません** —
  # ここで描き直します。
  # <<en>>
  # Called when this app gets the screen back. What was on it is gone;
  # redraw here.
  def on_resume: () -> void

  # キーやマウスの入力が来たとき <<en>> called on key and mouse input
  #
  # ev は入力の中身が入った Hash です。よく使うのは次の 4 つ:
  #
  # - `ev[:type]` … `:key_down` `:mouse_up` など、何が起きたか
  # - `ev[:scancode]` … 押されたキーの番号。**文字ではなくこちらで見ます**
  #   (かな入力のときも同じ番号が届くため)
  # - `ev[:x]` `ev[:y]` … マウスの位置
  #
  # Ctrl や Shift が押されていたかは `ev_ctrl?(ev)` などで調べます。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_event(ev)
  #     return unless
  #       ev[:type] == :key_down
  #     case ev[:scancode]
  #     when 0x4F then @x += 4  # 右
  #     when 0x50 then @x -= 4  # 左
  #     end
  #   end
  # end
  # ```
  # <<en>>
  # ev is a Hash describing the input. Four fields cover most uses:
  #
  # - `ev[:type]` -- what happened: `:key_down`, `:mouse_up` and so on
  # - `ev[:scancode]` -- the key's number. **Look at this, not the character**
  #   (kana input delivers the same numbers)
  # - `ev[:x]` `ev[:y]` -- where the mouse is
  #
  # Use `ev_ctrl?(ev)` and friends to see whether Ctrl or Shift was held.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_event(ev)
  #     return unless
  #       ev[:type] == :key_down
  #     case ev[:scancode]
  #     when 0x4F then @x += 4  # right
  #     when 0x50 then @x -= 4  # left
  #     end
  #   end
  # end
  # ```
  def on_event: (Hash ev) -> void

  # 窓の大きさが変わったとき
  #
  # 窓の大きさが変わったときに呼ばれます。全画面への切り替えでも呼ばれます。
  #
  # **FmrbUI の部品は作った場所に貼り付いたまま**なので、大きさが変わったら
  # 作り直しが要ります。枠も描き直します。
  #
  # ```ruby
  # def on_resize(w, h)
  #   detach_ui(@ui) if @ui
  #   @ui = FmrbUI.new(self)
  #   build_widgets
  #   redraw
  # end
  # ```
  # <<en>>
  # Called when the window changes size, and when it enters or leaves full
  # screen.
  #
  # **FmrbUI widgets stay where they were built**, so a resize means building
  # them again. Redraw the frame too.
  #
  # ```ruby
  # def on_resize(w, h)
  #   detach_ui(@ui) if @ui
  #   @ui = FmrbUI.new(self)
  #   build_widgets
  #   redraw
  # end
  # ```
  def on_resize: (Integer new_width, Integer new_height) -> void

  # 閉じてよいか聞かれたとき
  def on_quit_request: () -> void

  # ---- 動かす ----

  # アプリを動かし始める
  #
  # `on_create` を呼び、アプリのループに入り、終わったら後始末をします。
  # **これを呼ぶまでアプリは動きません。**
  #
  # ファイルに書いたアプリは、クラスの定義だけでは何も起きません。末尾に
  # `MyApp.new.start` を書きます。`rescue` を添えておくと、失敗が
  # ログに残ります。
  # <<en>>
  # Calls `on_create`, runs the app's loop, and cleans up when it ends.
  # **Nothing happens until this is called.**
  #
  # A file that only defines a class does nothing. End it with
  # `MyApp.new.start`, and wrap it in a `rescue` so a failure reaches the log.
  def start: () -> void

  # アプリを止める
  def stop: () -> void

  # 使った物を片づける
  def destroy: () -> void

  # 自分をもう一度読み込み直す
  def request_reload: () -> void

  # 呼ばれ続ける本体の繰り返し
  def main_loop: () -> void

  # ---- 窓と絵 ----

  # 窓のふちと題名を描き直す
  #
  # タイトルバーとわく、閉じるボタンを描きます。全画面のときは何もしません。
  #
  # **大きさの変わるアプリは、描き直すたびに呼ぶこと。** 一度描いたきりに
  # すると、窓を広げたときにわくが壊れます。
  #
  # タイトルバーは既定のフォントで描かれますが、**呼ぶ前のフォント設定は
  # 戻されます**。`set_font(:ja)` を毎フレーム掛け直す必要はありません。
  # <<en>>
  # Draws the title bar, the border and the close button. Does nothing in
  # full screen.
  #
  # **An app that can be resized must call this on every redraw.** Drawing
  # the frame once leaves it broken the first time the window grows.
  #
  # The title bar uses the default font, but the font in force before the
  # call is put back, so `set_font(:ja)` does not have to be re-applied
  # every frame.
  def draw_window_frame: () -> void

  # 中身の場所をぬりつぶす。色を省くとテーマの紙の色 <<en>> theme page colour by default
  #
  # 窓の中だけを塗りつぶします。**わくも描き直し**、その場所にあった
  # FmrbUI の部品にも描き直しの印を付けます。窓のアプリで画面を消すときは
  # `gfx.clear` ではなくこちらを使います。
  #
  # `gfx.clear` は canvas 全体を塗るので、自分で描いたタイトルバーもわくも
  # 消えます。
  # <<en>>
  # Wipes the user area only -- and puts the frame back, and marks any FmrbUI
  # widget standing in the wiped area for redrawing. In a windowed app this
  # is what to use, not `gfx.clear`.
  #
  # `gfx.clear` paints the whole canvas, taking the title bar and the border
  # with it.
  def clear_user_area: () -> void

  # ---- テーマの色 (system_conf.toml の [theme]) ----

  # 紙の色 <<en>> page background from the system theme
  def theme_bg: () -> Integer

  # 紙に書く字の色 <<en>> ink for text on theme_bg
  def theme_fg: () -> Integer

  # 目立たせる色 <<en>> selection / emphasis colour
  def theme_accent: () -> Integer

  # 線や枠、うすい字の色 <<en>> rules, boxes, muted text
  def theme_border: () -> Integer

  # 濃い地の上に書く字の色 <<en>> ink on accent or button backgrounds
  def theme_fg_light: () -> Integer

  # 右はしに巻物のつまみを描く
  def draw_scrollbar: (Integer scroll, Integer total, Integer visible) -> void

  # つまみのどこを押したか調べる
  def scrollbar_hit: (Integer click_x, Integer click_y) -> Symbol?

  # 窓を動かす
  def set_window_position: (Integer x, Integer y) -> FmrbApp

  # 全画面にするか元に戻すか頼む
  #
  # 全画面と窓を切り替えるよう頼みます。**すぐには変わりません** — VM は
  # 動いたまま、答えは `on_resize` として返ってきます。そのときには
  # `fullscreen` も窓の中の大きさも新しい値になっています。
  #
  # 描き直しは `on_resize` に書きます。ここでは書きません。
  # <<en>>
  # Asks to switch between full screen and a window. **Nothing changes
  # immediately** -- the VM keeps running and the answer arrives as
  # `on_resize`, by which time `fullscreen` and the user area are the new
  # ones.
  #
  # Redraw in `on_resize`, not here.
  def request_fullscreen: (bool on) -> void

  # 全画面と窓を切りかえる
  def toggle_fullscreen: () -> void

  # 自分用の画面をもう一枚作る
  #
  # このアプリの持ちものとして canvas をもう 1 枚作り、それに結び付いた
  # FmrbGfx を返します。終了時 (異常終了も含む) に自動で消えます。
  #
  # **呼び方はキーワード引数です** — 上のシグネチャは型推論の都合で
  # 位置引数の形に直してあります。実際にはこう書きます:
  #
  # ```ruby
  # g = create_canvas_gfx(
  #   width: 200, height: 100)
  # g.present(20, 40)
  # ```
  #
  # **全画面のアプリ向け**です。窓のアプリで使うと、フォーカスが移ったとき
  # に窓の管理側が追いかけてくれません。
  # <<en>>
  # Makes another canvas owned by this app and returns an FmrbGfx bound to
  # it. It is deleted when the app ends, a crash included.
  #
  # **It takes keyword arguments** -- the signature above is written
  # positionally because the type engine has no keywords. The real call is:
  #
  # ```ruby
  # g = create_canvas_gfx(
  #   width: 200, height: 100)
  # g.present(20, 40)
  # ```
  #
  # **Meant for fullscreen apps.** The window manager does not follow extra
  # canvases across a change of focus.
  def create_canvas_gfx: (Integer width, Integer height) -> FmrbGfx

  # 作った画面を片づける
  def delete_canvas_gfx: (FmrbGfx gfx) -> void

  # ---- キーの調べかた (on_event の中で使う) ----

  # Ctrl を押していたかどうか
  #
  # Ctrl が押されていたかを返します。左右どちらでも真です。
  #
  # 文字のキーを見分けるときは **`ev[:scancode]` を使うこと**。
  # `ev[:keycode]` は環境で変わります (Linux では SDL の値が来ます) が、
  # scancode は どこでも同じ USB HID の番号です。
  #
  # ```ruby
  # # Ctrl+S
  # if ev_ctrl?(ev) &&
  #    ev[:scancode] == 0x16
  # ```
  # <<en>>
  # Whether Ctrl was held; either side counts.
  #
  # Match letter keys on **`ev[:scancode]`**. `ev[:keycode]` differs between
  # platforms (SDL values on Linux), while the scancode is the same USB HID
  # number everywhere.
  #
  # ```ruby
  # # Ctrl+S
  # if ev_ctrl?(ev) &&
  #    ev[:scancode] == 0x16
  # ```
  def ev_ctrl?: (Hash ev) -> bool

  # Shift を押していたかどうか
  def ev_shift?: (Hash ev) -> bool

  # Alt を押していたかどうか
  def ev_alt?: (Hash ev) -> bool

  # ---- 時間と伝言 ----

  # 決まった時間ごとに呼んでもらう
  #
  # interval ミリ秒後に一度だけブロックを呼びます。**繰り返しません** —
  # 続けたいならブロックの中でもう一度 `set_timer` を呼びます。
  #
  # 呼ばれる時刻はアプリのループの刻みに丸められるので、**ミリ秒どおりには
  # 来ません**。戻り値は `clear_time` に渡す番号です。
  #
  # Spinel で動かすアプリでは、**ブロックの外側のローカル変数を掴めません**
  # (インスタンス変数と定数は使えます)。
  #
  # ```ruby
  # @id = set_timer(500) { blink }
  # ```
  # <<en>>
  # Calls the block once, interval milliseconds later. **It does not
  # repeat** -- call `set_timer` again inside the block for that.
  #
  # The moment it fires is rounded to the app loop's own tick, so it is not
  # accurate to the millisecond. The return value is the id `clear_time`
  # takes.
  #
  # Under Spinel a stored block **cannot capture an outer local variable**
  # (instance variables and constants are fine).
  #
  # ```ruby
  # @id = set_timer(500) { blink }
  # ```
  def set_timer: (Integer interval) -> Integer

  # 時間の呼び出しをやめる
  def clear_time: (Integer timer_id) -> void

  # 知らせを受け取るようにする
  def subscribe: (String topic) -> void

  # 知らせを受け取るのをやめる
  def unsubscribe: (String topic) -> void

  # みんなに知らせを送る
  #
  # topic の名前で、購読しているアプリ全部にデータを配ります。
  #
  # **1 通で送れるのは 176 バイトまで**です。大きなものは `/tmp` に書いて
  # **その場所だけを配る**のが定石です (`/tmp` はメモリの上にあり、
  # 再起動で消えます)。
  # <<en>>
  # Sends data to every app subscribed to that topic.
  #
  # **One message carries at most 176 bytes.** For anything larger, write it
  # to `/tmp` and publish the path instead (`/tmp` lives in memory and is
  # gone on the next boot).
  def publish: (String topic) -> void

  # 他のアプリに伝言を送る
  def send_message: (Integer dest_pid, Integer msg_type, untyped data) -> void

  # ---- ファイル ----

  # ファイルを選ぶ窓を出してもらう
  def request_file_select: (String mode) -> void

  # ファイルをアプリとして動かす
  def request_run: (String path) -> void

  # ---- 後片づけの調子 ----

  # ひまな時に片づけをするか
  def idle_gc: () -> bool

  # ---- クラスメソッド ----

  # 今の言葉 ("ja" か "en")
  def self.language: () -> String

  # 動いているアプリの一覧
  def self.ps: () -> Array

  # アプリ一覧が変わった回数
  def self.ps_gen: () -> Integer

  # 空きメモリの様子
  def self.heap_info: () -> Hash

  # 自分のメモリの使用率 (百分率)
  def self.pool_usage: () -> Integer

  # 機械全体のメモリの様子
  def self.sys_pool_info: () -> Hash

  # 設定ファイルの中身を読む
  def self.config: (String section_name) -> Array?

  # 電源を入れてからの時間 (百万分の一秒)
  def self.uptime_us: () -> Integer

  # 今の日付と時刻
  def self.wallclock: () -> Hash?

  # 日付と時刻を合わせる
  def self.set_wallclock: (Integer year, Integer month, Integer day, Integer hour, Integer minute, Integer second) -> Hash?

  # 絵を送った回数の記録
  def self.gfx_stats: () -> Hash

  # マウスの矢印を出す
  def self.enable_cursor: () -> void

  # マウスの矢印を見せるか隠すか
  def self.set_cursor_visible: (bool visible) -> void

  # 機械を再起動する
  def self.reboot: () -> void

  # かな入力を切りかえる (0 切 1 ひら 2 カタ)
  def self.set_kana_mode: (Integer mode) -> void

  # Bluetooth をはじめる
  def self.ble_start: () -> bool

  # Bluetooth の様子
  def self.ble_state: () -> Integer

  # 画面を配信中かどうかの様子
  def self.rd_stream_state: () -> Integer

  # WiFi がつながっているか
  def self.wifi_connected?: () -> bool

  # WiFi のつながり具合
  def self.wifi_info: () -> Hash?

  # つないだ USB 機器の一覧
  def self.usb_devices: () -> Array

  # USB の生の入力を受け取る
  def self.hid_raw_subscribe: (Integer slot) -> bool

  # USB の生の入力をやめる
  def self.hid_raw_unsubscribe: (Integer slot) -> bool
end
