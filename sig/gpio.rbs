# Minimal GPIO for host_test (static method suggestion).
#
# Kept in step with the engine's own sig/gpio.rbs: its tests use these
# declarations (the constants for constant completion, attach for the
# subclass-argument check). Add to it rather than removing from it.

class GPIO
  @pin: Integer
  @label: String

  # low level (0V)
  LOW: Integer
  # high level (3.3V)
  HIGH: Integer
  PULL_UP: Integer

  def self.new: (Integer pin, Integer mode) -> GPIO
  def write: (Integer value) -> nil
  def read: () -> Integer
  def attach: (GPIO other) -> nil
end
