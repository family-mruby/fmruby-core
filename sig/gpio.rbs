# GPIO (GPIO)。
# 実装は picoruby の gem picoruby-gpio (mrblib/gpio.rb、src/mruby/gpio.c、include/gpio.h) と、
# 端末側のつなぎ lib/upstream/picoruby-gpio-proxy/gpio.c -> main/drivers/hw_proxy/hw_proxy_gpio.c。
# **入るのは ESP32 の実機 (S3・P4) だけ**。Linux sim・ネイティブ版・ブラウザ版には `GPIO` が無く、
# NameError になる。同梱のアプリで `GPIO` を使うのは step_sensor (StickS3 の KEY1 を入力で読む) だけ。
# ピンはピンの台帳 (`FmrbHw.pin_status`) に照らす: 空いているピンは最初に設定したアプリの物になり、
# アプリが終わると返る。システムのピン (台帳に取られていない画面・SD・無線・音・システムの I2C
# などのピンも、機種ごとの表で) は断られる。ただし**本体のボタン** (StickS3 の 11・12、
# AtomS3R の 41、NARYA v3 の 6・7・8) は、入力として設定して読むことだけできる。
# 注: tools/ti/test_sig/gpio.rbs は型エンジンの試験用の見本で、ファイル名が同じなので試験のときは
# そちらが優先される。

# 1 本のピンを入れ出力に使う <<en>> Use one pin as input or output
#
# `GPIO.new(ピン, フラグ)` で作り、`read` と `write` を使う。フラグは `GPIO::IN | GPIO::PULL_UP`
# のように `|` でつなぐ。**ピンは整数だけ**。使ってよいピンは `FmrbHw.pin_available?` で調べる
# (システムのピン・使用中のピンは IOError になる)。
# ```ruby
# led = GPIO.new(5, GPIO::OUT)
# led.write(1)
# ```
# <<en>>
# `GPIO.new(pin, flags)` makes it, then `read` and `write`.
# Join flags with `|`, as in `GPIO::IN | GPIO::PULL_UP`. **A pin is an integer only.** Check
# with `FmrbHw.pin_available?` which pins you may use (a system pin or one in use raises IOError).
# ```ruby
# led = GPIO.new(5, GPIO::OUT)
# led.write(1)
# ```
class GPIO
  # 入力 <<en>> Input
  IN: Integer
  # 出力 <<en>> Output
  OUT: Integer
  # ハイインピーダンス <<en>> High impedance
  #
  # この端末では入力と同じに設定される。
  # <<en>>
  # It is set up as an input here.
  HIGH_Z: Integer
  # プルアップ <<en>> Pull-up
  PULL_UP: Integer
  # プルダウン <<en>> Pull-down
  PULL_DOWN: Integer
  # オープンドレイン (この端末では何もしない) <<en>> Open drain (does nothing here)
  OPEN_DRAIN: Integer
  # 代替機能 (この端末では何もしない) <<en>> Alternate function (does nothing here)
  ALT: Integer

  # ピンを開く <<en>> Open a pin
  #
  # `flags` に `IN`・`OUT`・`HIGH_Z` のどれか **1 つ**と、必要なら `PULL_UP` か `PULL_DOWN` を `|` で渡す。
  # `alt_function` (省略すると 0) は ALT 用で、この端末では効かない。
  #
  # 作るときにピンの台帳へ取る。**取れないときは IOError で、ピンの設定 (向き・プル) は変えない**:
  # システムのピン (`FmrbHw.pin_status` が `PIN_SYSTEM_EXCLUSIVE` のピン) は "GPIO n is used by the
  # system"、ほかのアプリ (または I2C などの別の使い方) が
  # 持っているピンは "GPIO n is in use by another app or driver"。**本体のボタン**は台帳には取らず、
  # `IN` (プルつきも) でだけ開ける。`OUT` などで開くと "GPIO n is a system button: input only"。
  # 取ったピンはアプリが終わると台帳へ返る。
  #
  # 文字列・Symbol のピンは ArgumentError ("Wrong GPIO pin name")、負の数も同じ。端末に無い番号は
  # ArgumentError ("GPIO n does not exist on this board")。方向が無い・
  # 2 つ以上は ArgumentError ("You must specify one of IN, OUT, HIGH_Z, and ALT"・
  # "IN, OUT and HIGH_Z are exclusive")、`PULL_UP` と `PULL_DOWN` の両方も ArgumentError。
  # ```ruby
  # sw = GPIO.new(7, GPIO::IN | GPIO::PULL_UP)
  # ```
  # <<en>>
  # Pass in `flags` **one** of `IN`, `OUT` and `HIGH_Z`, plus `PULL_UP` or `PULL_DOWN` if
  # needed, joined with `|`. `alt_function` (0 when left out) is for ALT and has no effect here.
  #
  # The pin is claimed in the pin table.
  # **When it cannot be, IOError is raised and the pin's setup (direction, pull) is left alone**:
  # a system pin (one `FmrbHw.pin_status` gives as `PIN_SYSTEM_EXCLUSIVE`) is "GPIO n is used by
  # the system", a pin another app (or another use such as I2C) holds is "GPIO n is in use by
  # another app or driver".
  # **The board's buttons** are not claimed and open with `IN` (pulls too) only; `OUT` and the like
  # raise "GPIO n is a system button: input only". A claimed pin goes back to the table when the
  # app ends.
  #
  # A String or Symbol pin is an ArgumentError ("Wrong GPIO pin name"), and so is a negative
  # number; a number this board does not have is an ArgumentError ("GPIO n does not exist on
  # this board"). No direction, or two or more, is an ArgumentError ("You must specify one of IN, OUT,
  # HIGH_Z, and ALT", "IN, OUT and HIGH_Z are exclusive"), and so are both `PULL_UP` and `PULL_DOWN`.
  # ```ruby
  # sw = GPIO.new(7, GPIO::IN | GPIO::PULL_UP)
  # ```
  def self.new: (Integer pin, Integer flags, ?Integer alt_function) -> GPIO

  # ピン番号 <<en>> The pin number
  #
  # ```ruby
  # led.pin   #=> 5
  # ```
  def pin: () -> Integer

  # 向きとプルを設定し直す <<en>> Set direction and pull again
  #
  # `new` と同じ組み合わせを渡せる。**向きのフラグを渡さなければ向きは今のまま**、プルも同じ。
  # 戻り値は 0。本体のボタンを出力にしようとすると IOError。
  # ```ruby
  # sw.setmode(GPIO::IN | GPIO::PULL_DOWN)
  # ```
  # <<en>>
  # Takes the same combinations as `new`. **Without a direction flag the direction stays as**
  # **it is**, and so does the pull. Returns 0. Making a board button an output raises IOError.
  # ```ruby
  # sw.setmode(GPIO::IN | GPIO::PULL_DOWN)
  # ```
  def setmode: (Integer flags, ?Integer alt_function) -> Integer

  # 読む (0 か 1) <<en>> Read the level (0 or 1)
  #
  # 読めなかったときは IOError ("GPIO n could not be read")。
  # ```ruby
  # sw.read   #=> 0 か 1
  # ```
  # <<en>>
  # IOError ("GPIO n could not be read") when the level cannot be read.
  # ```ruby
  # sw.read   #=> 0 or 1
  # ```
  def read: () -> Integer

  # 書く (0 か 1) <<en>> Write the level (0 or 1)
  #
  # 0 と 1 以外は ArgumentError ("Wrong value. 0 and 1 are only valid")。戻り値は 0。
  # 出力に設定したピンに使う。本体のボタンでは IOError ("... input only")。
  # ```ruby
  # led.write(1)
  # ```
  # <<en>>
  # Anything but 0 and 1 is an ArgumentError ("Wrong value. 0 and 1 are only valid"). Returns 0.
  # Use it on a pin set as an output. On a board button it raises IOError ("... input only").
  # ```ruby
  # led.write(1)
  # ```
  def write: (Integer value) -> Integer

  # 高いか <<en>> Whether the level is high
  #
  # 読んだ値が 0 でなければ true。読めなかったときは IOError。
  # ```ruby
  # pressed = !sw.high?
  # ```
  # <<en>>
  # true when the value read is not 0. IOError when the level cannot be read.
  # ```ruby
  # pressed = !sw.high?
  # ```
  def high?: () -> bool

  # 低いか <<en>> Whether the level is low
  #
  # 読んだ値が 0 なら true。読めなかったときは IOError。
  # ```ruby
  # pressed = sw.low?
  # ```
  # <<en>>
  # true when the value read is 0. IOError when the level cannot be read.
  # ```ruby
  # pressed = sw.low?
  # ```
  def low?: () -> bool

  # ピン番号で向きを設定する <<en>> Set direction by pin number
  #
  # `GPIO.new` と同じく台帳に照らす: 空いているピンはこのアプリの物になり、システムのピン・
  # 使用中のピンは IOError (設定は変えない)。本体のボタンは `IN` だけ。ほかの設定は覚えない。
  # `dir` は `IN`・`OUT`。戻り値は 0。普通は `GPIO.new` を使う。
  # ```ruby
  # GPIO.set_dir_at(5, GPIO::OUT)
  # ```
  # <<en>>
  # Checked against the pin table as `GPIO.new` is: a free pin becomes this app's, a system pin
  # or one in use raises IOError (nothing is changed). A board button takes `IN` only. Nothing
  # else is remembered. `dir` is `IN` or `OUT`. Returns 0. Normally use `GPIO.new`.
  # ```ruby
  # GPIO.set_dir_at(5, GPIO::OUT)
  # ```
  def self.set_dir_at: (Integer pin, Integer dir) -> Integer

  # ピン番号でプルアップにする <<en>> Pull a pin up by number
  #
  # `set_dir_at` と同じく台帳に照らす (本体のボタンにもかけられる)。戻り値は 0。
  # ```ruby
  # GPIO.pull_up_at(7)
  # ```
  # <<en>>
  # Checked against the pin table like `set_dir_at` (a board button takes it too). Returns 0.
  # ```ruby
  # GPIO.pull_up_at(7)
  # ```
  def self.pull_up_at: (Integer pin) -> Integer

  # ピン番号でプルダウンにする <<en>> Pull a pin down by number
  #
  # `set_dir_at` と同じく台帳に照らす (本体のボタンにもかけられる)。戻り値は 0。
  # ```ruby
  # GPIO.pull_down_at(7)
  # ```
  # <<en>>
  # Checked against the pin table like `set_dir_at` (a board button takes it too). Returns 0.
  # ```ruby
  # GPIO.pull_down_at(7)
  # ```
  def self.pull_down_at: (Integer pin) -> Integer

  # ピン番号でオープンドレインにする (何もしない) <<en>> Open drain by number (does nothing)
  #
  # この端末のつなぎは何もせず、戻り値は 0。出力と同じく台帳に照らす (断られると IOError)。
  # ```ruby
  # GPIO.open_drain_at(7)
  # ```
  # <<en>>
  # This machine's link does nothing. Returns 0. Checked against the pin table as an output (IOError when refused).
  # ```ruby
  # GPIO.open_drain_at(7)
  # ```
  def self.open_drain_at: (Integer pin) -> Integer

  # ピン番号で代替機能にする (何もしない) <<en>> Alternate function by number (does nothing)
  #
  # この端末のつなぎは何もせず、戻り値は 0。出力と同じく台帳に照らす (断られると IOError)。
  # ```ruby
  # GPIO.set_function_at(7, 1)
  # ```
  # <<en>>
  # This machine's link does nothing. Returns 0. Checked against the pin table as an output (IOError when refused).
  # ```ruby
  # GPIO.set_function_at(7, 1)
  # ```
  def self.set_function_at: (Integer pin, Integer function) -> Integer

  # ピン番号で読む <<en>> Read by pin number
  #
  # 0 か 1。**読むだけなので、システムのピンも使用中のピンも読める** (台帳に取らず、設定も変えない)。
  # 読めなかったときは IOError。文字列・Symbol・負の数・端末に無い番号は ArgumentError。
  # ```ruby
  # GPIO.read_at(7)
  # ```
  # <<en>>
  # 0 or 1. **Reading changes nothing, so any pin can be read**, a system pin or one in use too
  # (it is not claimed). IOError when it cannot be read. A String, a Symbol, a negative number or
  # a number this board does not have is an ArgumentError.
  # ```ruby
  # GPIO.read_at(7)
  # ```
  def self.read_at: (Integer pin) -> Integer

  # ピン番号で書く <<en>> Write by pin number
  #
  # `GPIO#write` と同じ (0・1 だけ、戻り値は 0)。`set_dir_at` と同じく台帳に照らす: 空いている
  # ピンはこのアプリの物になり、システムのピン (ボタンも)・使用中のピンは IOError。
  # ```ruby
  # GPIO.write_at(5, 1)
  # ```
  # <<en>>
  # Same as `GPIO#write` (0 or 1 only; returns 0). Checked against the pin table like
  # `set_dir_at`: a free pin becomes this app's; a system pin (a button too) or one in use raises IOError.
  # ```ruby
  # GPIO.write_at(5, 1)
  # ```
  def self.write_at: (Integer pin, Integer value) -> Integer

  # ピン番号で高いか <<en>> Whether a pin is high, by number
  #
  # 読んだ値が 0 でなければ true。`read_at` と同じく、どのピンも読める。読めなければ IOError。
  # ```ruby
  # GPIO.high_at?(7)
  # ```
  # <<en>>
  # True when the value read is not 0. Any pin can be read, as with `read_at`; IOError when it cannot be.
  # ```ruby
  # GPIO.high_at?(7)
  # ```
  def self.high_at?: (Integer pin) -> bool

  # ピン番号で低いか <<en>> Whether a pin is low, by number
  #
  # 読んだ値が 0 なら true。`read_at` と同じく、どのピンも読める。読めなければ IOError。
  # ```ruby
  # GPIO.low_at?(7)
  # ```
  # <<en>>
  # True when the value read is 0. Any pin can be read, as with `read_at`; IOError when it cannot be.
  # ```ruby
  # GPIO.low_at?(7)
  # ```
  def self.low_at?: (Integer pin) -> bool

  # GPIO の周辺機器の失敗の番号と例外 <<en>> Peripheral error codes and their exceptions
  #
  # 定数 `GPIO_ERROR_NONE` (0)・`TIMEOUT` (-1)・`GENERIC` (-2)・`NO_DATA` (-3)・`NOT_PERMITTED` (-4)・
  # `INVALID_ARG` (-5)・`IO` (-6) は番号。
  # <<en>>
  # The constants `GPIO_ERROR_NONE` (0), `TIMEOUT` (-1), `GENERIC` (-2), `NO_DATA` (-3),
  # `NOT_PERMITTED` (-4), `INVALID_ARG` (-5) and `IO` (-6) are the codes.
  # ```ruby
  # GPIO::Error.peripheral_error(0)   #=> 0
  # ```
  class Error
    # 番号を例外にする <<en>> Turn a code into an exception
    #
    # 0 (`GPIO_ERROR_NONE`) は 0 を返す。それ以外の番号は **IOError** を出す (文は
    # "Timeout error in 名前" の形。知らない番号は "Unknown error in 名前. code: n")。
    # `name` は省略すると "unknown peripheral"。同梱のアプリは呼ばない。
    # ```ruby
    # GPIO::Error.peripheral_error(-1, "uart")
    # ```
    # <<en>>
    # 0 (`GPIO_ERROR_NONE`) returns 0. Any other code raises **IOError** (the message looks like
    # "Timeout error in name"; an unknown code is "Unknown error in name. code: n").
    # `name` is "unknown peripheral" when left out. No bundled app calls it.
    # ```ruby
    # GPIO::Error.peripheral_error(-1, "uart")
    # ```
    def self.peripheral_error: (Integer code, ?String name) -> Integer
  end
end
