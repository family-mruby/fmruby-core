# 地図とタイル。実装は lib/gems/picoruby-fmrb-app/mrblib/fmrb-tilemap.rb。
#
# TileSheet がタイルの絵の一式、TileMap が地図のデータ、
# TileRing は広い地図をなめらかに動かすための仕組み。

# タイルの絵をならべた一枚の絵 <<en>> One picture with tiles laid side by side
#
# 番号でタイルを取り出して描く。
# <<en>>
# Tiles are taken out by number and drawn.
class TileSheet
  # タイルの絵を読み込む <<en>> Load a sheet of tiles
  #
  # 並んだ絵を 1 枚の PNG (か BMP) から読む。**キーワード引数で呼ぶ**
  # (cols: は必須、`tile_size:` は省略すると 16)。path は描画側のパスで、先に
  # sync_file で送る。rows: を省くなら source: に core の側の元の絵を渡す
  # (頭から高さを読む)。
  # ```ruby
  # gfx.sync_file(src, dest: dst)
  # sheet = TileSheet.new(gfx, dst,
  #   cols: 8, source: src)
  # ```
  # <<en>>
  # Reads a grid of pictures from one PNG (or BMP).
  # **Takes keyword arguments** (cols: is required; `tile_size:` is 16 when left
  # out). path is on the graphics side: send it with
  # sync_file first. Without rows:, give source: the picture on this side,
  # whose header has the height.
  # ```ruby
  # gfx.sync_file(src, dest: dst)
  # sheet = TileSheet.new(gfx, dst,
  #   cols: 8, source: src)
  # ```
  def self.new: (FmrbGfx gfx, String path, cols: Integer, ?rows: Integer, ?tile_size: Integer, ?source: String) -> TileSheet

  # 中で使っているうごく絵 <<en>> The sprite image behind it
  #
  # ```ruby
  # img = sheet.image
  # ```
  def image: () -> SpriteImage

  # 横にならぶタイルの数 <<en>> How many tiles across
  #
  # ```ruby
  # n = sheet.cols
  # ```
  def cols: () -> Integer

  # 縦にならぶタイルの数 <<en>> How many tiles down
  #
  # ```ruby
  # n = sheet.rows
  # ```
  def rows: () -> Integer

  # タイル一つの大きさ (ドット) <<en>> One tile's size in pixels
  #
  # ```ruby
  # px = sheet.tile_size
  # ```
  def tile_size: () -> Integer

  # 番号のタイルを画面に一つ描く <<en>> Stamp one numbered tile
  #
  # 置き場所はキーワード (dst_x:, dst_y:) で、原点から。clip_x: など 4 つで
  # 押す範囲を絞れる。nil か負の番号は何もしない。
  # ```ruby
  # sheet.stamp(3, dst_x: x, dst_y: y)
  # ```
  # <<en>>
  # The place is by keyword (dst_x:, dst_y:), from the origin; clip_x: and
  # its three companions narrow what is stamped. nil or a negative number
  # does nothing.
  # ```ruby
  # sheet.stamp(3, dst_x: x, dst_y: y)
  # ```
  def stamp: (Integer? index, dst_x: Integer, dst_y: Integer, ?clip_x: Integer, ?clip_y: Integer, ?clip_w: Integer, ?clip_h: Integer) -> void

  # 絵の高さを頭から読む <<en>> Read a picture's height from its header
  #
  # PNG か BMP のファイルの高さ (ドット) を返す。どちらでもないか読めない
  # ときは 0 (例外は出ない)。`TileSheet.new` が `source:` からタイルの
  # 段数を出すときに使う。
  # ```ruby
  # h = TileSheet.picture_height(src)
  # rows = h / 16
  # ```
  # <<en>>
  # The height in pixels of a PNG or BMP file. 0 when it is neither or
  # cannot be read (no exception). `TileSheet.new` uses it to get the rows
  # from `source:`.
  # ```ruby
  # h = TileSheet.picture_height(src)
  # rows = h / 16
  # ```
  def self.picture_height: (String path) -> Integer

  # このタイルの絵を片づける <<en>> Let go of the sheet
  #
  # ```ruby
  # sheet.destroy
  # ```
  def destroy: () -> void
end

# 地図そのもの <<en>> The map itself
#
# web の地図エディタが書き出した JSON を読む。
# <<en>>
# Reads the JSON that the web map editor writes out.
class TileMap
  # 地図のファイルを読み込む <<en>> Load a map file
  #
  # **`.map.bin` を渡す**。JSON も読めるが、端末では桁違いに遅い
  # (39 秒 対 55 ミリ秒)。
  # ```ruby
  # map = TileMap.new("/app/img/world.map.bin")
  # ```
  # <<en>>
  # **Give it the `.map.bin`.** JSON works and is far slower on a device --
  # 39 seconds against 55 milliseconds.
  # ```ruby
  # map = TileMap.new("/app/img/world.map.bin")
  # ```
  def self.new: (String json_path) -> TileMap

  # 地図の横のマス数 <<en>> The map's width in tiles
  #
  # ```ruby
  # w = map.width
  # ```
  def width: () -> Integer

  # 地図の縦のマス数 <<en>> The map's height in tiles
  #
  # ```ruby
  # h = map.height
  # ```
  def height: () -> Integer

  # マス一つの大きさ (ドット) <<en>> One tile's size in pixels
  #
  # ```ruby
  # px = map.tile_size
  # ```
  def tile_size: () -> Integer

  # 使うタイルの絵のファイル名 <<en>> The tile sheet it uses
  #
  # ```ruby
  # path = map.tilesheet_path
  # ```
  def tilesheet_path: () -> String

  # タイルの絵の横のならび数 <<en>> How many tiles across that sheet is
  #
  # ```ruby
  # n = map.tilesheet_cols
  # ```
  def tilesheet_cols: () -> Integer

  # 重ねた地図のデータ <<en>> The layers of the map
  #
  # `.map.bin` から読んだときは nil (JSON から読んだときだけ配列)。
  # 段の数は `layer_count`、マスは `tile_at` で読む。
  # ```ruby
  # map.layers.length
  # ```
  # <<en>>
  # nil when read from a `.map.bin` (an Array only from JSON). Read the number of layers with `layer_count` and squares with `tile_at`.
  # ```ruby
  # map.layers.length
  # ```
  def layers: () -> Array?

  # 重ねた段の数 <<en>> How many layers the map has
  #
  # `.map.bin` でも JSON でも使える。`tile_at` の `layer:` は 0 から
  # この数より 1 小さい数まで。
  # ```ruby
  # n = map.layer_count
  # ```
  # <<en>>
  # Works for a `.map.bin` and for JSON. The `layer:` of `tile_at` runs from
  # 0 to one less than this.
  # ```ruby
  # n = map.layer_count
  # ```
  def layer_count: () -> Integer

  # 地図に置いた仕掛けの一覧 <<en>> The events placed on the map
  #
  # ```ruby
  # map.events.length
  # ```
  def events: () -> Array

  # 歩いてよいタイルの番号 <<en>> Which tile numbers can be walked on
  #
  # ```ruby
  # map.walkable_tiles
  # ```
  def walkable_tiles: () -> Array

  # 始まりの場所 <<en>> Where the player starts
  #
  # ```ruby
  # @x = map.spawn_x
  # ```
  def spawn_x: () -> Integer

  # 始まりの場所 <<en>> Where the player starts
  #
  # ```ruby
  # @y = map.spawn_y
  # ```
  def spawn_y: () -> Integer

  # そのマスのタイル番号を調べる <<en>> The tile number at that square
  #
  # 地図の外・空のマス・段が無いときは nil。**升目の座標**で、ドットではない。
  # `layer:` (省略すると 0) は何段目か。
  # ```ruby
  # t = map.tile_at(3, 5)
  # ```
  # <<en>>
  # nil outside the map, on an empty square, or when the layer is missing.
  # The coordinates are **tiles**, not pixels. `layer:` (0 when left out)
  # picks the layer.
  # ```ruby
  # t = map.tile_at(3, 5)
  # ```
  def tile_at: (Integer x, Integer y, ?layer: Integer) -> Integer?

  # そのマスを歩けるかどうか <<en>> Whether that square can be walked on
  #
  # ```ruby
  # return unless map.walkable?(nx, ny)
  # ```
  def walkable?: (Integer x, Integer y) -> bool

  # そのマスの仕掛けを取り出す <<en>> The event on that square
  #
  # ```ruby
  # ev = map.event_at(@x, @y)
  # handle(ev) if ev
  # ```
  def event_at: (Integer x, Integer y) -> Hash?

  # 地図ぜんぶを画面に描く <<en>> Draw the whole map
  #
  # 地図を丸ごと描く。大きい地図では**画面ぶんだけの `render_view`** を使う。
  # **`origin_x:` と `origin_y:` は必須** (最初のタイルを canvas のどこに置くか)。`max_cols:`・`max_rows:` (省略すると地図の全部) で描く範囲を切れる。
  # ```ruby
  # @map.render(@sheet,
  #             origin_x: 0, origin_y: 0)
  # ```
  # <<en>>
  # Draws the whole map. For a large one use `render_view`, which draws only
  # what is on screen.
  # **`origin_x:` and `origin_y:` are required** (where the first tile lands on the canvas). `max_cols:` and `max_rows:` (the whole map when left out) clip the region.
  # ```ruby
  # @map.render(@sheet,
  #             origin_x: 0, origin_y: 0)
  # ```
  def render: (TileSheet sheet, origin_x: Integer, origin_y: Integer, ?max_cols: Integer, ?max_rows: Integer) -> void

  # 見えている場所だけを描く <<en>> Draw only what is in sight
  #
  # **キーワード引数で呼ぶ。全部必須**。`origin_x:` `origin_y:` は
  # 見える範囲の左上を canvas のどこに置くか、`view_x:` `view_y:` は
  # その左上が地図のどこか (ドット)。
  # ```ruby
  # map.render_view(sheet,
  #   origin_x: 0, origin_y: 0,
  #   view_x: @cam_x, view_y: @cam_y,
  #   view_w: 320, view_h: 240)
  # ```
  # <<en>>
  # **Takes keyword arguments, all required.** `origin_x:` and `origin_y:`
  # are where the view's top-left lands on the canvas; `view_x:` and
  # `view_y:` are where that corner is on the map, in pixels.
  # ```ruby
  # map.render_view(sheet,
  #   origin_x: 0, origin_y: 0,
  #   view_x: @cam_x, view_y: @cam_y,
  #   view_w: 320, view_h: 240)
  # ```
  def render_view: (TileSheet sheet, origin_x: Integer, origin_y: Integer, view_x: Integer, view_y: Integer, view_w: Integer, view_h: Integer) -> void
end

# 見えている周りだけを描き直す仕組み <<en>> Redraws only what is in view
#
# 広い地図を軽く動かすための仕組み。
# <<en>>
# A mechanism for moving a wide map lightly.
class TileRing
  # 動かすための入れ物を作る <<en>> Make the ring buffer that scrolls
  #
  # 画面より少し大きい canvas を輪のように使い、**新しく見えた列だけ**を
  # 描き足して広い世界をずらす。**Modern 専用**。
  # **`tiles_w:` と `tiles_h:` は必須** (輪にする canvas の大きさ。タイルの数で、見える数 + 1 以上にする)。
  # ```ruby
  # ring = TileRing.new(map, sheet,
  #   tiles_w: 12, tiles_h: 12)
  # ```
  # <<en>>
  # Uses a canvas a little larger than the view as a ring, stamping only the
  # columns that have just come into sight. **Modern only.**
  # **`tiles_w:` and `tiles_h:` are required** (the size of the ring canvas in tiles, at least the visible tiles + 1).
  # ```ruby
  # ring = TileRing.new(map, sheet,
  #   tiles_w: 12, tiles_h: 12)
  # ```
  def self.new: (TileMap map, TileSheet sheet, tiles_w: Integer, tiles_h: Integer) -> TileRing

  # 入れ物の横幅 (ドット) <<en>> The buffer's width in pixels
  #
  # ```ruby
  # w = ring.buf_w
  # ```
  def buf_w: () -> Integer

  # 入れ物の高さ (ドット) <<en>> The buffer's height in pixels
  #
  # ```ruby
  # h = ring.buf_h
  # ```
  def buf_h: () -> Integer

  # 見えてきたところを描き足す <<en>> Stamp the columns that came into sight
  #
  # **毎フレーム、動かしたあとに呼ぶ**。新しく見えた列だけを押すので、
  # 少し動いたときは何もしない。何か描いたら true で、そのとき
  # 輪の canvas を present しないと画面に出ない。
  # ```ruby
  # ring.ensure_view(@cam_x, @cam_y,
  #                  320, 240)
  # ```
  # <<en>>
  # **Call it every frame after moving.** It stamps only the columns that
  # have just come into sight, so a small step costs nothing. true when it
  # drew something, and then the ring's canvas must be presented or nothing
  # reaches the screen.
  # ```ruby
  # ring.ensure_view(@cam_x, @cam_y,
  #                  320, 240)
  # ```
  def ensure_view: (Integer view_x, Integer view_y, Integer view_w, Integer view_h) -> bool
end
