# 音を鳴らす。実装は lib/gems/picoruby-fmrb-app/mrblib/fmrb-audio.rb と
# nsf-header.rb。
#
# FmrbAudio はアプリが持っている音の係。曲を鳴らすのと、
# 音を一つずつ鳴らすのと、両方できる。
#
# FmrbAudio はクラスごと本体との境界に載る (%a{fmrb.boundary}、doc/app_boundary)。
# 境界のメソッドは受け手の番号を取らない (受け手は呼んだアプリ)。省略できる
# 引数を持つメソッド (包み) は %a{fmrb.internal} で、隣に _raw の形がある。

# 音を鳴らす。曲・効果音・WAV・マイク <<en>> Play sound: songs, effects, WAV, microphone
#
# アプリは `@audio = FmrbAudio.new(self)` で作る。NSF の曲は `play` (止めるのは `stop`、
# 一時停止は `pause`・`resume`)、WAV は `play_wav`、音を 1 つずつなら `note_on`・`note_off`、
# FMSQ のデータは `load_fmsq` で読んで `play_slot`。マイクは `mic_available?` で調べて
# `mic_enable`・`mic_read` で読む。MIDI の音符を送るなら FmrbMidi。
# <<en>>
# An app makes one with `@audio = FmrbAudio.new(self)`. A song in NSF is
# played with `play` (`stop` ends it; `pause` and `resume` hold it), a WAV
# with `play_wav`, single notes with `note_on` and `note_off`, and FMSQ data is
# loaded with `load_fmsq` and played with `play_slot`. For
# the microphone, check `mic_available?` and read with `mic_enable` and
# `mic_read`. To send MIDI notes, use FmrbMidi.
%a{fmrb.boundary}
class FmrbAudio
  # nsf_status が返す曲のようす <<en>> Where the song is, from nsf_status
  type nsf_status = { state: uint8, reason: uint8, track: uint8, laps: uint8, gen: uint16, period: uint16, frames: uint32 }

  # 音の係を作る <<en>> Make the sound handler
  #
  # ```ruby
  # @audio = FmrbAudio.new(self)
  # ```
  %a{fmrb.internal}
  def self.new: (FmrbApp app) -> FmrbAudio

  # 曲のファイルを鳴らす <<en>> Play a song file
  #
  # NSF を鳴らす。曲は /usr/share/sounds/nsf にある。`track:` (省略すると 0) は
  # NSF の中の曲の番号。
  # ```ruby
  # @audio.play("/usr/share/sounds/nsf/test.nsf")
  # ```
  # <<en>>
  # Plays an NSF. The tunes live in /usr/share/sounds/nsf. `track:` (0 when
  # left out) is the song inside the NSF.
  # ```ruby
  # @audio.play("/usr/share/sounds/nsf/test.nsf")
  # ```
  %a{fmrb.internal}
  def play: (String path, ?track: Integer) -> void

  # play の省略なしの形 <<en>> play with nothing left out
  #
  # 引数を省略できない単純な形。track は NSF の中の曲の番号 (0 から)。
  # 包みは play (track: を省くと 0)。
  # ```ruby
  # @audio.play_raw("/usr/share/sounds/nsf/test.nsf", 0)
  # ```
  # <<en>>
  # The simple form, with no argument left out. track is the song inside the
  # NSF, from 0. The wrapper is play (track: left out is 0).
  # ```ruby
  # @audio.play_raw("/usr/share/sounds/nsf/test.nsf", 0)
  # ```
  def play_raw: (String path, Integer track) -> void

  # 曲を止める <<en>> Stop the song
  #
  # ```ruby
  # @audio.stop
  # ```
  def stop: () -> void

  # 曲がどこまで進んだかを聞く <<en>> Ask where the song is
  #
  # NSF には長さが無いので、音の側が曲の終わりを決める (無音・ループを
  # 2 周・時間の上限)。終わった曲は音の側で止まる。1 秒に 1 回ほど聞いて、
  # 終わっていたら次の曲へ進む。答えが無いときは nil。
  # ```ruby
  # st = @audio.nsf_status
  # next_song if st && st[:state] == FmrbAudio::NSF_ENDED
  # ```
  # <<en>>
  # An NSF has no length, so the audio side decides when a song is over
  # (silence, its loop heard twice, or a time limit) and stops it. Ask about
  # once a second and move on when it is over. nil when there is no answer.
  # ```ruby
  # st = @audio.nsf_status
  # next_song if st && st[:state] == FmrbAudio::NSF_ENDED
  # ```
  def nsf_status: () -> nsf_status?

  NSF_IDLE: Integer
  NSF_PLAYING: Integer
  NSF_FADING: Integer
  NSF_ENDED: Integer
  NSF_END_SILENCE: Integer
  NSF_END_LOOP: Integer
  NSF_END_LIMIT: Integer

  # 長い曲を置く APU (0) <<en>> The APU for long music (0)
  #
  # `play` と `play_slot` の既定。効果音に使う `SUB` と分けると、効果音が曲を切らない。
  # ```ruby
  # @audio.play_slot(0, instance: FmrbAudio::MAIN)
  # ```
  # <<en>>
  # The default of `play` and `play_slot`. Keep effects on `SUB` so they do
  # not cut the music.
  # ```ruby
  # @audio.play_slot(0, instance: FmrbAudio::MAIN)
  # ```
  MAIN: Integer

  # 効果音の APU (1) <<en>> The APU for short effects (1)
  #
  # `note_on` もここで鳴る。
  # ```ruby
  # @audio.play_slot(1, instance: FmrbAudio::SUB)
  # ```
  # <<en>>
  # `note_on` sounds here too.
  # ```ruby
  # @audio.play_slot(1, instance: FmrbAudio::SUB)
  # ```
  SUB: Integer

  # 矩形波 1 の channel (0) <<en>> The first pulse channel (0)
  #
  # ```ruby
  # @audio.note_on(FmrbAudio::CH_PULSE1, 440)
  # ```
  CH_PULSE1: Integer

  # 矩形波 2 の channel (1) <<en>> The second pulse channel (1)
  #
  # ```ruby
  # @audio.note_on(FmrbAudio::CH_PULSE2, 440)
  # ```
  CH_PULSE2: Integer

  # 三角波の channel (2) <<en>> The triangle channel (2)
  #
  # ```ruby
  # @audio.note_on(FmrbAudio::CH_TRIANGLE, 220)
  # ```
  CH_TRIANGLE: Integer

  # ノイズの channel (3) <<en>> The noise channel (3)
  #
  # ```ruby
  # @audio.note_on(FmrbAudio::CH_NOISE, 8)
  # ```
  CH_NOISE: Integer

  # マイクがあるか <<en>> Whether this machine has a microphone
  #
  # ESP32-P4 の端末 (Tab5 など) だけ true。それ以外は false なので、
  # 呼ぶ前に端末を調べなくてよい。
  # ```ruby
  # return unless @audio.mic_available?
  # ```
  # <<en>>
  # true only on an ESP32-P4 machine (a Tab5 and the like); false elsewhere,
  # so there is no need to check the machine first.
  # ```ruby
  # return unless @audio.mic_available?
  # ```
  %a{fmrb.internal}
  def mic_available?: () -> bool

  # マイクの標本化の速さ (Hz) <<en>> The microphone's sampling rate in Hz
  #
  # ESP32-P4 では 47160 (スピーカーと同じクロックで、選べない)。マイクの
  # 無い端末では 0。スペクトルの 1 本の幅 (Hz) はこれを標本の数で割る。
  # ```ruby
  # hz = @audio.mic_rate
  # ```
  # <<en>>
  # 47160 on an ESP32-P4 (it shares the speaker's clock and cannot be
  # chosen); 0 on a machine without a microphone. A spectrum's bin width in
  # Hz is this over the number of samples.
  # ```ruby
  # hz = @audio.mic_rate
  # ```
  %a{fmrb.internal}
  def mic_rate: () -> Integer

  # マイクを入れる・切る <<en>> Turn the microphone on or off
  #
  # `on` (省略すると true)。**読む前に入れ、使い終えたら `false` で切る**。
  # 成功したら true。マイクの無い端末や、立ち上げに失敗したときは false
  # (例外は出ない)。すでにその状態なら true。
  # ```ruby
  # @audio.mic_enable
  # @audio.mic_enable(false)
  # ```
  # <<en>>
  # `on` (true when left out). Turn it on before reading and off with
  # `false` when done. true on success; false on a machine without one or
  # when it fails to start (no exception). true if it is already so.
  # ```ruby
  # @audio.mic_enable
  # @audio.mic_enable(false)
  # ```
  %a{fmrb.internal}
  def mic_enable: (?bool on) -> bool

  # マイクの音を標本で読む <<en>> Read microphone samples
  #
  # `count` 個 (1〜4096、外れると ArgumentError) の 16 ビット符号つき・
  # リトルエンディアンの標本を、2 * count バイトの String で返す。そろう
  # まで待つ (**止まる**)。`timeout_ms` (省略すると 200) は、ドライバが
  # 256 個ほどずつ渡すその 1 回ごとの待ち。そろわなかったときと、
  # マイクが入っていない・無いときは nil (半端な長さは返さない)。
  # ```ruby
  # bytes = @audio.mic_read(512, 300)
  # return if bytes.nil?
  # ```
  # <<en>>
  # Returns `count` (1 to 4096, else ArgumentError) signed 16-bit
  # little-endian samples as a String of 2 * count bytes. It waits until they
  # are there (**it blocks**); `timeout_ms` (200 when left out) is the wait of
  # each hand-over from the driver, about 256 samples at a time. nil when
  # they did not arrive, and when the microphone is off or absent (never a
  # short String).
  # ```ruby
  # bytes = @audio.mic_read(512, 300)
  # return if bytes.nil?
  # ```
  %a{fmrb.internal}
  def mic_read: (Integer count, ?Integer timeout_ms) -> String?

  # 曲をいったん止める <<en>> Pause the song
  #
  # ```ruby
  # @audio.pause
  # ```
  def pause: () -> void

  # 止めた曲の続きを鳴らす <<en>> Carry on from the pause
  #
  # ```ruby
  # @audio.resume
  # ```
  def resume: () -> void

  # 曲のデータを箱に入れる <<en>> Put song data into a slot
  #
  # 曲を枠に読み込む。**鳴らすのは play_slot**。
  # ```ruby
  # data = File.open(path, "r") { |f| f.read }
  # @audio.load_fmsq(0, data)
  # ```
  # <<en>>
  # Loads a tune into a slot. **play_slot is what sounds it.**
  # ```ruby
  # data = File.open(path, "r") { |f| f.read }
  # @audio.load_fmsq(0, data)
  # ```
  def load_fmsq: (Integer slot_id, bin binary_data) -> void

  # 曲のファイルを箱に読み込む <<en>> Read a song file into a slot
  #
  # ```ruby
  # @audio.load_fmsq_file(0,
  #   "/usr/share/music/round.mml")
  # ```
  def load_fmsq_file: (Integer slot_id, String path) -> void

  # 箱に入れた曲を鳴らす <<en>> Play the song in a slot
  #
  # `instance:` (省略すると MAIN) は鳴らす APU で、`FmrbAudio::MAIN` か `FmrbAudio::SUB`。
  # ```ruby
  # @audio.play_slot(0)
  # ```
  # <<en>>
  # `instance:` (MAIN when left out) is the APU that plays it,
  # `FmrbAudio::MAIN` or `FmrbAudio::SUB`.
  # ```ruby
  # @audio.play_slot(0)
  # ```
  %a{fmrb.internal}
  def play_slot: (Integer slot_id, ?instance: Integer) -> void

  # play_slot の省略なしの形 <<en>> play_slot with nothing left out
  #
  # 引数を省略できない単純な形。instance は鳴らす APU で、MAIN (0) か SUB (1)。
  # 長い曲は MAIN、短い効果音は SUB に置くと、効果音が曲を切らない。
  # 包みは play_slot (instance: を省くと MAIN)。
  # ```ruby
  # @audio.play_slot_raw(0, FmrbAudio::SUB)
  # ```
  # <<en>>
  # The simple form, with no argument left out. instance is the APU that plays
  # it, MAIN (0) or SUB (1): a long tune on MAIN and the short effects on SUB,
  # so an effect never cuts the tune. The wrapper is play_slot (instance: left
  # out is MAIN).
  # ```ruby
  # @audio.play_slot_raw(0, FmrbAudio::SUB)
  # ```
  def play_slot_raw: (Integer slot_id, Integer instance) -> void

  # 曲 (MAIN) だけの音量を変える <<en>> Set the volume of the music (MAIN) only
  #
  # 0〜100 (%)、最初は 100。play と MAIN の play_slot の曲だけが変わり、
  # 効果音 (SUB)・WAV・端末の音量はそのまま。アプリを閉じると 100 に戻る。
  # ```ruby
  # @audio.main_volume = 30
  # ```
  # <<en>>
  # 0 to 100 (%), 100 to start with. Only the music of play and of
  # play_slot on MAIN changes; the effects (SUB), WAVs and the machine's
  # volume stay. It goes back to 100 when the app closes.
  # ```ruby
  # @audio.main_volume = 30
  # ```
  def main_volume=: (Integer percent) -> void

  # 録音した音 (WAV) を鳴らす <<en>> Play a recorded sound (WAV)
  #
  # モノラル・8000〜48000Hz・2MB まで。PCM 16bit か IMA-ADPCM 4bit。APU の音に重ねて鳴る。
  # 一度に鳴らせるのは 1 本で、鳴っている間にもう一度呼ぶと入れ替わる。
  # Retro では鳴らせないので false を返す (鳴ったときは true)。
  # ```ruby
  # ok = @audio.play_wav("/home/a.wav")
  # # Retro では false
  # ```
  # <<en>>
  # Mono, 8000 to 48000Hz, up to 2MB, 16-bit PCM or 4-bit IMA-ADPCM. It plays over the APU.
  # Only one at a time: calling again while one sounds replaces it.
  # Retro cannot play it and gets false back (true when it does play).
  # ```ruby
  # ok = @audio.play_wav("/home/a.wav")
  # # false on Retro
  # ```
  def play_wav: (String path) -> bool

  # 鳴っている WAV を止める <<en>> Stop the WAV that is playing
  #
  # ```ruby
  # @audio.stop_wav
  # ```
  def stop_wav: () -> bool

  # 音を一つ鳴らす <<en>> Sound one note
  #
  # 周波数を Hz で渡す。曲を鳴らしている最中でも重なる。
  # `volume` (省略すると 10) は 0〜15、`duty` (省略すると 2) は矩形波の幅 0〜3、
  # `sweep` (省略すると 0)。
  # ```ruby
  # @audio.note_on(0, 440)
  # ```
  # <<en>>
  # The frequency is in Hz. It sounds over a tune that is already playing.
  # `volume` (10 when left out) is 0 to 15, `duty` (2) the pulse width 0 to
  # 3, `sweep` (0).
  # ```ruby
  # @audio.note_on(0, 440)
  # ```
  %a{fmrb.internal}
  def note_on: (Integer channel, Integer freq, ?Integer volume, ?Integer duty, ?Integer sweep) -> void

  # note_on の省略なしの形 <<en>> note_on with nothing left out
  #
  # 引数を省略できない単純な形。曲の中で何度も鳴らすような、速さが要る所で
  # 使う。volume は 0〜15 (包みは 10)、duty は矩形波の幅 0〜3 (包みは 2)、
  # sweep は 0 (包みと同じ)。包みは note_on。
  # ```ruby
  # @audio.note_on_raw(0, 440, 10, 2, 0)
  # ```
  # <<en>>
  # The simple form, with no argument left out, for where speed matters (many
  # notes in a tune). volume 0 to 15 (10 in the wrapper), duty the pulse width
  # 0 to 3 (2 in the wrapper), sweep 0 (as the wrapper). The wrapper is note_on.
  # ```ruby
  # @audio.note_on_raw(0, 440, 10, 2, 0)
  # ```
  def note_on_raw: (Integer channel, Integer freq, Integer volume, Integer duty, Integer sweep) -> void

  # 鳴っている音を止める <<en>> Stop a note
  #
  # ```ruby
  # @audio.note_off(0)
  # ```
  def note_off: (Integer channel) -> void
end

# マイクの C 側の窓口 <<en>> The C-side entry to the microphone
#
# アプリは ふつう FmrbAudio の mic_* を使う。
# <<en>>
# Apps normally use the mic_* methods of FmrbAudio.
module FmrbMic
  # マイクがあるか <<en>> Whether this machine has a microphone
  #
  # `FmrbAudio` を作る前に調べるとき用で、`FmrbAudio#mic_available?` と同じ。
  # ```ruby
  # unless FmrbMic.available?
  #   @error = "no microphone"
  # end
  # ```
  # <<en>>
  # For asking before an `FmrbAudio` exists; the same as
  # `FmrbAudio#mic_available?`.
  # ```ruby
  # unless FmrbMic.available?
  #   @error = "no microphone"
  # end
  # ```
  def self.available?: () -> bool
end

# NSF (ファミコンの曲) のファイルの題名などを読む <<en>> Read the title of an NSF song file
class NsfHeader
  # 曲のファイルから題名などを読む <<en>> Read the title and the rest from a song file
  #
  # NSF の見出しだけを読む。曲は鳴らさない。読めなければ nil。
  # ```ruby
  # h = NsfHeader.parse(path)
  # Log.info(h.song_name) if h
  # ```
  # <<en>>
  # Reads an NSF's header without playing it; nil when it cannot.
  # ```ruby
  # h = NsfHeader.parse(path)
  # Log.info(h.song_name) if h
  # ```
  def self.parse: (String path) -> NsfHeader?

  # 曲の題名 <<en>> The song's title
  #
  # ```ruby
  # h.song_name
  # ```
  def song_name: () -> String

  # 作った人 <<en>> Who made it
  #
  # ```ruby
  # h.artist
  # ```
  def artist: () -> String

  # 権利の表示 <<en>> The rights notice
  #
  # ```ruby
  # h.copyright
  # ```
  def copyright: () -> String

  # 入っている曲の数 <<en>> How many songs are inside
  #
  # ```ruby
  # n = h.total_songs
  # ```
  def total_songs: () -> Integer

  # 最初に鳴らす曲の番号 <<en>> Which song plays first
  #
  # ```ruby
  # i = h.starting_song
  # ```
  def starting_song: () -> Integer
end
