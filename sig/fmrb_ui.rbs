# 画面のある道具のための部品箱。実装は
# lib/gems/picoruby-fmrb-app/mrblib/fmrb-ui.rb。
#
# ボタンや切替の当たり判定・押した見た目・描き直しをまとめて持ちます。
# 部品は on_create で作り、あとは handle にイベントを渡して、返ってきた
# id を case で受けるだけです。
#
# ```ruby
# def on_create
#   @ui = FmrbUI.new(self)
#   @ui.toggle(:red, 4, 4, 50, 16, "赤", group: :color, on: true)
#   @ui.toggle(:blue, 60, 4, 50, 16, "青", group: :color)
#   @st = @ui.stepper(:size, 4, 26, 108, 14, 5, 1, 9)
#   @ui.flush
# end
#
# def on_event(ev)
#   case @ui.handle(ev)
#   when :red  then @color = FmrbGfx::RED
#   when :blue then @color = FmrbGfx::BLUE
#   when :size then @size = @st.value
#   when nil   then return @ui.flush
#   end
#   draw_picture
#   @ui.flush
# end
# ```
#
# 座標は user area (Window の枠とタイトルバーの内側) の左上が原点です。
# <<en>>
# Widget box for apps that draw their own window. Implemented in
# lib/gems/picoruby-fmrb-app/mrblib/fmrb-ui.rb.
#
# It owns the hit test, the pressed look and the redraw. Create the widgets
# in on_create, feed events to handle, and dispatch on the id it returns.
#
# Coordinates are relative to the top-left of the user area (inside the
# window frame, below the title bar).

# 部品の入れ物 <<en>> Widget container
class FmrbUI
  # 部品箱を作る <<en>> Create the widget box
  #
  # app には自分自身 (FmrbApp) を渡します。描画先と user area の位置を
  # そこから読みます。
  #
  # `bg:` は**部品が自分の中を塗る色**です (Label の箱、Stepper の値の欄、
  # Scrollbar の溝)。既定は Window の背景色で、暗い色で塗ったアプリはその色を
  # 渡します。省いたときは、アプリをテーマの違う端末へ移すと、着いた側の
  # Window の背景色に変わります (渡した色はそのまま)。
  #
  # `bg_painter:` は**部品を消したあとの地を描く相手**です。渡さなければ
  # 跡は `bg:` の色で塗られます (地が一色ならこれで正しい)。地が絵の場合
  # (壁紙・枠線・角の丸み) は、`paint_bg_rect(gfx, x, y, w, h)` を持つ
  # オブジェクト (ふつうは self) を渡すと、その矩形を自分で描けます。
  # 実装は**描くだけ**。present しない、確保しない、文字サイズや
  # フォントを変えたら戻す。名前は固定です。
  #
  # ```ruby
  # @ui = FmrbUI.new(self)                    # Window の背景色
  # @ui = FmrbUI.new(self, bg: COLOR_BG)      # 自前の背景色
  # @ui = FmrbUI.new(self, bg_painter: self)  # 地は自分で描く
  #
  # def paint_bg_rect(gfx, x, y, w, h)
  #   gfx.fill_rect(x, y, w, h, 0x01)
  # end
  # ```
  # <<en>>
  # Pass the app itself (FmrbApp). The canvas and the user-area origin are
  # read from it.
  #
  # bg: is the colour a widget paints inside itself - a Label's box, a
  # Stepper's value field, a Scrollbar's track. It defaults to the window
  # background; an app that clears its user area to something darker passes
  # that colour instead. Left out, it becomes the window background of the
  # machine an app is moved to (a colour passed is kept).
  #
  # bg_painter: is who repaints the ground where a widget used to be. Left
  # out, the hole is filled with bg:, which is right while the ground is one
  # colour. Where it is a picture - wallpaper, a border, a rounded corner -
  # pass an object answering paint_bg_rect(gfx, x, y, w, h), usually self.
  # That method draws the rectangle and nothing else: no present, no
  # allocation, and it puts back any text size or font it changed. The name
  # is fixed.
  #
  # text_size: is the default scale for the widgets made from here on (1
  # unless given). A single widget can override it with its own text_size:.
  # The size is fixed when the widget is made and never follows the size the
  # app happens to be in, and flush hands the app's size back afterwards.
  def self.new: (FmrbApp app, ?bg: Integer, ?text_size: Integer, ?bg_painter: untyped) -> FmrbUI

  # 文字を置く <<en>> Place a text label
  #
  # align: で寄せ方を選べます (:left / :center / :right、既定は :left)。
  # text_size: でこの部品だけ文字を大きくできます (1-4)。見出しに使います。
  # ```ruby
  # @ui.label(:l_size, 4, 148, 60, 10,
  #           "大きさ")
  # ```
  # <<en>>
  # align: chooses the alignment (:left / :center / :right, default :left).
  # text_size: enlarges this one widget's text (1-4); useful for a heading.
  # ```ruby
  # @ui.label(:l_size, 4, 148, 60, 10,
  #           "Size")
  # ```
  def label: (Symbol id, Integer x, Integer y, Integer w, Integer h, String text, ?align: Symbol, ?text_size: Integer) -> FmrbUI::Label

  # 押しボタンを置く <<en>> Place a push button
  #
  # 押している間だけ反転し、離したときに handle が id を返します。
  # 部品の外で離したときは何も起きません。
  #
  # `accent:` に色 (RGB332) を渡すと、テーマのボタン色の代わりにその色で
  # 塗ります。**色そのものが意味を持つ数少ない場合だけ**に使います
  # (確認ダイアログの Yes、再生/停止など)。Toggle では入のときの色です。
  # ```ruby
  # @ui.button(:start, 4, 20, 60, 16,
  #            "Start")
  # ```
  # <<en>>
  # Inverted while held; handle returns the id when the button is released
  # on top of it. Releasing outside does nothing. text_size: enlarges the
  # label (1-4), as on every widget.
  #
  # accent: paints the button in that RGB332 colour instead of the theme's.
  # Reserve it for the few controls whose colour carries meaning - a confirm
  # dialog's Yes, a transport's Stop. On a Toggle it is the on colour.
  # ```ruby
  # @ui.button(:start, 4, 20, 60, 16,
  #            "Start")
  # ```
  def button: (Symbol id, Integer x, Integer y, Integer w, Integer h, String text, ?text_size: Integer, ?accent: Integer) -> FmrbUI::Button

  # 入切の切替を置く <<en>> Place an on/off toggle
  #
  # group: に同じ名前を付けた切替どうしは、一つだけが入になります
  # (ラジオボタン)。on: true で最初から入、on_text: を渡すと入のときの
  # 文字を変えられます。
  #
  # ```ruby
  # @ui.toggle(:maru, 0, 0, 50, 16, "円", group: :motif, on: true)
  # @ui.toggle(:hishi, 58, 0, 50, 16, "菱", group: :motif)
  # @ui.toggle(:invert, 0, 20, 108, 12, "反転 切", on_text: "反転 入")
  # ```
  # <<en>>
  # Toggles sharing a group: name behave as radio buttons - only one is on.
  # on: true starts it on; on_text: gives it a different label when on.
  def toggle: (Symbol id, Integer x, Integer y, Integer w, Integer h, String text, ?group: Symbol, ?on: bool, ?on_text: String, ?text_size: Integer, ?accent: Integer) -> FmrbUI::Toggle

  # 数を増減する部品を置く <<en>> Place a value stepper
  #
  # 「< 値 >」の形で、左右どちらを押しても handle が id を返します。
  # min / max で止まり、端で押したときは id を返しません。
  # 最後に step (増減の幅、既定は 1) を渡せます。
  #
  # ```ruby
  # @size = @ui.stepper(:size, 0, 0, 108, 14, 70, 30, 100, 10)
  # @size.suffix = "%"   # 表示を "70%" にする
  # ```
  # <<en>>
  # A "< value >" control. handle returns the id for either side, the value
  # stops at min / max, and pressing at the end returns nothing. An optional
  # last argument sets the step (default 1).
  def stepper: (Symbol id, Integer x, Integer y, Integer w, Integer h, Integer value, Integer min, Integer max, ?Integer step, ?text_size: Integer) -> FmrbUI::Stepper

  # 選択肢を左右で選ぶ部品を置く <<en>> Place a choice picker
  #
  # 「< 選択肢 >」の形で、options の中身を左右で送ります。value は選ばれた
  # 添字、option_text はその文字列です。端では止まり、巡回しません。
  # 文字を作り直さないので Stepper より軽い部品です。
  # `index:` (省略すると 0) は最初に選ばれている添字、`text_size:` は
  # この部品だけの文字の大きさです。options は読むだけで書き換えません。
  #
  # ```ruby
  # THEMES = ["light", "dark", "classic"]
  # @ui.enum(:theme, 0, 0, 90, 14, THEMES, index: 1)
  # # ...
  # when :theme then apply_theme(@ui.option_text(:theme))
  # ```
  # <<en>>
  # A "< choice >" control over options. value is the chosen index and
  # option_text the string. It stops at the ends rather than wrapping, and
  # builds no string when moved, which makes it lighter than a Stepper.
  # `index:` (0 when left out) is the choice shown first, `text_size:` the
  # text scale of this widget alone. options is read, never written.
  def enum: (Symbol id, Integer x, Integer y, Integer w, Integer h, Array[String] options, ?index: Integer, ?text_size: Integer) -> FmrbUI::Enum

  # 縦のスクロールバーを置く <<en>> Place a vertical scrollbar
  #
  # x, y, w, h は**バーそのもの**の矩形で、動かす一覧のものではありません
  # (幅は 10 が標準)。total (全部の数)・visible (見える数)・scroll (今の位置、
  # 省略すると 0) の 3 つだけでつまみの大きさと位置が決まります。
  # **位置を持つのはアプリ**です。キーなどで動かしたら `set_value`、件数が
  # 変わったら `set_range` で入れ、バーを押されたら `value` で読み戻します。
  # ホイールには応えません (`wheel_rows` で自分で受ける)。
  #
  # **押した瞬間に** handle が id を返し (離したときではない)、押し続けても
  # 返るのは最初の 1 回だけです。1 回で 1 つ動き、端で押したときは返りません。
  # 押している間の向きは `direction` で読み、繰り返しはアプリがします。
  # 全部が見えている (total が visible 以下の) 間は何も描かず、
  # **クリックも後ろの一覧へ通ります**。作れるのは on_create の中です。
  # ```ruby
  # @ui.scrollbar(:sb, w - 10, y, 10, h,
  #               0, rows, 0)
  # # ...
  # @ui.set_range(:sb, @files.size, rows)
  # @ui.set_value(:sb, @scroll)
  # ```
  # <<en>>
  # x, y, w, h are the bar itself, not the list it scrolls (10 wide is the
  # usual). total (how many there are), visible (how many fit) and scroll
  # (the position; 0 when left out) are all it needs.
  # **The app owns the position.** Push it in with `set_value` when keys move
  # it, call `set_range` when the count changes, and read it back with
  # `value` after the bar is pressed. The wheel is not answered here (use
  # `wheel_rows`).
  #
  # **handle returns the id on the press** (not the release), once for a
  # held press. One press moves one step, and a press at an end returns
  # nothing. `direction` says which way a held bar goes; the app does the
  # repeating. While everything fits (total at most visible) it draws
  # nothing and **clicks pass through to the list behind**. Make it in
  # on_create.
  # ```ruby
  # @ui.scrollbar(:sb, w - 10, y, 10, h,
  #               0, rows, 0)
  # # ...
  # @ui.set_range(:sb, @files.size, rows)
  # @ui.set_value(:sb, @scroll)
  # ```
  def scrollbar: (Symbol id, Integer x, Integer y, Integer w, Integer h, Integer total, Integer visible, ?Integer scroll) -> FmrbUI::Scrollbar

  # 選ばれている文字 <<en>> The chosen string
  #
  # Enum が今見せている文字列です。添字は value で読みます。
  # ```ruby
  # name = @ui.option_text(:mode)
  # ```
  # <<en>>
  # What the Enum is showing. Its index is read with value.
  # ```ruby
  # name = @ui.option_text(:mode)
  # ```
  def option_text: (Symbol id) -> String?

  # 1 行の文字入力欄を置く <<en>> Place a one-line text field
  #
  # クリックで焦点が移り、焦点のある欄にキーが入ります。Enter で handle が
  # id を返し (確定)、Esc で焦点が外れます。文字数は max まで。
  # カーソルは点滅しません (点滅は毎フレーム描くことになるため)。
  # 矢印キーによる欄内の移動はありません。追加と後退だけです。
  #
  # ```ruby
  # @ui.text_field(:name, 40, 100, 120, 10, "song", max: 24)
  # # ...
  # when :name then save_as(@ui.field_text(:name))
  # ```
  # <<en>>
  # Click to focus; keys go to whichever field has the focus. Enter makes
  # handle report the id, Escape drops the focus. The caret does not blink
  # (blinking would mean drawing every frame) and there are no arrow keys:
  # characters go on the end and backspace takes from the end.
  def text_field: (Symbol id, Integer x, Integer y, Integer w, Integer h, ?String text, ?max: Integer, ?text_size: Integer) -> FmrbUI::TextField

  # 打たれている文字 <<en>> What has been typed
  #
  # ```ruby
  # name = @ui.field_text(:name)
  # ```
  def field_text: (Symbol id) -> String?

  # 文字を入れ直す <<en>> Replace what is in the field
  #
  # ```ruby
  # @ui.set_field_text(:name, "untitled")
  # ```
  def set_field_text: (Symbol id, String text) -> void

  # 焦点を当てる <<en>> Give a widget the focus
  #
  # nil を渡すと焦点を外します。文字入力欄以外を渡した場合も外れます。
  # ```ruby
  # @ui.focus(:name)
  # @ui.focus(nil)
  # ```
  # <<en>>
  # nil takes the focus away, and so does anything that is not a text field.
  # ```ruby
  # @ui.focus(:name)
  # @ui.focus(nil)
  # ```
  def focus: (Symbol id) -> void

  # 焦点のある部品の名前 <<en>> Which widget has the focus
  #
  # ```ruby
  # return if @ui.focused == :name
  # ```
  def focused: () -> Symbol?

  # イベントを渡す <<en>> Feed one event
  #
  # 操作が決まった部品の id を返します。決まっていなければ nil です。
  # 押し下げでは押した見た目にするだけで nil を返し、同じ部品の上で
  # 離したときに id を返します。mouse_move は何もせず nil です。
  # ```ruby
  # case @ui.handle(ev)
  # when :start then start_game
  # end
  # ```
  # <<en>>
  # Returns the id of the widget whose operation completed, or nil. A press
  # only updates the pressed look and returns nil; the id comes when the
  # button is released over the same widget. mouse_move does nothing.
  # ```ruby
  # case @ui.handle(ev)
  # when :start then start_game
  # end
  # ```
  def handle: (Hash[Symbol, untyped] ev) -> Symbol?

  # 変わった部品だけ描く <<en>> Draw the changed widgets
  #
  # 描くものがあれば最後に present を 1 回呼んで true、何も変わって
  # いなければ何もせず false を返します。自分の絵を描いたあとに呼べば
  # present は 1 回で済みます。
  # ```ruby
  # draw_picture
  # @gfx.present unless @ui.flush
  # ```
  # <<en>>
  # Calls present once when anything was drawn and returns true; returns
  # false without drawing when nothing changed. Call it after drawing your
  # own picture so present happens only once.
  # ```ruby
  # draw_picture
  # @gfx.present unless @ui.flush
  # ```
  def flush: () -> bool

  # 全部を描き直しの印にする <<en>> Mark every widget for redraw
  #
  # clear_user_area や大きさ変更のあとに呼びます。
  # ```ruby
  # clear_user_area
  # @ui.invalidate_all
  # @ui.flush
  # ```
  # <<en>>
  # Call it after clear_user_area or a resize.
  # ```ruby
  # clear_user_area
  # @ui.invalidate_all
  # @ui.flush
  # ```
  def invalidate_all: () -> void

  # id から部品を探す <<en>> Find a widget by id
  #
  # 見つからなければ nil。
  # ```ruby
  # w = @ui.find(:ok)
  # w.place(x, y, 60, 20) if w
  # ```
  # <<en>>
  # nil when there is none.
  # ```ruby
  # w = @ui.find(:ok)
  # w.place(x, y, 60, 20) if w
  # ```
  def find: (Symbol id) -> FmrbUI::Widget?

  # 部品を置き直す <<en>> Move and resize a widget
  #
  # 座標は作ったときと同じく user area の左上が原点です。
  # ```ruby
  # @ui.move(:ok, 4, 60, 50, 16)
  # ```
  # <<en>>
  # Coordinates are user-area relative, as at creation time.
  # ```ruby
  # @ui.move(:ok, 4, 60, 50, 16)
  # ```
  def move: (Symbol id, Integer x, Integer y, Integer w, Integer h) -> void

  # 切替が入かどうか <<en>> Whether the toggle is on
  #
  # ```ruby
  # save_backup if @ui.on?(:backup)
  # ```
  def on?: (Symbol id) -> bool

  # 切替を外から入切する <<en>> Set a toggle from the app
  #
  # group を付けた切替なら、入にしたときに同じ group の他は切になります。
  # ```ruby
  # @ui.set_on(:on, true)
  # ```
  # <<en>>
  # For a grouped toggle, switching it on switches the rest of the group off.
  # ```ruby
  # @ui.set_on(:on, true)
  # ```
  def set_on: (Symbol id, bool on) -> void

  # 部品の文字を変える <<en>> Change a widget's text
  #
  # 同じ文字なら何もしません。変わったときだけ幅を測り直して描き直します。
  # ```ruby
  # @ui.set_text(:near, "Back")
  # ```
  # <<en>>
  # Does nothing when the text is unchanged; it re-measures and redraws only
  # when it actually changed.
  # ```ruby
  # @ui.set_text(:near, "Back")
  # ```
  def set_text: (Symbol id, String text) -> void

  # 数を外から入れる <<en>> Set a stepper value from the app
  #
  # min / max で止まります。値が変わったときだけ true を返します。
  # ```ruby
  # @ui.set_value(:sb, 3)
  # ```
  # <<en>>
  # Clamped to min / max. Returns true only when the value actually changed.
  # ```ruby
  # @ui.set_value(:sb, 3)
  # ```
  def set_value: (Symbol id, Integer value) -> bool

  # 今の数を読む <<en>> Read the current stepper value
  #
  # ```ruby
  # n = @ui.value(:speed)
  # ```
  def value: (Symbol id) -> Integer

  # 部品を使える/使えないにする <<en>> Enable or disable a widget
  #
  # 使えない部品は押しても反応せず、文字が薄く出ます。
  # ```ruby
  # @ui.set_enabled(:export, false)
  # ```
  # <<en>>
  # A disabled widget ignores clicks and draws its text dimmed.
  # ```ruby
  # @ui.set_enabled(:export, false)
  # ```
  def set_enabled: (Symbol id, bool flag) -> void

  # 部品を出す/隠す <<en>> Show or hide a widget
  #
  # 隠した部品のあった場所は背景色で塗り直されます。
  # ```ruby
  # @ui.set_visible(:inst, false)
  # ```
  # <<en>>
  # The area of a hidden widget is repainted with the background color.
  # ```ruby
  # @ui.set_visible(:inst, false)
  # ```
  def set_visible: (Symbol id, bool flag) -> void


  # 範囲を入れ直す <<en>> Change a widget's range
  #
  # **部品によって 2 つの数の意味が違います**。Stepper (と Enum) は
  # `(min, max)`、Scrollbar は `(total, visible)`。値は新しい範囲の中へ
  # 引き戻されます。同じ範囲なら何もせず、id が無いときも何も起きません
  # (常に nil)。ほかの部品では何もしません。
  # ```ruby
  # @ui.set_range(:track, 1, total)    # Stepper
  # @ui.set_range(:sb, @files.size, 8) # Scrollbar
  # ```
  # <<en>>
  # **The two numbers mean different things.** A Stepper (and Enum) takes
  # `(min, max)`, a Scrollbar `(total, visible)`. The value is pulled inside
  # the new range. The same range does nothing, an unknown id does nothing
  # (it always returns nil), and other widgets ignore it.
  # ```ruby
  # @ui.set_range(:track, 1, total)    # Stepper
  # @ui.set_range(:sb, @files.size, 8) # Scrollbar
  # ```
  def set_range: (Symbol id, Integer min, Integer max) -> void

  # つまみを押している向き <<en>> Which way a scrollbar is held
  #
  # 上へ押している間は -1、下へは 1、押していなければ 0 (id が無いときも 0)。
  # handle が id を返したあとに読み、押している間の繰り返しに使います。
  # ```ruby
  # if @ui.handle(ev) == :sb
  #   d = @ui.direction(:sb)
  #   @scroll_hold = d
  # end
  # ```
  # <<en>>
  # -1 while held up, 1 held down, 0 when not held (and for an unknown id).
  # Read it after handle returns the id to drive the repeat.
  # ```ruby
  # if @ui.handle(ev) == :sb
  #   d = @ui.direction(:sb)
  #   @scroll_hold = d
  # end
  # ```
  def direction: (Symbol id) -> Integer

  # 部品の地の色 <<en>> The colour behind the widgets
  #
  # ```ruby
  # c = @ui.bg
  # ```
  def bg: () -> Integer

  # 部品の地の色を変える <<en>> Change the colour behind the widgets
  #
  # **あとから作る部品と、隠した部品の跡を塗る色**が変わります。
  # **すでにある部品の中の色は変わりません**。部品は作るときに色を写して
  # 持つので、変えるなら部品の `bg=` です。渡した色は自前の色として扱われ、
  # アプリを別の端末へ移してもテーマの色には戻りません。描き直しは
  # `invalidate_all` のあとの flush で。
  # ```ruby
  # @ui.bg = @bg_col
  # @ui.invalidate_all
  # ```
  # <<en>>
  # Changes what **widgets made afterwards, and the hole left by a hidden one**,
  # are painted with. **Widgets that already exist keep their own colour**:
  # each copies it when made, so use the widget's `bg=`. The colour
  # counts as the app's own and does not turn back into the theme's after a
  # move to another machine. Repaint with `invalidate_all` and a flush.
  # ```ruby
  # @ui.bg = @bg_col
  # @ui.invalidate_all
  # ```
  def bg=: (Integer c) -> void

  # 置いてある部品の一覧 <<en>> The widgets placed so far
  #
  # ```ruby
  # @ui.widgets.length
  # ```
  def widgets: () -> Array[FmrbUI::Widget]
end

# 部品に共通のところ <<en>> What every widget has
class FmrbUI::Widget
  # この部品の名前 <<en>> This widget's id
  #
  # ```ruby
  # case w.id
  # when :ok then close
  # end
  # ```
  def id: () -> Symbol

  # 左端の位置 (画面の座標) <<en>> Left edge (canvas coordinates)
  #
  # ```ruby
  # left = w.x
  # ```
  def x: () -> Integer

  # 上端の位置 (画面の座標) <<en>> Top edge (canvas coordinates)
  #
  # ```ruby
  # top = w.y
  # ```
  def y: () -> Integer

  # 横幅 (ドット) <<en>> Width in pixels
  #
  # ```ruby
  # width = w.w
  # ```
  def w: () -> Integer

  # 高さ (ドット) <<en>> Height in pixels
  #
  # ```ruby
  # height = w.h
  # ```
  def h: () -> Integer

  # 次の flush で描き直すか <<en>> Whether the next flush redraws it
  #
  # ```ruby
  # @ui.flush if w.dirty
  # ```
  def dirty: () -> bool

  # 使えるかどうか <<en>> Whether it accepts clicks
  #
  # ```ruby
  # return unless w.enabled
  # ```
  def enabled: () -> bool

  # 出ているかどうか <<en>> Whether it is shown
  #
  # ```ruby
  # next unless w.visible
  # ```
  def visible: () -> bool

  # 文字の大きさ (作ったときに決まる) <<en>> Text scale, fixed at creation
  #
  # ```ruby
  # s = w.text_size
  # ```
  def text_size: () -> Integer

  # その点がこの部品の上か <<en>> Whether the point is inside
  #
  # ```ruby
  # hit = w.hit?(ev[:x], ev[:y])
  # ```
  def hit?: (Integer px, Integer py) -> bool

  # 置き直す (画面の座標) <<en>> Move and resize (canvas coordinates)
  #
  # **作ったあとに動かす**ときに使う。大きさを変えた Window に部品を
  # 並べ直すのはこれ。
  # ```ruby
  # w.place(10, 40, 80, 20)
  # @ui.flush
  # ```
  # <<en>>
  # Moves a widget that already exists -- what you use to lay the
  # widgets out again after the window is resized.
  # ```ruby
  # w.place(10, 40, 80, 20)
  # @ui.flush
  # ```
  def place: (Integer x, Integer y, Integer w, Integer h) -> void

  # 部品が自分の中を塗る色 <<en>> The colour a widget paints inside itself
  #
  # Label の箱・Stepper の値の欄・Scrollbar の溝の色。Button・Toggle・
  # TextField は使いません。**背後の色ではありません**。
  # ```ruby
  # c = w.bg
  # ```
  # <<en>>
  # The box of a Label, the value field of a Stepper, the track of a
  # Scrollbar. A Button, Toggle and TextField do not use it. It is not the
  # colour of what is behind the widget.
  # ```ruby
  # c = w.bg
  # ```
  def bg: () -> Integer

  # 部品の中の色を変える <<en>> Change the colour a widget paints inside
  #
  # **自前の色として扱われ**、アプリを別の端末へ移してもテーマの色には戻り
  # ません。**描き直しの印は付かない**ので、`@ui.invalidate_all` か、その部品が
  # 変わるときに描かれます。
  # ```ruby
  # @ui.find(:title).bg = FmrbGfx::BLACK
  # @ui.invalidate_all
  # ```
  # <<en>>
  # The colour counts as the app's own and does not turn back into the
  # theme's after a move to another machine.
  # **It does not mark the widget for redraw**: call `@ui.invalidate_all`,
  # or wait until the widget changes.
  # ```ruby
  # @ui.find(:title).bg = FmrbGfx::BLACK
  # @ui.invalidate_all
  # ```
  def bg=: (Integer c) -> void
end

# 文字だけの部品 <<en>> A text-only widget
class FmrbUI::Label < FmrbUI::Widget
  # 出ている文字 <<en>> The text shown
  #
  # ```ruby
  # s = label.text
  # ```
  def text: () -> String
end

# 押しボタン <<en>> A push button
class FmrbUI::Button < FmrbUI::Widget
  # ボタンの文字 <<en>> The button's text
  #
  # ```ruby
  # s = button.text
  # ```
  def text: () -> String
end

# 入切の切替 <<en>> An on/off toggle
class FmrbUI::Toggle < FmrbUI::Widget
  # 切のときの文字 <<en>> The text shown when off
  #
  # ```ruby
  # s = toggle.text
  # ```
  def text: () -> String

  # 入のときの文字 <<en>> The text shown when on
  #
  # ```ruby
  # s = toggle.on_text
  # ```
  def on_text: () -> String

  # 入かどうか <<en>> Whether it is on
  #
  # ```ruby
  # save if toggle.on?
  # ```
  def on?: () -> bool

  # 入切を変える <<en>> Switch it on or off
  #
  # **押されたことにはならない** — 見た目と状態だけ変わる。
  # ```ruby
  # toggle.set_on(true)
  # @ui.flush
  # ```
  # <<en>>
  # It does not count as a press: only the look and the state change.
  # ```ruby
  # toggle.set_on(true)
  # @ui.flush
  # ```
  def set_on: (bool flag) -> void

  # 同じ一つだけ入にする仲間の名前 <<en>> The radio group name
  #
  # 同じ名前の仲間のうち一つだけが入になる。
  # ```ruby
  # g = toggle.group
  # ```
  # <<en>>
  # Only one toggle in a group is on at a time.
  # ```ruby
  # g = toggle.group
  # ```
  def group: () -> Symbol
end

# 1 行の文字入力欄 <<en>> A one-line text field
class FmrbUI::TextField < FmrbUI::Widget
  # 打たれている文字 <<en>> What has been typed
  #
  # ```ruby
  # s = field.field_text
  # ```
  def field_text: () -> String

  # 焦点があるか <<en>> Whether it has the focus
  #
  # ```ruby
  # draw_caret if field.focused?
  # ```
  def focused?: () -> bool

  # 文字を入れ直す <<en>> Replace what is in the field
  #
  # nil は空の文字列になります。渡した文字列は写して持つので、あとで
  # 渡した側を書き換えても欄は変わりません。
  # ```ruby
  # field.set_field_text("untitled")
  # @ui.flush
  # ```
  # <<en>>
  # nil becomes an empty string. The field keeps a copy, so changing the
  # string you passed later does not change the field.
  # ```ruby
  # field.set_field_text("untitled")
  # @ui.flush
  # ```
  def set_field_text: (String? t) -> void
end

# 選択肢を選ぶ部品 <<en>> A choice picker
class FmrbUI::Enum < FmrbUI::Stepper
  # 選ばれている文字 <<en>> The chosen string
  #
  # 何も選ばれていなければ nil。
  # ```ruby
  # s = sel.option_text
  # ```
  # <<en>>
  # nil when nothing is chosen.
  # ```ruby
  # s = sel.option_text
  # ```
  def option_text: () -> String?
end

# 数を増減する部品 <<en>> A value stepper
class FmrbUI::Stepper < FmrbUI::Widget
  # 今の数 <<en>> The current value
  #
  # ```ruby
  # n = stepper.value
  # ```
  def value: () -> Integer

  # 下限 <<en>> The lowest value
  #
  # ```ruby
  # lo = stepper.min
  # ```
  def min: () -> Integer

  # 上限 <<en>> The highest value
  #
  # ```ruby
  # hi = stepper.max
  # ```
  def max: () -> Integer

  # 一度に増減する幅 <<en>> How much one press moves the value
  #
  # ```ruby
  # d = stepper.step
  # ```
  def step: () -> Integer

  # 出ている文字 <<en>> The text shown
  #
  # ```ruby
  # s = stepper.text
  # ```
  def text: () -> String

  # 数を入れる <<en>> Set the value
  #
  # min / max で止まります。値が変わったときだけ true を返します。
  # ```ruby
  # st = @ui.stepper(:size, 4, 26, 108,
  #                  14, 5, 1, 9)
  # st.set_value(7)   #=> true
  # ```
  # <<en>>
  # Clamped to min / max. Returns true only when the value actually changed.
  # ```ruby
  # st = @ui.stepper(:size, 4, 26, 108,
  #                  14, 5, 1, 9)
  # st.set_value(7)   #=> true
  # ```
  def set_value: (Integer v) -> bool

  # 下限と上限を入れ直す <<en>> Change the lowest and highest values
  #
  # **今の数は新しい範囲の中へ引き戻されます**。同じ範囲なら何もしません。
  # 読み込んだファイルの曲数のように、範囲がデータで決まるときに使います。
  # ```ruby
  # @track_st.set_range(1, total)
  # ```
  # <<en>>
  # **The current value is pulled inside the new range.** The same range
  # does nothing. For a range the data decides, like the tracks in a loaded
  # file.
  # ```ruby
  # @track_st.set_range(1, total)
  # ```
  def set_range: (Integer min, Integer max) -> void

  # 数のうしろに付ける単位 <<en>> Unit appended after the number
  #
  # 作ったあとに 1 回だけ渡します ("%" など)。
  # ```ruby
  # st.suffix = "%"
  # ```
  # <<en>>
  # Set it once, right after creating the stepper (e.g. "%").
  # ```ruby
  # st.suffix = "%"
  # ```
  def suffix=: (String s) -> void
end

# 縦のスクロールバー <<en>> A vertical scrollbar
#
# 一覧のことは何も知らず、全部の数・見える数・今の位置の 3 つの整数だけで
# 動きます。位置を持つのはアプリで、バーは写しです。`FmrbUI#scrollbar` で
# 作り、値の出し入れは `FmrbUI#set_value` / `set_range` でもできます。
# <<en>>
# It knows nothing about the list: three integers (how many there are, how
# many fit, where we are) are all it needs. The app owns the position and the
# bar is a view of it. Made with `FmrbUI#scrollbar`; the value can also be
# pushed in with `FmrbUI#set_value` / `set_range`.
class FmrbUI::Scrollbar < FmrbUI::Widget
  # 今の位置 <<en>> The current position
  #
  # ```ruby
  # @scroll = bar.value
  # ```
  def value: () -> Integer

  # 全部の数 <<en>> How many there are
  #
  # ```ruby
  # n = bar.total
  # ```
  def total: () -> Integer

  # 一度に見える数 <<en>> How many fit
  #
  # ```ruby
  # rows = bar.visible_count
  # ```
  def visible_count: () -> Integer

  # バーが出ているか <<en>> Whether the bar is in use
  #
  # 全部が見えている間は偽で、何も描かず、クリックも通します。
  # ```ruby
  # draw_hint unless bar.active?
  # ```
  # <<en>>
  # False while everything fits: nothing is drawn and clicks pass through.
  # ```ruby
  # draw_hint unless bar.active?
  # ```
  def active?: () -> bool

  # 位置を入れる <<en>> Set the position
  #
  # 0 から (total - visible) の間へ収めます。**位置が変わったときだけ true**
  # を返します (同じ位置なら false)。
  # ```ruby
  # bar.set_value(@scroll)
  # ```
  # <<en>>
  # Clamped to 0 .. (total - visible). Returns true only when the position
  # actually changed (false when it was already there).
  # ```ruby
  # bar.set_value(@scroll)
  # ```
  def set_value: (Integer v) -> bool

  # 全部の数と見える数を入れ直す <<en>> Change how many there are and fit
  #
  # **Stepper の set_range とは違い、引数は (total, visible)** です。位置は
  # 新しい範囲の中へ引き戻されます。
  # ```ruby
  # bar.set_range(@files.size, 8)
  # ```
  # <<en>>
  # **Unlike a Stepper's set_range the arguments are (total, visible).** The
  # position is pulled inside the new range.
  # ```ruby
  # bar.set_range(@files.size, 8)
  # ```
  def set_range: (Integer total, Integer visible) -> void

  # その点がバーの上か <<en>> Whether the point is on the bar
  #
  # **バーが出ていないとき (全部が見えている間) は偽**です。点が重なって
  # いても同じで、一覧へクリックを通すための振る舞いです。
  # ```ruby
  # on_bar = @ui.find(:sb).hit?(x, y)
  # ```
  # <<en>>
  # **False while the bar is not in use (everything fits)**, even over its
  # rectangle, so the click goes to the list behind.
  # ```ruby
  # on_bar = @ui.find(:sb).hit?(x, y)
  # ```
  def hit?: (Integer px, Integer py) -> bool
end

# 毎回描く画面の押せる範囲 <<en>> Click targets of a screen redrawn every time
#
# ゲームの卓のように画面をまるごと描き直す物で使う。描く前に clear し、
# 描きながら add し、クリックの点を id_at で引く。**何も描かない**
# (ボタンの絵は FmrbGfx#draw_button)。FmrbUI の部品とは混ぜない。
# 押した時点でアプリが動く。
#
# ```ruby
# @hits = FmrbUI::HitAreas.new
#
# @hits.clear
# @gfx.draw_button(x, y, 60, 16, "OK",
#   theme_accent, theme_fg_light)
# @hits.add(:ok, x, y, 60, 16)
#
# id = @hits.id_at(ev[:x], ev[:y])
# ```
# <<en>>
# For screens drawn whole every time, like a game table: clear before
# drawing, add each target as it is drawn, and look a click up with id_at.
# **It draws nothing** (the button picture is FmrbGfx#draw_button). Do not
# mix it with the FmrbUI widgets; the app acts on the press.
#
# ```ruby
# @hits = FmrbUI::HitAreas.new
#
# @hits.clear
# @gfx.draw_button(x, y, 60, 16, "OK",
#   theme_accent, theme_fg_light)
# @hits.add(:ok, x, y, 60, 16)
#
# id = @hits.id_at(ev[:x], ev[:y])
# ```
class FmrbUI::HitAreas
  # 空の一覧を作る <<en>> Create an empty list
  #
  # ```ruby
  # @hits = FmrbUI::HitAreas.new
  # ```
  def self.new: () -> FmrbUI::HitAreas

  # 一覧を空にする <<en>> Empty the list
  #
  # ```ruby
  # @hits.clear
  # ```
  def clear: () -> FmrbUI::HitAreas

  # 押せる範囲を足す <<en>> Add a click target
  #
  # 6 番目に data を渡すと、at の結果に入って戻る (麻雀の牌など)。
  # 範囲は次の clear まで有効。
  #
  # ```ruby
  # @hits.add(:ok, x, y, 60, 16)
  # @hits.add(:tile, x, y, 16, 24, t)
  # ```
  # <<en>>
  # A sixth argument, data, comes back in the result of at (a mahjong tile,
  # say). A target lasts until the next clear.
  #
  # ```ruby
  # @hits.add(:ok, x, y, 60, 16)
  # @hits.add(:tile, x, y, 16, 24, t)
  # ```
  def add: (untyped id, Integer x, Integer y, Integer w, Integer h, ?untyped data) -> FmrbUI::HitAreas

  # 点にある範囲を引く <<en>> The target at a point
  #
  # 戻り値は `[id, x, y, w, h, data]` か nil。重なっているときは
  # **先に足した方が勝つ**。
  #
  # ```ruby
  # b = @hits.at(ev[:x], ev[:y])
  # tile = b[5] if b
  # ```
  # <<en>>
  # Answers [id, x, y, w, h, data] or nil. Where targets overlap,
  # **the one added first wins**.
  #
  # ```ruby
  # b = @hits.at(ev[:x], ev[:y])
  # tile = b[5] if b
  # ```
  def at: (Integer x, Integer y) -> Array?

  # 点にある範囲の id <<en>> The id of the target at a point
  #
  # 無ければ nil。重なっているときは先に足した方。
  #
  # ```ruby
  # case @hits.id_at(ev[:x], ev[:y])
  # when :ok then close
  # end
  # ```
  # <<en>>
  # nil when there is none; where targets overlap, the one added first.
  #
  # ```ruby
  # case @hits.id_at(ev[:x], ev[:y])
  # when :ok then close
  # end
  # ```
  def id_at: (Integer x, Integer y) -> untyped
end
