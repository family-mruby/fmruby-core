# 絵を描くための道具。実装は lib/add/picoruby-fmrb-app/mrblib/fmrb-gfx.rb と
# ports/esp32/gfx.c。`_` で始まる内部用のメソッドは書いていない。
#
# 描くメソッドは自分自身を返すので、続けて書ける。
# 色は RGB332 の数 (FmrbGfx.rgb_to_332 で作れる)。

class FmrbGfx
  # ---- 色 ----
  #
  # 短い名前 (BLACK など) は C が、COLOR_ 付きは mrblib が決めている。
  # 中身は同じ RGB332 の数なので、どちらで書いてもよい。

  # 黒 (RGB332) <<en>> black (RGB332)
  BLACK: Integer
  # 白 (RGB332) <<en>> white (RGB332)
  WHITE: Integer
  # 赤 (RGB332) <<en>> red (RGB332)
  RED: Integer
  # 緑 (RGB332) <<en>> green (RGB332)
  GREEN: Integer
  # 青 (RGB332) <<en>> blue (RGB332)
  BLUE: Integer
  # 黄 (RGB332) <<en>> yellow (RGB332)
  YELLOW: Integer
  # 水色 (RGB332) <<en>> cyan (RGB332)
  CYAN: Integer
  # 紫 (RGB332) <<en>> magenta (RGB332)
  MAGENTA: Integer
  # 灰色 (RGB332) <<en>> gray (RGB332)
  GRAY: Integer

  # 黒 (RGB332)
  COLOR_BLACK: Integer
  # 白 (RGB332)
  COLOR_WHITE: Integer
  # 赤 (RGB332)
  COLOR_RED: Integer
  # 緑 (RGB332)
  COLOR_GREEN: Integer
  # 青 (RGB332)
  COLOR_BLUE: Integer
  # 黄 (RGB332)
  COLOR_YELLOW: Integer
  # 水色 (RGB332)
  COLOR_CYAN: Integer
  # 紫 (RGB332)
  COLOR_MAGENTA: Integer
  # 灰色 (RGB332)
  COLOR_GRAY: Integer

  # 色を加算で混ぜる (blend_rect 用) <<en>> additive blend (for blend_rect)
  BLEND_ADD: Integer
  # 色を XOR で混ぜる (blend_rect 用) <<en>> XOR blend (for blend_rect)
  BLEND_XOR: Integer

  # ---- この画面のこと ----

  # 画面の番号
  def canvas_id: () -> Integer

  # 画面の横幅 (ドット)
  def canvas_width: () -> Integer

  # 画面の高さ (ドット)
  def canvas_height: () -> Integer

  # 今えらんでいる字の種類
  def current_font: () -> Symbol

  # 今の字の大きさの倍率
  def current_text_size: () -> Integer

  # ---- 形を描く ----

  # 画面ぜんぶを一色でぬる
  def clear: (Integer color) -> FmrbGfx

  # 点を一つ打つ
  def set_pixel: (Integer x, Integer y, Integer color) -> FmrbGfx

  # 点の色を読む
  def get_pixel: (Integer x, Integer y) -> Integer

  # まっすぐな線を引く
  def draw_line: (Integer x0, Integer y0, Integer x1, Integer y1, Integer color) -> FmrbGfx

  # 太さのある線を引く
  def draw_thick_line: (Integer x0, Integer y0, Integer x1, Integer y1, Integer thickness, Integer color) -> FmrbGfx

  # 四角のふちを描く
  #
  # (x, y) は左上の角、w は横幅、h は高さです。線だけを描くので、
  # 中は下にあるものが見えたままになります。中もぬりたいときは
  # `fill_rect` を使います。
  #
  # ```ruby
  # gfx.draw_rect(10, 10, 100, 50, FmrbGfx::WHITE)   # わく
  # gfx.fill_rect(12, 12, 96, 46, FmrbGfx::BLUE)     # 中身
  # gfx.present
  # ```
  def draw_rect: (Integer x, Integer y, Integer w, Integer h, Integer color) -> FmrbGfx

  # 四角をぬりつぶす
  #
  # (x, y) は左上の角、w は横幅、h は高さです。中まで色でうめます。
  # 画面ぜんぶを消したいときは `clear` のほうが速いです。
  #
  # 動くものを描くときは、**前にいた場所を背景色でぬってから**新しい場所に
  # 描くと、跡が残りません。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     gfx.fill_rect(@x, 100, 16, 16, FmrbGfx::BLACK)  # 前の場所を消す
  #     @x = @x + 2
  #     gfx.fill_rect(@x, 100, 16, 16, FmrbGfx::RED)    # 新しい場所に描く
  #     gfx.present
  #   end
  # end
  # ```
  def fill_rect: (Integer x, Integer y, Integer w, Integer h, Integer color) -> FmrbGfx

  # 下の絵と混ぜて四角をぬる
  def blend_rect: (Integer x, Integer y, Integer w, Integer h, Integer color, Integer alpha) -> FmrbGfx

  # 角の丸い四角のふちを描く
  def draw_round_rect: (Integer x, Integer y, Integer w, Integer h, Integer r, Integer color) -> FmrbGfx

  # 角の丸い四角をぬりつぶす
  def fill_round_rect: (Integer x, Integer y, Integer w, Integer h, Integer r, Integer color) -> FmrbGfx

  # 円のふちを描く
  def draw_circle: (Integer x, Integer y, Integer r, Integer color) -> FmrbGfx

  # 円をぬりつぶす
  def fill_circle: (Integer x, Integer y, Integer r, Integer color) -> FmrbGfx

  # だ円のふちを描く
  def draw_ellipse: (Integer x, Integer y, Integer rx, Integer ry, Integer color) -> FmrbGfx

  # だ円をぬりつぶす
  def fill_ellipse: (Integer x, Integer y, Integer rx, Integer ry, Integer color) -> FmrbGfx

  # 三角のふちを描く
  def draw_triangle: (Integer x0, Integer y0, Integer x1, Integer y1, Integer x2, Integer y2, Integer color) -> FmrbGfx

  # 三角をぬりつぶす
  def fill_triangle: (Integer x0, Integer y0, Integer x1, Integer y1, Integer x2, Integer y2, Integer color) -> FmrbGfx

  # 円の一部の弧を描く
  def draw_arc: (Integer x, Integer y, Integer r0, Integer r1, Integer angle0, Integer angle1, Integer color) -> FmrbGfx

  # 円の一部をぬりつぶす
  def fill_arc: (Integer x, Integer y, Integer r0, Integer r1, Integer angle0, Integer angle1, Integer color) -> FmrbGfx

  # ---- 字を描く ----

  # 文字列を描く <<en>> draw a string
  #
  # (x, y) は文字列の**左上**の位置です。画面の左上が (0, 0) で、
  # 右に行くほど x が大きく、下に行くほど y が大きくなります。
  # color は RGB332 の数です。`FmrbGfx::WHITE` のような決まった色か、
  # `FmrbGfx.rgb_to_332(255, 0, 0)` で好きな色を指定できます。
  #
  # 描いたものは `present` を呼ぶまで画面に出ません。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.draw_text(10, 20, "こんにちは", FmrbGfx::WHITE)
  #     gfx.present
  #   end
  # end
  # ```
  # <<en>>
  # (x, y) is the **top-left** corner of the string. The screen's top-left is
  # (0, 0): x grows to the right and y grows downwards.
  # color is an RGB332 value -- a named one such as `FmrbGfx::WHITE`, or any
  # colour made with `FmrbGfx.rgb_to_332(255, 0, 0)`.
  #
  # Nothing appears on the screen until `present` is called.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.draw_text(10, 20, "hello", FmrbGfx::WHITE)
  #     gfx.present
  #   end
  # end
  # ```
  def draw_text: (Integer x, Integer y, String str, Integer color) -> FmrbGfx

  # 字の種類と大きさをえらぶ (無い字は近いものに変わる。選ばれた組を返す)
  #
  # family は :default (6x8 の英数)、:ja (日本語)、:ja_bold (:ja の太字)。
  # size は画素の高さで、:ja は 8 と 12 と 16、:ja_bold は 12。持っている字は
  # 機種で違う (Retro は 12 まで) ので、無い大きさや太字を頼むと近いものが
  # 選ばれる。戻り値は実際に選ばれた [family, size] で、太字が無かったことも
  # これで分かる (自分で太く描くときの判断に使う)。
  def set_font: (Symbol family, ?Integer size) -> Array[untyped]

  # 字の大きさの倍率を決める
  def set_text_size: (Integer size) -> FmrbGfx

  # 字を描いたときの横幅を測る
  def text_width: (String str) -> Integer

  # 一行分の高さを調べる
  def font_height: () -> Integer

  # 今の時刻を描く
  def draw_wallclock: (Integer x, Integer y, Integer color, Integer bg_color) -> FmrbGfx

  # 空きメモリの量を描く
  def draw_free_iram: (Integer x, Integer y, Integer color, Integer bg_color) -> FmrbGfx

  # ---- 絵の読み込みと表示 ----

  # 絵のファイルを読み込んで置く
  def load_image: (String path) -> void

  # 絵のファイルから絵を作る
  def create_image: (String path) -> Hash?

  # 作った絵を描く
  def draw_image: (Integer image_id) -> FmrbGfx

  # 作った絵を片づける
  def delete_image: (Integer image_id) -> FmrbGfx

  # 絵の一部を切り取って描く
  def draw_tile: (Integer image_id, Integer src_x, Integer src_y, Integer w, Integer h) -> FmrbGfx

  # 型ぬきの形を作る
  def create_mask: (Integer width, Integer height, String data) -> Integer

  # 型ぬきの形を片づける
  def delete_mask: (Integer mask_id) -> void

  # 型でぬいた形の絵を描く
  def draw_image_masked: (Integer image_id, Integer mask_id) -> FmrbGfx

  # ---- 画面に出す ----

  # 描いたものを画面に出す <<en>> show what has been drawn
  def present: () -> FmrbGfx

  # この画面を片づける
  def destroy: () -> FmrbGfx

  # 画面の見せる場所をずらす
  def set_viewport: (Integer src_x, Integer src_y, Integer w, Integer h) -> void

  # ずらした場所を元に戻す
  def clear_viewport: () -> void

  # 重ねて見せる場所を決める
  def set_composite_regions: (Array regions) -> void

  # スプライトが出られる範囲を決める <<en>> limit where sprites may appear
  #
  # スプライトは canvas に描いた絵の上に重ねて合成されるので、何も
  # しないと窓のわくやタイトルバーの上にもはみ出す。この四角の中だけに
  # 出るようにする。x, y, w, h は SpriteInstance#move と同じ座標。
  #
  # 窓のアプリは起動時に窓の中身の範囲が入っているので、ふつうは呼ぶ
  # 必要はない。点数を出す帯など、さらに狭い範囲に閉じ込めたいときに使う。
  # ```ruby
  # # 上 10px を点数の帯にして、スプライトはその下だけに出す
  # @gfx.set_sprite_clip(@user_area_x0, @user_area_y0 + 10,
  #                      @user_area_width, @user_area_height - 10)
  # ```
  # <<en>>
  # Sprites are composited on top of everything drawn into the canvas, so
  # without a clip they paint over the window frame and title bar. This
  # confines them to the given rect, in the same coordinates as
  # SpriteInstance#move.
  #
  # Windowed apps start with their user area set, so calling this is only
  # needed to narrow it further - e.g. to keep sprites out of a score bar.
  # ```ruby
  # # reserve the top 10px for the score; sprites stay below it
  # @gfx.set_sprite_clip(@user_area_x0, @user_area_y0 + 10,
  #                      @user_area_width, @user_area_height - 10)
  # ```
  def set_sprite_clip: (Integer x, Integer y, Integer w, Integer h) -> FmrbGfx

  # スプライトの範囲の決まりをなくす <<en>> let sprites use the whole canvas
  def clear_sprite_clip: () -> FmrbGfx

  # 映像の明るさを決める
  def set_output_level: (Integer level) -> FmrbGfx

  # 映像の色の濃さを決める
  def set_chroma_level: (Integer level) -> FmrbGfx

  # ---- ファイルの受けわたし ----

  # 絵や音のファイルを送る
  def sync_file: (String path) -> bool

  # ファイルを必ず送り直す
  def transfer_file: (String path) -> bool

  # 送った先にファイルがあるか
  def file_status: (String path) -> Hash

  # ---- クラスメソッド ----

  # 赤緑青の三つの数から色を作る
  def self.rgb_to_332: (Integer r, Integer g, Integer b) -> Integer

  # 色あいと濃さと明るさから色を作る
  def self.hsv_to_rgb: (Integer h, Integer s, Integer v) -> Array
end
