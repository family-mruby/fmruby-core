# 絵を描くための道具。実装は lib/gems/picoruby-fmrb-app/mrblib/fmrb-gfx.rb と
# ports/esp32/gfx.c。`_` で始まる内部用のメソッドは書いていない。
#
# FmrbGfx はクラスごと本体との境界に載る (%a{fmrb.boundary}、doc/app_boundary)。
# 載せないもの (Ruby で書いたメソッドと、まだ包みが持つ状態) には
# %a{fmrb.internal} を付ける。後ろに _raw の付くメソッドは、省略できる引数を
# 持つ包み (draw_text など) の、省略なしの形。描く先の canvas・原点・区画は
# 境界の下 (本体の C) が持ち、canvas_id・origin_x などで読める。
#
# 描くメソッドは自分自身を返すので、続けて書ける。
# 色は RGB332 の数 (FmrbGfx.rgb_to_332 で作れる)。

# 文字を px で測って詰める・折る道具 <<en>> Fit and wrap a text in pixels
#
# FmrbGfx に混ぜてあるので、`@gfx.fit_text` のように呼ぶ。幅は呼んだ
# 時点のフォントと文字の大きさで測る (text_width と同じ数字)。何も
# 覚えない。実装は lib/gems/picoruby-fmrb-app/mrblib/fmrb-text.rb。
#
# ```ruby
# s = @gfx.fit_text(name, 80)
# @gfx.draw_text(x, y, s, theme_fg)
# ```
# <<en>>
# Mixed into FmrbGfx, so call it on @gfx. Widths are measured with the
# font and text size selected at the time of the call (the same numbers as
# text_width). It remembers nothing. Implemented in
# lib/gems/picoruby-fmrb-app/mrblib/fmrb-text.rb.
#
# ```ruby
# s = @gfx.fit_text(name, 80)
# @gfx.draw_text(x, y, s, theme_fg)
# ```
module FmrbText
  # 文字を幅に収まるよう切る <<en>> Cut a text to fit a width in pixels
  #
  # **収まる文字はそのまま返る**。切ったときだけ 3 番目の引数の印
  # (`"…"`、`".."`) を付け、その幅の分を空けて切る。印を省くと何も
  # 付けずに切る。4 番目は印の幅 (px、nil で測る)、5 番目は測る
  # フォント (nil で今のフォント)。
  #
  # ```ruby
  # @gfx.fit_text(title, 100)
  # @gfx.fit_text(title, 100, "…")
  # @gfx.fit_text(name, w, "..", nil,
  #               :default)
  # ```
  # <<en>>
  # **A text that fits comes back unchanged.** Only when it has to be cut
  # is the third argument appended as a mark ("…", ".."), with room kept
  # for it; without a mark the text is just cut. The fourth argument is the
  # mark's width in pixels (nil measures it), the fifth the font to measure
  # with (nil means the current one).
  #
  # ```ruby
  # @gfx.fit_text(title, 100)
  # @gfx.fit_text(title, 100, "…")
  # @gfx.fit_text(name, w, "..", nil,
  #               :default)
  # ```
  def fit_text: (String text, Integer width, ?String mark, ?Integer? mark_w, ?Symbol? family) -> String

  # 文字を最大 2 行に折る <<en>> Wrap a text into at most two lines
  #
  # 戻り値は 1 つか 2 つの文字列の配列。1 行目の最後の空白で割って
  # 残りが 1 行に収まればそこで、だめなら幅で割り、2 行目がまだ長ければ
  # `…` で詰める。3 行以上は fit_text で 1 行ずつ切る。
  #
  # ```ruby
  # lines = @gfx.wrap_text(msg, 120)
  # ```
  # <<en>>
  # Answers an array of one or two strings. The break goes at the last
  # space of the first line when the rest then fits on one line; otherwise
  # at the width, and a second line still too long ends in "…". For three
  # lines or more, cut one line at a time with fit_text.
  #
  # ```ruby
  # lines = @gfx.wrap_text(msg, 120)
  # ```
  def wrap_text: (String text, Integer width) -> Array[String]

  # 折った文字を行ごとに描く <<en>> Draw a text wrapped into lines
  #
  # wrap_text の行を line_h 間隔で下へ描き、最後の行の下の y を返す。
  #
  # ```ruby
  # y = @gfx.draw_text_lines(x, y, msg,
  #       120, theme_fg, 15)
  # ```
  # <<en>>
  # Draws the lines of wrap_text downwards, line_h apart, and answers the y
  # under the last one.
  #
  # ```ruby
  # y = @gfx.draw_text_lines(x, y, msg,
  #       120, theme_fg, 15)
  # ```
  def draw_text_lines: (Integer x, Integer y, String text, Integer width, Integer color, Integer line_h) -> Integer
end

# 絵を描く画面。図形・文字・画像・スプライト <<en>> A canvas: shapes, text, images, sprites
#
# アプリは自分で作らない。`FmrbApp` が用意する `gfx` (`@gfx`) を使う。原点 (0, 0) は
# アプリが描いてよい区画の左上で、色は RGB332 の数 (`FmrbGfx::RED` など)。
# 描くメソッドは自分自身を返すので続けて書ける。**描いただけでは出ない**。
# フレームの終わりに `present` を 1 回呼ぶ。
#
# 最初に読むとよいメソッド: `clear`、`fill_rect`、`draw_text`、`draw_image`、
# `present`。
# <<en>>
# An app does not make one; it uses the `gfx` (`@gfx`) that `FmrbApp`
# prepares. The origin (0, 0) is the top-left of the area the app owns, and
# colours are RGB332 numbers (`FmrbGfx::RED` and so on). The drawing
# methods return the canvas itself, so calls chain. **Drawing alone shows nothing**:
# call `present` once at the end of a frame.
#
# Methods to read first: `clear`, `fill_rect`, `draw_text`, `draw_image`,
# `present`.
%a{fmrb.boundary}
class FmrbGfx
  include FmrbText

  # create_image が返す絵の番号と大きさ <<en>> An image's number and size, from create_image
  type image_info = { id: uint16, width: uint16, height: uint16 }

  # file_status が返す描画側のファイルのようす <<en>> A file on the graphics side, from file_status
  type file_info = { exists: bool, size: uint32 }

  # 合成する矩形 1 つ (set_composite_regions_raw) <<en>> One composited rectangle
  type composite_region = { src_x: int16, src_y: int16, dst_x: int16, dst_y: int16, w: int16, h: int16, transparent: bool }

  # video_open_raw が返す動画の大きさ <<en>> A video's size, from video_open_raw
  type video_info = { width: uint16, height: uint16 }

  # 動画の再生のようす <<en>> The video player's state
  type video_status = { state: uint8, shown: uint32, dropped: uint32 }

  # picture_info が返す絵の大きさと形 <<en>> A picture file's size and kind, from picture_info
  type picture_info = { width: uint16, height: uint16, format: uint8, bytes: uint32, mtime: uint32 }

  # ---- 色 ----
  #
  # 短い名前 (BLACK など) は C が、COLOR_ 付きは mrblib が決めている。
  # 中身は同じ RGB332 の数なので、どちらで書いてもよい。

  # 黒 (RGB332) <<en>> black (RGB332)
  BLACK: Integer
  # 白 (RGB332) <<en>> white (RGB332)
  WHITE: Integer
  # 赤 (RGB332) <<en>> red (RGB332)
  RED: Integer
  # 緑 (RGB332) <<en>> green (RGB332)
  GREEN: Integer
  # 青 (RGB332) <<en>> blue (RGB332)
  BLUE: Integer
  # 黄 (RGB332) <<en>> yellow (RGB332)
  YELLOW: Integer
  # 水色 (RGB332) <<en>> cyan (RGB332)
  CYAN: Integer
  # 紫 (RGB332) <<en>> magenta (RGB332)
  MAGENTA: Integer
  # 灰色 (RGB332) <<en>> gray (RGB332)
  GRAY: Integer

  # 黒 (RGB332) <<en>> black (RGB332)
  COLOR_BLACK: Integer
  # 白 (RGB332) <<en>> white (RGB332)
  COLOR_WHITE: Integer
  # 赤 (RGB332) <<en>> red (RGB332)
  COLOR_RED: Integer
  # 緑 (RGB332) <<en>> green (RGB332)
  COLOR_GREEN: Integer
  # 青 (RGB332) <<en>> blue (RGB332)
  COLOR_BLUE: Integer
  # 黄 (RGB332) <<en>> yellow (RGB332)
  COLOR_YELLOW: Integer
  # 水色 (RGB332) <<en>> cyan (RGB332)
  COLOR_CYAN: Integer
  # 紫 (RGB332) <<en>> magenta (RGB332)
  COLOR_MAGENTA: Integer
  # 灰色 (RGB332) <<en>> gray (RGB332)
  COLOR_GRAY: Integer

  # 色を加算で混ぜる (blend_rect 用) <<en>> additive blend (for blend_rect)
  BLEND_ADD: Integer
  # 色を XOR で混ぜる (blend_rect 用) <<en>> XOR blend (for blend_rect)
  BLEND_XOR: Integer

  # ---- この画面のこと ----

  # 画面の番号 <<en>> The canvas number
  #
  # ```ruby
  # id = gfx.canvas_id
  # ```
  def canvas_id: () -> Integer

  # 画面の横幅 (ドット) <<en>> Canvas width in pixels
  #
  # canvas 全体の幅。Window のアプリが描いてよいのは、その内側の
  # 区画 (area_width、@user_area_width と同じ) で、canvas_width とは違う。
  # 全画面のアプリでは一致する。
  # ```ruby
  # w = @gfx.canvas_width
  # ```
  # <<en>>
  # The width of the whole canvas. A windowed app may only draw inside its
  # area (area_width, the same as @user_area_width), which is not the same
  # thing; for a fullscreen app the two agree.
  # ```ruby
  # w = @gfx.canvas_width
  # ```
  %a{fmrb.internal}
  def canvas_width: () -> Integer

  # 描く区画の横幅 (ドット) <<en>> Width of the area drawn in
  #
  # 原点 (0, 0) から描いてよい幅。アプリの gfx では @user_area_width と同じ。
  # ```ruby
  # w = @gfx.area_width
  # ```
  # <<en>>
  # How far from the origin there is to draw in. For the app's gfx it is
  # @user_area_width.
  # ```ruby
  # w = @gfx.area_width
  # ```
  def area_width: () -> Integer

  # 描く区画の高さ (ドット) <<en>> Height of the area drawn in
  #
  # 原点 (0, 0) から描いてよい高さ。`area_width` と対。アプリの gfx では @user_area_height と同じ。
  # ```ruby
  # @gfx.fill_rect(0, 0, @gfx.area_width,
  #                 @gfx.area_height, 0)
  # ```
  # <<en>>
  # How far from the origin there is to draw down. The pair of `area_width`; for the app's gfx it is @user_area_height.
  # ```ruby
  # @gfx.fill_rect(0, 0, @gfx.area_width,
  #                 @gfx.area_height, 0)
  # ```
  def area_height: () -> Integer

  # 原点の canvas 上の x <<en>> Where the origin is on the canvas (x)
  #
  # 描く座標はすべてここに足されて canvas に届く (本体の側で足す)。枠のある
  # Window の gfx は 1、window_gfx などは 0。スプライトの画像へ描いている間は
  # 描く座標に足さないが、スプライトの座標 (set_sprite_clip・SpriteInstance)
  # には足す。
  # ```ruby
  # FmrbApp.set_text_cursor(
  #   @gfx.origin_x + x,
  #   @gfx.origin_y + y, 12)
  # ```
  # <<en>>
  # Every coordinate drawn is added to it on its way to the canvas (the
  # firmware adds it): 1 for a framed window's gfx, 0 for window_gfx and the
  # rest. While drawing into a sprite image it is not added to what is drawn,
  # but it still is to sprite coordinates (set_sprite_clip, SpriteInstance).
  # ```ruby
  # FmrbApp.set_text_cursor(
  #   @gfx.origin_x + x,
  #   @gfx.origin_y + y, 12)
  # ```
  def origin_x: () -> Integer

  # 原点の canvas 上の y <<en>> Where the origin is on the canvas (y)
  #
  # `origin_x` の縦の対。描く座標に足されて canvas に届く y 座標の原点で、枠のある Window の gfx は 1、window_gfx などは 0。
  # ```ruby
  # FmrbApp.set_text_cursor(
  #   @gfx.origin_x + x,
  #   @gfx.origin_y + y, 12)
  # ```
  # <<en>>
  # The vertical pair of `origin_x`: the y of the origin that is added to every coordinate on its way to the canvas. 1 for a framed window's gfx, 0 for window_gfx and the rest.
  # ```ruby
  # FmrbApp.set_text_cursor(
  #   @gfx.origin_x + x,
  #   @gfx.origin_y + y, 12)
  # ```
  def origin_y: () -> Integer

  # 画面の高さ (ドット) <<en>> Canvas height in pixels
  #
  # ```ruby
  # h = gfx.canvas_height
  # ```
  %a{fmrb.internal}
  def canvas_height: () -> Integer

  # 今えらんでいる字の種類 <<en>> The font in use now
  #
  # ```ruby
  # saved = gfx.current_font
  # gfx.set_font(:ja)
  # gfx.set_font(saved)
  # ```
  %a{fmrb.internal}
  def current_font: () -> Symbol

  # 今の字の大きさの倍率 <<en>> The text scale in use now
  #
  # ```ruby
  # n = gfx.current_text_size
  # ```
  %a{fmrb.internal}
  def current_text_size: () -> Integer

  # ---- 形を描く ----

  # 画面ぜんぶを一色でぬる <<en>> Paint the whole canvas one colour
  #
  # canvas 全体を塗る。Window のアプリで呼ぶと、自分で描いたタイトルバーもわくも
  # 消える。Window の中だけを消すなら FmrbApp#clear_user_area を使う。あちらは
  # わくを描き直し、付いている FmrbUI の部品にも描き直しの印を付ける。
  #
  # 全画面のアプリなら clear でよく、fill_rect で同じ範囲を塗るより速い。
  # ```ruby
  # @gfx.clear(FmrbGfx::BLACK)
  # @gfx.present
  # ```
  # <<en>>
  # Fills the whole canvas. In a windowed app that erases the title bar and
  # frame the app drew itself; to clear only the inside of the window use
  # FmrbApp#clear_user_area, which redraws the frame and marks any attached
  # FmrbUI widgets for redraw.
  #
  # For a fullscreen app clear is the right call, and faster than a fill_rect
  # over the same area.
  # ```ruby
  # @gfx.clear(FmrbGfx::BLACK)
  # @gfx.present
  # ```
  def clear: (Integer color) -> FmrbGfx

  # 点を一つ打つ <<en>> Set one pixel
  #
  # ```ruby
  # gfx.set_pixel(10, 20,
  #               FmrbGfx::WHITE)
  # ```
  def set_pixel: (Integer x, Integer y, Integer color) -> FmrbGfx

  # 点の色を読む <<en>> Read one pixel's colour
  #
  # 描画側への同期的な往復になる。1 画素ずつ読んで画面を走査するような
  # 使い方には向かない。
  #
  # canvas の外を指すと 0 を返す。0 は黒でもあるので、範囲外と黒は
  # 戻り値では区別できない。
  # ```ruby
  # c = @gfx.get_pixel(60, 40)
  # # canvas の外は 0
  # ```
  # <<en>>
  # A synchronous round trip to the graphics side. Not something to do per
  # pixel in a loop scanning the screen.
  #
  # Outside the canvas it returns 0, which is also black -- the return value
  # does not tell the two apart.
  # ```ruby
  # c = @gfx.get_pixel(60, 40)
  # # 0 outside the canvas
  # ```
  def get_pixel: (Integer x, Integer y) -> Integer

  # まっすぐな線を引く <<en>> Draw a straight line
  #
  # ```ruby
  # gfx.draw_line(0, 0, 100, 60,
  #               FmrbGfx::WHITE)
  # ```
  def draw_line: (Integer x0, Integer y0, Integer x1, Integer y1, Integer color) -> FmrbGfx

  # 太さのある線を引く <<en>> Draw a line with a thickness
  #
  # 描画側に太い線の命令が無いので、1 画素の線を thickness 本だけずらして
  # 重ねている。太さの分だけ命令が増えるので、太い線を毎フレーム引くと効く。
  # ```ruby
  # @gfx.draw_thick_line(10, 10, 60, 40,
  #                     2, FmrbGfx::WHITE)
  # ```
  # <<en>>
  # The graphics side has no thick-line primitive, so this stacks thickness
  # one-pixel lines side by side. The cost grows with the thickness, which
  # shows if thick lines are drawn every frame.
  # ```ruby
  # @gfx.draw_thick_line(10, 10, 60, 40,
  #                     2, FmrbGfx::WHITE)
  # ```
  %a{fmrb.internal}
  def draw_thick_line: (Integer x0, Integer y0, Integer x1, Integer y1, Integer thickness, Integer color) -> FmrbGfx

  # 四角のふちを描く <<en>> Draw the outline of a rectangle
  #
  # (x, y) は左上の角、w は横幅、h は高さです。線だけを描くので、
  # 中は下にあるものが見えたままになります。中もぬりたいときは
  # `fill_rect` を使います。
  #
  # ```ruby
  # gfx.draw_rect(10, 10, 100, 50,
  #               FmrbGfx::WHITE)  # わく
  # gfx.fill_rect(12, 12, 96, 46,
  #               FmrbGfx::BLUE)   # 中身
  # gfx.present
  # ```
  # <<en>>
  # (x, y) is the top-left corner, w the width, h the height. It draws the
  # outline only, so whatever is underneath stays visible inside. Use
  # `fill_rect` to colour the inside too.
  #
  # ```ruby
  # gfx.draw_rect(10, 10, 100, 50,
  #               FmrbGfx::WHITE)  # frame
  # gfx.fill_rect(12, 12, 96, 46,
  #               FmrbGfx::BLUE)   # inside
  # gfx.present
  # ```
  def draw_rect: (Integer x, Integer y, Integer w, Integer h, Integer color) -> FmrbGfx

  # 四角をぬりつぶす <<en>> Fill a rectangle
  #
  # (x, y) は左上の角、w は横幅、h は高さです。中まで色でうめます。
  # 画面ぜんぶを消したいときは `clear` のほうが速いです。
  #
  # 動くものを描くときは、**前にいた場所を背景色でぬってから**新しい場所に
  # 描くと、跡が残りません。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     # 前の場所を消す
  #     gfx.fill_rect(@x, 100, 16, 16,
  #                   FmrbGfx::BLACK)
  #     @x = @x + 2
  #     # 新しい場所に描く
  #     gfx.fill_rect(@x, 100, 16, 16,
  #                   FmrbGfx::RED)
  #     gfx.present
  #   end
  # end
  # ```
  # <<en>>
  # (x, y) is the top-left corner, w the width, h the height, and the inside
  # is filled. To wipe the whole canvas, `clear` is faster.
  #
  # For something that moves,
  # **paint over where it was in the background colour first**,
  # then draw it at the new place, and it leaves no trail.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     # erase the old place
  #     gfx.fill_rect(@x, 100, 16, 16,
  #                   FmrbGfx::BLACK)
  #     @x = @x + 2
  #     # draw at the new one
  #     gfx.fill_rect(@x, 100, 16, 16,
  #                   FmrbGfx::RED)
  #     gfx.present
  #   end
  # end
  # ```
  def fill_rect: (Integer x, Integer y, Integer w, Integer h, Integer color) -> FmrbGfx

  # 下の絵と混ぜて四角をぬる <<en>> Fill a rectangle blended with what is under it
  #
  # 最後の引数は混ぜ方で、FmrbGfx::BLEND_ADD (加算) か FmrbGfx::BLEND_XOR。
  # 透明度ではない。加算は光っている表現に、XOR は下の色を反転させる表現に使う。
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 64, 64, FmrbGfx::BLUE)
  # gfx.blend_rect(16, 16, 32, 32,
  #                FmrbGfx::RED, FmrbGfx::BLEND_ADD)
  # ```
  # <<en>>
  # The last argument is the blend mode -- FmrbGfx::BLEND_ADD or
  # FmrbGfx::BLEND_XOR -- not an opacity. Additive reads as a glow; XOR
  # inverts what is underneath.
  #
  # ```ruby
  # gfx.fill_rect(0, 0, 64, 64, FmrbGfx::BLUE)
  # gfx.blend_rect(16, 16, 32, 32,
  #                FmrbGfx::RED, FmrbGfx::BLEND_ADD)
  # ```
  def blend_rect: (Integer x, Integer y, Integer w, Integer h, Integer color, Integer mode) -> FmrbGfx

  # 角の丸い四角のふちを描く <<en>> Draw a rounded rectangle outline
  #
  # ```ruby
  # gfx.draw_round_rect(10, 10, 80, 40,
  #                     6, theme_fg)
  # ```
  def draw_round_rect: (Integer x, Integer y, Integer w, Integer h, Integer r, Integer color) -> FmrbGfx

  # 角の丸い四角をぬりつぶす <<en>> Fill a rounded rectangle
  #
  # ```ruby
  # gfx.fill_round_rect(10, 10, 80, 40,
  #                     6, theme_bg)
  # ```
  def fill_round_rect: (Integer x, Integer y, Integer w, Integer h, Integer r, Integer color) -> FmrbGfx

  # 角の丸いボタンの絵を描く <<en>> Draw the picture of a rounded button
  #
  # 地を fill で塗り、label を fg で中央に描く (今のフォント)。**絵だけ**で、
  # 押せる範囲は持たない。毎回描く画面では FmrbUI::HitAreas#add と
  # 2 行で使う。8 番目に角の半径を渡せる (既定 3)。
  #
  # ```ruby
  # @gfx.draw_button(x, y, 60, 16, "OK",
  #   theme_accent, theme_fg_light)
  # @hits.add(:ok, x, y, 60, 16)
  # ```
  # <<en>>
  # Fills it with fill and centres label in fg with the current font.
  # **Only the picture**: it has no click target. On a screen redrawn every time,
  # pair it with FmrbUI::HitAreas#add. An eighth argument sets the corner
  # radius (default 3).
  #
  # ```ruby
  # @gfx.draw_button(x, y, 60, 16, "OK",
  #   theme_accent, theme_fg_light)
  # @hits.add(:ok, x, y, 60, 16)
  # ```
  %a{fmrb.internal}
  def draw_button: (Integer x, Integer y, Integer w, Integer h, String label, Integer fill, Integer fg) -> FmrbGfx

  # 円のふちを描く <<en>> Draw a circle outline
  #
  # ```ruby
  # gfx.draw_circle(50, 30, 20,
  #                 FmrbGfx::WHITE)
  # ```
  def draw_circle: (Integer x, Integer y, Integer r, Integer color) -> FmrbGfx

  # 円をぬりつぶす <<en>> Fill a circle
  #
  # ```ruby
  # gfx.fill_circle(50, 30, 20,
  #                 FmrbGfx::YELLOW)
  # ```
  def fill_circle: (Integer x, Integer y, Integer r, Integer color) -> FmrbGfx

  # だ円のふちを描く <<en>> Draw an ellipse outline
  #
  # ```ruby
  # gfx.draw_ellipse(50, 30, 30, 15,
  #                  FmrbGfx::WHITE)
  # ```
  def draw_ellipse: (Integer x, Integer y, Integer rx, Integer ry, Integer color) -> FmrbGfx

  # だ円をぬりつぶす <<en>> Fill an ellipse
  #
  # ```ruby
  # gfx.fill_ellipse(50, 30, 30, 15,
  #                  FmrbGfx::CYAN)
  # ```
  def fill_ellipse: (Integer x, Integer y, Integer rx, Integer ry, Integer color) -> FmrbGfx

  # 三角のふちを描く <<en>> Draw a triangle outline
  #
  # ```ruby
  # gfx.draw_triangle(50, 10, 20, 50,
  #                   80, 50,
  #                   FmrbGfx::WHITE)
  # ```
  def draw_triangle: (Integer x0, Integer y0, Integer x1, Integer y1, Integer x2, Integer y2, Integer color) -> FmrbGfx

  # 三角をぬりつぶす <<en>> Fill a triangle
  #
  # ```ruby
  # gfx.fill_triangle(50, 10, 20, 50,
  #                   80, 50,
  #                   FmrbGfx::GREEN)
  # ```
  def fill_triangle: (Integer x0, Integer y0, Integer x1, Integer y1, Integer x2, Integer y2, Integer color) -> FmrbGfx

  # 円の一部の弧を描く <<en>> Draw an arc
  #
  # 角度は度の整数。r0 が内側の半径、r1 が外側の半径で、r0 に 0 でない値を
  # 入れると輪の一部になる。r0 を 0 にすると扇形の外周になる。
  # ```ruby
  # @gfx.draw_arc(80, 60, 35, 45, 0, 360,
  #               FmrbGfx::WHITE)
  # ```
  # <<en>>
  # Angles are integer degrees. r0 is the inner radius and r1 the outer one,
  # so a non-zero r0 gives part of a ring; r0 of 0 gives the outline of a
  # pie slice.
  # ```ruby
  # @gfx.draw_arc(80, 60, 35, 45, 0, 360,
  #               FmrbGfx::WHITE)
  # ```
  def draw_arc: (Integer x, Integer y, Integer r0, Integer r1, Integer angle0, Integer angle1, Integer color) -> FmrbGfx

  # 円の一部をぬりつぶす <<en>> Fill a wedge of a circle
  #
  # 角度は度の整数。r0 が内側の半径、r1 が外側の半径。r0 を 0 にすると扇形、
  # 0 でない値にすると輪の一部になる。ゲージや円グラフはこの形で描ける。
  # ```ruby
  # @gfx.fill_arc(80, 60, 0, 50, 0, 120,
  #              FmrbGfx::BLUE)
  # ```
  # <<en>>
  # Angles are integer degrees. r0 is the inner radius and r1 the outer one:
  # r0 of 0 fills a pie slice, a non-zero r0 fills part of a ring -- which is
  # how a gauge or a pie chart is drawn.
  # ```ruby
  # @gfx.fill_arc(80, 60, 0, 50, 0, 120,
  #              FmrbGfx::BLUE)
  # ```
  def fill_arc: (Integer x, Integer y, Integer r0, Integer r1, Integer angle0, Integer angle1, Integer color) -> FmrbGfx

  # ---- 字を描く ----

  # 文字列を描く <<en>> draw a string
  #
  # (x, y) は文字列の**左上**の位置です。画面の左上が (0, 0) で、
  # 右に行くほど x が大きく、下に行くほど y が大きくなります。
  # color は RGB332 の数です。`FmrbGfx::WHITE` のような決まった色か、
  # `FmrbGfx.rgb_to_332(255, 0, 0)` で好きな色を指定できます。
  #
  # 描いたものは `present` を呼ぶまで画面に出ません。
  # 5 番目の引数を渡すと、字の背景をその色で塗ります (省くと塗らない)。
  # `mixed: true` は、選んでいるフォントに関わらず、英数字を 6x8、
  # 日本語を 8x8 のフォントで描きます。
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.draw_text(10, 20, "こんにちは", FmrbGfx::WHITE)
  #     gfx.present
  #   end
  # end
  # ```
  # <<en>>
  # (x, y) is the **top-left** corner of the string. The screen's top-left is
  # (0, 0): x grows to the right and y grows downwards.
  # color is an RGB332 value -- a named one such as `FmrbGfx::WHITE`, or any
  # colour made with `FmrbGfx.rgb_to_332(255, 0, 0)`.
  #
  # Nothing appears on the screen until `present` is called.
  # A fifth argument paints the background of the characters in that colour
  # (none when left out). `mixed: true` draws ASCII with the 6x8 font and
  # Japanese with the 8x8 one, whatever font is selected.
  #
  # ```ruby
  # class MyApp < FmrbApp
  #   def on_update
  #     gfx.clear(FmrbGfx::BLACK)
  #     gfx.draw_text(10, 20, "hello", FmrbGfx::WHITE)
  #     gfx.present
  #   end
  # end
  # ```
  %a{fmrb.internal}
  def draw_text: (Integer x, Integer y, String text, Integer color, ?Integer? bg_color, ?mixed: bool) -> FmrbGfx

# draw_text の省略なしの形 <<en>> draw_text with nothing left out
#
# 引数を省略できない単純な形。毎フレーム何度も描くような、速さが要る所で
# 使う。bg_color が負なら背景は塗らない。mixed が true なら英数を 6x8、
# それ以外を misaki 8 で描く (draw_text の mixed: true)。包みは draw_text。
# ```ruby
# gfx.draw_text_raw(10, 20, "hi",
#   FmrbGfx::WHITE, -1, false)
# ```
# <<en>>
# The simple form, with no argument left out, for where speed matters
# (drawing many times a frame). A negative bg_color leaves the background
# alone; mixed true draws ASCII in 6x8 and the rest in misaki 8 (draw_text's
# mixed: true). The wrapper is draw_text.
# ```ruby
# gfx.draw_text_raw(10, 20, "hi",
#   FmrbGfx::WHITE, -1, false)
# ```
def draw_text_raw: (Integer x, Integer y, String text, Integer color, Integer bg_color, bool mixed) -> FmrbGfx

  # 字の種類と大きさをえらぶ <<en>> Choose the font and size
  #
  # family は :default (6x8 の英数)、:ja (日本語)、:ja_bold (:ja の太字)。
  # size は画素の高さで、:ja は 8 と 12 と 16、:ja_bold は 12。持っている字は
  # 機種で違う (Retro は 12 まで) ので、無い大きさや太字を頼むと近いものが
  # 選ばれる。戻り値は実際に選ばれた [family, size] で、太字が無かったことも
  # これで分かる (自分で太く描くときの判断に使う)。
  # ```ruby
  # got = gfx.set_font(:ja, 12)
  # ```
  # <<en>>
  # family is :default (6x8 ASCII), :ja (Japanese) or :ja_bold (:ja in bold).
  # size is the height in pixels: 8, 12 and 16 for :ja, 12 for :ja_bold.
  # Which faces exist differs by machine (Retro stops at 12), so asking for a
  # size or a weight it has not got gets you the nearest one. What comes back
  # is the [family, size] actually chosen -- which is also how you find out
  # that bold was unavailable and you should thicken the text yourself.
  # ```ruby
  # got = gfx.set_font(:ja, 12)
  # ```
  %a{fmrb.internal}
  def set_font: (Symbol family, ?Integer size) -> Array[untyped]

# set_font の省略なしの形 <<en>> set_font with nothing left out
#
# 引数を省略できない単純な形。機種が持つ字への置き換えはしないので、
# 無い大きさはエラーになる (:ja は 8・12・16、:ja_bold は 12。:default の
# size は使われない)。current_font は変わらない。包みは set_font。
# ```ruby
# gfx.set_font_raw(:ja, 12)
# ```
# <<en>>
# The simple form, with no argument left out. It does not pick the nearest
# face this machine has, so a size it lacks is an error (:ja takes 8, 12
# and 16, :ja_bold 12; :default ignores size). current_font is left as it
# is. The wrapper is set_font.
# ```ruby
# gfx.set_font_raw(:ja, 12)
# ```
def set_font_raw: (:default | :ja | :ja_bold family, Integer size) -> FmrbGfx

  # 字の大きさの倍率を決める <<en>> Set the text scale
  #
  # 選んでいる字を整数倍で拡大する。字が増えるわけではないので、大きくすると
  # 角が目立つ。倍率をかけた後の幅は text_width が返す。
  # ```ruby
  # @gfx.set_text_size(2)
  # @gfx.draw_text(4, 4, "BIG", 0xFF)
  # @gfx.set_text_size(1)
  # ```
  # <<en>>
  # Scales the selected font by an integer factor. It is the same glyphs
  # enlarged, so the edges get blocky. text_width reports the width after the
  # multiplier.
  # ```ruby
  # @gfx.set_text_size(2)
  # @gfx.draw_text(4, 4, "BIG", 0xFF)
  # @gfx.set_text_size(1)
  # ```
  %a{fmrb.internal}
  def set_text_size: (Integer size) -> FmrbGfx

# set_text_size の包みのない形 <<en>> set_text_size without the wrapper
#
# 倍率 (1〜4) を描画側へ送るだけで、current_text_size と text_width の
# 測り方は変わらない。包みは set_text_size。
# ```ruby
# gfx.set_text_size_raw(2)
# ```
# <<en>>
# Only sends the scale (1 to 4) to the graphics side; current_text_size and
# what text_width measures stay as they were. The wrapper is set_text_size.
# ```ruby
# gfx.set_text_size_raw(2)
# ```
def set_text_size_raw: (Integer size) -> FmrbGfx

  # 字を描いたときの横幅を測る <<en>> Measure how wide text would be
  #
  # いま set_font で選んでいる字と set_text_size の倍率で測る。字を変えたら
  # 測り直す。UTF-8 を走査して画素の幅を返すので、日本語混じりでも文字数では
  # なく実際の幅が返る。
  #
  # ```ruby
  # w = gfx.text_width(text)
  # x = (gfx.area_width - w) / 2
  # gfx.draw_text(x, 20, text, FmrbGfx::WHITE)
  # ```
  # <<en>>
  # Measured with the font set_font selected and the multiplier set_text_size
  # set, so measure again after changing either. It walks the UTF-8, so a
  # mixed Japanese and ASCII string gives a real pixel width rather than a
  # character count.
  #
  # ```ruby
  # w = gfx.text_width(text)
  # x = (gfx.area_width - w) / 2
  # gfx.draw_text(x, 20, text, FmrbGfx::WHITE)
  # ```
  %a{fmrb.internal}
  def text_width: (String text) -> Integer

  # 一行分の高さを調べる <<en>> The height of one line
  #
  # いま選んでいる字の高さ。行を積むときの間隔に使う。字を変えると変わる。
  # ```ruby
  # y += @gfx.font_height + 2
  # ```
  # <<en>>
  # The height of the font currently selected -- the spacing to use when
  # stacking lines. It changes with the font.
  # ```ruby
  # y += @gfx.font_height + 2
  # ```
  %a{fmrb.internal}
  def font_height: () -> Integer

  # 今の時刻を描く <<en>> Draw the time now
  #
  # 時刻の文字はこの中で組み立てられる。毎秒呼んでもごみが出ない。
  # bg_color が負なら背景は塗らない。
  # ```ruby
  # gfx.draw_wallclock(300, 2,
  #                    theme_fg, theme_bg)
  # ```
  # <<en>>
  # The time is formatted inside the call, so calling it every second
  # allocates nothing. A negative bg_color leaves the background as it is.
  # ```ruby
  # gfx.draw_wallclock(300, 2,
  #                    theme_fg, theme_bg)
  # ```
  def draw_wallclock: (Integer x, Integer y, Integer color, Integer bg_color) -> bool

  # 空きメモリの量を描く <<en>> Draw how much memory is free
  #
  # 値の取得も整形もこの中。空きが読めない環境では横棒が出る。
  # bg_color が負なら背景は塗らない。
  # ```ruby
  # gfx.draw_free_iram(360, 2,
  #                    theme_fg, theme_bg)
  # ```
  # <<en>>
  # Fetching and formatting both happen inside. Where no figure can be
  # read, it draws dashes. A negative bg_color leaves the background as it is.
  # ```ruby
  # gfx.draw_free_iram(360, 2,
  #                    theme_fg, theme_bg)
  # ```
  def draw_free_iram: (Integer x, Integer y, Integer color, Integer bg_color) -> bool

  # ---- 絵の読み込みと表示 ----

  # 絵のファイルを読み込んで置く <<en>> Load an image file and place it
  #
  # sync_file、create_image、draw_image、present、delete_image をまとめて行う。
  # 一枚絵を出すだけならこれで足りる。
  #
  # 置き場所は coord: で、[x, y] か :center。省略すると左上。毎フレーム呼ぶ
  # ものではない (呼ぶたびに画像を作り直して捨てる)。
  #
  # ```ruby
  # gfx.load_image("/home/pic.png", coord: :center)
  # ```
  # <<en>>
  # Does sync_file, create_image, draw_image, present and delete_image in one
  # call -- enough when a picture just has to appear.
  #
  # coord: takes [x, y] or :center; left out, it draws at the top left. Not
  # something to call every frame: it builds and throws away the image each
  # time.
  #
  # ```ruby
  # gfx.load_image("/home/pic.png", coord: :center)
  # ```
  %a{fmrb.internal}
  def load_image: (String path) -> void

  # 絵のファイルから絵を作る <<en>> Make an image from a file
  #
  # 受けるのは PNG。スプライトの素材 (RGB332 の PNG・BMP) はこちらではなく
  # SpriteImage#load_bmp が読む。BMP を渡しても例外にはならず、画面と同じ
  # 大きさの空の画像ができて何も出ない。
  #
  # 描画側は自分のファイルシステムしか読めないので、先に sync_file で送る。
  # 戻り値は {id:, width:, height:} か、読めなければ nil。
  #
  # ```ruby
  # path = "/home/pic.png"
  # gfx.sync_file(path)
  # img = gfx.create_image(path)
  # gfx.draw_image(img[:id], x: 0, y: 0) if img
  # ```
  # <<en>>
  # Takes a PNG. Sprite artwork (an RGB332 PNG or BMP) goes through
  # SpriteImage#load_bmp instead. Handing a BMP to this does not raise: you
  # get an empty screen-sized image and nothing appears.
  #
  # The graphics side reads its own filesystem, so send the file with
  # sync_file first. Returns {id:, width:, height:}, or nil when it could not
  # be read.
  #
  # ```ruby
  # path = "/home/pic.png"
  # gfx.sync_file(path)
  # img = gfx.create_image(path)
  # gfx.draw_image(img[:id], x: 0, y: 0) if img
  # ```
  def create_image: (String path) -> image_info?

  # 作った絵を描く <<en>> Draw an image you made
  #
  # 位置と倍率はキーワードで渡す (x:, y:, scale_x:, scale_y:)。scale_y に
  # 0.0 を渡すと scale_x と同じ倍率になる。
  #
  # ```ruby
  # gfx.draw_image(id, x: 10, y: 20)
  # gfx.draw_image(id, x: 10, y: 20,
  #                scale_x: 2.0)   # 縦横とも 2 倍
  # ```
  # <<en>>
  # Position and scale are keyword arguments (x:, y:, scale_x:, scale_y:).
  # A scale_y of 0.0 means "the same as scale_x".
  #
  # ```ruby
  # gfx.draw_image(id, x: 10, y: 20)
  # gfx.draw_image(id, x: 10, y: 20,
  #                scale_x: 2.0)   # both axes doubled
  # ```
  %a{fmrb.internal}
  def draw_image: (Integer image_id) -> FmrbGfx

# draw_image の省略なしの形 <<en>> draw_image with nothing left out
#
# 引数を省略できない単純な形。scale_y に 0.0 を渡すと scale_x と同じ倍率。
# 包みは draw_image。
# ```ruby
# gfx.draw_image_raw(id, 10, 20,
#                    1.0, 0.0)
# ```
# <<en>>
# The simple form, with no argument left out. A scale_y of 0.0 means the
# same as scale_x. The wrapper is draw_image.
# ```ruby
# gfx.draw_image_raw(id, 10, 20,
#                    1.0, 0.0)
# ```
def draw_image_raw: (Integer image_id, Integer x, Integer y, Float scale_x, Float scale_y) -> FmrbGfx

  # 作った絵を片づける <<en>> Let go of an image you made
  #
  # 画像は描画側の資源で、数に限りがある。使い終わったら消す。アプリが
  # 終わるときには系がまとめて片づけるので、終了処理で消し忘れても漏れはしない。
  # ```ruby
  # @gfx.delete_image(@image[:id])
  # ```
  # <<en>>
  # An image is a resource on the graphics side, and there is a limited
  # number of them, so release one when it is done with. The system reclaims
  # them when the app exits, so a missing cleanup at exit does not leak.
  # ```ruby
  # @gfx.delete_image(@image[:id])
  # ```
  def delete_image: (Integer image_id) -> FmrbGfx

  # 絵の一部を切り取って描く <<en>> Draw one piece cut out of an image
  #
  # SpriteImage の一部を canvas に直接押す。SpriteInstance を作らないので、
  # 地形のように動かないものを並べるのに向く。置き場所はキーワード
  # (dst_x:, dst_y:)。
  #
  # use_transparent: true で作った SpriteImage なら、その透明色は抜ける。
  # タイル 1 枚ずつを並べる高水準の側は TileMap にある。
  #
  # scale: で大きさを変えて描ける。2〜32 は元の 1 点を scale x scale に
  # (scale: 2 で 2 倍)、-2〜-32 は 1/|scale| に (scale: -4 で 1/4。
  # 升ごとに左上の 1 点を取る)。中身は draw_tile_scaled_raw。
  #
  # ```ruby
  # sheet.load_bmp("/cache/app/x/tiles.png")
  # gfx.draw_tile(sheet.id, 0, 0, 16, 16,
  #               dst_x: 32, dst_y: 16)
  # gfx.draw_tile(sheet.id, 0, 0, 16, 16,
  #   dst_x: 0, dst_y: 40, scale: 3)
  # ```
  # <<en>>
  # Stamps part of a SpriteImage straight onto the canvas. No SpriteInstance
  # is created, which suits the things that do not move -- terrain, a
  # background. The destination is passed by keyword (dst_x:, dst_y:).
  #
  # A SpriteImage made with use_transparent: true keeps its transparent
  # colour transparent here. TileMap is the higher-level way to lay a whole
  # map out.
  #
  # scale: draws it at another size. 2 to 32 turns each pixel into a
  # scale x scale block (scale: 2 is twice the size); -2 to -32 draws
  # 1/|scale| of it (scale: -4 is a quarter, taking the top-left pixel of
  # each block). It goes through draw_tile_scaled_raw.
  #
  # ```ruby
  # sheet.load_bmp("/cache/app/x/tiles.png")
  # gfx.draw_tile(sheet.id, 0, 0, 16, 16,
  #               dst_x: 32, dst_y: 16)
  # gfx.draw_tile(sheet.id, 0, 0, 16, 16,
  #   dst_x: 0, dst_y: 40, scale: 3)
  # ```
  %a{fmrb.internal}
  def draw_tile: (Integer image_id, Integer src_x, Integer src_y, Integer w, Integer h) -> FmrbGfx

# draw_tile の省略なしの形 <<en>> draw_tile with nothing left out
#
# 置き場所をキーワードでなく位置の引数で渡す形。包みは draw_tile。
# ```ruby
# gfx.draw_tile_raw(sheet.id, 0, 0,
#                   16, 16, 32, 16)
# ```
# <<en>>
# The destination as plain arguments rather than keywords. The wrapper is
# draw_tile.
# ```ruby
# gfx.draw_tile_raw(sheet.id, 0, 0,
#                   16, 16, 32, 16)
# ```
def draw_tile_raw: (Integer image_id, Integer src_x, Integer src_y, Integer w, Integer h, Integer dst_x, Integer dst_y) -> FmrbGfx

# draw_tile を拡大・縮小して描く <<en>> draw_tile drawn larger or smaller
#
# scale が 1〜32 なら元の 1 点を scale x scale に、-2〜-32 なら 1/|scale|
# の大きさに (升ごとに左上の 1 点。0 と -1 は 1)。範囲の外は ERR_ARG。
# 描く先は clip の矩形 (原点から。clip_w か clip_h が 0 なら無し) と
# canvas で切る。透明色は draw_tile と同じに抜ける。包みは draw_tile の
# scale:。
# ```ruby
# gfx.draw_tile_scaled_raw(id, 0, 0,
#   16, 16, 40, 20, 2, 0, 0, 0, 0)
# ```
# <<en>>
# A scale of 1 to 32 turns each pixel into a scale x scale block; -2 to -32
# draws 1/|scale| of the size (the top-left pixel of each block; 0 and -1
# are 1). Out of range is ERR_ARG. The destination is cut to the clip rect
# (from the origin; none when clip_w or clip_h is 0) and to the canvas. The
# transparent colour is skipped as in draw_tile. The wrapper is draw_tile's
# scale:.
# ```ruby
# gfx.draw_tile_scaled_raw(id, 0, 0,
#   16, 16, 40, 20, 2, 0, 0, 0, 0)
# ```
def draw_tile_scaled_raw: (Integer image_id, Integer src_x, Integer src_y, Integer w, Integer h, Integer dst_x, Integer dst_y, Integer scale, Integer clip_x, Integer clip_y, Integer clip_w, Integer clip_h) -> FmrbGfx

  # 絵のファイルの大きさを読む <<en>> Read a picture file's width and height
  #
  # PNG と 8 ビットの BMP の先頭だけを読み、解かない (BMP332.info と同じ
  # C)。結果は {width:, height:, format:, bytes:, mtime:}。format は 1 が
  # PNG、2 が BMP。bytes はファイルの大きさ、mtime は書いた時刻
  # (時刻を持たないファイルシステムでは 0)。無い・読めなければ nil。
  # ファイルは本体の側のもの (描画側に送る前でよい)。
  # ```ruby
  # info = gfx.picture_info("/home/a.png")
  # w = info[:width] if info
  # ```
  # <<en>>
  # Reads only the head of a PNG or an 8-bit BMP; nothing is decoded (the
  # same C as BMP332.info). The result is {width:, height:, format:, bytes:,
  # mtime:}: format is 1 for PNG, 2 for BMP; bytes is the file's size and
  # mtime when it was written (0 on a file system that keeps no time). nil
  # when it is not there or cannot be read. The file is the app's own (it
  # need not have been sent to the display side).
  # ```ruby
  # info = gfx.picture_info("/home/a.png")
  # w = info[:width] if info
  # ```
  def picture_info: (String path) -> picture_info?

  # 絵のファイルを描く (無ければ読む) <<en>> Draw a picture file, reading it in the first time
  #
  # パス (か put_picture の名前) を渡すだけでよい。初めての絵は描画側の
  # スプライトの絵に読み、この FmrbGfx が picture_limit 枚 (既定 8) まで
  # 持つ。超えたら最近使っていないものから離す。ファイルを書き換えると
  # (大きさか時刻が変わると) 次に描くときに読み直す (見に行くのは 1 秒に
  # 1 回まで)。アプリが終わると全部離れる。
  #
  # - scale: 1〜32 は元の 1 点を scale x scale に、-2〜-32 は 1/|scale| に
  # - checker: true で透明の所に市松を敷く (draw_checker)
  # - clip: [x, y, w, h] でその矩形の中だけ描く
  #
  # 描けなければ false (落ちない)。理由は picture_error。65,536 点を
  # 超える絵は断る。65,536 バイトを超えるファイルはアプリの側で読んで
  # (BMP332.load、読む間は VM プールに載る) 画素を置く。透明は 0x01 の色
  # (PNG の α・tRNS)。
  # ```ruby
  # gfx.draw_picture("/home/stamps/a.png",
  #   10, 20, scale: 2)
  # gfx.draw_picture(path, 0, 0,
  #   scale: -2, checker: true)
  # ```
  # <<en>>
  # Just hand the path (or put_picture's name). A picture is read into a
  # sprite image on the display side the first time; this FmrbGfx keeps up
  # to picture_limit of them (8 unless set), letting the least recently
  # drawn go first. A file written again (another size or time) is read
  # again the next time it is drawn (looked at once a second at most). They
  # all go when the app ends.
  #
  # - scale: 1 to 32 turns each pixel into scale x scale; -2 to -32 draws
  #   1/|scale| of the size
  # - checker: true lays the checkerboard under the transparent parts
  #   (draw_checker)
  # - clip: [x, y, w, h] draws only inside that rect
  #
  # false when it cannot be drawn (nothing raises); picture_error says why.
  # A picture past 65,536 pixels is refused. A file past 65,536 bytes is
  # read on the app side (BMP332.load: in the VM pool while it is read) and
  # its pixels put. Transparent is the colour 0x01 (a PNG's alpha and tRNS).
  # ```ruby
  # gfx.draw_picture("/home/stamps/a.png",
  #   10, 20, scale: 2)
  # gfx.draw_picture(path, 0, 0,
  #   scale: -2, checker: true)
  # ```
  %a{fmrb.internal}
  def draw_picture: (String path, Integer x, Integer y) -> bool

  # 絵の幅と高さ ([w, h]) <<en>> A picture's width and height, as [w, h]
  #
  # 置き場にあればその大きさ、無ければファイルの先頭だけを読む
  # (picture_info)。描画側には送らない。絵でなければ nil。
  # ```ruby
  # w, h = gfx.picture_size("/home/a.png")
  # ```
  # <<en>>
  # From the store when the picture is there, else from the file's head
  # (picture_info); nothing goes to the display side. nil when it is not a
  # picture.
  # ```ruby
  # w, h = gfx.picture_size("/home/a.png")
  # ```
  %a{fmrb.internal}
  def picture_size: (String path) -> Array[Integer]?

  # 手元の画素を名前で置き場に置く <<en>> Put RGB332 pixels in the picture store by name
  #
  # pixels は幅 x 高さバイト (上の行から、0x01 が透明)。置いた後は
  # draw_picture(名前, ...) で描く。同じ名前で置き直すと画素を書き直す。
  # ファイルは使わない。場所が無ければ false。
  # ```ruby
  # gfx.put_picture("mine", 16, 16, px)
  # gfx.draw_picture("mine", 0, 0,
  #   scale: 4)
  # ```
  # <<en>>
  # pixels is width x height bytes, top row first; 0x01 is transparent.
  # Draw it with draw_picture(name, ...). Putting the same name again
  # writes the pixels again. No file is involved. false when there is no
  # room.
  # ```ruby
  # gfx.put_picture("mine", 16, 16, px)
  # gfx.draw_picture("mine", 0, 0,
  #   scale: 4)
  # ```
  %a{fmrb.internal}
  def put_picture: (String name, Integer width, Integer height, String pixels) -> bool

  # 置き場の絵を 1 枚離す <<en>> Let go of one picture in the picture store
  #
  # ```ruby
  # gfx.release_picture("/home/a.png")
  # ```
  # <<en>>
  # ```ruby
  # gfx.release_picture("/home/a.png")
  # ```
  %a{fmrb.internal}
  def release_picture: (String path) -> FmrbGfx

  # 置き場の絵を全部離す <<en>> Let go of every picture in the picture store
  #
  # アプリが終わるときは呼ばなくてよい (絵は canvas と一緒に離れる)。
  # 部屋を変えるときなど、もう描かない絵をまとめて離すのに使う。
  # ```ruby
  # gfx.release_pictures
  # ```
  # <<en>>
  # Not needed when the app ends (the pictures go with the canvas). For
  # letting go of pictures no longer drawn, all at once.
  # ```ruby
  # gfx.release_pictures
  # ```
  %a{fmrb.internal}
  def release_pictures: () -> FmrbGfx

  # 置き場に持つ絵の枚数を決める <<en>> How many pictures the picture store keeps
  #
  # 既定は 8。減らすと古いものから離す。描画側の絵の数は機械全体で
  # 限りがある (sim・Retro は 64 枚・256 KB、P4 は 160 枚)。
  # ```ruby
  # gfx.picture_limit = 16
  # ```
  # <<en>>
  # 8 unless set; fewer lets the oldest go now. The display side's sprite
  # images are limited for the whole machine (64 and 256 KB on the sim and
  # Retro, 160 on P4).
  # ```ruby
  # gfx.picture_limit = 16
  # ```
  %a{fmrb.internal}
  def picture_limit=: (Integer n) -> Integer

  # 絵が描けなかった理由 <<en>> Why the last picture could not be drawn
  #
  # :unreadable (無い・絵でない)、:too_big (65,536 点を超える)、
  # :no_room (描画側に場所が無い)、:not_sent (描画側へ送れない)。
  # うまくいった後は nil。
  # ```ruby
  # unless gfx.draw_picture(path, 0, 0)
  #   Log.info(gfx.picture_error.to_s)
  # end
  # ```
  # <<en>>
  # :unreadable (not there, not a picture), :too_big (past 65,536 pixels),
  # :no_room (no room on the display side), :not_sent (could not be sent
  # there). nil after one that worked.
  # ```ruby
  # unless gfx.draw_picture(path, 0, 0)
  #   Log.info(gfx.picture_error.to_s)
  # end
  # ```
  %a{fmrb.internal}
  def picture_error: () -> Symbol?

  # 透明を表す市松を描く <<en>> Draw the checkerboard that stands for transparency
  #
  # 白と薄い灰色の升 (cell: px、既定 4) を (x, y, w, h) に敷く。clip:
  # [x, y, w, h] で切れる。描画側に帯を 1 枚作って押すので、命令は
  # 高さ / (cell x 2) 回。
  # ```ruby
  # gfx.draw_checker(0, 0, 64, 64)
  # gfx.draw_checker(0, 0, 64, 64,
  #   cell: 2)
  # ```
  # <<en>>
  # White and light grey cells (cell: px, 4 unless given) over
  # (x, y, w, h); clip: [x, y, w, h] cuts it. One strip is made on the
  # display side and stamped, height / (cell x 2) commands.
  # ```ruby
  # gfx.draw_checker(0, 0, 64, 64)
  # gfx.draw_checker(0, 0, 64, 64,
  #   cell: 2)
  # ```
  %a{fmrb.internal}
  def draw_checker: (Integer x, Integer y, Integer w, Integer h) -> FmrbGfx

  # 型ぬきの形を作る <<en>> Make a mask
  #
  # data は 1 画素 1 ビットの列。1 行あたり ceil(width / 8) バイトで、各バイトは
  # 上位ビットが左。ビットが 1 のところだけが描かれる。
  #
  # 戻り値は mask_id で、draw_image_masked に渡す。使い終わったら delete_mask。
  # ```ruby
  # mask = @gfx.create_mask(48, 48, bits)
  # # bits: 6 バイト × 48 行
  # ```
  # <<en>>
  # data is one bit per pixel: ceil(width / 8) bytes per row, most significant
  # bit leftmost. Only the pixels whose bit is set are drawn.
  #
  # Returns a mask_id for draw_image_masked; release it with delete_mask.
  # ```ruby
  # mask = @gfx.create_mask(48, 48, bits)
  # # bits: 6 bytes x 48 rows
  # ```
  def create_mask: (Integer width, Integer height, bin data) -> Integer

  # 型ぬきの形を片づける <<en>> Let go of a mask
  #
  # ```ruby
  # gfx.delete_mask(@mask_id)
  # ```
  def delete_mask: (Integer mask_id) -> FmrbGfx

  # 型でぬいた形の絵を描く <<en>> Draw an image through a mask
  #
  # SpriteImage の絵を、マスクのビットが立っているところだけ canvas に写す。
  # 置き場所はキーワード (x:, y:)。絵の (xx, yy) が canvas の (x+xx, y+yy) に来る。
  # ```ruby
  # @gfx.draw_image_masked(sid, mask,
  #                        x: 20, y: 30)
  # ```
  # <<en>>
  # Copies a SpriteImage onto the canvas only where the mask's bits are set.
  # The position is passed by keyword (x:, y:): the image's (xx, yy) lands at
  # (x + xx, y + yy).
  # ```ruby
  # @gfx.draw_image_masked(sid, mask,
  #                        x: 20, y: 30)
  # ```
  %a{fmrb.internal}
  def draw_image_masked: (Integer image_id, Integer mask_id) -> FmrbGfx

# draw_image_masked の省略なしの形 <<en>> draw_image_masked, plain arguments
#
# 置き場所をキーワードでなく位置の引数で渡す形。包みは draw_image_masked。
# ```ruby
# gfx.draw_image_masked_raw(img.id,
#   @mask_id, 10, 20)
# ```
# <<en>>
# The position as plain arguments rather than keywords. The wrapper is
# draw_image_masked.
# ```ruby
# gfx.draw_image_masked_raw(img.id,
#   @mask_id, 10, 20)
# ```
def draw_image_masked_raw: (Integer image_id, Integer mask_id, Integer x, Integer y) -> FmrbGfx

  # ---- 画面に出す ----

  # 描いたものを画面に出す <<en>> show what has been drawn
  #
  # 描くメソッドは命令を積むだけで、画面には出ない。present を呼んだときに
  # まとめて送られ、そこで初めて出る。スプライトの合成も present の時に走るので、
  # SpriteInstance#move や visible= の後にも要る。
  #
  # 1 フレームの終わりに 1 回呼ぶ。描くたびに呼ぶと、その回数だけ画面全体の
  # 転送が起きて遅くなる。
  #
  # ```ruby
  # gfx.clear(FmrbGfx::BLACK)
  # gfx.draw_text(10, 10, "hi", FmrbGfx::WHITE)
  # gfx.present   # ここで画面に出る
  # ```
  # <<en>>
  # Drawing methods only queue commands; nothing reaches the screen until
  # present sends them. Sprite compositing also happens at present, so it is
  # needed after SpriteInstance#move or visible= as well.
  #
  # Call it once at the end of a frame. Calling it after every shape costs a
  # whole-screen transfer each time.
  #
  # ```ruby
  # gfx.clear(FmrbGfx::BLACK)
  # gfx.draw_text(10, 10, "hi", FmrbGfx::WHITE)
  # gfx.present   # now it appears
  # ```
  %a{fmrb.internal}
  def present: () -> FmrbGfx

# present の省略なしの形 <<en>> present with nothing left out
#
# positioned が false なら Window の位置に出し (x, y は使わない)、true なら
# 画面の (x, y) に出す。包みは present (present(x, y) で位置を渡す)。
# ```ruby
# gfx.present_raw(0, 0, false)
# ```
# <<en>>
# With positioned false the canvas goes where the window is (x and y are
# not used); with true it goes to (x, y) on the screen. The wrapper is
# present (present(x, y) gives a position).
# ```ruby
# gfx.present_raw(0, 0, false)
# ```
def present_raw: (Integer x, Integer y, bool positioned) -> FmrbGfx

  # この画面を片づける <<en>> Let go of this canvas
  #
  # 自分で作った canvas を片づける。アプリの終了時には自動で消えるので、
  # 途中で要らなくなったときだけ呼ぶ。
  # ```ruby
  # g = create_canvas_gfx(width: 64,
  #                      height: 64)
  # g.destroy
  # ```
  # <<en>>
  # Throws away a canvas made by the app. They go on their own when the
  # app ends, so this is for one that is finished with early.
  # ```ruby
  # g = create_canvas_gfx(width: 64,
  #                      height: 64)
  # g.destroy
  # ```
  %a{fmrb.internal}
  def destroy: () -> FmrbGfx

  # 画面の見せる場所をずらす <<en>> Shift what part of the canvas is shown
  #
  # canvas より小さい表示範囲を、canvas の上で動かす。canvas は輪として扱われ、
  # 元の四角は端で回り込む。表示範囲より少し大きい canvas を用意し、動いた分だけ
  # 新しく見えるところにタイルを描き足せば、大きな地図を描き直さずに流せる。
  #
  # Modern (ESP32-P4) だけの機能で、Retro の描画側はこの命令を無視する。
  # FmrbConst::CHIP_MODEL == "ESP32-P4" で分ける。
  # ```ruby
  # @map_gfx.set_viewport(vx % bw, vy % bh,
  #                       160, 120)
  # ```
  # <<en>>
  # Moves a viewport smaller than the canvas across it. The canvas is treated
  # as a torus, so the source rectangle wraps at the edges: with a canvas a
  # little larger than the viewport, stamping only the newly exposed tiles as
  # it moves scrolls an arbitrarily large world without redrawing it.
  #
  # Modern (ESP32-P4) only; the Retro backend ignores the command. Gate it on
  # FmrbConst::CHIP_MODEL == "ESP32-P4".
  # ```ruby
  # @map_gfx.set_viewport(vx % bw, vy % bh,
  #                       160, 120)
  # ```
  def set_viewport: (Integer src_x, Integer src_y, Integer w, Integer h) -> FmrbGfx

  # ずらした場所を元に戻す <<en>> Put the shown part back
  #
  # set_viewport で決めた切り出しをやめ、canvas 全体を合成に戻す。
  # set_viewport と同じく Modern (ESP32-P4) だけで効く。
  # ```ruby
  # @map_gfx.set_viewport(8, 0, 160, 120)
  # @map_gfx.clear_viewport
  # ```
  # <<en>>
  # Undo set_viewport: the whole canvas is composited again. Modern
  # (ESP32-P4) only, as set_viewport is.
  # ```ruby
  # @map_gfx.set_viewport(8, 0, 160, 120)
  # @map_gfx.clear_viewport
  # ```
  def clear_viewport: () -> FmrbGfx

  # 重ねて見せる場所を決める <<en>> Set the regions that are composited
  #
  # canvas のどの矩形をどう合成するかを指定する。角の丸い Window のように、隅だけ
  # 透過が要るときの最適化で、中央は速い経路で送れる。最大 8 個。nil か [] で
  # 既定 (canvas 全体) に戻る。
  #
  # Window のアプリでは .app.toml の rounded_corners から系が設定するので、ふつうは
  # 自分で呼ぶ必要はない。
  # ```ruby
  # @gfx.set_composite_regions([
  #   { dst_x: 0, dst_y: 0, w: 100,
  #     h: 20, transparent: false }
  # ])
  # ```
  # <<en>>
  # Says which rectangles of the canvas are composited and how. It is the
  # optimisation for a rounded window, where only the corners need
  # transparency and the middle can take the fast path. Eight at most; nil or
  # [] restores the default of the whole canvas.
  #
  # For a windowed app the system sets this from rounded_corners in the
  # .app.toml, so calling it directly is rarely needed.
  # ```ruby
  # @gfx.set_composite_regions([
  #   { dst_x: 0, dst_y: 0, w: 100,
  #     h: 20, transparent: false }
  # ])
  # ```
  %a{fmrb.internal}
  def set_composite_regions: (Array[Hash] regions) -> FmrbGfx

# set_composite_regions の省略なしの形 <<en>> set_composite_regions, every field given
#
# 矩形ごとに src_x・src_y・dst_x・dst_y・w・h・transparent を全部書く形。
# 空の配列で既定 (canvas 全体) に戻る。包みは set_composite_regions。
# ```ruby
# gfx.set_composite_regions_raw([
#   { src_x: 0, src_y: 0, dst_x: 0,
#     dst_y: 0, w: 8, h: 8,
#     transparent: true }])
# ```
# <<en>>
# Every field of each rectangle written out: src_x, src_y, dst_x, dst_y,
# w, h and transparent. An empty array restores the default (the whole
# canvas). The wrapper is set_composite_regions.
# ```ruby
# gfx.set_composite_regions_raw([
#   { src_x: 0, src_y: 0, dst_x: 0,
#     dst_y: 0, w: 8, h: 8,
#     transparent: true }])
# ```
def set_composite_regions_raw: (Array[composite_region] regions) -> FmrbGfx

  # スプライトが出られる範囲を決める <<en>> limit where sprites may appear
  #
  # スプライトは canvas に描いた絵の上に重ねて合成されるので、何も
  # しないと Window のわくやタイトルバーの上にもはみ出す。この四角の中だけに
  # 出るようにする。x, y, w, h は SpriteInstance#move と同じ座標 (原点から。
  # スプライトの画像へ描いている間も原点を足す)。
  #
  # Window のアプリは起動時に Window の中身の範囲が入っているので、ふつうは呼ぶ
  # 必要はない。点数を出す帯など、さらに狭い範囲に閉じ込めたいときに使う。
  # ```ruby
  # # 上 10px を点数の帯にして、スプライトはその下だけに出す
  # @gfx.set_sprite_clip(0, 10,
  #   @user_area_width,
  #   @user_area_height - 10)
  # ```
  # <<en>>
  # Sprites are composited on top of everything drawn into the canvas, so
  # without a clip they paint over the window frame and title bar. This
  # confines them to the given rect, in the same coordinates as
  # SpriteInstance#move (from the origin, also while drawing into a sprite
  # image).
  #
  # Windowed apps start with their user area set, so calling this is only
  # needed to narrow it further - e.g. to keep sprites out of a score bar.
  # ```ruby
  # # reserve the top 10px for the score; sprites stay below it
  # @gfx.set_sprite_clip(0, 10,
  #   @user_area_width,
  #   @user_area_height - 10)
  # ```
  def set_sprite_clip: (Integer x, Integer y, Integer w, Integer h) -> FmrbGfx

  # スプライトの範囲の決まりをなくす <<en>> let sprites use the whole canvas
  #
  # ```ruby
  # gfx.clear_sprite_clip
  # ```
  def clear_sprite_clip: () -> FmrbGfx

  # ---- スプライト (SpriteImage・SpriteInstance の下の関数) ----
  #
  # SpriteImage と SpriteInstance は、ここの関数を呼ぶ Ruby の包み。速さが
  # 要る所や Ruby 以外の言語では、番号を持ってこちらを直接呼ぶ。絵と置いた
  # 絵の番号は、この FmrbGfx の canvas の中のもの。

  # スプライトの絵を作る <<en>> Make a sprite image
  #
  # 描画側に width x height の絵を作り、番号を返す。use_transparent が真なら
  # transparent_color の画素は抜ける。包みは SpriteImage.new。
  # ```ruby
  # id = gfx.create_sprite_image(16, 16,
  #                              0x00, true)
  # ```
  # <<en>>
  # Makes a width x height image on the graphics side and returns its
  # number. With use_transparent,
  # the pixels of transparent_color are see-through. The wrapper is
  # SpriteImage.new.
  # ```ruby
  # id = gfx.create_sprite_image(16, 16,
  #                              0x00, true)
  # ```
  def create_sprite_image: (Integer width, Integer height, Integer transparent_color, bool use_transparent) -> Integer

  # スプライトの絵を片づける <<en>> Let go of a sprite image
  #
  # 包みは SpriteImage#destroy。
  # ```ruby
  # gfx.delete_sprite_image(id)
  # ```
  # <<en>>
  # The wrapper is SpriteImage#destroy.
  # ```ruby
  # gfx.delete_sprite_image(id)
  # ```
  def delete_sprite_image: (Integer image_id) -> FmrbGfx

  # 絵 (PNG か BMP) をスプライトの絵に読み込む <<en>> Read a PNG or BMP into a sprite image
  #
  # 描画側のパスを渡す (先に sync_file で送る)。展開は描画側でやる。
  # PNG の透明な点 (α が 128 未満、tRNS) は透明色 0x01 になる。
  # 包みは SpriteImage#load_bmp。
  # ```ruby
  # gfx.load_sprite_image(id,
  #   "/cache/app/x/bird.png")
  # ```
  # <<en>>
  # Takes a path on the graphics side (send it there with sync_file first),
  # which decodes it. A PNG's transparent pixels (alpha below 128, tRNS)
  # become the transparent colour 0x01. The wrapper is SpriteImage#load_bmp.
  # ```ruby
  # gfx.load_sprite_image(id,
  #   "/cache/app/x/bird.png")
  # ```
  def load_sprite_image: (Integer image_id, String path) -> FmrbGfx

  # 画素 (RGB332) をスプライトの絵に書く <<en>> Write RGB332 pixels into a sprite image
  #
  # pixels は w * h バイト (上の行から)。絵の (x, y) から書き、絵の外は
  # 捨てる。1 回 65,536 点まで (超えると ERR_ARG)。描く命令と同じ列で
  # 送るので、前に頼んだ draw_tile は書く前の絵で描かれる。
  # 包みは SpriteImage#write_pixels。
  # ```ruby
  # gfx.write_sprite_image(img.id, 0, 0,
  #   16, 16, pixels)
  # ```
  # <<en>>
  # pixels is w * h bytes, top row first, written from (x, y) of the image;
  # what falls outside it is dropped. Up to 65,536 pixels a call (more is
  # ERR_ARG). It travels with the drawing commands, so a draw_tile asked for
  # earlier still draws the image as it was. The wrapper is
  # SpriteImage#write_pixels.
  # ```ruby
  # gfx.write_sprite_image(img.id, 0, 0,
  #   16, 16, pixels)
  # ```
  def write_sprite_image: (Integer image_id, Integer x, Integer y, Integer w, Integer h, bin pixels) -> FmrbGfx

  # 描く先をスプライトの絵にする <<en>> Draw into a sprite image
  #
  # この後の描画は、その絵の中の座標で絵に描かれる (原点は足さない)。0 で
  # canvas に戻す。
  # 包みは SpriteImage#set_target・#reset_target・#draw。
  # ```ruby
  # gfx.set_sprite_image_target(id)
  # gfx.fill_rect(0, 0, 16, 16, FmrbGfx::RED)
  # gfx.set_sprite_image_target(0)
  # ```
  # <<en>>
  # What is drawn next goes into that image, in its own coordinates (no
  # origin added); 0 goes back to the canvas. The wrappers are SpriteImage#set_target, #reset_target and
  # #draw.
  # ```ruby
  # gfx.set_sprite_image_target(id)
  # gfx.fill_rect(0, 0, 16, 16, FmrbGfx::RED)
  # gfx.set_sprite_image_target(0)
  # ```
  def set_sprite_image_target: (Integer image_id) -> FmrbGfx

  # スプライトの絵を画面に置く <<en>> Place sprite images on the canvas
  #
  # 置いた絵の番号を返す。image_ids はパラパラ漫画の絵の番号 (1〜8 枚)。座標は原点から (絵に
  # 描いている間も)。z が大きいほど手前。包みは SpriteInstance.new。
  # ```ruby
  # sp = gfx.create_sprite_instance(
  #   [id1, id2], 40, 80, 0)
  # ```
  # <<en>>
  # Returns the placed sprite's number. image_ids are the frames of a flip
  # book (1 to 8). The position is from
  # the origin, also while drawing into a sprite image; a larger z is nearer.
  # The wrapper is SpriteInstance.new.
  # ```ruby
  # sp = gfx.create_sprite_instance(
  #   [id1, id2], 40, 80, 0)
  # ```
  def create_sprite_instance: (Array[uint16] image_ids, Integer x, Integer y, Integer z) -> Integer

  # 置いた絵を片づける <<en>> Let go of a placed sprite
  #
  # 包みは SpriteInstance#destroy。
  # ```ruby
  # gfx.delete_sprite_instance(sp)
  # ```
  # <<en>>
  # The wrapper is SpriteInstance#destroy.
  # ```ruby
  # gfx.delete_sprite_instance(sp)
  # ```
  def delete_sprite_instance: (Integer instance_id) -> FmrbGfx

  # 置いた絵を動かす <<en>> Move a placed sprite
  #
  # 座標は原点から。合成は次の present で走る。包みは SpriteInstance#move
  # (枠なしの Window の当たりに印を付けたスプライトは、包みが当たりも動かす)。
  # ```ruby
  # gfx.move_sprite(sp, 48, 80)
  # gfx.present
  # ```
  # <<en>>
  # From the origin. The compositing happens at the next present. The wrapper
  # is SpriteInstance#move, which also moves a frameless window's hit shape
  # when the sprite is marked for it.
  # ```ruby
  # gfx.move_sprite(sp, 48, 80)
  # gfx.present
  # ```
  def move_sprite: (Integer instance_id, Integer x, Integer y) -> FmrbGfx

  # 置いた絵を見せるか隠すか <<en>> Show or hide a placed sprite
  #
  # 包みは SpriteInstance#visible=。
  # ```ruby
  # gfx.set_sprite_visible(sp, false)
  # ```
  # <<en>>
  # The wrapper is SpriteInstance#visible=.
  # ```ruby
  # gfx.set_sprite_visible(sp, false)
  # ```
  def set_sprite_visible: (Integer instance_id, bool visible) -> FmrbGfx

  # 置いた絵の何枚目を見せるか <<en>> Which frame a placed sprite shows
  #
  # 0 が 1 枚目。包みは SpriteInstance#frame=。
  # ```ruby
  # gfx.set_sprite_frame(sp, 1)
  # ```
  # <<en>>
  # 0 is the first. The wrapper is SpriteInstance#frame=.
  # ```ruby
  # gfx.set_sprite_frame(sp, 1)
  # ```
  def set_sprite_frame: (Integer instance_id, Integer frame) -> FmrbGfx

  # この canvas のスプライトを全部片づける <<en>> Let go of every sprite on this canvas
  #
  # 置いた絵も絵の中身も消える。
  # ```ruby
  # gfx.delete_all_sprites
  # ```
  # <<en>>
  # The placed sprites and their images both go.
  # ```ruby
  # gfx.delete_all_sprites
  # ```
  def delete_all_sprites: () -> FmrbGfx

  # ---- 動画と画面の書き出し ----

  # JPEG を並べた動画を canvas で流す (Modern) <<en>> Play a motion-JPEG file into the canvas (Modern)
  #
  # 位置と速さはキーワード (x:, y:, fps:, loop:)。止まった状態で開くので、
  # 返った FmrbVideo の play で流す。流せない端末 (Retro・sim) では nil。
  # 流している間は、その四角の中に描かない。
  # ```ruby
  # v = gfx.video_open("/home/a.mjpeg",
  #                    x: 0, y: 0, fps: 15)
  # v.play if v
  # ```
  # <<en>>
  # Position and speed are keyword arguments (x:, y:, fps:, loop:). It opens
  # paused; play the FmrbVideo it gives back. nil where it cannot be played
  # (Retro, the sim). Do not draw inside the picture while it plays.
  # ```ruby
  # v = gfx.video_open("/home/a.mjpeg",
  #                    x: 0, y: 0, fps: 15)
  # v.play if v
  # ```
  %a{fmrb.internal}
  def video_open: (String path) -> FmrbVideo?

# video_open の省略なしの形 <<en>> video_open with nothing left out
#
# 引数を省略できない単純な形。返すのは動画の {width:, height:} か、流せない
# ときは nil。流す・止めるは FmrbGfx.video_control。包みは video_open。
# ```ruby
# info = gfx.video_open_raw(path,
#          0, 0, 15, false)
# ```
# <<en>>
# The simple form, with no argument left out. It returns the video's
# {width:, height:}, or nil when it cannot be played; FmrbGfx.video_control
# plays and stops it. The wrapper is video_open.
# ```ruby
# info = gfx.video_open_raw(path,
#          0, 0, 15, false)
# ```
def video_open_raw: (String path, Integer x, Integer y, Integer fps, bool loop) -> video_info?

  # 描いた画面をファイルに書き出す <<en>> Write the presented picture to a file
  #
  # 最後の present で出た絵を、描画側のファイルシステムに書く (Tab5 は JPEG、
  # sim は BMP。Retro はできない)。present はしないので先に呼んでおく。
  # 待たずに返る。
  # ```ruby
  # gfx.present
  # gfx.export_frame("/home/shot.jpg")
  # ```
  # <<en>>
  # Writes what the last present showed to a file on the graphics side
  # (Tab5 a JPEG, the sim a BMP; Retro cannot). It does not present, so
  # present first. It does not wait for the write.
  # ```ruby
  # gfx.present
  # gfx.export_frame("/home/shot.jpg")
  # ```
  def export_frame: (String path) -> FmrbGfx

  # 映像の明るさを決める <<en>> Set the video brightness
  #
  # Retro のコンポジット映像の明るさを決める。Modern には効かない。
  # CRT のつまみで合わせきれないときに使う。
  # ```ruby
  # @gfx.set_output_level(200)
  # ```
  # <<en>>
  # Sets the brightness of Retro's composite video signal. It does nothing on
  # Modern. For when a CRT's own controls do not get there.
  # ```ruby
  # @gfx.set_output_level(200)
  # ```
  def set_output_level: (Integer level) -> FmrbGfx

  # 映像の色の濃さを決める <<en>> Set the colour depth of the video
  #
  # Retro のコンポジット映像の色の濃さ (カラーバーストの振幅) を決める。
  # Modern には効かない。0 にすると白黒になる。
  # ```ruby
  # @gfx.set_chroma_level(128)
  # @gfx.set_chroma_level(0)  # 白黒
  # ```
  # <<en>>
  # Sets the saturation of Retro's composite video -- the colour burst
  # amplitude. It does nothing on Modern; 0 gives a black-and-white picture.
  # ```ruby
  # @gfx.set_chroma_level(128)
  # @gfx.set_chroma_level(0)  # b/w
  # ```
  def set_chroma_level: (Integer level) -> FmrbGfx

  # ---- ファイルの受けわたし ----

  # 絵や音のファイルを送る <<en>> Send an image or sound file across
  #
  # 描画側は自分のファイルシステムしか読めないので、素材は先に送っておく。
  # 大きさと CRC32 を比べて、違うときだけ送る。毎回呼んでよい。
  #
  # file_status[:exists] で「あるから送らない」と判断すると、書き換えた素材が
  # 古いまま残る。素材にはこちらを使う。
  #
  # ```ruby
  # gfx.sync_file("/home/bird.png",
  #               dest: "/cache/app/x/bird.png")
  # ```
  # <<en>>
  # The graphics side reads its own filesystem, so an asset has to be put
  # there first. This compares size and CRC32 and transfers only when they
  # differ, so it is fine to call on every start.
  #
  # Deciding with file_status[:exists] instead -- "it is there, skip it" --
  # leaves an edited asset stale for ever. Use this one for assets.
  #
  # ```ruby
  # gfx.sync_file("/home/bird.png",
  #               dest: "/cache/app/x/bird.png")
  # ```
  %a{fmrb.internal}
  def sync_file: (String path, ?dest: String) -> bool

# sync_file の省略なしの形 <<en>> sync_file with nothing left out
#
# 送り先を省略できない形。包みは sync_file (dest: を省くと同じパス)。
# ```ruby
# gfx.sync_file_raw(path, path)
# ```
# <<en>>
# The destination cannot be left out. The wrapper is sync_file (without
# dest: it uses the same path).
# ```ruby
# gfx.sync_file_raw(path, path)
# ```
def sync_file_raw: (String path, String dest) -> bool

  # ファイルを必ず送り直す <<en>> Send a file again whatever happens
  #
  # 中身を見ずに必ず送り直す。ふつうは sync_file でよく、こちらは送り先を
  # 書き換えたことが分かっているときに使う。
  # ```ruby
  # @gfx.transfer_file("/data/a.bmp")
  # ```
  # <<en>>
  # Transfers unconditionally, without looking at what is already there.
  # sync_file is the usual choice; this one is for when the destination is
  # known to need rewriting.
  # ```ruby
  # @gfx.transfer_file("/data/a.bmp")
  # ```
  %a{fmrb.internal}
  def transfer_file: (String path) -> bool

# transfer_file の省略なしの形 <<en>> transfer_file with nothing left out
#
# 送り先を省略できない形。包みは transfer_file。
# ```ruby
# gfx.transfer_file_raw(path, path)
# ```
# <<en>>
# The destination cannot be left out. The wrapper is transfer_file.
# ```ruby
# gfx.transfer_file_raw(path, path)
# ```
def transfer_file_raw: (String path, String dest) -> bool

  # 送った先にファイルがあるか <<en>> Whether the file arrived
  #
  # 描画側にそのファイルがあるかと、その大きさを {exists:, size:} で返す。
  #
  # 素材を送るかどうかの判断にはこれを使わない。中身が変わっても exists は
  # true のままなので、書き換えた素材が古いまま残る。判断は sync_file に任せる。
  # ```ruby
  # st = @gfx.file_status("/data/a.bmp")
  # st[:exists]
  # st[:size]
  # ```
  # <<en>>
  # Whether the graphics side has the file, and how big it is: {exists:, size:}.
  #
  # Do not use it to decide whether to send an asset. exists stays true after
  # the contents change, so an edited asset would stay stale; leave that
  # decision to sync_file.
  # ```ruby
  # st = @gfx.file_status("/data/a.bmp")
  # st[:exists]
  # st[:size]
  # ```
  def file_status: (String path) -> file_info

  # ---- クラスメソッド ----

  # 赤緑青の三つの数から色を作る <<en>> Make a colour from red, green and blue
  #
  # 0-255 の 3 つを 1 バイトに落とす。赤と緑は 3 ビット、青は 2 ビットなので、
  # 近い色は同じ値になる。細かい階調は出ない。
  #
  # 結果が 0x01 になる組み合わせは避ける。デスクトップは 0x01 を透明の目印に
  # 使っているので、Window が透けて見える。
  # ```ruby
  # FmrbGfx.rgb_to_332(255, 0, 0)  #=> 224
  # ```
  # <<en>>
  # Packs three 0-255 values into one byte: three bits of red, three of green,
  # two of blue, so nearby colours collapse onto the same value and fine
  # gradients do not survive.
  #
  # Avoid combinations that come out as 0x01. The desktop uses 0x01 as its
  # transparency key, so a window painted with it shows through.
  # ```ruby
  # FmrbGfx.rgb_to_332(255, 0, 0)  #=> 224
  # ```
  def self.rgb_to_332: (Integer r, Integer g, Integer b) -> Integer

  # 動画を流す・止める <<en>> Play, pause, stop or rewind the video
  #
  # 流せる動画は 1 つ。video_open で開いた動画を操作して、そのあとのようすを返す (返事が無ければ
  # nil)。:stop はファイルを閉じ、canvas には最後の絵が残る。包みは FmrbVideo の
  # play・pause・stop・rewind。
  # ```ruby
  # FmrbGfx.video_control(:play)
  # ```
  # <<en>>
  # There is one player. Acts on the video video_open opened and returns its state afterwards (nil
  # when there is no answer). :stop closes the file; the canvas keeps the last
  # picture. The wrappers are FmrbVideo's play, pause, stop and rewind.
  # ```ruby
  # FmrbGfx.video_control(:play)
  # ```
  def self.video_control: (:play | :pause | :stop | :rewind action) -> video_status?

  # 動画の再生のようす <<en>> The video player's state
  #
  # {state:, shown:, dropped:} か、返事が無ければ nil。state は 0 止まり・
  # 1 再生中・2 一時停止・3 終わり。shown と dropped は出した・飛ばしたこま数。
  # 包みは FmrbVideo#status。
  # ```ruby
  # st = FmrbGfx.video_status
  # ```
  # <<en>>
  # {state:, shown:, dropped:}, or nil when there is no answer. state is 0
  # idle, 1 playing, 2 paused, 3 finished; shown and dropped count frames.
  # The wrapper is FmrbVideo#status.
  # ```ruby
  # st = FmrbGfx.video_status
  # ```
  def self.video_status: () -> video_status?

  # 色あいと濃さと明るさから色を作る <<en>> Make a colour from hue, saturation and value
  #
  # h は 0-360、s と v は 0-255。戻り値は [r, g, b] の配列で、そのままでは
  # 色として使えない。rgb_to_332 に渡す。
  #
  # ```ruby
  # r, g, b = FmrbGfx.hsv_to_rgb(hue, 255, 255)
  # color = FmrbGfx.rgb_to_332(r, g, b)
  # ```
  # <<en>>
  # h is 0-360, s and v are 0-255. It returns [r, g, b], which is not a colour
  # yet -- pass it through rgb_to_332.
  #
  # ```ruby
  # r, g, b = FmrbGfx.hsv_to_rgb(hue, 255, 255)
  # color = FmrbGfx.rgb_to_332(r, g, b)
  # ```
  %a{fmrb.internal}
  def self.hsv_to_rgb: (Integer h, Integer s, Integer v) -> Array
end

# 流している動画の取っ手 <<en>> A handle on the video being played
#
# FmrbGfx#video_open が返す。流せる動画は 1 つなので、どの取っ手も同じ再生機を操作する。
# 中身は FmrbGfx.video_control を呼ぶ Ruby。
# <<en>>
# Returned by FmrbGfx#video_open. Only one video can play at a time, so every
# handle operates the same player. It is Ruby that calls FmrbGfx.video_control.
class FmrbVideo
  # 動画の横幅 (ドット) <<en>> The video's width in pixels
  #
  # ```ruby
  # w = v.width
  # ```
  def width: () -> Integer

  # 動画の高さ (ドット) <<en>> The video's height in pixels
  #
  # ```ruby
  # h = v.height
  # ```
  def height: () -> Integer

  # 流す <<en>> Play
  #
  # ```ruby
  # v.play
  # ```
  def play: () -> FmrbVideo

  # 一時停止する <<en>> Pause
  #
  # ```ruby
  # v.pause
  # ```
  def pause: () -> FmrbVideo

  # 止めてファイルを閉じる <<en>> Stop and close the file
  #
  # canvas には最後の絵が残る。
  # ```ruby
  # @video.stop
  # ```
  # <<en>>
  # The canvas keeps the last picture.
  # ```ruby
  # @video.stop
  # ```
  def stop: () -> FmrbVideo

  # 頭に戻す <<en>> Back to the start
  #
  # ```ruby
  # v.rewind
  # ```
  def rewind: () -> FmrbVideo

  # 再生のようす <<en>> The player's state
  #
  # {state:, shown:, dropped:} か nil (FmrbGfx.video_status と同じ)。
  # ```ruby
  # st = @video.status
  # st[:shown]
  # st[:dropped]
  # ```
  # <<en>>
  # {state:, shown:, dropped:} or nil, as FmrbGfx.video_status.
  # ```ruby
  # st = @video.status
  # st[:shown]
  # st[:dropped]
  # ```
  def status: () -> FmrbGfx::video_status?

  # 流れているか <<en>> Whether it is playing
  #
  # ```ruby
  # v.play unless v.playing?
  # ```
  def playing?: () -> bool

  # 終わりまで流れたか <<en>> Whether it has played to the end
  #
  # ```ruby
  # v.rewind if v.finished?
  # ```
  def finished?: () -> bool
end
