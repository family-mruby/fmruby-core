build
build.log
sdkconfig
sdkconfig.old
sdkconfig.1
dependencies.lock
.vscode/*
.claude/*
main/prebuild_scripts/kernel/mrb/*
main/prebuild_scripts/default_app/mrb/*
log/
*.log
.rake_tasks~
managed_components/
.serial_port
flash/etc/system_conf.toml
# System service list, generated from config/services.toml by the build
flash/etc/services.toml
# Written by the service host at runtime (svc enable / svc disable)
flash/home/services_state.toml
flash/home/music/
# Launcher app index, rebuilt on demand by the desktop
flash/var/cache/launcher_index

# Generated documentation
doc/local/
doc/api/
doc/ruby_api/
.yardoc/

tmp/

# Backup files
lib/*.backup.*

flash/home/rubykaigi/
# WiFi credentials - never commit; see config/wifi.toml.example
config/wifi.toml
flash/etc/wifi.toml

# Python bytecode cache
__pycache__/
*.pyc

# Pinned Spinel compiler checkout (rake spinel:setup)
vendor/spinel/

# Pinned picoruby-ti engine checkout (rake ti:setup) and the scratch prism
# static library its host tests link against (rake ti:test)
vendor/picoruby-ti/
vendor/ti_prism/
vendor/ti_probe
vendor/ti_test_sig/

# Local reference material for comparing the character sheets (never committed)
tool/basic/ref/

# Stashed build trees when switching targets by hand (see doc/midi/report/p1.md).
# rake clean_all is the normal way; these exist so a Linux sim build survives
# an esp32 build without a 10-minute rebuild.
build.*.saved/
sdkconfig.*.saved

# Development FIFO for the simulator's MIDI out (tools/fmrb_midi_monitor.rb
# creates it; see doc/midi/report/p5s.md).
midi_out.fifo
flash/etc/system_conf.factory.toml

# /tmp RAM FS: the Linux dev build backs it with this directory and empties
# it at boot (components/fmrb_hal/platform/posix/fmrb_tmpfs_posix.c).
flash/tmp/

# Editor help, generated from the doc comments in sig/ (rake ti:help, run by
# rake setup). Same rule as the type database: the source is sig/.
flash/help/

# The WebConsole's browser type engine (rake ti:wasm) and its help bundle.
# Same rule as the firmware database: the source is sig/ plus the engine, so
# only the wrapper and the export list are committed here.
tool/web/wasm/ti.js
tool/web/wasm/ti.wasm
tool/web/wasm/help.json
node_modules/
tool/web/test/shots/

# Spinel gem sources staged into main/prebuild_scripts/spinel/ by rake spinel:gen
# are ignored by that directory's own .gitignore (ignore-all + whitelist the real
# sources), so a new gem needs no entry here.
