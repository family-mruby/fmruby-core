10 REM Ball Bounce Demo for Family mruby BASIC
20 REM Uses CIRCLE, CLS, PRESENT, WAIT
30 LET X = 80
40 LET Y = 50
50 LET DX = 1
60 LET DY = 1
70 LET R = 5
80 LET W = 190
90 LET H = 130
100 CLS
110 CIRCLE X, Y, R, 224
120 PRESENT
130 WAIT 30
140 LET X = X + DX
150 LET Y = Y + DY
160 IF X > W THEN DX = -DX
170 IF X < R THEN DX = -DX
180 IF Y > H THEN DY = -DY
190 IF Y < R THEN DY = -DY
200 GOTO 100
