10 REM MAZE WALK: COLLISION READS THE TEXT SCREEN WITH SCR$
20 REM B2/B3 TARGET: SCR$, LOCATE, COLOR, STICK OR IJKM KEYS, KANA
30 REM WALLS ARE RANDOM, SO A RUN CAN BE UNSOLVABLE. RETRY IN THAT CASE
40 CLS
50 LOCATE 2,2:PRINT "Gまで あるけ (IJKM/PAD)"
60 FOR X=0 TO 27:LOCATE X,4:PRINT "#";:LOCATE X,22:PRINT "#";:NEXT
70 FOR Y=5 TO 21:LOCATE 0,Y:PRINT "#";:LOCATE 27,Y:PRINT "#";:NEXT
80 FOR I=1 TO 30
90 X=RND(26)+1:Y=RND(16)+5
100 IF X<4 AND Y<9 THEN 90
110 IF X>23 AND Y>17 THEN 90
120 LOCATE X,Y:PRINT "#";
130 NEXT
140 COLOR 26,21,2
150 LOCATE 26,21:PRINT "G";
160 PX=1:PY=5:ST=0
170 LOCATE PX,PY:PRINT "P";
200 REM MAIN LOOP
210 S=STICK(0):A$=INKEY$
220 DX=0:DY=0
230 IF (S AND 1)<>0 OR A$="K" THEN DX=1
240 IF (S AND 2)<>0 OR A$="J" THEN DX=-1
250 IF (S AND 4)<>0 OR A$="M" THEN DY=1
260 IF (S AND 8)<>0 OR A$="I" THEN DY=-1
270 IF DX=0 AND DY=0 THEN 210
280 NX=PX+DX:NY=PY+DY
290 B$=SCR$(NX,NY)
300 IF B$="#" THEN BEEP:GOTO 210
310 LOCATE PX,PY:PRINT " ";
320 PX=NX:PY=NY:LOCATE PX,PY:PRINT "P";
330 ST=ST+1
340 IF B$="G" THEN 400
350 PAUSE 3
360 GOTO 210
400 LOCATE 10,11:PRINT "ゴール!"
410 LOCATE 8,13:PRINT "STEPS";ST
420 END
