10 REM HIT THE KANA: PRESS THE DIGIT OF THE CELL WHERE カ APPEARS
20 REM B2/B3 TARGET: RND, PAUSE TIMING, INKEY$, KANA, SCORE RANKING
30 CLS
40 LOCATE 3,3:PRINT "1-9の キーで たたけ!"
50 SC=0
60 FOR R=1 TO 10
70 N=RND(9)+1
80 X=(N-1) MOD 3:Y=(N-1)/3
90 LOCATE 8+X*4,8+Y*3:PRINT "カ";
100 T=0
110 A$=INKEY$
120 IF A$=CHR$(48+N) THEN GOSUB 300:GOTO 160
130 T=T+1:PAUSE 2
140 IF T<60 THEN 110
150 BEEP
160 LOCATE 8+X*4,8+Y*3:PRINT " ";
170 PAUSE 20
180 NEXT
190 LOCATE 6,16:PRINT "SCORE";SC
200 IF SC>=80 THEN LOCATE 7,18:PRINT "めいじん!"
210 END
300 SC=SC+10:BEEP
310 RETURN
