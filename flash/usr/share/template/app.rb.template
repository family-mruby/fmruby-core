# {{name}}.app.rb
class {{class}} < FmrbApp
  # Called once at startup
  def on_create
    redraw
  end

  # Called repeatedly. Return value = sleep ms until next on_update.
  def on_update
    500
  end

  # Keyboard / mouse / gamepad events. The close button, the window menu and
  # dragging are the system's; the app sees only what is its own.
  def on_event(ev)
    # case ev[:type]
    # when :key_down
    # when :mouse_down
    # when :gamepad_down
    # end
  end

  # Called when a fullscreen app takes over.
  def on_suspend
  end

  # Called when returning from suspend.
  def on_resume
  end

  # Called once at shutdown. Release resources here.
  def on_destroy
  end

  def redraw
    # clear_user_area with no colour paints the system theme's page colour,
    # and theme_fg is the ink that goes with it (see [theme] in
    # system_conf.toml). Name colours yourself only when the picture is the
    # point of the app. It draws the window frame again too.
    clear_user_area
    @gfx.draw_text(4, 4,
                   "{{title}}", theme_fg)
    @gfx.present
  end
end
