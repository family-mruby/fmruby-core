# An example of your own service list. Copy it to /home/services.toml and copy
# the bodies you want next to it:
#
#   cp /usr/share/samples/services/services.toml.example /home/services.toml
#   cp /usr/share/samples/services/heartbeat.rb /home/services/heartbeat.rb
#
# Nothing under /usr/share is yours -- a new firmware replaces it -- and
# nothing in /home is ever touched by an update. That is the whole rule.
#
# Everything listed here runs inside one app (the service host), so a dozen
# small resident jobs cost one task and one VM instead of a dozen. Bodies go
# in /home/services/; the contract is four optional methods and is written out
# in heartbeat.rb next to this file.
#
# Fields:
#   file         source under /home/services/
#   class        the class inside it
#   enable       false keeps the entry but does not run it (default true)
#   interval_ms  how often on_tick is called; omit for a service that only
#                reacts to topics (a one-off callback is ctx.wake_in ->
#                on_wake, which does not need one either)
#   oneshot      true = on_start once at boot, then out of the list
#   [<name>.config]  handed to the service as ctx.config
#
# An entry can start an ordinary app at boot instead of a service:
#
#   [my_game]
#   app = "/app/game/robo_explorer/robo_explorer.app.rb"
#   fullscreen = true      # overrides the app's own window mode
#   delay_ms = 2000        # let the desktop settle first
#   restart = true         # start it again if it CRASHES (a kill stays killed)
#
# The system list is /etc/services.toml, read first; anything written here
# with the same name wins, so "[clock] enable = false" switches off the
# system clock service.
#
# Watch what you ask for: the services run one after another, so a handler
# that takes its time makes the others wait (the host logs a warning past
# 50 ms), and anything that allocates on every tick shows up in the host's
# heap. ps lists them.
#
# Two ways to switch one off, and they are not the same:
#   kill <name> / svc stop <name>   this session only; a reboot undoes it
#   svc disable <name>              remembered, so it stays off after a reboot
# The remembered ones are kept in /home/services_state.toml, which the host
# writes; this file is yours and is never rewritten. svc start / svc enable
# are the other halves.

[heartbeat]
file = "heartbeat.rb"
class = "HeartbeatService"
enable = true
interval_ms = 10000

# hourly_chime is not here: it ships as a system service (/etc/services.toml,
# body in /usr/share/services/), so it rings without you listing anything. An
# entry with the same name in this file wins field by field, which is how it
# gets a recording to ring instead of the note, or gets switched off:
#
#   [hourly_chime]
#   enable = false
#   [hourly_chime.config]
#   wav = "/home/voice/hour.wav"    # any PCM 16-bit mono WAV, 8-48 kHz

# Raises on purpose. Turn it on to see that one bad service does not take the
# others with it: three errors, then the host switches it off alone.
[broken]
file = "broken.rb"
class = "BrokenService"
enable = false
interval_ms = 2000
