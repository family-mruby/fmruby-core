# Round - the same tune the MML demo plays, as a file.
# Parts go one per line and each gets its own channel, in order.
bpm 120
loop off

o5 l4 cegegegc
velocity 80
# The rest at the end is what makes this part as long as the one above it:
# parts that do not end together leave the shorter one waiting for the repeat.
o3 l2 c   g   c   r
