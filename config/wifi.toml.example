# WiFi credentials for Modern (ESP32-P4 / Tab5) remote desktop.
#
# Copy this file to config/wifi_p4.toml and fill in your network.
# config/wifi_p4.toml is listed in .gitignore so credentials never end
# up in the repository. When present it is copied to /etc/wifi.toml in
# the flash image by `rake build:esp32`.
#
# A board can also carry its own copy, in the same form, as /home/wifi.toml
# (put on the board; an app-only flash keeps it). When that file is there
# it is the one read and /etc/wifi.toml is not (doc/ruby_asterism/report/cf1.md).

[wifi]
enable = true
ssid = "your-ssid"
password = "your-password"
# mDNS hostname. Leave this out and the board names itself
# fmruby-XXXXXX.local, after the last three bytes of its WiFi MAC -- so two
# boards on one network can be told apart. Every board also answers to
# fmruby.local, which is the convenient name when there is only one (with
# two, which one replies is a race).
# hostname = "fmruby"
