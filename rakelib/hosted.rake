# rakelib/hosted.rake
# What the two one-process builds share: the browser (rakelib/wasm.rake) and
# the native Linux program (rakelib/native.rake). Their CMake side shares
# hosted/hosted.cmake; this is the rake side of the same thing -- fetching
# LovyanGFX, and regenerating the mruby bytecode neither CMake build can make.

HOSTED_DIR = File.expand_path("hosted", ROOT_DIR)

# LovyanGFX for the hosted displays: the M5GFX copy (same library the Tab5
# firmware draws with), fetched shallow and given a sprite-only platform
# branch. Only the sprite/font core is compiled -- no bus, no panel, no touch.
M5GFX_REPO = "https://github.com/m5stack/M5GFX"
M5GFX_PIN = "d91077b9a607b59404e4e4a49f775c792bfae382" # 2026-08-25
M5GFX_DIR = File.join(HOSTED_DIR, "vendor", "m5gfx")
# Where the browser build used to keep its clone, before the native build
# shared it. Moved rather than fetched again.
M5GFX_OLD_DIR = File.expand_path("wasm/vendor/m5gfx", ROOT_DIR)

def hosted_patch_m5gfx!
  # Insert a hosted branch at the head of the two platform-selection chains.
  # The framebuffer platform's common.hpp is already free of Linux
  # dependencies; its .cpp is not compiled (hosted/backend/
  # lgfx_common_hosted.cpp provides millis/delay instead).
  {
    "src/lgfx/v1/platforms/common.hpp" =>
      ["#if defined (ESP_PLATFORM)",
       "#if defined (FMRB_LGFX_HOSTED)\n\n#include \"framebuffer/common.hpp\"\n\n#elif defined (ESP_PLATFORM)"],
    "src/lgfx/v1/platforms/device.hpp" =>
      ["#if defined (ESP_PLATFORM)",
       "#if defined (FMRB_LGFX_HOSTED)\n\n// sprite-only build: no bus or panel headers\n\n#elif defined (ESP_PLATFORM)"],
  }.each do |rel, (from, to)|
    path = File.join(M5GFX_DIR, rel)
    src = File.read(path)
    # A clone patched before the branch had its shared name.
    src.gsub!("FMRB_LGFX_WASM", "FMRB_LGFX_HOSTED")
    unless src.include?("FMRB_LGFX_HOSTED")
      src.sub!(from) { to } or abort "hosted:m5gfx: anchor not found in #{rel}"
    end
    File.write(path, src)
  end
end

# Regenerate the stale mruby app/kernel bytecode. Both hosted builds compile
# the mruby apps from their PRE-GENERATED bytecode (main/prebuild_scripts/**/
# mrb/*.c), and only the ESP-IDF / Linux CMake build produces those. Editing
# an app's Ruby and building for wasm alone therefore linked yesterday's
# bytecode without a word -- an hour went into a shell command that "did not
# exist" because of it. This runs the two commands that CMake step runs, for
# whatever is older than its sources.
#
# Same trap one level down: the gems under lib/add are compiled into
# libmruby, which the hosted core links but never rebuilds. Adding a method
# to the app base and building linked the library from before it, and the
# desktop died on the first event with a NoMethodError it had no way to
# report. So the caller's libmruby is checked first and rebuilt (mruby_task)
# when lib/add is newer.
def hosted_regen_mrb!(label, mruby_build, mruby_task)
  lib_a = File.join(ROOT_DIR, "components/picoruby-esp32/picoruby/build",
                    mruby_build, "lib/libmruby.a")
  newest_gem = Dir[File.join(ROOT_DIR, "lib/add/**/*.{rb,c,h}")]
               .map { |f| File.mtime(f) }.max
  if newest_gem && (!File.exist?(lib_a) || File.mtime(lib_a) < newest_gem)
    puts "#{label}: lib/add is newer than libmruby -- rebuilding it first"
    Rake::Task[mruby_task].invoke
  end
  mrbc = File.join(ROOT_DIR, "components/picoruby-esp32/picoruby/bin/mrbc")
  unless File.exist?(mrbc)
    puts "#{label}: no #{mrbc} yet -- skipped (a full build makes it)"
    return
  end
  gen = File.join(ROOT_DIR, "tool/debug/gen_combined_rb.py")
  [File.join(ROOT_DIR, "main/prebuild_scripts/default_app"),
   File.join(ROOT_DIR, "main/prebuild_scripts/kernel")].each do |dir|
    Dir[File.join(dir, "*.rb")].sort.each do |rb|
      # CMake's NAME_WE: the longest extension goes, so shell.app.rb is
      # "shell" and its mixins live in shell/.
      name = File.basename(rb).sub(/\..*\z/, "")
      out_c = File.join(dir, "mrb", "#{name}.c")
      subdir = File.join(dir, name)
      sources = [rb]
      sources += Dir[File.join(subdir, "*.rb")].sort if File.directory?(subdir)
      newest = sources.map { |f| File.mtime(f) }.max
      next if File.exist?(out_c) && File.mtime(out_c) >= newest
      mkdir_p File.join(dir, "mrb")
      if File.directory?(subdir)
        combined = File.join(dir, "mrb", "#{name}_combined.rb")
        map = File.join(dir, "mrb", "#{name}_combined.map.json")
        sh "python3 #{gen} #{combined} #{map} " \
           "#{(sources - [rb]).join(' ')} #{rb}"
        sh "#{mrbc} -g -B#{name}_irep -o#{out_c} #{combined}"
      else
        sh "#{mrbc} -g -B#{name}_irep -o#{out_c} #{rb}"
      end
      puts "#{label}: #{name} rebuilt"
    end
  end
end

namespace :hosted do
  desc "Fetch + patch LovyanGFX (M5GFX #{M5GFX_PIN[0, 8]}) for the hosted displays (wasm, native)"
  task :m5gfx do
    if !File.directory?(M5GFX_DIR) && File.directory?(M5GFX_OLD_DIR)
      mkdir_p File.dirname(M5GFX_DIR)
      mv M5GFX_OLD_DIR, M5GFX_DIR
    end
    unless File.directory?(M5GFX_DIR)
      sh "git clone --depth 1 #{M5GFX_REPO} #{M5GFX_DIR}"
      sh "cd #{M5GFX_DIR} && (git checkout #{M5GFX_PIN} 2>/dev/null || " \
         "(git fetch --depth 1 origin #{M5GFX_PIN} && git checkout #{M5GFX_PIN}))"
    end
    hosted_patch_m5gfx!
    puts "hosted:m5gfx done (#{M5GFX_DIR})"
  end
end
