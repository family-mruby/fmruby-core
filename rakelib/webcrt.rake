# The CRT look (doc/web_crt/): one shader and one curve for the browser
# build and the native compositor.
#
#   rake webcrt:gen    write hosted/crt/crt.vert and crt.frag into
#                      wasm/web/crt.js (between its "generated" markers);
#                      the native build makes its C strings itself (CMake)
#   rake webcrt:test   the curve and its inverse under node, crt.js's
#                      shaders against hosted/crt/, and the C curve
#                      (hosted/crt/crt_warp.c) against crt.js's
#                      (part of rake test)

WEBCRT_JS = File.join(ROOT_DIR, "wasm/web/crt.js")
WEBCRT_SHADERS = { "VERT" => File.join(ROOT_DIR, "hosted/crt/crt.vert"),
                   "FRAG" => File.join(ROOT_DIR, "hosted/crt/crt.frag") }.freeze
WEBCRT_BEGIN = "  // BEGIN generated by rake webcrt:gen from hosted/crt/ (edit those, not this)\n"
WEBCRT_END = "  // END generated by rake webcrt:gen\n"

# crt.js with the shared shaders written in: GLSL ES 3.00, the #version
# line first, the text as it is in a template literal.
def webcrt_generated_js
  js = File.read(WEBCRT_JS)
  a = js.index(WEBCRT_BEGIN) or abort "webcrt: #{WEBCRT_JS} has no BEGIN marker"
  b = js.index(WEBCRT_END, a) or abort "webcrt: #{WEBCRT_JS} has no END marker"
  block = WEBCRT_SHADERS.map do |name, path|
    src = File.read(path)
    raise "webcrt: #{path} has a #version line (the users put it first)" if src =~ /^\s*#version/
    text = "#version 300 es\n" + src
    text = text.gsub("\\", "\\\\\\\\").gsub("`", "\\\\`").gsub("${", "\\${")
    "  const #{name} = `#{text}`;\n"
  end.join("\n")
  js[0...(a + WEBCRT_BEGIN.length)] + block + js[b..]
end

namespace :webcrt do
  desc "Write the shared CRT shaders (hosted/crt/) into wasm/web/crt.js"
  task :gen do
    js = webcrt_generated_js
    if js == File.read(WEBCRT_JS)
      puts "webcrt:gen: crt.js is up to date"
    else
      File.write(WEBCRT_JS, js)
      puts "webcrt:gen: wrote the shaders into #{WEBCRT_JS}"
    end
  end

  # The browser build's CRT look (doc/web_crt/): the curve that the shader
  # draws and that clicks are sent back through, and its inverse, under
  # node; the shaders in crt.js are hosted/crt/'s; the C curve the native
  # compositor's pointer goes through gives crt.js's values.
  desc "CRT look: curve round trip (node), crt.js's shaders current, C curve = JS curve"
  task :test do
    sh "node test/web_crt/warp_test.js"
    abort "webcrt:test: wasm/web/crt.js's shaders differ from hosted/crt/; run rake webcrt:gen" \
      unless webcrt_generated_js == File.read(WEBCRT_JS)
    puts "webcrt:test: crt.js's shaders are hosted/crt/'s"
    sh "ruby test/web_crt/warp_c_test.rb"
  end
end
