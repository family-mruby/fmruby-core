# The CRT look (doc/web_crt/): one shader and one curve for the browser
# build and the native compositor.
#
#   rake webcrt:gen    write hosted/crt/crt.vert and crt.frag into
#                      wasm/web/crt.js (between its "generated" markers);
#                      the native build makes its C strings itself (CMake).
#                      Also the sets of strengths (hosted/crt/crt_presets.h)
#                      into crt.js and the native PC settings
#                      (native/apps/linux_settings.app.rb)
#   rake webcrt:test   the curve and its inverse under node, crt.js's
#                      shaders and both files' sets against hosted/crt/,
#                      and the C curve (hosted/crt/crt_warp.c) against
#                      crt.js's (part of rake test)

WEBCRT_JS = File.join(ROOT_DIR, "wasm/web/crt.js")
WEBCRT_SHADERS = { "VERT" => File.join(ROOT_DIR, "hosted/crt/crt.vert"),
                   "FRAG" => File.join(ROOT_DIR, "hosted/crt/crt.frag") }.freeze
WEBCRT_SETTINGS = File.join(ROOT_DIR, "native/apps/linux_settings.app.rb")
WEBCRT_PRESETS_H = File.join(ROOT_DIR, "hosted/crt/crt_presets.h")
# crt.js's KEYS, the order of a row in crt_presets.h.
WEBCRT_KEYS = %w[scan mask glow curve vignette ntsc flicker noise].freeze
WEBCRT_BEGIN = "  // BEGIN generated by rake webcrt:gen from hosted/crt/ (edit those, not this)\n"
WEBCRT_END = "  // END generated by rake webcrt:gen\n"

# crt.js with the shared shaders written in: GLSL ES 3.00, the #version
# line first, the text as it is in a template literal.
def webcrt_generated_js
  js = File.read(WEBCRT_JS)
  a = js.index(WEBCRT_BEGIN) or abort "webcrt: #{WEBCRT_JS} has no BEGIN marker"
  b = js.index(WEBCRT_END, a) or abort "webcrt: #{WEBCRT_JS} has no END marker"
  block = WEBCRT_SHADERS.map do |name, path|
    src = File.read(path)
    raise "webcrt: #{path} has a #version line (the users put it first)" if src =~ /^\s*#version/
    text = "#version 300 es\n" + src
    text = text.gsub("\\", "\\\\\\\\").gsub("`", "\\\\`").gsub("${", "\\${")
    "  const #{name} = `#{text}`;\n"
  end.join("\n")
  js[0...(a + WEBCRT_BEGIN.length)] + block + js[b..]
end

# The sets in hosted/crt/crt_presets.h: { "standard" => [8 numbers], ... },
# in the file's order.
def webcrt_presets
  sets = {}
  File.read(WEBCRT_PRESETS_H).scan(/^#define\s+CRT_PRESET_([A-Z0-9_]+)\s+(.+)$/) do |name, row|
    v = row.split(",").map { |x| Integer(x.strip) }
    raise "webcrt: CRT_PRESET_#{name} has #{v.size} values, not #{WEBCRT_KEYS.size}" unless v.size == WEBCRT_KEYS.size
    raise "webcrt: CRT_PRESET_#{name} has a value outside 0..100" unless v.all? { |x| x.between?(0, 100) }
    sets[name.downcase] = v
  end
  %w[standard strong].each { |n| raise "webcrt: #{WEBCRT_PRESETS_H} has no CRT_PRESET_#{n.upcase}" unless sets[n] }
  sets
end

# text with the lines between "<lead>BEGIN presets generated ..." and
# "<lead>END presets generated ..." replaced by body.
def webcrt_replace_presets(text, path, lead, body)
  b_mark = "#{lead}BEGIN presets generated by rake webcrt:gen from hosted/crt/crt_presets.h (edit that, not this)\n"
  e_mark = "#{lead}END presets generated by rake webcrt:gen\n"
  a = text.index(b_mark) or abort "webcrt: #{path} has no presets BEGIN marker"
  b = text.index(e_mark, a) or abort "webcrt: #{path} has no presets END marker"
  text[0...(a + b_mark.length)] + body + text[b..]
end

# { path => its text as webcrt:gen would write it }
def webcrt_generated
  sets = webcrt_presets
  js_body = "  const PRESETS = Object.freeze({\n" + sets.map do |name, v|
    "    #{name}: Object.freeze({ " + WEBCRT_KEYS.zip(v).map { |k, x| "#{k}: #{x}" }.join(", ") + " }),\n"
  end.join + "  });\n"
  rb_body = sets.map { |name, v| "  CRT_#{name.upcase} = [#{v.join(', ')}]\n" }.join +
            "  CRT_DEFAULTS = CRT_STANDARD\n"
  js = webcrt_replace_presets(webcrt_generated_js, WEBCRT_JS, "  // ", js_body)
  rb = webcrt_replace_presets(File.read(WEBCRT_SETTINGS), WEBCRT_SETTINGS, "  # ", rb_body)
  { WEBCRT_JS => js, WEBCRT_SETTINGS => rb }
end

namespace :webcrt do
  desc "Write the shared CRT shaders and sets (hosted/crt/) into crt.js and the PC settings"
  task :gen do
    webcrt_generated.each do |path, text|
      if text == File.read(path)
        puts "webcrt:gen: #{File.basename(path)} is up to date"
      else
        File.write(path, text)
        puts "webcrt:gen: wrote hosted/crt/ into #{path}"
      end
    end
  end

  # The browser build's CRT look (doc/web_crt/): the curve that the shader
  # draws and that clicks are sent back through, and its inverse, under
  # node; the shaders in crt.js are hosted/crt/'s; the C curve the native
  # compositor's pointer goes through gives crt.js's values.
  desc "CRT look: curve round trip (node), crt.js's shaders current, C curve = JS curve"
  task :test do
    sh "node test/web_crt/warp_test.js"
    webcrt_generated.each do |path, text|
      abort "webcrt:test: #{path} differs from hosted/crt/ (shaders or sets); run rake webcrt:gen" \
        unless text == File.read(path)
    end
    puts "webcrt:test: crt.js's shaders and sets, and the PC settings' sets, are hosted/crt/'s"
    sh "ruby test/web_crt/warp_c_test.rb"
  end
end
